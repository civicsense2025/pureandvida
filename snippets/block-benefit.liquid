{% comment %}
  Block Benefit Snippet
  ---------------------
  Reusable benefit/feature item with icon image, title, and description.
  Optimized for benefits section with simpler structure.

  Parameters:
    Required:
    - block: The block object containing settings

    Block Settings Expected:
    - block.settings.icon: Image picker for icon
    - block.settings.icon_asset: Alternative asset filename
    - block.settings.title: Benefit title
    - block.settings.description: Benefit description
    - block.settings.title_color: Override title color (optional)
    - block.settings.description_color: Override description color (optional)

    Optional Parameters:
    - icon_size: Max width for icon image (default: 80px)
    - show_shopify_attributes: true/false (default: true)

  Usage:
    {% render 'block-benefit', block: block, icon_size: 100 %}

  For settings mode (non-block):
    {% render 'block-benefit',
      icon: section.settings.benefit_1_icon,
      title: section.settings.benefit_1_title,
      description: section.settings.benefit_1_description
    %}
{% endcomment %}

{% liquid
  assign benefit_icon_size = icon_size | default: 80
  assign show_attrs = show_shopify_attributes | default: true

  # Support both block mode and direct settings mode
  if block
    assign benefit_icon = block.settings.icon
    assign benefit_icon_asset = block.settings.icon_asset
    assign benefit_title = block.settings.title
    assign benefit_description = block.settings.description
    assign benefit_title_color = block.settings.title_color
    assign benefit_description_color = block.settings.description_color
  else
    assign benefit_icon = icon
    assign benefit_icon_asset = icon_asset
    assign benefit_title = title
    assign benefit_description = description
    assign benefit_title_color = title_color
    assign benefit_description_color = description_color
  endif
%}

<div class="block-benefit" {% if block and show_attrs %}{{ block.shopify_attributes }}{% endif %}>
  {% if benefit_icon != blank %}
    <div class="block-benefit__icon" style="--icon-max-width: {{ benefit_icon_size }}px;">
      <img
        src="{{ benefit_icon | image_url: width: 200 }}"
        alt="{{ benefit_title | escape }}"
        loading="lazy"
        width="100"
        height="100"
      >
    </div>
  {% elsif benefit_icon_asset != blank %}
    <div class="block-benefit__icon" style="--icon-max-width: {{ benefit_icon_size }}px;">
      <img
        src="{{ benefit_icon_asset | asset_url }}"
        alt="{{ benefit_title | escape }}"
        loading="lazy"
        width="100"
        height="100"
      >
    </div>
  {% endif %}

  {% if benefit_title != blank %}
    <h3
      class="block-benefit__title"
      {% if benefit_title_color != blank %}style="color: {{ benefit_title_color }};"{% endif %}
    >
      {{ benefit_title | escape }}
    </h3>
  {% endif %}

  {% if benefit_description != blank %}
    <p
      class="block-benefit__description"
      {% if benefit_description_color != blank %}style="color: {{ benefit_description_color }};"{% endif %}
    >
      {{ benefit_description }}
    </p>
  {% endif %}
</div>

<style>
  .block-benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .block-benefit__icon {
    margin-bottom: var(--spacing-md, 16px);
  }

  .block-benefit__icon img {
    width: clamp(48px, 10vw, var(--icon-max-width, 80px));
    height: auto;
  }

  .block-benefit__title {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 600;
    margin: 0 0 var(--spacing-sm, 8px);
    line-height: 1.3;
  }

  .block-benefit__description {
    font-size: clamp(0.875rem, 2.5vw, 1rem);
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-secondary, inherit);
    opacity: 0.85;
  }
</style>
