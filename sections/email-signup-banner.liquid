{% liquid
  # @description Full-width newsletter signup banner with promotional styling
  # Eye-catching banner format for growing email list
  # @settings heading {String} - Banner heading
  # @settings background_image {Image} - Optional background image
  # @settings show_discount {Boolean} - Display discount offer
  # @example
  #   Add to homepage or any template for email capture

  assign form_id = 'email-signup-banner-' | append: section.id
%}

{% if request.design_mode %}
  <div class="editor-controls editor-controls--email-banner">
    <span class="editor-label">Email Signup Banner</span>
    <span class="editor-info">
      Layout: {{ section.settings.layout | replace: '-', ' ' | capitalize }} |
      {% if section.settings.background_image != blank %}Has background{% else %}Solid color{% endif %}
    </span>
  </div>
{% endif %}

<section
  class="email-signup-banner email-signup-banner--{{ section.settings.layout }}"
  style="
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.background_image != blank %}background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}'); background-size: cover; background-position: {{ section.settings.background_position }};{% endif %}
    {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}
    min-height: {{ section.settings.min_height }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.show_overlay and section.settings.background_image != blank %}
    <div
      class="email-signup-banner__overlay"
      style="
        background-color: {{ section.settings.overlay_color | default: 'rgba(0,0,0,0.5)' }};
        opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      "
    ></div>
  {% endif %}

  <div class="email-signup-banner__container{% if section.settings.full_width %} email-signup-banner__container--full{% else %} page-width{% endif %}">
    <div class="email-signup-banner__content" style="max-width: {{ section.settings.content_width }}px; text-align: {{ section.settings.text_alignment }};">

      {% if section.settings.show_icon and section.settings.icon != blank %}
        <span class="email-signup-banner__icon" aria-hidden="true">{{ section.settings.icon }}</span>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p
          class="email-signup-banner__subheading"
          style="
            font-size: {{ section.settings.subheading_size }}px;
            {% if section.settings.subheading_color != blank %}color: {{ section.settings.subheading_color }};{% endif %}
          "
        >
          {{ section.settings.subheading | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2
          class="email-signup-banner__heading"
          style="
            font-size: {{ section.settings.heading_size }}px;
            font-weight: {{ section.settings.heading_weight }};
            {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
          "
        >
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.show_discount and section.settings.discount_text != blank %}
        <div
          class="email-signup-banner__discount"
          style="
            {% if section.settings.discount_background != blank %}background-color: {{ section.settings.discount_background }};{% endif %}
            {% if section.settings.discount_text_color != blank %}color: {{ section.settings.discount_text_color }};{% endif %}
          "
        >
          {{ section.settings.discount_text | escape }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <p
          class="email-signup-banner__description"
          style="
            font-size: {{ section.settings.description_size }}px;
            {% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}
          "
        >
          {{ section.settings.description }}
        </p>
      {% endif %}

      <div class="email-signup-banner__form-wrapper">
        {% form 'customer', id: form_id, class: 'email-signup-banner__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.additional_tags }}">

          {% if form.posted_successfully? %}
            <div class="email-signup-banner__success" role="alert">
              <span class="success-icon" aria-hidden="true">✓</span>
              <p>{{ section.settings.success_message | default: 'Thanks for subscribing!' }}</p>
            </div>
          {% else %}
            <div class="email-signup-banner__input-group email-signup-banner__input-group--{{ section.settings.form_layout }}">
              {% if section.settings.show_name_field %}
                <input
                  type="text"
                  name="contact[{{ 'customer.first_name' | t | default: 'First Name' }}]"
                  class="email-signup-banner__input"
                  placeholder="{{ section.settings.name_placeholder | default: 'Your name' }}"
                  {% if section.settings.name_required %}required{% endif %}
                  autocomplete="name"
                  style="
                    {% if section.settings.input_background != blank %}background-color: {{ section.settings.input_background }};{% endif %}
                    {% if section.settings.input_text_color != blank %}color: {{ section.settings.input_text_color }};{% endif %}
                    border-radius: {{ section.settings.input_border_radius }}px;
                  "
                >
              {% endif %}

              <input
                type="email"
                name="contact[email]"
                class="email-signup-banner__input email-signup-banner__input--email"
                placeholder="{{ section.settings.email_placeholder | default: 'Enter your email' }}"
                required
                autocomplete="email"
                autocapitalize="off"
                aria-label="{{ 'newsletter.email' | t | default: 'Email address' }}"
                style="
                  {% if section.settings.input_background != blank %}background-color: {{ section.settings.input_background }};{% endif %}
                  {% if section.settings.input_text_color != blank %}color: {{ section.settings.input_text_color }};{% endif %}
                  border-radius: {{ section.settings.input_border_radius }}px;
                "
              >

              <button
                type="submit"
                class="email-signup-banner__submit"
                style="
                  {% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}
                  {% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %}
                  border-radius: {{ section.settings.button_border_radius }}px;
                "
              >
                {{ section.settings.button_text | default: 'Subscribe' }}
              </button>
            </div>

            {% if form.errors %}
              <p class="email-signup-banner__error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {% endif %}
          {% endif %}
        {% endform %}

        {% if section.settings.privacy_text != blank %}
          <p class="email-signup-banner__privacy" style="{% if section.settings.privacy_color != blank %}color: {{ section.settings.privacy_color }};{% endif %}">
            {{ section.settings.privacy_text }}
          </p>
        {% endif %}
      </div>

      {% if section.settings.show_features %}
        <div class="email-signup-banner__features">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="email-signup-banner__feature" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  <span class="feature-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                {% endif %}
                <span class="feature-text">{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .email-signup-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .email-signup-banner__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .email-signup-banner__container {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .email-signup-banner__container--full {
    max-width: none;
    padding: 0 20px;
  }

  .email-signup-banner__content {
    width: 100%;
  }

  .email-signup-banner__icon {
    display: block;
    font-size: 3rem;
    margin-bottom: 16px;
  }

  .email-signup-banner__subheading {
    font-family: var(--font-body-family);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0 0 8px;
    opacity: 0.9;
  }

  .email-signup-banner__heading {
    font-family: var(--font-heading-family);
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .email-signup-banner__discount {
    display: inline-block;
    padding: 8px 24px;
    margin-bottom: 16px;
    font-weight: 700;
    font-size: 1.25rem;
    border-radius: 4px;
    background: var(--color-accent, #ff6b6b);
    color: #fff;
  }

  .email-signup-banner__description {
    font-family: var(--font-body-family);
    margin: 0 0 24px;
    line-height: 1.6;
    opacity: 0.9;
  }

  .email-signup-banner__form-wrapper {
    width: 100%;
  }

  .email-signup-banner__form {
    width: 100%;
  }

  .email-signup-banner__input-group {
    display: flex;
    gap: 12px;
    width: 100%;
  }

  .email-signup-banner__input-group--inline {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .email-signup-banner__input-group--stacked {
    flex-direction: column;
    max-width: 400px;
    margin: 0 auto;
  }

  .email-signup-banner__input {
    flex: 1;
    min-width: 0;
    padding: 14px 20px;
    border: 2px solid transparent;
    font-family: var(--font-body-family);
    font-size: 1rem;
    min-height: 52px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .email-signup-banner__input:focus {
    outline: none;
    border-color: var(--color-primary, #000);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
  }

  .email-signup-banner__input--email {
    min-width: 250px;
  }

  .email-signup-banner__input::placeholder {
    opacity: 0.6;
  }

  .email-signup-banner__submit {
    padding: 14px 32px;
    background: var(--color-primary, #000);
    color: var(--color-background, #fff);
    border: none;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.1s ease;
    min-height: 52px;
    white-space: nowrap;
  }

  .email-signup-banner__submit:hover {
    opacity: 0.9;
  }

  .email-signup-banner__submit:active {
    transform: scale(0.98);
  }

  .email-signup-banner__success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
    background: rgba(76, 175, 80, 0.15);
    border-radius: 8px;
  }

  .email-signup-banner__success .success-icon {
    font-size: 1.5rem;
    color: #4caf50;
  }

  .email-signup-banner__success p {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .email-signup-banner__error {
    margin: 12px 0 0;
    color: #e53935;
    font-size: 0.9rem;
  }

  .email-signup-banner__privacy {
    margin: 16px 0 0;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .email-signup-banner__privacy a {
    color: inherit;
    text-decoration: underline;
  }

  .email-signup-banner__features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-top: 32px;
  }

  .email-signup-banner__feature {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
  }

  .email-signup-banner__feature .feature-icon {
    font-size: 1.1rem;
  }

  /* Layout variations */
  .email-signup-banner--centered .email-signup-banner__content {
    text-align: center;
  }

  .email-signup-banner--centered .email-signup-banner__input-group--inline {
    justify-content: center;
  }

  .email-signup-banner--left .email-signup-banner__content {
    text-align: left;
  }

  .email-signup-banner--left .email-signup-banner__features {
    justify-content: flex-start;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 767px) {
    .email-signup-banner {
      min-height: auto !important;
      padding: 40px 16px !important;
    }

    .email-signup-banner__heading {
      font-size: clamp(1.5rem, 6vw, 2.5rem) !important;
    }

    .email-signup-banner__input-group--inline {
      flex-direction: column;
    }

    .email-signup-banner__input--email {
      min-width: auto;
    }

    .email-signup-banner__submit {
      width: 100%;
    }

    .email-signup-banner__features {
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
  }

  /* Tablet */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .email-signup-banner__input-group--inline {
      flex-wrap: nowrap;
    }
  }

  {% if request.design_mode %}
    .email-signup-banner {
      outline: 2px dashed rgba(255, 64, 129, 0.3);
      outline-offset: -2px;
    }

    .email-signup-banner::before {
      content: 'EMAIL SIGNUP BANNER';
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(255, 64, 129, 0.95);
      color: white;
      padding: 4px 12px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
    }

    .editor-controls--email-banner {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.90);
      color: white;
      padding: 8px 14px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font-body-family);
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      border: 2px solid rgba(255, 64, 129, 0.5);
    }

    .editor-controls--email-banner .editor-label {
      font-weight: 600;
      color: rgba(255, 64, 129, 1);
      font-size: 12px;
    }

    .editor-controls--email-banner .editor-info {
      font-size: 10px;
      opacity: 0.85;
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "📧 Email Signup Banner",
  "tag": "section",
  "class": "section-email-signup-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Eye-catching full-width email signup banner for growing your subscriber list. Supports background images, discount offers, and promotional messaging."
    },
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Content Alignment",
      "options": [
        { "value": "centered", "label": "Centered" },
        { "value": "left", "label": "Left Aligned" }
      ],
      "default": "centered"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Max Width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Container",
      "default": false
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a2e"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Overlay",
      "default": true,
      "info": "Only visible when background image is set"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "✏️ Content"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Icon",
      "default": true
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon (Emoji)",
      "default": "📬",
      "info": "Emoji or symbol displayed above heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Newsletter",
      "info": "Small text above main heading"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% Off Your First Order"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show Discount Badge",
      "default": false
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Badge Text",
      "default": "10% OFF"
    },
    {
      "type": "color",
      "id": "discount_background",
      "label": "Discount Badge Background"
    },
    {
      "type": "color",
      "id": "discount_text_color",
      "label": "Discount Badge Text Color"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Subscribe to our newsletter and be the first to know about new products, exclusive offers, and wellness tips."
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Default Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "select",
      "id": "form_layout",
      "label": "Form Layout",
      "options": [
        { "value": "inline", "label": "Inline (Side by Side)" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "inline"
    },
    {
      "type": "checkbox",
      "id": "show_name_field",
      "label": "Show Name Field",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "name_required",
      "label": "Name Required",
      "default": false
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Placeholder",
      "default": "Your name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "additional_tags",
      "label": "Additional Tags",
      "info": "Comma-separated tags to add to subscribers"
    },
    {
      "type": "header",
      "content": "Form Styling"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input Text Color"
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Input Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "🔒 Privacy"
    },
    {
      "type": "richtext",
      "id": "privacy_text",
      "label": "Privacy Notice",
      "default": "<p>We respect your privacy. Unsubscribe at any time.</p>"
    },
    {
      "type": "color",
      "id": "privacy_color",
      "label": "Privacy Text Color"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show Features List",
      "default": false,
      "info": "Add feature blocks below to display benefits"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
