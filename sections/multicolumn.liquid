{% liquid
  # @description Multi-column content section with flexible blocks
  # Supports icons, images, text content, and call-to-action buttons
  # @settings title {text} - Section title
  # @settings columns_desktop {range} - Number of columns on desktop
  # @blocks column {object} - Individual column content
  # @example
  #   Use for feature highlights, benefits, team members, or service offerings
%}

{% if request.design_mode %}
  <div class="editor-controls editor-controls--multicolumn">
    <span class="editor-label">Multi-Column</span>
    <span class="editor-info">
      {{ section.blocks.size }} columns |
      {{ section.settings.columns_desktop }} per row
    </span>
  </div>
{% endif %}

<section
  class="multicolumn multicolumn--{{ section.settings.layout_style }}"
  style="
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-label="{{ section.settings.title | default: 'Multi-column content' | escape }}"
>
  <div class="multicolumn__container page-width">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="multicolumn__header" style="text-align: {{ section.settings.header_alignment }};">
        {%- if section.settings.subtitle != blank -%}
          <span class="multicolumn__subtitle">{{ section.settings.subtitle }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="multicolumn__title" style="font-size: {{ section.settings.title_size }}px;">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="multicolumn__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="multicolumn__grid"
      style="
        --columns-desktop: {{ section.settings.columns_desktop }};
        --columns-tablet: {{ section.settings.columns_tablet }};
        --columns-mobile: {{ section.settings.columns_mobile }};
        --column-gap: {{ section.settings.column_gap }}px;
        --row-gap: {{ section.settings.row_gap }}px;
      "
    >
      {%- for block in section.blocks -%}
        <div
          class="multicolumn__item"
          style="text-align: {{ section.settings.content_alignment }};"
          {{ block.shopify_attributes }}
        >
          {%- if block.type contains '@theme' -%}
            <div class="multicolumn__card{% if section.settings.show_card_background %} multicolumn__card--has-bg{% endif %}">
              {{ block }}
            </div>
          {%- elsif block.type == 'column' -%}
            <div class="multicolumn__card{% if section.settings.show_card_background %} multicolumn__card--has-bg{% endif %}">
              {%- render 'block-column',
                block: block,
                image_ratio: section.settings.image_ratio,
                image_width: section.settings.image_width,
                image_border_radius: section.settings.image_border_radius,
                icon_size: section.settings.icon_size,
                icon_color: section.settings.icon_color,
                content_alignment: section.settings.content_alignment,
                button_style: section.settings.button_style,
                heading_color: section.settings.heading_color,
                text_color: section.settings.text_color
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- if request.design_mode -%}
          <div class="multicolumn__empty">
            <p>Add column blocks to populate this section.</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="multicolumn__footer" style="text-align: {{ section.settings.header_alignment }};">
        <a
          href="{{ section.settings.button_link }}"
          class="multicolumn__button button button--{{ section.settings.footer_button_style }}"
          {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .multicolumn {
    position: relative;
  }

  .multicolumn__container {
    width: 100%;
  }

  .multicolumn__header {
    margin-bottom: 48px;
    max-width: 800px;
    {% if section.settings.header_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  .multicolumn__subtitle {
    display: block;
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary, #2c5530);
    margin-bottom: 12px;
  }

  .multicolumn__title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight, 600);
    line-height: 1.2;
    margin: 0 0 16px;
    color: {{ section.settings.heading_color | default: 'var(--color-text, #333)' }};
  }

  .multicolumn__description {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    line-height: 1.6;
    color: {{ section.settings.text_color | default: 'var(--color-text, #666)' }};
    opacity: 0.85;
  }

  .multicolumn__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-desktop), 1fr);
    gap: var(--row-gap) var(--column-gap);
  }

  .multicolumn__item {
    display: flex;
  }

  .multicolumn__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    {% if section.settings.show_card_background %}
      background: {{ section.settings.card_background_color | default: '#f9f9f9' }};
      padding: 32px 24px;
      border-radius: {{ section.settings.card_border_radius }}px;
    {% endif %}
  }

  .multicolumn__media {
    width: 100%;
    overflow: hidden;
    margin-bottom: 20px;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  .multicolumn__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .multicolumn__icon {
    width: var(--icon-size);
    height: var(--icon-size);
    margin-bottom: 20px;
    color: var(--icon-color);
    {% if section.settings.content_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
    {% if section.settings.content_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .multicolumn__icon svg {
    width: 100%;
    height: 100%;
  }

  .multicolumn__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .multicolumn__item-title {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
    color: {{ section.settings.heading_color | default: 'var(--color-text, #333)' }};
  }

  .multicolumn__item-text {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    line-height: 1.7;
    color: {{ section.settings.text_color | default: 'var(--color-text, #666)' }};
    margin-bottom: 16px;
    flex: 1;
  }

  .multicolumn__item-text p {
    margin: 0;
  }

  .multicolumn__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary, #2c5530);
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .multicolumn__link:not(.button):hover {
    gap: 10px;
  }

  .multicolumn__link.button {
    padding: 12px 24px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
  }

  .multicolumn__footer {
    margin-top: 48px;
  }

  .multicolumn__button {
    display: inline-block;
    padding: 14px 32px;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .multicolumn__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    background: #f5f5f5;
    border: 2px dashed #ddd;
    border-radius: 8px;
    color: #666;
  }

  /* Button styles */
  .button--primary {
    background-color: var(--color-primary, #2c5530);
    color: white;
    border: 2px solid var(--color-primary, #2c5530);
  }

  .button--primary:hover {
    background-color: var(--color-primary-dark, #1e3a21);
    border-color: var(--color-primary-dark, #1e3a21);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--color-primary, #2c5530);
    border: 2px solid var(--color-primary, #2c5530);
  }

  .button--secondary:hover {
    background-color: var(--color-primary, #2c5530);
    color: white;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .multicolumn__grid {
      grid-template-columns: repeat(var(--columns-tablet), 1fr);
    }
  }

  @media (max-width: 768px) {
    .multicolumn__grid {
      grid-template-columns: repeat(var(--columns-mobile), 1fr);
    }

    .multicolumn__header {
      margin-bottom: 32px;
    }

    .multicolumn__title {
      font-size: {{ section.settings.title_size | times: 0.7 | round }}px !important;
    }

    .multicolumn__card--has-bg {
      padding: 24px 20px;
    }

    .multicolumn__footer {
      margin-top: 32px;
    }
  }

  /* Editor mode styles */
  {% if request.design_mode %}
    .multicolumn {
      outline: 2px dashed rgba(44, 85, 48, 0.3);
      outline-offset: -2px;
      min-height: 200px;
    }

    .multicolumn::before {
      content: 'MULTI-COLUMN';
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(44, 85, 48, 0.95);
      color: white;
      padding: 4px 12px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
    }

    .editor-controls--multicolumn {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.90);
      color: white;
      padding: 8px 14px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font-body-family);
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      border: 2px solid rgba(44, 85, 48, 0.5);
    }

    .editor-controls--multicolumn .editor-label {
      font-weight: 600;
      color: var(--color-primary, #2c5530);
      font-size: 12px;
    }

    .editor-controls--multicolumn .editor-info {
      font-size: 10px;
      opacity: 0.85;
    }

    .multicolumn__item {
      outline: 1px dashed rgba(44, 85, 48, 0.2);
      outline-offset: -1px;
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "📊 Multi-Column",
  "tag": "section",
  "class": "section-multicolumn",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Create flexible multi-column layouts for features, benefits, team members, or any content grid. Add column blocks below."
    },
    {
      "type": "header",
      "content": "📝 Section Header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "Small text above the title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Multi-Column"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "📐 Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns (Tablet)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row Gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "🖼️ Image Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to Image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "square"
    },
    {
      "type": "range",
