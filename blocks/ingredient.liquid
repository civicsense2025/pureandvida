{%- comment -%}
  Theme Block: Ingredient
  -----------------------
  Ingredient item with image, name, description, and optional benefit tags.
{%- endcomment -%}

{%- liquid
  assign img_size = block.settings.image_size | default: 400
  assign ingredient_image = block.settings.image
  assign ingredient_image_asset = block.settings.image_asset
  assign ingredient_name = block.settings.name
  assign ingredient_description = block.settings.description
  assign ingredient_benefit_tags = block.settings.benefit_tags
  assign ingredient_name_color = block.settings.name_color
  assign ingredient_description_color = block.settings.description_color
  assign image_border_radius = block.settings.image_border_radius | default: 8
-%}

<div class="block-ingredient" {{ block.shopify_attributes }}>
  {%- if ingredient_image != blank -%}
    <div class="block-ingredient__image" style="border-radius: {{ image_border_radius }}px;">
      <img
        src="{{ ingredient_image | image_url: width: img_size }}"
        srcset="
          {{ ingredient_image | image_url: width: 200 }} 200w,
          {{ ingredient_image | image_url: width: 300 }} 300w,
          {{ ingredient_image | image_url: width: img_size }} {{ img_size }}w
        "
        sizes="(max-width: 480px) 50vw, (max-width: 768px) 33vw, 20vw"
        alt="{{ ingredient_name | escape }}"
        loading="lazy"
        width="{{ ingredient_image.width }}"
        height="{{ ingredient_image.height }}"
      >
    </div>
  {%- elsif ingredient_image_asset != blank -%}
    <div class="block-ingredient__image" style="border-radius: {{ image_border_radius }}px;">
      <img
        src="{{ ingredient_image_asset | asset_url }}"
        alt="{{ ingredient_name | escape }}"
        loading="lazy"
      >
    </div>
  {%- else -%}
    <div class="block-ingredient__placeholder" style="border-radius: {{ image_border_radius }}px;">
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if ingredient_name != blank -%}
    <h3
      class="block-ingredient__name"
      {% if ingredient_name_color != blank %}style="color: {{ ingredient_name_color }};"{% endif %}
    >
      {{ ingredient_name | escape }}
    </h3>
  {%- endif -%}

  {%- if ingredient_description != blank -%}
    <p
      class="block-ingredient__description"
      {% if ingredient_description_color != blank %}style="color: {{ ingredient_description_color }};"{% endif %}
    >
      {{ ingredient_description }}
    </p>
  {%- endif -%}

  {%- if ingredient_benefit_tags != blank -%}
    <div class="block-ingredient__tags">
      {{ ingredient_benefit_tags }}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .block-ingredient {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .block-ingredient__image {
    margin-bottom: var(--spacing-md, 16px);
    width: 100%;
    max-width: 200px;
    overflow: hidden;
  }

  .block-ingredient__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .block-ingredient__placeholder {
    margin-bottom: var(--spacing-md, 16px);
    width: 100%;
    max-width: 200px;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .block-ingredient__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  .block-ingredient__name {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 600;
    margin: 0 0 var(--spacing-sm, 8px);
    line-height: 1.3;
  }

  .block-ingredient__description {
    font-size: clamp(0.813rem, 2vw, 0.938rem);
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-secondary, inherit);
    opacity: 0.85;
  }

  .block-ingredient__tags {
    margin-top: var(--spacing-sm, 8px);
    font-size: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
  }

  .block-ingredient__tags span,
  .block-ingredient__tags p {
    display: inline-block;
    background: var(--color-primary-light, rgba(44, 85, 48, 0.1));
    color: var(--color-primary, #2c5530);
    padding: 2px 8px;
    border-radius: 4px;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient",
  "settings": [
    {
      "type": "text",
      "id": "name",
      "label": "Ingredient Name",
      "default": "Ingredient"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Describe the ingredient and its benefits."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image Asset Filename",
      "info": "Alternative: enter asset filename (e.g., 'ingredient.png')"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image Size",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Benefit Tags"
    },
    {
      "type": "richtext",
      "id": "benefit_tags",
      "label": "Benefit Tags",
      "info": "Add tags like <span>Organic</span> <span>Vegan</span>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name Color"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    }
  ],
  "presets": [
    {
      "name": "Ingredient"
    }
  ]
}
{% endschema %}
