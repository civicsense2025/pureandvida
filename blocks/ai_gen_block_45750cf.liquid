{% doc %}
  @prompt
    Create a customizeable header with the ability to upload custom fonts, change layout options and column numbers, custom menus, parralax baackground options
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @font-face {
    font-family: 'CustomHeaderFont';
    src: url('{{ block.settings.custom_font_file }}') format('woff2');
    font-weight: normal;
    font-style: normal;
  }

  .ai-header-{{ ai_gen_id }} {
    position: relative;
    min-height: {{ block.settings.min_height }}px;
    overflow: hidden;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-header-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-header-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ai-header-bg-{{ ai_gen_id }}.parallax {
    transform: translateY(var(--ai-parallax-offset-{{ ai_gen_id }}, 0));
    transition: transform 0.1s linear;
  }

  .ai-header-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }

  .ai-header-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-header-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.content_alignment }};
  }

  .ai-header-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.element_spacing }}px;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    max-width: {{ block.settings.logo_width }}px;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-header-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    {% if block.settings.use_custom_font %}
      font-family: 'CustomHeaderFont', sans-serif;
    {% else %}
      font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
      font-weight: {{ block.settings.heading_font.weight }};
      font-style: {{ block.settings.heading_font.style }};
    {% endif %}
  }

  .ai-header-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-header-nav-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.nav_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-nav-{{ ai_gen_id }} a {
    color: {{ block.settings.nav_link_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_font_size }}px;
    transition: color 0.3s ease;
  }

  .ai-header-nav-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.nav_link_hover_color }};
  }

  .ai-header-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-header-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-header-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }

    .ai-header-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-header-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-header-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-header-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    .ai-header-nav-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}

<header-parallax-{{ ai_gen_id }} class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-bg-{{ ai_gen_id }} {% if block.settings.enable_parallax %}parallax{% endif %}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-header-bg-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-header-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-header-content-{{ ai_gen_id }}">
    <div class="ai-header-grid-{{ ai_gen_id }}">
      <div class="ai-header-column-{{ ai_gen_id }}">
        {% if block.settings.show_logo and block.settings.logo %}
          <div class="ai-header-logo-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              loading="lazy"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
            >
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h1 class="ai-header-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-header-text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
        {% endif %}

        {% if block.settings.show_cta and block.settings.cta_text != blank %}
          <div>
            <a href="{{ block.settings.cta_link }}" class="ai-header-cta-{{ ai_gen_id }}">
              {{ block.settings.cta_text }}
            </a>
          </div>
        {% endif %}
      </div>

      {% if block.settings.show_navigation %}
        <div class="ai-header-column-{{ ai_gen_id }}">
          {% if block.settings.menu_1 != blank %}
            <nav>
              <ul class="ai-header-nav-{{ ai_gen_id }}">
                {% for link in linklists[block.settings.menu_1].links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_secondary_menu %}
        <div class="ai-header-column-{{ ai_gen_id }}">
          {% if block.settings.menu_2 != blank %}
            <nav>
              <ul class="ai-header-nav-{{ ai_gen_id }}">
                {% for link in linklists[block.settings.menu_2].links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</header-parallax-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderParallax{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.parallaxEnabled = {{ block.settings.enable_parallax | json }};
        this.parallaxSpeed = {{ block.settings.parallax_speed }};
      }

      connectedCallback() {
        if (this.parallaxEnabled) {
          this.bgElement = this.querySelector('.ai-header-bg-{{ ai_gen_id }}');
          this.handleScroll = this.handleScroll.bind(this);
          window.addEventListener('scroll', this.handleScroll, { passive: true });
          this.handleScroll();
        }
      }

      disconnectedCallback() {
        if (this.parallaxEnabled) {
          window.removeEventListener('scroll', this.handleScroll);
        }
      }

      handleScroll() {
        const rect = this.getBoundingClientRect();
        const scrolled = window.pageYOffset;
        const offset = (scrolled - this.offsetTop) * this.parallaxSpeed;
        
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          this.style.setProperty('--ai-parallax-offset-{{ ai_gen_id }}', offset + 'px');
        }
      }
    }

    customElements.define('header-parallax-{{ ai_gen_id }}', HeaderParallax{{ ai_gen_id }});
  })();
</script>

