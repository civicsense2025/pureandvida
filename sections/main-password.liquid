{% liquid
  # @description Password page section
  # Displays password protection form for password-protected stores
  # Fully customizable via Theme Editor
%}

<section class="password-section" id="section-{{ section.id }}">
  <div class="password-container">
    {% if section.settings.logo_image != blank %}
      <div class="password-logo">
        {{ section.settings.logo_image | image_url: width: 300 | image_tag:
          alt: shop.name,
          loading: 'eager'
        }}
      </div>
    {% elsif section.settings.show_shop_name %}
      <h1 class="password-shop-name">{{ shop.name | escape }}</h1>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="password-heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="password-description">{{ section.settings.description }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'password-form' %}
      <div class="password-input-wrapper">
        <label for="password-input-{{ section.id }}" class="visually-hidden">
          {{ section.settings.input_label | default: 'Password' }}
        </label>
        <input
          type="password"
          name="password"
          id="password-input-{{ section.id }}"
          placeholder="{{ section.settings.input_placeholder | default: 'Enter password' }}"
          required
          class="password-input"
          autocomplete="current-password"
        >
      </div>
      <button type="submit" class="password-submit">
        {{ section.settings.button_text | default: 'Enter' }}
      </button>
    {% endform %}

    {% if form.errors %}
      <div class="password-error" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    {% if section.settings.show_powered_by %}
      <p class="password-powered-by">
        {{ 'general.password_page.powered_by_shopify' | t | default: 'Powered by Shopify' }}
      </p>
    {% endif %}
  </div>
</section>

<style>
  #section-{{ section.id }} {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl, 32px) var(--page-width-padding, 20px);
    background-color: {{ section.settings.background_color | default: 'var(--color-background)' }};
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
  }

  #section-{{ section.id }} .password-container {
    width: 100%;
    max-width: {{ section.settings.max_width | default: 400 }}px;
    text-align: center;
    {% if section.settings.background_image != blank %}
      background: rgba(255, 255, 255, 0.95);
      padding: var(--spacing-2xl, 48px) var(--spacing-xl, 32px);
      border-radius: var(--radius-lg, 12px);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    {% endif %}
  }

  #section-{{ section.id }} .password-logo {
    margin-bottom: var(--spacing-lg, 24px);
  }

  #section-{{ section.id }} .password-logo img {
    max-width: 100%;
    height: auto;
    max-height: {{ section.settings.logo_height | default: 80 }}px;
  }

  #section-{{ section.id }} .password-shop-name {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 var(--spacing-md, 16px);
    color: {{ section.settings.heading_color | default: 'var(--color-text)' }};
    font-family: var(--font-heading-family);
  }

  #section-{{ section.id }} .password-heading {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 600;
    margin: 0 0 var(--spacing-sm, 8px);
    color: {{ section.settings.heading_color | default: 'var(--color-text)' }};
  }

  #section-{{ section.id }} .password-description {
    font-size: clamp(0.875rem, 2.5vw, 1rem);
    color: {{ section.settings.text_color | default: 'var(--color-text-secondary)' }};
    margin: 0 0 var(--spacing-lg, 24px);
    line-height: 1.6;
  }

  #section-{{ section.id }} .password-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, 16px);
  }

  #section-{{ section.id }} .password-input {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid {{ section.settings.input_border_color | default: 'var(--color-border, #ccc)' }};
    border-radius: {{ section.settings.input_radius | default: 8 }}px;
    font-size: 1rem;
    background: {{ section.settings.input_bg_color | default: '#fff' }};
    color: var(--color-text);
    min-height: 48px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #section-{{ section.id }} .password-input:focus {
    outline: none;
    border-color: {{ section.settings.button_color | default: 'var(--color-primary)' }};
    box-shadow: 0 0 0 3px {{ section.settings.button_color | default: 'var(--color-primary)' }}20;
  }

  #section-{{ section.id }} .password-submit {
    width: 100%;
    padding: 14px 24px;
    background: {{ section.settings.button_color | default: 'var(--color-primary, #000)' }};
    color: {{ section.settings.button_text_color | default: '#fff' }};
    border: none;
    border-radius: {{ section.settings.button_radius | default: 8 }}px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 48px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #section-{{ section.id }} .password-submit:hover {
    opacity: 0.9;
  }

  #section-{{ section.id }} .password-submit:active {
    transform: scale(0.98);
  }

  #section-{{ section.id }} .password-error {
    margin-top: var(--spacing-md, 16px);
    padding: 12px 16px;
    background: rgba(220, 38, 38, 0.1);
    color: #dc2626;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.875rem;
  }

  #section-{{ section.id }} .password-powered-by {
    margin-top: var(--spacing-xl, 32px);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    opacity: 0.6;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 479px) {
    #section-{{ section.id }} .password-container {
      padding: var(--spacing-lg, 24px) var(--spacing-md, 16px);
    }

    #section-{{ section.id }} .password-input,
    #section-{{ section.id }} .password-submit {
      padding: 12px 16px;
    }
  }
</style>

{% schema %}
{
  "name": "🔒 Password Page",
  "tag": "section",
  "class": "section section--password",
  "settings": [
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image",
      "info": "Upload a logo to display above the form"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_shop_name",
      "label": "Show Shop Name",
      "default": true,
      "info": "Display shop name if no logo is uploaded"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coming Soon"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "This store is password protected. Please enter the password to continue."
    },
    {
      "type": "header",
      "content": "🔑 Form"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input Label (Screen Readers)",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input Placeholder",
      "default": "Enter password"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Enter"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Optional background image"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "input_bg_color",
      "label": "Input Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input Border Color"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Input Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show 'Powered by Shopify'",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Password Page",
      "settings": {
        "heading": "Coming Soon",
        "description": "This store is password protected. Please enter the password to continue."
      }
    }
  ]
}
{% endschema %}
