{% liquid
  # @description Image collage section with flexible grid layouts
  # Supports multiple layout patterns with images, products, collections, and videos
  # @settings layout {String} - Collage layout pattern (left-large, right-large, etc.)
  # @settings desktop_layout {String} - Grid arrangement on desktop
  # @settings mobile_layout {String} - Stack order on mobile
  # @blocks image - Image block with optional overlay and link
  # @blocks product - Product card block
  # @blocks collection - Collection card block
  # @blocks video - Video embed block
  # @example
  #   Add to any template for visual collage displays

  assign collage_id = 'collage-' | append: section.id
%}

{% if request.design_mode %}
  <div class="editor-controls editor-controls--collage">
    <span class="editor-label">Collage Section</span>
    <span class="editor-info">
      Layout: {{ section.settings.layout | replace: '-', ' ' | capitalize }} |
      {{ section.blocks.size }} blocks
    </span>
  </div>
{% endif %}

<section
  class="collage-section"
  id="{{ collage_id }}"
  style="
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="collage-section__container{% if section.settings.full_width %} collage-section__container--full{% else %} page-width{% endif %}">
    {% if section.settings.heading != blank %}
      <h2
        class="collage-section__heading"
        style="
          {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
          text-align: {{ section.settings.heading_alignment }};
          font-size: {{ section.settings.heading_size }}px;
          margin-bottom: {{ section.settings.heading_spacing }}px;
        "
      >
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p
        class="collage-section__description"
        style="
          {% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}
          text-align: {{ section.settings.heading_alignment }};
          margin-bottom: {{ section.settings.description_spacing }}px;
        "
      >
        {{ section.settings.description }}
      </p>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="collage-grid collage-grid--{{ section.settings.layout }}"
        style="gap: {{ section.settings.grid_gap }}px;"
      >
        {% for block in section.blocks %}
          <div
            class="collage-item collage-item--{{ forloop.index }}"
            {{ block.shopify_attributes }}
            style="{% if block.settings.custom_height != blank %}min-height: {{ block.settings.custom_height }}px;{% endif %}"
          >
            {% case block.type %}
              {% when 'image' %}
                <div class="collage-item__image-wrapper">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      srcset="
                        {{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 800 }} 800w,
                        {{ block.settings.image | image_url: width: 1200 }} 1200w
                      "
                      sizes="(max-width: 767px) 100vw, 50vw"
                      alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                      class="collage-item__image"
                      loading="lazy"
                      style="object-position: {{ block.settings.image_position }};"
                    >
                  {% else %}
                    <div class="collage-item__placeholder">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}

                  {% if block.settings.show_overlay %}
                    <div
                      class="collage-item__overlay"
                      style="background-color: {{ block.settings.overlay_color | default: 'rgba(0,0,0,0.4)' }};"
                    >
                      {% if block.settings.heading != blank %}
                        <h3
                          class="collage-item__heading"
                          style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}"
                        >
                          {{ block.settings.heading | escape }}
                        </h3>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <p
                          class="collage-item__text"
                          style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}"
                        >
                          {{ block.settings.text }}
                        </p>
                      {% endif %}
                      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                        <a
                          href="{{ block.settings.button_link }}"
                          class="collage-item__button"
                          style="
                            {% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %}
                            {% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}
                          "
                        >
                          {{ block.settings.button_text }}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.link != blank and block.settings.button_text == blank %}
                    <a href="{{ block.settings.link }}" class="collage-item__full-link" aria-label="{{ block.settings.heading | default: 'View more' }}"></a>
                  {% endif %}
                </div>

              {% when 'product' %}
                {% if block.settings.product != blank %}
                  <div class="collage-item__product">
                    <a href="{{ block.settings.product.url }}" class="collage-item__product-link">
                      {% if block.settings.product.featured_image != blank %}
                        <img
                          src="{{ block.settings.product.featured_image | image_url: width: 800 }}"
                          alt="{{ block.settings.product.featured_image.alt | default: block.settings.product.title | escape }}"
                          class="collage-item__image"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="collage-item__placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                      {% if block.settings.show_product_info %}
                        <div class="collage-item__product-info">
                          <h3 class="collage-item__product-title">{{ block.settings.product.title }}</h3>
                          <p class="collage-item__product-price">{{ block.settings.product.price | money }}</p>
                        </div>
                      {% endif %}
                    </a>
                  </div>
                {% else %}
                  <div class="collage-item__placeholder collage-item__placeholder--product">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    <p>Select a product</p>
                  </div>
                {% endif %}

              {% when 'collection' %}
                {% if block.settings.collection != blank %}
                  <div class="collage-item__collection">
                    <a href="{{ block.settings.collection.url }}" class="collage-item__collection-link">
                      {% if block.settings.collection.image != blank %}
                        <img
                          src="{{ block.settings.collection.image | image_url: width: 800 }}"
                          alt="{{ block.settings.collection.image.alt | default: block.settings.collection.title | escape }}"
                          class="collage-item__image"
                          loading="lazy"
                        >
                      {% elsif block.settings.collection.products.first.featured_image != blank %}
                        <img
                          src="{{ block.settings.collection.products.first.featured_image | image_url: width: 800 }}"
                          alt="{{ block.settings.collection.title | escape }}"
                          class="collage-item__image"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="collage-item__placeholder">
                          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                      <div class="collage-item__collection-info">
                        <h3 class="collage-item__collection-title">{{ block.settings.collection.title }}</h3>
                        {% if block.settings.show_product_count %}
                          <p class="collage-item__collection-count">{{ block.settings.collection.products_count }} {{ block.settings.collection.products_count | pluralize: 'product', 'products' }}</p>
                        {% endif %}
                      </div>
                    </a>
                  </div>
                {% else %}
                  <div class="collage-item__placeholder collage-item__placeholder--collection">
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    <p>Select a collection</p>
                  </div>
                {% endif %}

              {% when 'video' %}
                <div class="collage-item__video">
                  {% if block.settings.video_url != blank %}
                    {% assign video_id = '' %}
                    {% assign video_type = '' %}
                    {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
                      {% assign video_type = 'youtube' %}
                      {% if block.settings.video_url contains 'youtu.be' %}
                        {% assign video_id = block.settings.video_url | split: 'youtu.be/' | last | split: '?' | first %}
                      {% else %}
                        {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
                      {% endif %}
                    {% elsif block.settings.video_url contains 'vimeo.com' %}
                      {% assign video_type = 'vimeo' %}
                      {% assign video_id = block.settings.video_url | split: 'vimeo.com/' | last | split: '?' | first %}
                    {% endif %}

                    {% if block.settings.cover_image != blank %}
                      <div class="collage-item__video-cover" data-video-cover>
                        <img
                          src="{{ block.settings.cover_image | image_url: width: 800 }}"
                          alt="{{ block.settings.cover_image.alt | default: 'Video cover' }}"
                          class="collage-item__image"
                          loading="lazy"
                        >
                        <button type="button" class="collage-item__play-button" aria-label="Play video" data-play-video data-video-type="{{ video_type }}" data-video-id="{{ video_id }}">
                          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
                            <circle cx="12" cy="12" r="12" fill="rgba(0,0,0,0.6)"/>
                            <polygon points="10,8 16,12 10,16" fill="white"/>
                          </svg>
                        </button>
                      </div>
                      <div class="collage-item__video-embed" data-video-embed style="display: none;"></div>
                    {% else %}
                      {% if video_type == 'youtube' %}
                        <iframe
                          src="https://www.youtube.com/embed/{{ video_id }}?autoplay=0&rel=0"
                          title="YouTube video"
                          frameborder="0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                          class="collage-item__iframe"
                        ></iframe>
                      {% elsif video_type == 'vimeo' %}
                        <iframe
                          src="https://player.vimeo.com/video/{{ video_id }}?autoplay=0"
                          title="Vimeo video"
                          frameborder="0"
                          allow="autoplay; fullscreen; picture-in-picture"
                          allowfullscreen
                          loading="lazy"
                          class="collage-item__iframe"
                        ></iframe>
                      {% endif %}
                    {% endif %}
                  {% else %}
                    <div class="collage-item__placeholder collage-item__placeholder--video">
                      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <polygon points="5,3 19,12 5,21"></polygon>
                      </svg>
                      <p>Add a video URL</p>
                    </div>
                  {% endif %}
                </div>
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <div class="collage-section__placeholder">
        <p>Add blocks to create your collage layout</p>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const playButtons = document.querySelectorAll('[data-play-video]');

    playButtons.forEach(button => {
      button.addEventListener('click', function() {
        const cover = this.closest('[data-video-cover]');
        const embedContainer = cover.nextElementSibling;
        const videoType = this.dataset.videoType;
        const videoId = this.dataset.videoId;

        let embedUrl = '';
        if (videoType === 'youtube') {
          embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        } else if (videoType === 'vimeo') {
          embedUrl = `https://player.vimeo.com/video/${videoId}?autoplay=1`;
        }

        if (embedUrl) {
          embedContainer.innerHTML = `<iframe src="${embedUrl}" class="collage-item__iframe" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
          embedContainer.style.display = 'block';
          cover.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .collage-section {
    position: relative;
  }

  .collage-section__container--full {
    width: 100%;
    max-width: none;
    padding: 0;
  }

  .collage-section__heading {
    font-family: var(--font-heading-family);
    font-weight: 600;
    margin: 0;
  }

  .collage-section__description {
    font-family: var(--font-body-family);
    font-size: clamp(0.875rem, 2vw, 1rem);
    opacity: 0.8;
    margin: 0;
  }

  /* Grid Layouts */
  .collage-grid {
    display: grid;
    grid-auto-rows: minmax(200px, 1fr);
  }

  /* Left Large Layout (2x2 large + 2 stacked) */
  .collage-grid--left-large {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, minmax(200px, 1fr));
  }

  .collage-grid--left-large .collage-item--1 {
    grid-row: span 2;
  }

  /* Right Large Layout */
  .collage-grid--right-large {
    grid-template-columns: 1fr 2fr;
    grid-template-rows: repeat(2, minmax(200px, 1fr));
  }

  .collage-grid--right-large .collage-item--2 {
    grid-row: span 2;
  }

  /* Equal Three */
  .collage-grid--equal-three {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: minmax(300px, 1fr);
  }

  /* Equal Four */
  .collage-grid--equal-four {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, minmax(200px, 1fr));
  }

  /* Masonry-like */
  .collage-grid--masonry {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, minmax(150px, 1fr));
  }

  .collage-grid--masonry .collage-item--1 {
    grid-row: span 2;
  }

  /* Collage Item Styles */
  .collage-item {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
  }

  .collage-item__image-wrapper,
  .collage-item__product,
  .collage-item__collection,
  .collage-item__video {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }

  .collage-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collage-item:hover .collage-item__image {
    transform: scale(1.05);
  }

  .collage-item__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: var(--color-background-alt, #f5f5f5);
    color: var(--color-text-light, #666);
  }

  .collage-item__placeholder .placeholder-svg {
    width: 80px;
    height: 80px;
    opacity: 0.5;
  }

  .collage-item__placeholder p {
    margin-top: 12px;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  /* Overlay Styles */
  .collage-item__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .collage-item:hover .collage-item__overlay,
  .collage-item__overlay:focus-within {
    opacity: 1;
  }

  .collage-item__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    margin: 0 0 8px;
  }

  .collage-item__text {
    font-size: clamp(0.875rem, 2vw, 1rem);
    margin: 0 0 16px;
    max-width: 80%;
  }

  .collage-item__button {
    display: inline-block;
    padding: 12px 24px;
    background: var(--color-primary, #000);
    color: var(--color-background, #fff);
    text-decoration: none;
    font-weight: 500;
    border-radius: 4px;
    transition: opacity 0.2s ease;
    min-height: 44px;
  }

  .collage-item__button:hover {
    opacity: 0.9;
  }

  .collage-item__full-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Product & Collection Info */
  .collage-item__product-link,
  .collage-item__collection-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .collage-item__product-info,
  .collage-item__collection-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    color: #fff;
  }

  .collage-item__product-title,
  .collage-item__collection-title {
    font-family: var(--font-heading-family);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 4px;
  }

  .collage-item__product-price,
  .collage-item__collection-count {
    font-size: 0.875rem;
    margin: 0;
    opacity: 0.9;
  }

  /* Video Styles */
  .collage-item__video {
    background: #000;
  }

  .collage-item__video-cover {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .collage-item__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: none;
    border: none;
    cursor: pointer;
    color: #fff;
    transition: transform 0.2s ease;
    min-width: 64px;
    min-height: 64px;
    padding: 0;
  }

  .collage-item__play-button:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .collage-item__iframe {
    width: 100%;
    height: 100%;
    min-height: 200px;
  }

  .collage-item__video-embed {
    width: 100%;
    height: 100%;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 767px) {
    .collage-grid {
      grid-template-columns: 1fr !important;
      grid-template-rows: auto !important;
    }

    .collage-grid .collage-item {
      grid-row: auto !important;
      grid-column: auto !important;
      min-height: 250px;
    }

    .collage-item__overlay {
      opacity: 1;
      background-color: rgba(0,0,0,0.3) !important;
    }
  }

  /* Tablet */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .collage-grid--equal-three,
    .collage-grid--masonry {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  {% if request.design_mode %}
    .collage-section {
      outline: 2px dashed rgba(233, 30, 99, 0.3);
      outline-offset: -2px;
    }

    .collage-section::before {
      content: 'COLLAGE SECTION';
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(233, 30, 99, 0.95);
      color: white;
      padding: 4px 12px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
    }

    .collage-item {
      outline: 1px dashed rgba(233, 30, 99, 0.3);
    }

    .editor-controls--collage {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.90);
      color: white;
      padding: 8px 14px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font-body-family);
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      border: 2px solid rgba(233, 30, 99, 0.5);
    }

    .editor-controls--collage .editor-label {
      font-weight: 600;
      color: rgba(233, 30, 99, 1);
      font-size: 12px;
    }

    .editor-controls--collage .editor-info {
      font-size: 10px;
      opacity: 0.85;
    }

    .collage-section__placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 300px;
      background: rgba(233, 30, 99, 0.05);
      border: 2px dashed rgba(233, 30, 99, 0.3);
      border-radius: 8px;
      color: var(--color-text);
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "class": "section-collage",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Create visually striking image collages with multiple layout options. Mix images, products, collections, and videos in flexible grid arrangements."
    },
    {
      "type": "header",
      "content": "✏️ Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional section heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Optional description below heading"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Description Spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid Layout",
      "options": [
        { "value": "left-large", "label": "Left Large (1 big + 2 stacked)" },
        { "value": "right-large", "label": "Right Large (2 stacked + 1 big)" },
        { "value": "equal-three", "label": "Three Equal Columns" },
        { "value": "equal-four", "label": "Four Equal (2x2 grid)" },
        { "value": "masonry", "label": "Masonry (1 tall + 2 small)" }
      ],
      "default": "left-large",
      "info": "Choose the grid arrangement for your collage"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap Between Items",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false,
      "info": "Extend collage to full viewport width"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
