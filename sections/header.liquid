          ],
          "default": "icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Account"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color"
        }
      ]
    },
    {
      "type": "custom_link",
      "name": "Custom Link",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
