      "type": "badge",
      "name": "Badge",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "header", "label": "Header" },
            { "value": "content", "label": "Content" },
            { "value": "media", "label": "Over Media" }
          ],
          "default": "content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Save 30%"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Badge Color"
        },
        {
