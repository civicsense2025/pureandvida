{% comment %}
  Render Icon Snippet
  -------------------
  Centralized icon rendering for consistent SVG icons across sections.

  Parameters:
    - icon: Icon name (see list below)
    - size: Icon size in pixels (default: 24 for stroke icons, varies for filled)
    - color: Icon color (default: currentColor)
    - class: Additional CSS classes (optional)
    - stroke_width: SVG stroke width for stroke-based icons (default: 2)

  Stroke-based icons (24x24 viewBox):
    checkmark, star, heart, shield, truck, package, leaf, globe, clock, award,
    plus, minus, chevron-down, chevron-right, chevron-up, arrow-right, x, close,
    info, alert-circle, check-circle, shopping-cart, cart, user, mail, email,
    phone, map-pin, location, calendar, gift, refresh, sync, external-link

  Filled icons (various viewBoxes, preserved from original theme):
    caret, search, account, error, success

  Usage:
    {% render 'render-icon', icon: 'checkmark', size: 48, color: '#2c5530' %}
    {% render 'render-icon', icon: 'caret', size: 10 %}
{% endcomment %}

{% liquid
  assign icon_size = size | default: 24
  assign icon_color = color | default: 'currentColor'
  assign icon_stroke = stroke_width | default: 2

  # Check if this is a filled icon with custom viewBox
  assign filled_icons = 'caret,search,account,error,success,close-filled' | split: ','
  assign is_filled_icon = false
  for filled_icon in filled_icons
    if icon == filled_icon
      assign is_filled_icon = true
      break
    endif
  endfor
%}

{% if is_filled_icon %}
  {% comment %} Filled icons with original viewBoxes and paths {% endcomment %}
  {% case icon %}
    {% when 'caret' %}
      <svg aria-hidden="true" focusable="false" class="icon icon-caret{% if class %} {{ class }}{% endif %}" viewBox="0 0 10 6" fill="none" width="{{ size | default: 10 }}" height="{{ size | default: 10 }}">
        <path fill-rule="evenodd" clip-rule="evenodd" d="m9.354.646a.5.5 0 0 0-.708 0L5 4.293 1.354.646a.5.5 0 0 0-.708.708l4 4a.5.5 0 0 0 .708 0l4-4a.5.5 0 0 0 0-.708z" fill="{{ icon_color }}"/>
      </svg>

    {% when 'search' %}
      <svg aria-hidden="true" focusable="false" class="icon icon-search{% if class %} {{ class }}{% endif %}" viewBox="0 0 18 19" fill="none" width="{{ size | default: 18 }}" height="{{ size | default: 18 }}">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 0 1 5.5 13.75c-3.59 0-6.5-2.91-6.5-6.5s2.91-6.5 6.5-6.5 6.5 2.91 6.5 6.5a5.784 5.784 0 0 1-2.07 4.28l7.32 7.32c.26.26.26.68 0 .94a.663.663 0 0 1-.94 0l-7.32-7.32zm-5.53-9.43c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5z" fill="{{ icon_color }}"/>
      </svg>

    {% when 'account' %}
      <svg aria-hidden="true" focusable="false" class="icon icon-account{% if class %} {{ class }}{% endif %}" viewBox="0 0 18 19" fill="none" width="{{ size | default: 18 }}" height="{{ size | default: 18 }}">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 106 0 3 3 0 00-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.91 4.85H1.51c.08-2.6.79-4.03 1.9-4.85C4.66 11.75 6.5 11.5 9 11.5s4.35.26 5.58 1.15zM9 10.5c-2.5 0-4.65.24-6.17 1.35C1.27 12.98 1 14.14 1 15.5h16c0-1.36-.27-2.52-.83-3.65-1.52-1.1-3.67-1.35-6.17-1.35z" fill="{{ icon_color }}"/>
      </svg>

    {% when 'error' %}
      <svg aria-hidden="true" focusable="false" class="icon icon-error{% if class %} {{ class }}{% endif %}" viewBox="0 0 13 13" fill="none" width="{{ size | default: 13 }}" height="{{ size | default: 13 }}">
        <circle cx="6.5" cy="6.50049" r="5.5" stroke="{{ icon_color }}" stroke-width="2"/>
        <circle cx="6.5" cy="6.5" r="4.5" fill="{{ icon_color }}"/>
        <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
      </svg>

    {% when 'success' %}
      <svg aria-hidden="true" focusable="false" class="icon icon-success{% if class %} {{ class }}{% endif %}" viewBox="0 0 13 13" fill="none" width="{{ size | default: 13 }}" height="{{ size | default: 13 }}">
        <path d="M6.5 12.35C9.73087 12.35 12.35 9.73086 12.35 6.5C12.35 3.26913 9.73087 0.65 6.5 0.65C3.26913 0.65 0.65 3.26913 0.65 6.5C0.65 9.73086 3.26913 12.35 6.5 12.35Z" fill="#1A1A1A" stroke="#1A1A1A" stroke-width="0.7"/>
        <path d="M5.53271 8.66357L9.25213 4.68197" stroke="white"/>
        <path d="M4.10645 6.7688L6.13766 8.62553" stroke="white"/>
      </svg>

    {% when 'close-filled' %}
      <svg aria-hidden="true" focusable="false" class="icon icon-close{% if class %} {{ class }}{% endif %}" viewBox="0 0 18 17" fill="none" width="{{ size | default: 18 }}" height="{{ size | default: 18 }}">
        <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="{{ icon_color }}"/>
      </svg>
  {% endcase %}

{% else %}
  {% comment %} Stroke-based icons with 24x24 viewBox {% endcomment %}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="{{ icon_color }}"
    stroke-width="{{ icon_stroke }}"
    stroke-linecap="round"
    stroke-linejoin="round"
    {% if class %}class="{{ class }}"{% endif %}
    aria-hidden="true"
  >
    {% case icon %}
    {% when 'checkmark' or 'check' %}
      <polyline points="20 6 9 17 4 12"></polyline>

    {% when 'star' %}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>

    {% when 'heart' %}
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>

    {% when 'shield' %}
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>

    {% when 'truck' %}
      <rect x="1" y="3" width="15" height="13"></rect>
      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
      <circle cx="5.5" cy="18.5" r="2.5"></circle>
      <circle cx="18.5" cy="18.5" r="2.5"></circle>

    {% when 'package' %}
      <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
      <line x1="12" y1="22.08" x2="12" y2="12"></line>

    {% when 'leaf' %}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>

    {% when 'globe' %}
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>

    {% when 'clock' %}
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>

    {% when 'award' %}
      <circle cx="12" cy="8" r="7"></circle>
      <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>

    {% when 'plus' %}
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>

    {% when 'minus' %}
      <line x1="5" y1="12" x2="19" y2="12"></line>

    {% when 'chevron-down' %}
      <polyline points="6 9 12 15 18 9"></polyline>

    {% when 'chevron-right' %}
      <polyline points="9 18 15 12 9 6"></polyline>

    {% when 'chevron-up' %}
      <polyline points="18 15 12 9 6 15"></polyline>

    {% when 'arrow-right' %}
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>

    {% when 'x' or 'close' %}
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>

    {% when 'info' %}
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="16" x2="12" y2="12"></line>
      <line x1="12" y1="8" x2="12.01" y2="8"></line>

    {% when 'alert-circle' %}
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>

    {% when 'check-circle' %}
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>

    {% when 'shopping-cart' or 'cart' %}
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>

    {% when 'user' %}
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>

    {% when 'mail' or 'email' %}
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
      <polyline points="22,6 12,13 2,6"></polyline>

    {% when 'phone' %}
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>

    {% when 'map-pin' or 'location' %}
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>

    {% when 'calendar' %}
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>

    {% when 'gift' %}
      <polyline points="20 12 20 22 4 22 4 12"></polyline>
      <rect x="2" y="7" width="20" height="5"></rect>
      <line x1="12" y1="22" x2="12" y2="7"></line>
      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
      <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>

    {% when 'refresh' or 'sync' %}
      <polyline points="23 4 23 10 17 10"></polyline>
      <polyline points="1 20 1 14 7 14"></polyline>
      <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>

    {% when 'external-link' %}
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      <polyline points="15 3 21 3 21 9"></polyline>
      <line x1="10" y1="14" x2="21" y2="3"></line>

    {% endcase %}
  </svg>
{% endif %}
