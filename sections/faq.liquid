{% liquid
  # @description FAQ accordion section with expandable questions and answers
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings heading {String} - Section heading
  # @settings default_open {Boolean} - Open first item by default
  # @blocks faq_item - Individual FAQ with question and answer
  # @example
  #   Use blocks mode for dynamic FAQs, settings mode for fixed 10-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
%}

<{{ structural_element }} class="faq-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  <div class="faq-content page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-title" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    <div class="faq-list">
      {%- if section.settings.content_mode == 'blocks' -%}
        {%- for block in section.blocks -%}
          <details class="faq-item" {% if section.settings.default_open and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq-question" style="{% if block.settings.question_color != blank %}color: {{ block.settings.question_color }};{% endif %}">
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq-icon" style="{% if block.settings.icon_color != blank %}color: {{ block.settings.icon_color }};{% endif %}">{{ section.settings.icon_text }}</span>
            </summary>
            <div class="faq-answer" style="{% if block.settings.answer_color != blank %}color: {{ block.settings.answer_color }};{% endif %}">
              <p>{{ block.settings.answer }}</p>
            </div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Settings mode - Fixed fields {%- endcomment -%}
        {%- for i in (1..10) -%}
          {%- assign question_key = 'faq_' | append: i | append: '_question' -%}
          {%- assign answer_key = 'faq_' | append: i | append: '_answer' -%}
          {%- assign question = section.settings[question_key] -%}
          {%- assign answer = section.settings[answer_key] -%}
          {%- if question != blank or answer != blank -%}
            <details class="faq-item" {% if section.settings.default_open and forloop.first %}open{% endif %}>
              <summary class="faq-question">
                <span>{{ question | escape }}</span>
                <span class="faq-icon">{{ section.settings.icon_text }}</span>
              </summary>
              <div class="faq-answer">
                <p>{{ answer }}</p>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</{{ structural_element }}>

<style>
  /* FAQ Section Responsive Styles */
  .faq-content {
    max-width: 632px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 0);
  }
  
  .faq-question {
    min-height: 44px;
    font-size: clamp(16px, 2vw, 19.719px);
    padding: clamp(10px, 1.2vw, 11.99px);
  }
  
  .faq-answer {
    font-size: clamp(14px, 1.6vw, 16px);
    padding: clamp(10px, 1.2vw, 11.99px);
  }
  
  .faq-icon {
    font-size: clamp(20px, 2.4vw, 24px);
    min-width: 24px;
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Mobile adjustments */
  @media screen and (max-width: 767px) {
    .faq-content {
      max-width: 100%;
    }
  }
</style>

