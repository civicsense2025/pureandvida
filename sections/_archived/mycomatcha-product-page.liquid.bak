</style>

<div class="w-full bg-cream">
  <!-- Header -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] py-4 md:py-[54px]">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-[8px]">
        <h1 class="text-dark-green text-[32px] md:text-[52px] font-light">PURE  VIDA</h1>
        <span class="text-teal text-[16px] md:text-[24px] font-bold">+</span>
      </div>
      
      <!-- Mobile Menu Button -->
      <button class="lg:hidden text-dark-green text-[32px]" onclick="toggleMobileMenu()">
        <i class="ph ph-list"></i>
      </button>
      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-[48px]">
        <a href="#" class="text-teal text-[24px] font-semibold tracking-[0.06em]">MycoMatcha</a>
        <a href="#" class="text-[24px] tracking-[0.06em]">Order Tracking</a>
        <a href="#" class="text-[24px] tracking-[0.06em]">About</a>
        <a href="#" class="bg-orange text-white px-[22px] py-[15px] rounded-[91px] text-[20px] font-semibold tracking-[0.06em]">View Cart</a>
      </nav>
    </div>
    <!-- Mobile Menu -->
    <div class="mobile-menu fixed top-0 left-0 w-full h-full bg-cream z-50 lg:hidden">
      <div class="flex justify-between items-center px-4 py-4 border-b border-gray-300">
        <div class="flex items-center gap-[8px]">
          <h1 class="text-dark-green text-[32px] font-light">PURE  VIDA</h1>
          <span class="text-teal text-[16px] font-bold">+</span>
        </div>
        <button class="text-dark-green text-[32px]" onclick="toggleMobileMenu()">
          <i class="ph ph-x"></i>
        </button>
      </div>
      <nav class="flex flex-col p-4 gap-4">
        <a href="#" class="text-teal text-[20px] font-semibold tracking-[0.06em] py-3 border-b border-gray-200">MycoMatcha</a>
        <a href="#" class="text-[20px] tracking-[0.06em] py-3 border-b border-gray-200">Order Tracking</a>
        <a href="#" class="text-[20px] tracking-[0.06em] py-3 border-b border-gray-200">About</a>
        <a href="#" class="bg-orange text-white px-[22px] py-[15px] rounded-[91px] text-[18px] font-semibold tracking-[0.06em] text-center mt-4">View Cart</a>
      </nav>
    </div>
  </div>
  <script>
    function toggleMobileMenu() {
      const menu = document.querySelector('.mobile-menu');
      menu.classList.toggle('active');
    }
  </script>
  <!-- Hero Section with Product -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] pb-[50px] md:pb-[100px]">
    <div class="flex flex-col lg:flex-row gap-[30px] lg:gap-[60px]">
      <!-- Product Images -->
      <div class="w-full lg:w-[602px]">
        {%- if section.settings.product_image -%}
          {{ section.settings.product_image | image_url: width: 602 | image_tag: class: 'w-full h-auto' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'w-full h-auto bg-gray-200' }}
        {%- endif -%}
      </div>
      <!-- Product Details -->
      <div class="flex-1 pt-[10px]">
        <div class="mb-[20px] md:mb-[38px]">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-[15px] sm:gap-[38px] mb-[20px] md:mb-[38px]">
            <h2 class="text-[36px] sm:text-[52px] md:text-[72px] leading-[100%] tracking-[0.02em]">{{ section.settings.product_title }}</h2>
            <div class="bg-dark-olive text-white px-[20px] md:px-[30px] py-[10px] md:py-[15px] rounded-[46px]">
              <p class="text-[16px] md:text-[22px] leading-[100%] tracking-[0.12em]">{{ section.settings.badge_text }}</p>
            </div>
          </div>
        </div>
        <div class="flex items-start gap-[10px] mb-[20px] md:mb-[38px]">
          <div class="relative">
            <span class="text-teal text-[24px] md:text-[35px] tracking-[0.12em] line-through-teal">{{ section.settings.original_price }}</span>
          </div>
          <span class="text-[52px] md:text-[94px] tracking-[-0.01em]">{{ section.settings.sale_price }}</span>
        </div>
        <div class="mb-[20px] md:mb-[38px]">
          <p class="text-[16px] md:text-[23px] leading-[120%] md:leading-[100%] tracking-[0.08em] whitespace-pre-line">{{ section.settings.product_description | newline_to_br }}</p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-[15px] sm:gap-[24px] mb-[20px] md:mb-[38px]">
          <div class="border border-teal rounded-[72px] px-[17px] py-[15px] md:py-[23px] w-full sm:w-[116px]">
            <p class="text-[24px] md:text-[35px] leading-[100%] text-center">+ 1</p>
          </div>
          <button class="bg-teal text-white px-[30px] md:px-[47px] py-[15px] md:py-[23px] rounded-[72px] text-[24px] md:text-[35px] leading-[100%] tracking-[0.12em] w-full sm:w-auto">
            {{ section.settings.button_text }}
          </button>
        </div>
        <div class="flex gap-[7px]">
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/22131a881663a5537e3980a3d571d5a61ec7bd7d.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/0902198dda288f244b470588af55e74e8facd4fc.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <svg width="29" height="9" viewBox="0 0 29 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0 8.2099L28.1993 0V4.64038C28.1993 6.61177 26.6011 8.2099 24.6297 8.2099H0Z" fill="#FD6020"/>
</svg>
          </div>
          <div class="w-[50px] h-[34px] bg-[#1F72CD] border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/bfba9b9e11ec6200260302d3e952df331df200e7.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/86700408f70341c2d7fdf34d756567c802955bb2.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/6d8a0f2ef3cb91c11062e4fcb5c29a0be7daf438.svg" />
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Customer Reviews Carousel -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] lg:px-[127px] pb-[50px] md:pb-[100px]">
    <div class="testimonial-carousel relative">
      <div class="testimonial-track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="testimonial-slide px-4 md:px-8" {{ block.shopify_attributes }}>
              <div class="flex gap-[10px] mb-[15px]">
                {%- for i in (1..5) -%}
                  <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/210b2ce3d0f16f17b660c3752ed11ef8c3c23668.svg" class="w-[20px] h-[20px]" />
                {%- endfor -%}
              </div>
              <p class="text-[14px] md:text-[16px] leading-[120%] tracking-[0.12em] mb-[15px] text-justify">{{ block.settings.review_text }}</p>
              <div class="flex items-center gap-[18px]">
                <p class="text-[14px] md:text-[16px] leading-[120%] tracking-[0.12em] font-semibold">{{ block.settings.reviewer_name }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      
      <!-- Carousel Controls -->
      <div class="flex justify-center gap-4 mt-8">
        <button onclick="prevTestimonial()" class="bg-teal text-white w-[40px] h-[40px] rounded-full flex items-center justify-center">
          <i class="ph ph-caret-left text-[20px]"></i>
        </button>
        <button onclick="nextTestimonial()" class="bg-teal text-white w-[40px] h-[40px] rounded-full flex items-center justify-center">
          <i class="ph ph-caret-right text-[20px]"></i>
        </button>
      </div>
    </div>
  </div>
  <script>
    let currentTestimonial = 0;
    const testimonialTrack = document.querySelector('.testimonial-track');
    const testimonialSlides = document.querySelectorAll('.testimonial-slide');
    const totalTestimonials = testimonialSlides.length;
    function updateCarousel() {
      const slideWidth = window.innerWidth >= 768 ? 33.333 : 100;
      testimonialTrack.style.transform = `translateX(-${currentTestimonial * slideWidth}%)`;
    }
    function nextTestimonial() {
      const maxSlide = window.innerWidth >= 768 ? totalTestimonials - 3 : totalTestimonials - 1;
      currentTestimonial = currentTestimonial >= maxSlide ? 0 : currentTestimonial + 1;
      updateCarousel();
    }
    function prevTestimonial() {
      const maxSlide = window.innerWidth >= 768 ? totalTestimonials - 3 : totalTestimonials - 1;
      currentTestimonial = currentTestimonial <= 0 ? maxSlide : currentTestimonial - 1;
      updateCarousel();
    }
    window.addEventListener('resize', updateCarousel);
  </script>
  <!-- Benefits Section -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[85px] pb-[50px] md:pb-[100px]">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px] md:gap-[29px]">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <div class="w-full" {{ block.shopify_attributes }}>
            <div class="flex justify-center mb-[20px] md:mb-[26px]">
              <svg data-vector-hash="{{ block.settings.icon_hash }}" class="w-[40px] h-[40px] md:w-[45px] md:h-[45px]" />
            </div>
            <h3 class="text-[20px] md:text-[25px] tracking-[0.12em] text-center mb-[15px] md:mb-[26px]">{{ block.settings.benefit_title }}</h3>
            <p class="text-[14px] md:text-[16px] leading-[140%] tracking-[0.06em] text-center">{{ block.settings.benefit_description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <!-- Comparison Table -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] lg:px-[163px] pb-[50px] md:pb-[100px]">
    <h2 class="text-[28px] md:text-[40px] leading-[140%] tracking-[0.12em] text-center mb-[40px] md:mb-[82px]">{{ section.settings.comparison_title }}</h2>
    
    <div class="bg-amber rounded-[20px] md:rounded-[40px] p-[20px] md:p-[40px] relative overflow-hidden">
      <div class="hidden md:block absolute left-0 top-0 w-[50%] lg:w-[646px] h-full bg-teal"></div>
      
      <div class="relative z-10">
        <!-- Desktop Header -->
        <div class="hidden md:flex justify-between mb-[25px]">
          <div class="flex-1"></div>
          <div class="flex gap-[30px] lg:gap-[60px]">
            <span class="text-[16px] lg:text-[20px] leading-[140%] tracking-[0.12em] font-bold w-[100px] lg:w-[120px]">MycoMatcha</span>
            <span class="text-[16px] lg:text-[20px] leading-[140%] tracking-[0.12em] font-bold w-[60px] lg:w-[40px]">Coffee</span>
          </div>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'comparison_row' -%}
            <!-- Desktop Row -->
            <div class="hidden md:flex justify-between items-center py-[10px] lg:py-[13px]" {{ block.shopify_attributes }}>
              <span class="text-white text-[14px] lg:text-[20px] leading-[140%] tracking-[0.12em] font-medium flex-1 pr-4">{{ block.settings.feature_name }}</span>
              <div class="flex gap-[30px] lg:gap-[60px]">
                <span class="text-[14px] lg:text-[20px] leading-[140%] tracking-[0.12em] w-[100px] lg:w-[120px]">{{ block.settings.myco_value }}</span>
                <span class="text-[14px] lg:text-[20px] leading-[140%] tracking-[0.12em] w-[60px] lg:w-[40px]">{{ block.settings.coffee_value }}</span>
              </div>
            </div>
            <!-- Mobile Row -->
            <div class="md:hidden bg-white bg-opacity-10 rounded-[10px] p-[15px] mb-[10px]" {{ block.shopify_attributes }}>
              <p class="text-[14px] leading-[140%] tracking-[0.12em] font-bold mb-[10px]">{{ block.settings.feature_name }}</p>
              <div class="flex justify-between">
                <div>
                  <p class="text-[12px] leading-[140%] tracking-[0.12em] text-gray-600 mb-[5px]">MycoMatcha</p>
                  <p class="text-[14px] leading-[140%] tracking-[0.12em] font-semibold">{{ block.settings.myco_value }}</p>
                </div>
                <div>
                  <p class="text-[12px] leading-[140%] tracking-[0.12em] text-gray-600 mb-[5px]">Coffee</p>
                  <p class="text-[14px] leading-[140%] tracking-[0.12em] font-semibold">{{ block.settings.coffee_value }}</p>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <!-- Shipping & Returns -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] lg:px-[283px] pb-[50px] md:pb-[100px]">
    <h2 class="text-[28px] md:text-[40px] leading-[140%] tracking-[0.12em] text-center mb-[10px]">{{ section.settings.shipping_title }}</h2>
    <div class="text-[14px] md:text-[20px] leading-[140%] tracking-[0.04em]">
      {{ section.settings.shipping_content | newline_to_br }}
    </div>
  </div>
  <!-- FAQ Section -->
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] lg:px-[369px] pb-[50px] md:pb-[100px]">
    <h2 class="text-[28px] md:text-[40px] leading-[140%] tracking-[0.12em] text-center mb-[10px]">{{ section.settings.faq_title }}</h2>
    
    <div class="space-y-[15px] md:space-y-[20px]">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <div class="faq-item p-[12px] rounded" onclick="toggleFaq(this)" {{ block.shopify_attributes }}>
            <div class="flex justify-between items-center cursor-pointer">
              <span class="text-[16px] md:text-[20px] tracking-[0.12em] pr-4">{{ block.settings.question }}</span>
              <span class="text-[20px] md:text-[24px] tracking-[0.12em] faq-icon">+</span>
            </div>
            {%- if block.settings.answer -%}
              <div class="faq-answer mt-[10px]">
                <p class="text-[14px] md:text-[16px] leading-[140%] tracking-[0.06em]">{{ block.settings.answer }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <script>
    function toggleFaq(element) {
      const isActive = element.classList.contains('active');
      
      // Close all FAQ items
      document.querySelectorAll('.faq-item').forEach(item => {
        item.classList.remove('active');
        item.querySelector('.faq-icon').textContent = '+';
      });
      
      // Open clicked item if it wasn't active
      if (!isActive) {
        element.classList.add('active');
        element.querySelector('.faq-icon').textContent = '−';
      }
    }
  </script>
  <!-- Footer -->
  <div class="bg-dark-green">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 md:px-[60px] lg:px-[95px] py-[30px] md:py-[62px]">
      <div class="flex flex-col lg:flex-row justify-between gap-[40px]">
        <div class="text-center lg:text-left">
          <div class="flex items-center gap-[8px] mb-[8px] justify-center lg:justify-start">
            <h3 class="text-white text-[32px] md:text-[52px] font-light">PURE  VIDA</h3>
            <span class="text-amber text-[16px] md:text-[20px] font-bold">+</span>
          </div>
          <p class="text-white text-[12px] md:text-[15px] tracking-[0.12em] font-light">Copyright Pura Vida 2025. All rights reserved.</p>
        </div>
        <div class="flex flex-col md:flex-row gap-[30px] md:gap-[60px] lg:gap-[115px]">
          <div>
            <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light mb-[10px]">Shop MycoMatcha</p>
            <h4 class="text-white text-[18px] md:text-[20px] tracking-[0.12em] font-medium mb-[10px]">About Us</h4>
            <div class="space-y-[10px]">
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">The Company</p>
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Terms of Service</p>
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Privacy Policy</p>
            </div>
          </div>
          <div>
            <h4 class="text-white text-[18px] md:text-[20px] tracking-[0.12em] font-medium mb-[10px]">For You</h4>
            <div class="space-y-[10px]">
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Shipping Information</p>
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Return & Refund Policy</p>
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Track Your Order</p>
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Contact Us</p>
              <p class="text-white text-[14px] md:text-[15px] tracking-[0.12em] font-light">Privacy Choices</p>
            </div>
          </div>
          <div class="flex flex-row md:flex-col gap-[7px] justify-center lg:justify-start">
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/06cfb31974dbc19d991ce3d6092463e8660795b5.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/93f7af38e2ba7538fa535d6ba7e3e40b44ebbc14.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <svg width="29" height="9" viewBox="0 0 29 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0 8.44593L29.01 0V4.77379C29.01 6.80186 27.3659 8.44593 25.3378 8.44593H0Z" fill="#FD6020"/>
</svg>
            </div>
            <div class="w-[51px] h-[35px] bg-[#1F72CD] border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/9628c063b747d06050dd879c2a69048cbc2beea1.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/a9c5d21d1d5ca17ce14538a8a9afa0e23a8c7b99.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/787e2bd70ea9fba4a83e89bb3f11013d75e688cd.svg" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MycoMatcha Product Page",
  "class": "shopdev",
  "tag": "section",
  "settings": [
    {
      "type": "file",
      "id": "custom_font",
      "label": "Custom Font File",
      "info": "Upload a custom font file (.woff, .woff2, .ttf, .otf)"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "MycoMatcha"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Get 33% off today"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original Price",
      "default": "$45"
    },
    {
      "type": "text",
      "id": "sale_price",
      "label": "Sale Price",
      "default": "$34.99"
    },
    {
      "type": "textarea",
      "id": "product_description",
      "label": "Product Description",
      "default": "Your morning coffee spikes cortisol, burns through your adrenal reserves, and leaves you crashing by 2 PM. MycoMatcha works differently.\n\nCeremonial-grade matcha delivers 25-35mg of caffeine paired with L-theanine, which crosses the blood-brain barrier to promote alpha wave activity. The result: 4-6 hours of sustained energy without the spike-crash cycle. Add four adaptogenic mushrooms that have been used in traditional medicine for over 2,000 years, and you have a formula that doesn't just wake you up. It builds resilience."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "comparison_title",
      "label": "Comparison Title",
      "default": "Matcha vs. Coffee"
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping Title",
      "default": "Shipping & Returns"
    },
    {
      "type": "textarea",
      "id": "shipping_content",
      "label": "Shipping Content",
      "default": "Processing & Delivery\nOrders ship within 1-2 business days. Expect delivery within 2-4 business days after shipping. Free shipping on all orders with full tracking provided.\n\n60-Day Money-Back Guarantee\nNot fully satisfied? Return your product within 60 days for a full refund, risk-free.\n\nEasy Returns Process\nReach out to support@pureandvida.com. Our team will guide you through the return process. Your satisfaction is our top priority."
    },
    {
      "type": "text",
      "id": "faq_title",
      "label": "FAQ Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon_hash",
          "label": "Icon Hash"
        },
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit Title"
        },
        {
          "type": "text",
          "id": "benefit_description",
          "label": "Benefit Description"
        }
      ]
    },
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name"
        },
        {
          "type": "text",
          "id": "myco_value",
          "label": "MycoMatcha Value"
        },
        {
          "type": "text",
          "id": "coffee_value",
          "label": "Coffee Value"
        }
      ]
    },
    {
      "type": "faq",
