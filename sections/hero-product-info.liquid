{% liquid
  # @description Hero product info section with taglines, pricing, description, CTA, and badges
  # @settings product {Product} - Featured product
  # @settings show_pricing {Boolean} - Display product pricing
  # @example
  #   Add to index.json template for homepage hero product info section
  assign structural_element = section.settings.structural_element | default: 'section'
%}

<{{ structural_element }} class="hero-product-info-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}">
  <div class="hero-product-info-wrapper page-width">
    <div class="hero-product-info">
      <div class="hero-tagline">
        {%- if section.settings.tagline_line_1 != blank -%}
          <p class="hero-tagline-line1" style="{% if section.settings.tagline_color != blank %}color: {{ section.settings.tagline_color }};{% endif %}">{{ section.settings.tagline_line_1 | escape }}</p>
        {%- endif -%}
        {%- if section.settings.tagline_line_2 != blank -%}
          <p class="hero-tagline-line2" style="{% if section.settings.tagline_color != blank %}color: {{ section.settings.tagline_color }};{% endif %}">{{ section.settings.tagline_line_2 | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_pricing -%}
        <div class="hero-pricing">
          {%- if section.settings.show_compare_price -%}
            <div class="hero-price-compare">
              <span class="hero-price-old" style="{% if section.settings.compare_price_color != blank %}color: {{ section.settings.compare_price_color }};{% endif %}">
                {%- if section.settings.custom_compare_price != blank -%}
                  {{ section.settings.custom_compare_price }}
                {%- elsif section.settings.product != blank -%}
                  {{ section.settings.product.selected_or_first_available_variant.compare_at_price | money }}
                {%- else -%}
                  $45
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}
          <div class="hero-price-current">
            <span class="hero-price-currency" style="{% if section.settings.price_color != blank %}color: {{ section.settings.price_color }};{% endif %}">$</span>
            <span class="hero-price-amount" style="{% if section.settings.price_color != blank %}color: {{ section.settings.price_color }};{% endif %}">
              {%- if section.settings.custom_price != blank -%}
                {{ section.settings.custom_price }}
              {%- elsif section.settings.product != blank -%}
                {{ section.settings.product.selected_or_first_available_variant.price | money | remove: '$' }}
              {%- else -%}
                34.99
              {%- endif -%}
            </span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.description_paragraph_1 != blank or section.settings.description_paragraph_2 != blank -%}
        <div class="hero-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}">
          {%- if section.settings.description_paragraph_1 != blank -%}
            <p>{{ section.settings.description_paragraph_1 }}</p>
          {%- endif -%}
          {%- if section.settings.description_paragraph_2 != blank -%}
            <p>{{ section.settings.description_paragraph_2 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hero-cta-section">
        {%- if section.settings.show_quantity_selector -%}
          <div class="hero-quantity-selector">
            <button type="button" class="quantity-btn" data-action="decrease">-</button>
            <input type="number" class="quantity-input" value="{{ section.settings.default_quantity }}" min="{{ section.settings.min_quantity }}" max="{{ section.settings.max_quantity }}" id="hero-quantity-{{ section.id }}">
            <button type="button" class="quantity-btn" data-action="increase">+</button>
          </div>
        {%- endif -%}
        {%- if section.settings.product != blank -%}
          {%- assign featured_product = section.settings.product -%}
          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="hero-add-to-cart-form">
            <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="{{ section.settings.default_quantity }}" id="cart-quantity-{{ section.id }}">
            <button type="submit" class="hero-add-to-cart-btn" style="{% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %}">
              {{ section.settings.button_text | default: "Add to cart" }}
            </button>
          </form>
        {%- else -%}
          <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="hero-add-to-cart-btn" style="{% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %} text-decoration: none; display: inline-block;">
            {{ section.settings.button_text | default: "Add to cart" }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_methods -%}
        <div class="hero-payment-methods">
          {% render 'payment-icons' %}
        </div>
      {%- endif -%}

      {%- if section.settings.show_discount_badge and section.settings.discount_badge_text != blank -%}
        <div class="hero-discount-badge" style="{% if section.settings.badge_background_color != blank %}background-color: {{ section.settings.badge_background_color }};{% endif %}{% if section.settings.badge_text_color != blank %}color: {{ section.settings.badge_text_color }};{% endif %}">
          {{ section.settings.discount_badge_text | escape }}
        </div>
      {%- endif -%}
    </div>
  </div>
</{{ structural_element }}>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quantityInput = document.getElementById('hero-quantity-{{ section.id }}');
    const cartQuantityInput = document.getElementById('cart-quantity-{{ section.id }}');
    const quantityBtns = document.querySelectorAll('#hero-quantity-{{ section.id }}').length > 0 ? document.querySelector('#hero-quantity-{{ section.id }}').closest('.hero-quantity-selector').querySelectorAll('.quantity-btn') : [];

    if (quantityInput && cartQuantityInput) {
      quantityBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const action = this.dataset.action;
          const min = parseInt(quantityInput.min) || 1;
          const max = parseInt(quantityInput.max) || 999;
          let currentValue = parseInt(quantityInput.value) || min;
          
          if (action === 'increase' && currentValue < max) {
            currentValue++;
          } else if (action === 'decrease' && currentValue > min) {
            currentValue--;
          }
          
          quantityInput.value = currentValue;
          if (cartQuantityInput) {
            cartQuantityInput.value = currentValue;
          }
        });
      });
    }
  });
</script>

<style>
  /* Hero Product Info Section - Responsive Styles */
  .hero-product-info-section {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .hero-product-info-wrapper {
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  .hero-product-info {
    max-width: 100%;
  }

  .hero-tagline {
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }

  .hero-tagline-line1,
  .hero-tagline-line2 {
    font-size: clamp(1.125rem, 3vw, 1.75rem);
    line-height: 1.3;
    margin: 0 0 clamp(0.25rem, 1vw, 0.5rem) 0;
  }

  .hero-pricing {
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: clamp(0.5rem, 2vw, 1rem);
  }

  .hero-price-old {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    text-decoration: line-through;
    opacity: 0.7;
  }

  .hero-price-current {
    display: flex;
    align-items: baseline;
  }

  .hero-price-currency {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }

  .hero-price-amount {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .hero-description {
    font-size: clamp(0.875rem, 2vw, 1rem);
    line-height: 1.6;
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
  }

  .hero-description p {
    margin: 0 0 clamp(0.75rem, 2vw, 1rem) 0;
  }

  .hero-description p:last-child {
    margin-bottom: 0;
  }

  .hero-cta-section {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1rem);
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
  }

  .hero-quantity-selector {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1px solid currentColor;
    border-radius: 4px;
    overflow: hidden;
  }

  .hero-quantity-selector .quantity-btn {
    min-width: 44px;
    min-height: 44px;
    padding: clamp(0.5rem, 1.5vw, 0.75rem);
    font-size: clamp(1rem, 2vw, 1.25rem);
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .hero-quantity-selector .quantity-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .hero-quantity-selector .quantity-input {
    width: clamp(40px, 8vw, 60px);
    min-height: 44px;
    text-align: center;
    font-size: clamp(0.875rem, 2vw, 1rem);
    border: none;
    border-left: 1px solid currentColor;
    border-right: 1px solid currentColor;
    background: transparent;
    -moz-appearance: textfield;
  }

  .hero-quantity-selector .quantity-input::-webkit-outer-spin-button,
  .hero-quantity-selector .quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .hero-add-to-cart-form {
    flex: 1;
    min-width: 150px;
  }

  .hero-add-to-cart-btn {
    width: 100%;
    min-height: 44px;
    padding: clamp(0.75rem, 2vw, 1rem) clamp(1.5rem, 4vw, 2rem);
    font-size: clamp(0.875rem, 2vw, 1rem);
    font-weight: 600;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .hero-add-to-cart-btn:hover {
    opacity: 0.9;
  }

  .hero-add-to-cart-btn:active {
    transform: scale(0.98);
  }

  .hero-payment-methods {
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
  }

  .hero-discount-badge {
    display: inline-block;
    padding: clamp(0.5rem, 1.5vw, 0.75rem) clamp(1rem, 3vw, 1.5rem);
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    font-weight: 600;
    border-radius: 4px;
    text-align: center;
  }

  /* Mobile - 479px and below */
  @media screen and (max-width: 479px) {
    .hero-product-info-section {
      padding: 1.5rem 0;
    }

    .hero-product-info-wrapper {
      padding: 0 1rem;
    }

    .hero-tagline-line1,
    .hero-tagline-line2 {
      font-size: 1.125rem;
    }

    .hero-price-amount {
      font-size: 2rem;
    }

    .hero-description {
      font-size: 0.875rem;
    }

    .hero-cta-section {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-quantity-selector {
      width: 100%;
      justify-content: center;
    }

    .hero-add-to-cart-form {
      width: 100%;
    }

    .hero-add-to-cart-btn {
      width: 100%;
    }

    .hero-discount-badge {
      width: 100%;
      display: block;
    }
  }

  /* Small tablets - 480px to 767px */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .hero-product-info-section {
      padding: 2rem 0;
    }

    .hero-tagline-line1,
    .hero-tagline-line2 {
      font-size: 1.25rem;
    }

    .hero-price-amount {
      font-size: 2.5rem;
    }

    .hero-description {
      font-size: 0.9375rem;
    }

    .hero-cta-section {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .hero-add-to-cart-form {
      flex: 1;
      min-width: 200px;
    }
  }

  /* Tablets - 768px to 1023px */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .hero-product-info-section {
      padding: 2.5rem 0;
    }

    .hero-tagline-line1,
    .hero-tagline-line2 {
      font-size: 1.5rem;
    }

    .hero-price-amount {
      font-size: 3rem;
    }

    .hero-description {
      font-size: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Product Info",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "header",
      "content": "Taglines"
    },
    {
      "type": "text",
      "id": "tagline_line_1",
      "label": "Tagline Line 1",
      "default": "Coffee borrows energy."
    },
    {
      "type": "text",
      "id": "tagline_line_2",
      "label": "Tagline Line 2",
      "default": "MycoMatcha creates it."
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline Color"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_pricing",
      "label": "Show Pricing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show Compare Price",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_compare_price",
      "label": "Custom Compare Price",
      "info": "Leave blank to use product price"
    },
    {
      "type": "text",
      "id": "custom_price",
      "label": "Custom Price",
      "info": "Leave blank to use product price (enter number only, e.g. 34.99)"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare Price Color"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description_paragraph_1",
      "label": "Description Paragraph 1",
      "default": "Your morning coffee spikes cortisol, burns through your adrenal reserves, and leaves you crashing by 2 PM. MycoMatcha works differently."
    },
    {
      "type": "textarea",
      "id": "description_paragraph_2",
      "label": "Description Paragraph 2",
      "default": "Ceremonial-grade matcha delivers 25-35mg of caffeine paired with L-theanine, which crosses the blood-brain barrier to promote alpha wave activity. The result: 4-6 hours of sustained energy without the spike-crash cycle. Add four adaptogenic mushrooms that have been used in traditional medicine for over 2,000 years, and you have a formula that doesn't just wake you up. It builds resilience."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to cart"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "info": "Only used if no product is selected"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "header",
      "content": "Quantity Selector"
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show Quantity Selector",
      "default": true
    },
    {
      "type": "range",
      "id": "default_quantity",
      "label": "Default Quantity",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "min_quantity",
      "label": "Minimum Quantity",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "Discount Badge"
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Show Discount Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_badge_text",
      "label": "Discount Badge Text",
      "default": "Get 33% off today!"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge Background Color"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color"
    },
    {
      "type": "header",
      "content": "Payment Methods"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show Payment Methods",
      "default": true
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Structural Elements"
    },
    {
      "type": "select",
      "id": "structural_element",
      "label": "HTML Element",
      "options": [
        { "value": "section", "label": "Section (default)" },
        { "value": "article", "label": "Article" },
        { "value": "aside", "label": "Aside" },
        { "value": "div", "label": "Div" }
      ],
      "default": "section",
      "info": "Choose the semantic HTML element for this section"
    }
  ],
  "presets": [
    {
      "name": "Hero Product Info"
    }
  ],
  "templates": ["index", "page", "collection"]
}
{% endschema %}

