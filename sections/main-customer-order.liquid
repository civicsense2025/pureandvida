{% liquid
  # @description Premium customer order details section
  # Displays complete order information with items, addresses, totals, and actions
  # Supports color schemes, visibility controls, and modern styling
  # @blocks order_notes, support_info
%}

{% render 'visibility-classes',
  show_on_mobile: section.settings.show_on_mobile,
  show_on_desktop: section.settings.show_on_desktop,
  section_id: section.id
%}

<div
  id="{{ section.id }}"
  class="customer-order color-scheme-{{ section.settings.color_scheme }}"
>
  <style>
    #{{ section.id }} {
      {% render 'color-scheme', scheme: section.settings.color_scheme %}
      {% render 'section-spacing', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
      {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    }

    #{{ section.id }} .order-container {
      {% render 'container-width', width: section.settings.container_width %}
    }

    /* Order Header */
    #{{ section.id }} .order-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
    }

    #{{ section.id }} .order-title {
      font-family: var(--font-heading-family);
      font-size: clamp(1.5rem, 4vw, calc(var(--font-heading-size) * {{ section.settings.title_scale | divided_by: 100.0 }}));
      font-weight: var(--font-heading-weight);
      color: {% if section.settings.heading_color != blank %}{{ section.settings.heading_color }}{% else %}var(--section-heading, var(--color-heading)){% endif %};
      margin: 0;
      line-height: 1.2;
    }

    #{{ section.id }} .order-date {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text-secondary));
      margin: var(--spacing-xs) 0 0 0;
    }

    /* Status Badges */
    #{{ section.id }} .order-statuses {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
      margin-top: var(--spacing-sm);
    }

    #{{ section.id }} .status-badge {
      display: inline-block;
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: 0.75rem;
      font-weight: 600;
      color: white;
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    #{{ section.id }} .status-badge--paid {
      background: var(--color-product-badge-new, #059669);
    }

    #{{ section.id }} .status-badge--pending {
      background: #D97706;
    }

    #{{ section.id }} .status-badge--fulfillment {
      background: #3B82F6;
    }

    /* Header Actions */
    #{{ section.id }} .order-actions {
      display: flex;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
    }

    #{{ section.id }} .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm) var(--spacing-lg);
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.875);
      font-weight: 500;
      color: var(--section-text, var(--color-text));
      background: transparent;
      border: 1px solid var(--color-text-secondary);
      border-radius: var(--button-radius);
      text-decoration: none;
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    #{{ section.id }} .btn-secondary:hover {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: white;
    }

    /* Order Layout */
    #{{ section.id }} .order-layout {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: var(--spacing-xl);
      margin-bottom: var(--spacing-xl);
    }

    /* Card Styles */
    #{{ section.id }} .order-card {
      background: {% if section.settings.card_background != blank %}{{ section.settings.card_background }}{% else %}var(--scheme-default-bg, white){% endif %};
      border: 1px solid var(--color-text-secondary);
      border-radius: {{ section.settings.card_border_radius }}px;
      padding: {{ section.settings.card_padding }}px;
    }

    #{{ section.id }} .order-card + .order-card {
      margin-top: var(--spacing-lg);
    }

    #{{ section.id }} .order-card__title {
      font-family: var(--font-heading-family);
      font-size: clamp(1.125rem, 2.5vw, 1.25rem);
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-md);
      padding-bottom: var(--spacing-sm);
      border-bottom: 1px solid var(--color-text-secondary);
    }

    /* Order Items */
    #{{ section.id }} .order-items {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
    }

    #{{ section.id }} .order-item {
      display: flex;
      gap: var(--spacing-md);
      padding-bottom: var(--spacing-md);
      border-bottom: 1px solid var(--color-text-secondary);
    }

    #{{ section.id }} .order-item:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    #{{ section.id }} .order-item__image {
      flex-shrink: 0;
      width: 80px;
      height: 80px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      background: var(--scheme-subtle-bg, #f5f5f5);
    }

    #{{ section.id }} .order-item__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    #{{ section.id }} .order-item__details {
      flex: 1;
      min-width: 0;
    }

    #{{ section.id }} .order-item__title {
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      font-weight: 500;
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-xs);
    }

    #{{ section.id }} .order-item__variant,
    #{{ section.id }} .order-item__quantity {
      font-size: calc(var(--font-body-size) * 0.875);
      color: var(--section-text, var(--color-text-secondary));
      margin: 0;
    }

    #{{ section.id }} .order-item__prices {
      text-align: right;
      flex-shrink: 0;
    }

    #{{ section.id }} .order-item__price {
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      font-weight: 600;
      color: var(--section-heading, var(--color-heading));
      margin: 0;
    }

    #{{ section.id }} .order-item__original-price {
      font-size: calc(var(--font-body-size) * 0.875);
      color: var(--section-text, var(--color-text-secondary));
      text-decoration: line-through;
      margin: 0;
    }

    /* Address Card */
    #{{ section.id }} .order-address {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      line-height: 1.6;
      color: {% if section.settings.text_color != blank %}{{ section.settings.text_color }}{% else %}var(--section-text, var(--color-text)){% endif %};
    }

    #{{ section.id }} .order-address p {
      margin: 0;
    }

    /* Order Totals */
    #{{ section.id }} .order-totals {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    #{{ section.id }} .order-totals__row {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text));
    }

    #{{ section.id }} .order-totals__row--discount {
      color: var(--color-product-badge-new, #059669);
    }

    #{{ section.id }} .order-totals__row--total {
      padding-top: var(--spacing-sm);
      border-top: 2px solid var(--color-text-secondary);
      font-size: calc(var(--font-body-size) * 1.125);
      font-weight: 600;
      color: var(--section-heading, var(--color-heading));
    }

    /* Reorder Button */
    #{{ section.id }} .btn-reorder {
      display: block;
      width: 100%;
      padding: var(--spacing-sm) var(--spacing-lg);
      margin-top: var(--spacing-lg);
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      font-weight: 500;
      text-align: center;
      color: {% if section.settings.button_text_color != blank %}{{ section.settings.button_text_color }}{% else %}var(--button-primary-text){% endif %};
      background: {% if section.settings.button_background_color != blank %}{{ section.settings.button_background_color }}{% else %}var(--button-primary-bg){% endif %};
      border: none;
      border-radius: var(--button-radius);
      cursor: pointer;
      transition: background-color var(--transition-fast);
    }

    #{{ section.id }} .btn-reorder:hover {
      background: var(--button-primary-hover);
    }

    /* Tracking */
    #{{ section.id }} .tracking-info {
      margin-top: var(--spacing-md);
    }

    #{{ section.id }} .tracking-info p {
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text));
      margin: 0 0 var(--spacing-xs);
    }

    #{{ section.id }} .tracking-info a {
      color: var(--color-primary);
      text-decoration: underline;
    }

    /* Empty State */
    #{{ section.id }} .order-empty {
      text-align: center;
      padding: var(--spacing-3xl) var(--spacing-lg);
    }

    #{{ section.id }} .order-empty__text {
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      color: var(--section-text, var(--color-text-secondary));
      margin: 0 0 var(--spacing-lg);
    }

    /* Blocks */
    #{{ section.id }} .order-blocks {
      margin-top: var(--spacing-xl);
    }

    #{{ section.id }} .block-order-notes {
      padding: var(--spacing-lg);
      background: var(--scheme-subtle-bg, #f5f5f5);
      border-radius: var(--radius-md);
      margin-bottom: var(--spacing-md);
    }

    #{{ section.id }} .block-order-notes__title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-body-size) * 1.125);
      font-weight: 600;
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-sm);
    }

    #{{ section.id }} .block-order-notes__content {
      font-size: calc(var(--font-body-size) * 0.9375);
      line-height: 1.6;
      color: var(--section-text, var(--color-text-secondary));
      margin: 0;
    }

    #{{ section.id }} .block-support-info {
      display: flex;
      gap: var(--spacing-md);
      padding: var(--spacing-lg);
      background: var(--scheme-accent-bg, var(--color-primary));
      color: var(--scheme-accent-text, white);
      border-radius: var(--radius-md);
    }

    #{{ section.id }} .block-support-info__icon {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
    }

    #{{ section.id }} .block-support-info__content {
      flex: 1;
    }

    #{{ section.id }} .block-support-info__title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-body-size) * 1.125);
      font-weight: 600;
      margin: 0 0 var(--spacing-xs);
    }

    #{{ section.id }} .block-support-info__text {
      font-size: calc(var(--font-body-size) * 0.9375);
      line-height: 1.5;
      margin: 0;
      opacity: 0.9;
    }

    #{{ section.id }} .block-support-info__link {
      display: inline-block;
      margin-top: var(--spacing-sm);
      color: inherit;
      text-decoration: underline;
    }

    /* Responsive */
    @media screen and (max-width: 767px) {
      #{{ section.id }} .order-header {
        flex-direction: column;
        align-items: flex-start;
      }

      #{{ section.id }} .order-layout {
        grid-template-columns: 1fr;
      }

      #{{ section.id }} .order-item {
        flex-wrap: wrap;
      }

      #{{ section.id }} .order-item__prices {
        flex-basis: 100%;
        text-align: left;
        margin-top: var(--spacing-xs);
      }
    }

    @media print {
      #{{ section.id }} .order-actions,
      #{{ section.id }} .btn-reorder,
      #{{ section.id }} .order-blocks {
        display: none !important;
      }
    }
  </style>

  <div class="order-container page-width">
    {% if order %}
      <header class="order-header">
        <div>
          <h1 class="order-title">
            {{ 'customer.order.title' | t: name: order.name }}
          </h1>
          <p class="order-date">
            {{ 'customer.order.date_html' | t: date: order.created_at | date: format: 'date' }}
          </p>
          <div class="order-statuses">
            <span class="status-badge {% if order.financial_status == 'paid' %}status-badge--paid{% else %}status-badge--pending{% endif %}">
              {{ order.financial_status_label }}
            </span>
            {% if order.fulfillment_status_label != blank %}
              <span class="status-badge status-badge--fulfillment">
                {{ order.fulfillment_status_label }}
              </span>
            {% endif %}
          </div>
        </div>

        <div class="order-actions">
          {% if section.settings.show_print_button %}
            <button type="button" onclick="window.print()" class="btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              {{ section.settings.print_button_text | default: 'Print' }}
            </button>
          {% endif %}
          <a href="{{ routes.account_url }}" class="btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            {{ 'customer.account.return' | t }}
          </a>
        </div>
      </header>

      <div class="order-layout">
        {%- comment -%} Order Items {%- endcomment -%}
        <div class="order-card">
          <h2 class="order-card__title">{{ section.settings.items_title | default: 'Order Items' }}</h2>

          <div class="order-items">
            {% for line_item in order.line_items %}
              <article class="order-item">
                {% if line_item.image %}
                  <div class="order-item__image">
                    <img
                      src="{{ line_item.image | image_url: width: 160 }}"
                      alt="{{ line_item.title | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  </div>
                {% endif %}

                <div class="order-item__details">
                  <h3 class="order-item__title">{{ line_item.title }}</h3>
                  {% if line_item.variant.title != 'Default Title' %}
                    <p class="order-item__variant">{{ line_item.variant.title }}</p>
                  {% endif %}
                  <p class="order-item__quantity">{{ 'customer.order.quantity' | t }}: {{ line_item.quantity }}</p>
                  {% if line_item.sku != blank %}
                    <p class="order-item__variant">{{ 'customer.order.sku' | t }}: {{ line_item.sku }}</p>
                  {% endif %}
                </div>

                <div class="order-item__prices">
                  <p class="order-item__price">{{ line_item.final_line_price | money }}</p>
                  {% if line_item.original_line_price != line_item.final_line_price %}
                    <p class="order-item__original-price">{{ line_item.original_line_price | money }}</p>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        </div>

        <div class="order-sidebar">
          {%- comment -%} Shipping Address {%- endcomment -%}
          {% if order.shipping_address %}
            <div class="order-card">
              <h3 class="order-card__title">{{ 'customer.order.shipping_address' | t }}</h3>
              <div class="order-address">
                {{ order.shipping_address | format_address }}
              </div>
            </div>
          {% endif %}

          {%- comment -%} Billing Address {%- endcomment -%}
          {% if order.billing_address %}
            <div class="order-card">
              <h3 class="order-card__title">{{ 'customer.order.billing_address' | t }}</h3>
              <div class="order-address">
                {{ order.billing_address | format_address }}
              </div>
            </div>
          {% endif %}

          {%- comment -%} Order Summary {%- endcomment -%}
          <div class="order-card">
            <h3 class="order-card__title">{{ section.settings.summary_title | default: 'Order Summary' }}</h3>

            <div class="order-totals">
              <div class="order-totals__row">
                <span>{{ 'customer.order.subtotal' | t }}</span>
                <span>{{ order.subtotal_price | money }}</span>
              </div>

              {% for shipping_method in order.shipping_methods %}
                <div class="order-totals__row">
                  <span>{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</span>
                  <span>{{ shipping_method.price | money }}</span>
                </div>
              {% endfor %}

              {% for tax_line in order.tax_lines %}
                <div class="order-totals__row">
                  <span>{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
                  <span>{{ tax_line.price | money }}</span>
                </div>
              {% endfor %}

              {% if order.total_duties > 0 %}
                <div class="order-totals__row">
                  <span>{{ 'customer.order.total_duties' | t }}</span>
                  <span>{{ order.total_duties | money }}</span>
                </div>
              {% endif %}

              {% if order.total_discounts > 0 %}
                <div class="order-totals__row order-totals__row--discount">
                  <span>{{ 'customer.order.discount' | t }}</span>
                  <span>-{{ order.total_discounts | money }}</span>
                </div>
              {% endif %}

              <div class="order-totals__row order-totals__row--total">
                <span>{{ 'customer.order.total' | t }}</span>
                <span>{{ order.total_price | money }}</span>
              </div>
            </div>

            {%- comment -%} Reorder Button {%- endcomment -%}
            {% if section.settings.show_reorder_button %}
              <form action="{{ routes.cart_url }}" method="post">
                {% for line_item in order.line_items %}
                  <input type="hidden" name="updates[{{ line_item.variant_id }}]" value="{{ line_item.quantity }}">
                {% endfor %}
                <button type="submit" name="checkout" class="btn-reorder">
                  {{ section.settings.reorder_button_text | default: 'Reorder' }}
                </button>
              </form>
            {% endif %}
          </div>
        </div>
      </div>

      {%- comment -%} Tracking Information {%- endcomment -%}
      {% if order.fulfillments.size > 0 %}
        <div class="order-card">
          <h2 class="order-card__title">{{ section.settings.tracking_title | default: 'Tracking Information' }}</h2>

          {% for fulfillment in order.fulfillments %}
            <div class="tracking-info">
              {% if fulfillment.tracking_number %}
                <p>
                  <strong>{{ 'customer.order.tracking_number' | t }}:</strong>
                  {% if fulfillment.tracking_url %}
                    <a href="{{ fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ fulfillment.tracking_number }}</a>
                  {% else %}
                    {{ fulfillment.tracking_number }}
                  {% endif %}
                </p>
              {% endif %}
              {% if fulfillment.tracking_company %}
                <p>
                  <strong>{{ 'customer.order.tracking_company' | t }}:</strong>
                  {{ fulfillment.tracking_company }}
                </p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} Blocks {%- endcomment -%}
      {% if section.blocks.size > 0 %}
        <div class="order-blocks">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'order_notes' %}
                <div class="block-order-notes" {{ block.shopify_attributes }}>
                  {% if block.settings.title != blank %}
                    <h3 class="block-order-notes__title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.content != blank %}
                    <div class="block-order-notes__content">{{ block.settings.content }}</div>
                  {% endif %}
                </div>

              {% when 'support_info' %}
                <div class="block-support-info" {{ block.shopify_attributes }}>
                  <svg class="block-support-info__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                  <div class="block-support-info__content">
                    {% if block.settings.title != blank %}
                      <h3 class="block-support-info__title">{{ block.settings.title }}</h3>
                    {% endif %}
                    {% if block.settings.content != blank %}
                      <p class="block-support-info__text">{{ block.settings.content }}</p>
                    {% endif %}
                    {% if block.settings.link_text != blank and block.settings.link_url != blank %}
                      <a href="{{ block.settings.link_url }}" class="block-support-info__link">{{ block.settings.link_text }}</a>
                    {% endif %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}

    {% else %}
      <div class="order-empty">
        <p class="order-empty__text">{{ section.settings.empty_text | default: 'Order not found.' }}</p>
        <a href="{{ routes.account_url }}" class="btn-secondary">
          {{ 'customer.account.return' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Customer Order",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "accent", "label": "Accent" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (Custom)"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "narrow", "label": "Narrow (800px)" },
        { "value": "medium", "label": "Medium (1000px)" },
        { "value": "wide", "label": "Wide (1200px)" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "wide"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "title_scale",
      "label": "Title scale",
      "min": 75,
