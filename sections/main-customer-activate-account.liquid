{% liquid
  # @description Customer account activation section
  # Activation form with password setup and success/error messaging
  # @example
  #   Used in templates/customers/activate_account.json

  # Extract style logic into variables
  assign section_bg_style = ''
  if section.settings.background_color != blank
    assign section_bg_style = 'background-color: ' | append: section.settings.background_color | append: ';'
  endif

  assign heading_style = ''
  if section.settings.heading_color != blank
    assign heading_style = 'color: ' | append: section.settings.heading_color | append: ';'
  endif

  assign text_style = ''
  if section.settings.text_color != blank
    assign text_style = 'color: ' | append: section.settings.text_color | append: ';'
  endif

  assign button_style = ''
  if section.settings.button_background_color != blank
    assign button_style = 'background-color: ' | append: section.settings.button_background_color | append: ';'
  endif
  if section.settings.button_text_color != blank
    assign button_style = button_style | append: 'color: ' | append: section.settings.button_text_color | append: ';'
  endif

  assign form_bg_style = ''
  if section.settings.form_background_color != blank
    assign form_bg_style = 'background-color: ' | append: section.settings.form_background_color | append: ';'
  endif
%}

<div class="customer-activate page-width"{% if section_bg_style != blank %} style="{{ section_bg_style }} padding: {{ section.settings.section_padding }}px 0;"{% else %} style="padding: {{ section.settings.section_padding }}px 0;"{% endif %}>
  <div class="customer-activate__container" style="max-width: {{ section.settings.content_width }}px; margin: 0 auto;">
    
    <div class="customer-activate__form-wrapper"{% if form_bg_style != blank %} style="{{ form_bg_style }} padding: {{ section.settings.form_padding }}px; border-radius: {{ section.settings.form_border_radius }}px;"{% else %} style="padding: {{ section.settings.form_padding }}px; border-radius: {{ section.settings.form_border_radius }}px;"{% endif %}>
      <h1 class="customer-activate__heading" style="text-align: center;"{% if heading_style != blank %} style="{{ heading_style }} text-align: center;"{% endif %}>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          Activate Account
        {%- endif -%}
      </h1>
      
      {%- if section.settings.description != blank -%}
        <p class="customer-activate__description" style="text-align: center; margin-bottom: 2rem;"{% if text_style != blank %} style="{{ text_style }} text-align: center; margin-bottom: 2rem;"{% endif %}>
          {{ section.settings.description }}
        </p>
      {%- endif -%}

      {%- form 'activate_customer_password', class: 'customer-activate__form' -%}
        {%- if form.errors -%}
          <div class="customer-activate__errors" style="background: #fee; border: 1px solid #fcc; border-radius: 4px; padding: 1rem; margin-bottom: 1rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="customer-activate__field" style="margin-bottom: 1rem;">
          <label for="CustomerPassword" class="customer-activate__label"{% if text_style != blank %} style="{{ text_style }}"{% endif %}>
            Password
          </label>
          <input
            type="password"
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="new-password"
            required
            class="customer-activate__input"
            style="width: 100%; padding: 0.75rem; border: 1px solid rgba(0,0,0,0.2); border-radius: 4px; font-size: 1rem;"
            minlength="5"
          >
        </div>

        <div class="customer-activate__field" style="margin-bottom: 1.5rem;">
          <label for="CustomerPasswordConfirmation" class="customer-activate__label"{% if text_style != blank %} style="{{ text_style }}"{% endif %}>
            Confirm Password
          </label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="CustomerPasswordConfirmation"
            autocomplete="new-password"
            required
            class="customer-activate__input"
            style="width: 100%; padding: 0.75rem; border: 1px solid rgba(0,0,0,0.2); border-radius: 4px; font-size: 1rem;"
            minlength="5"
          >
        </div>

        <button type="submit" class="customer-activate__submit"{% if button_style != blank %} style="{{ button_style }} width: 100%; padding: 0.875rem 1.5rem; border: none; border-radius: 4px; font-size: 1rem; font-weight: 500; cursor: pointer; transition: opacity 0.2s;"{% else %} style="width: 100%; padding: 0.875rem 1.5rem; border: none; border-radius: 4px; font-size: 1rem; font-weight: 500; cursor: pointer; transition: opacity 0.2s;"{% endif %}>
          {%- if section.settings.button_text != blank -%}
            {{ section.settings.button_text }}
          {%- else -%}
            Activate Account
          {%- endif -%}
        </button>

        <div style="text-align: center; margin-top: 1.5rem;">
          <button type="submit" name="decline" formaction="{{ routes.account_register_url }}" class="customer-activate__decline" style="background: transparent; border: none; text-decoration: underline; cursor: pointer; font-size: 0.875rem;"{% if text_style != blank %} style="{{ text_style }} background: transparent; border: none; text-decoration: underline; cursor: pointer; font-size: 0.875rem;"{% endif %}>
            {%- if section.settings.decline_text != blank -%}
              {{ section.settings.decline_text }}
            {%- else -%}
              Decline invitation
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}
    </div>

  </div>
</div>

<style>
  .customer-activate__input:focus {
    outline: none;
    border-color: #3B82F6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .customer-activate__submit:hover {
    opacity: 0.9;
  }

  .customer-activate__decline:hover {
    opacity: 0.7;
  }
</style>

{% schema %}
{
  "name": "Customer Activate Account",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "text",
      "id": "decline_text",
      "label": "Decline Link Text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Max Width (px)",
      "min": 400,
      "max": 600,
      "step": 50,
      "default": 500
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "form_padding",
      "label": "Form Padding (px)",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "form_border_radius",
      "label": "Form Border Radius (px)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "form_background_color",
      "label": "Form Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    }
  ],
  "presets": [
    {
      "name": "Customer Activate Account"
    }
  ],
  "templates": ["customers/activate_account"]
}
{% endschema %}
