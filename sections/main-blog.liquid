{% liquid
  # @description Main blog section
  # Displays blog posts in a grid or list layout
%}

<div class="page-width" style="padding: 40px 20px;">
  {%- if blog.title != blank -%}
    <h1 class="h1" style="margin-bottom: 30px;">{{ blog.title | escape }}</h1>
  {%- endif -%}
  
  {%- if blog.articles.size > 0 -%}
    <div class="blog-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 30px;">
      {%- for article in blog.articles -%}
        <article class="blog-article" style="border: 1px solid #eee; border-radius: 4px; overflow: hidden;">
          {%- if article.image != blank -%}
            <a href="{{ article.url }}">
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" style="width: 100%; height: 200px; object-fit: cover;">
            </a>
          {%- endif -%}
          <div style="padding: 20px;">
            <h2 style="margin-bottom: 10px;">
              <a href="{{ article.url }}" style="color: #000; text-decoration: none;">{{ article.title | escape }}</a>
            </h2>
            {%- if article.excerpt != blank -%}
              <p style="margin-bottom: 15px; color: #666;">{{ article.excerpt | strip_html | truncate: 150 }}</p>
            {%- endif -%}
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: #999;">
              <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
              <a href="{{ article.url }}" style="color: #000; text-decoration: underline;">Read more</a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p style="text-align: center; padding: 60px 20px;">No articles found.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Blog"
    }
  ]
}
{% endschema %}

