<style>
  /* Product Page Responsive Styles */
  
  /* Product Media Gallery Responsive */
  .product__media-wrapper {
    width: 100%;
  }
  
  .product__media-list {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  
  .product__media-wrapper--grid .product__media-list {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  
  .product__media-wrapper--stacked .product__media-list {
    grid-template-columns: 1fr;
  }
  
  .product__media-wrapper--carousel .product__media-list {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  
  .product__media-wrapper--carousel .product__media-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  
  .product__media-item {
    width: 100%;
  }
  
  .product__media-item img,
  .product__media-item video {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: attr(width) / attr(height);
  }
  
  .product__media-item iframe {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    min-height: 300px;
  }
  
  /* Product Info Wrapper Responsive */
  .product__info-wrapper {
    width: 100%;
  }
  
  .product__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  
  .product__price {
    font-size: clamp(1.5rem, 2.5vw, 1.8rem);
    margin-bottom: clamp(1.5rem, 2vw, 2rem);
  }
  
  /* Variant Picker Responsive */
  .product__variant-picker-wrapper {
    margin-bottom: clamp(1.5rem, 2vw, 2rem);
  }
  
  .variant-picker-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }
  
  .variant-picker-button {
    min-height: 44px;
    min-width: 44px;
    padding: clamp(0.75rem, 1.5vw, 1rem) clamp(1rem, 2vw, 1.5rem);
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
    border: 1px solid rgba(var(--color-base-text), 0.2);
    border-radius: 0.4rem;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .variant-picker-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }
  
  .variant-picker-swatch {
    width: clamp(40px, 5vw, 50px);
    height: clamp(40px, 5vw, 50px);
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .variant-picker-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }
  
  .variant-picker-image {
    min-height: 80px;
    min-width: 80px;
    border: 2px solid transparent;
    border-radius: 0.4rem;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.2s ease;
  }
  
  .variant-picker-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .select {
    position: relative;
    min-height: 44px;
  }
  
  .select__select {
    width: 100%;
    min-height: 44px;
    padding: clamp(0.75rem, 1.5vw, 1rem);
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
    border: 1px solid rgba(var(--color-base-text), 0.2);
    border-radius: 0.4rem;
    background-color: rgb(var(--color-base-background-1));
    color: rgba(var(--color-base-text), 0.75);
    appearance: none;
    cursor: pointer;
  }
  
  /* Quantity Selector Responsive */
  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid rgba(var(--color-base-text), 0.2);
    border-radius: 0.4rem;
    min-height: 44px;
    width: 100%;
    max-width: 150px;
  }
  
  .quantity-btn {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
  }
  
  .quantity-input {
    min-height: 44px;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
  }
  
  /* Product Form Buttons Responsive */
  .product-form__submit {
    min-height: 44px;
    font-size: clamp(1.4rem, 1.8vw, 1.6rem);
    padding: clamp(1.2rem, 2vw, 1.5rem) clamp(2rem, 4vw, 3rem);
  }
  
  /* Product Description Responsive */
  .product__description {
    font-size: clamp(1.4rem, 1.8vw, 1.6rem);
    line-height: 1.6;
    margin-bottom: clamp(1.5rem, 2vw, 2rem);
  }
  
  /* Product Tabs Responsive */
  .product__tabs-wrapper {
    margin-top: clamp(2rem, 3vw, 3rem);
  }
  
  .product-tabs__header {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 1vw, 1rem);
    border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  
  .product-tabs__header::-webkit-scrollbar {
    display: none;
  }
  
  .product-tabs__tab {
    min-height: 44px;
    padding: clamp(0.75rem, 1.5vw, 1rem) clamp(1rem, 2vw, 1.5rem);
    font-size: clamp(1.2rem, 1.6vw, 1.4rem);
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  
  .product-tabs__tab--active {
    border-bottom-color: rgba(var(--color-base-text), 0.75);
    font-weight: 600;
  }
  
  .product-tabs__panel {
    padding: clamp(1.5rem, 2vw, 2rem) 0;
  }
  
  .product-tabs__content {
    min-height: 200px;
  }
  
  /* Mobile tabs - scrollable */
  @media screen and (max-width: 767px) {
    .product-tabs__header {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    
    .product-tabs__tab {
      flex-shrink: 0;
    }
  }
  
  /* Sticky Product Info Responsive */
  .product--sticky-info .product__info-wrapper {
    position: sticky;
    top: clamp(80px, 10vw, 120px);
    align-self: start;
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .product {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 0;
    }
    
    .product__media-wrapper--grid .product__media-list {
      grid-template-columns: 1fr;
    }
    
    .product__media-wrapper--carousel .product__media-item {
      flex: 0 0 100%;
    }
    
    .product--sticky-info .product__info-wrapper {
      position: static;
    }
    
    .quantity-selector {
      max-width: 100%;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .product {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .product__media-wrapper--grid .product__media-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .product {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    
    .product__media-wrapper--grid .product__media-list {
      grid-template-columns: repeat(2, 1fr);
    }
