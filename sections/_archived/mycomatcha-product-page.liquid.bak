          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "feature_name": "Enhanced Focus & Clarity",
            "myco_value": "✓",
            "coffee_value": "✓"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "feature_name": "Packed with Antioxidants",
            "myco_value": "✓",
            "coffee_value": "✓"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "feature_name": "Smooth, Sustained Energy (4-6 hours)",
            "myco_value": "✓",
            "coffee_value": "✗"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "feature_name": "No Jitters or Anxiety",
            "myco_value": "✓",
            "coffee_value": "✗"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "feature_name": "No Afternoon Crash",
