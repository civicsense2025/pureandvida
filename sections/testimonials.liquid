{% liquid
  # @description Testimonials section displaying customer reviews and testimonials
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings heading {String} - Section heading
  # @settings columns_desktop {Number} - Number of columns on desktop
  # @blocks testimonial_item - Individual testimonial with stars, text, author, avatar, and date
  # @example
  #   Use blocks mode for dynamic testimonials, settings mode for fixed 6-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
%}

<{{ structural_element }} class="testimonials-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  <div class="testimonials-content page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
      {%- if section.settings.content_mode == 'blocks' -%}
        {%- for block in section.blocks -%}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            {%- if block.settings.show_stars -%}
              <div class="testimonial-stars">
                {%- if block.settings.stars_image != blank -%}
                  <img src="{{ block.settings.stars_image | image_url: width: 100 }}" alt="5 Stars">
                {%- elsif block.settings.stars_asset != blank -%}
                  <img src="{{ block.settings.stars_asset | asset_url }}" alt="5 Stars">
                {%- else -%}
                  <span>★★★★★</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="testimonial-text" style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}">{{ block.settings.text }}</p>
            {%- endif -%}
            <div class="testimonial-author">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 50 }}" alt="{{ block.settings.author_name | escape }}" class="testimonial-avatar">
              {%- elsif block.settings.avatar_asset != blank -%}
                <img src="{{ block.settings.avatar_asset | asset_url }}" alt="{{ block.settings.author_name | escape }}" class="testimonial-avatar">
              {%- endif -%}
              {%- if block.settings.author_name != blank -%}
                <span class="testimonial-name" style="{% if block.settings.author_color != blank %}color: {{ block.settings.author_color }};{% endif %}">—{{ block.settings.author_name | escape }}</span>
              {%- endif -%}
              {%- if block.settings.date != blank -%}
                <span class="testimonial-date" style="{% if block.settings.date_color != blank %}color: {{ block.settings.date_color }};{% endif %}">{{ block.settings.date | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Settings mode - Fixed fields {%- endcomment -%}
        {%- for i in (1..6) -%}
          {%- assign text_key = 'testimonial_' | append: i | append: '_text' -%}
          {%- assign author_key = 'testimonial_' | append: i | append: '_author' -%}
          {%- assign avatar_key = 'testimonial_' | append: i | append: '_avatar' -%}
          {%- assign date_key = 'testimonial_' | append: i | append: '_date' -%}
          {%- assign text = section.settings[text_key] -%}
          {%- assign author = section.settings[author_key] -%}
          {%- assign avatar = section.settings[avatar_key] -%}
          {%- assign date = section.settings[date_key] -%}
          {%- if text != blank or author != blank -%}
            <div class="testimonial-card">
              <div class="testimonial-stars">
                {%- if section.settings.stars_image != blank -%}
                  <img src="{{ section.settings.stars_image | image_url: width: 100 }}" alt="5 Stars">
                {%- else -%}
                  <img src="{{ '60a916eaf79acd1bbd27ac953b76a1185c5ab0e4.svg' | asset_url }}" alt="5 Stars">
                {%- endif -%}
              </div>
              {%- if text != blank -%}
                <p class="testimonial-text">{{ text }}</p>
              {%- endif -%}
              <div class="testimonial-author">
                {%- if avatar != blank -%}
                  <img src="{{ avatar | image_url: width: 50 }}" alt="{{ author | escape }}" class="testimonial-avatar">
                {%- else -%}
                  <img src="{{ '225302497f6aff11e874ccb561046fe17eb63a34.svg' | asset_url }}" alt="{{ author | escape }}" class="testimonial-avatar">
                {%- endif -%}
                {%- if author != blank -%}
                  <span class="testimonial-name">—{{ author | escape }}</span>
                {%- endif -%}
                {%- if date != blank -%}
                  <span class="testimonial-date">{{ date | escape }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</{{ structural_element }}>

<style>
  /* Testimonials Section Responsive Styles */
  .testimonials-grid {
    display: grid;
    gap: clamp(20px, 4vw, {{ section.settings.item_spacing }}px);
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .testimonials-grid {
      grid-template-columns: 1fr !important;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr) !important;
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }
  
  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  
  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr) !important;
    }
  }
</style>

