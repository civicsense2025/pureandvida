{%- liquid
  # @description Password page header section
  # Displays logo and optional navigation for password-protected storefront
-%}

<header class="password-header">
  <div class="password-header__inner page-width">
    {%- if section.settings.logo_image != blank -%}
      <a href="/" class="password-header__logo">
        <img
          src="{{ section.settings.logo_image | image_url: width: 300 }}"
          alt="{{ shop.name | escape }}"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      </a>
    {%- else -%}
      <a href="/" class="password-header__logo">
        {%- if section.settings.show_plus -%}
          <span class="logo__text-pure">{{ section.settings.logo_text | split: '+' | first | strip }}</span>
          <span class="logo__plus">+</span>
          <span class="logo__text-vida">{{ section.settings.logo_text | split: '+' | last | strip }}</span>
        {%- else -%}
          {{ section.settings.logo_text | default: shop.name }}
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</header>

<style>
  .password-header {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color | default: 'transparent' }};
  }

  .password-header__inner {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .password-header__logo {
    display: flex;
    align-items: center;
    gap: 0.25em;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.logo_text_size }}px;
    font-weight: var(--font-heading-weight);
    color: {{ section.settings.logo_color | default: 'var(--color-primary)' }};
    text-decoration: none;
  }

  .password-header__logo img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
  }

  .password-header__logo .logo__plus {
    color: {{ section.settings.plus_color | default: 'var(--color-accent)' }};
  }
</style>

{% schema %}
{
  "name": "Password Header",
  "tag": "div",
  "class": "section-password-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "Pure + Vida",
      "info": "Displayed if no logo image is set"
    },
    {
      "type": "range",
      "id": "logo_text_size",
      "label": "Logo Text Size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "show_plus",
      "label": "Show Plus Sign Style",
      "default": true,
      "info": "Style the + in logo text with accent color"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Color"
    },
    {
      "type": "color",
      "id": "plus_color",
      "label": "Plus Sign Color"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
