{% liquid
  # @description Newsletter signup section for email subscription
  # Supports various layouts and styling options
  # @settings heading {text} - Section heading
  # @settings subheading {text} - Text above heading
  # @settings success_message {text} - Message shown on successful signup
  # @example
  #   Use for email list building, promotional signups, or content subscriptions
%}

{% if request.design_mode %}
  <div class="editor-controls editor-controls--newsletter">
    <span class="editor-label">Newsletter</span>
    <span class="editor-info">
      Layout: {{ section.settings.layout | capitalize }}
    </span>
  </div>
{% endif %}

<section
  class="newsletter newsletter--{{ section.settings.layout }}"
  style="
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: {{ section.settings.background_position }};
    {% endif %}
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  aria-label="Newsletter signup"
>
  {%- if section.settings.background_image != blank and section.settings.show_overlay -%}
    <div
      class="newsletter__overlay"
      style="
        background: {{ section.settings.overlay_color }};
        opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      "
    ></div>
  {%- endif -%}

  <div class="newsletter__container page-width">
    <div class="newsletter__wrapper" style="text-align: {{ section.settings.text_alignment }};">
      {%- comment -%} Icon {%- endcomment -%}
      {%- if section.settings.show_icon -%}
        <div class="newsletter__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
      {%- endif -%}

      {%- comment -%} Content {%- endcomment -%}
      <div class="newsletter__content">
        {%- if section.settings.subheading != blank -%}
          <span class="newsletter__subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter__heading" style="font-size: {{ section.settings.heading_size }}px;">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="newsletter__description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} Form {%- endcomment -%}
      <div class="newsletter__form-wrapper">
        {% form 'customer', class: 'newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div class="newsletter__success" role="status">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <p>{{ section.settings.success_message | default: 'Thanks for subscribing!' }}</p>
            </div>
          {%- else -%}
            <div class="newsletter__form-inner newsletter__form-inner--{{ section.settings.form_layout }}">
              <div class="newsletter__field">
                <label for="newsletter-email-{{ section.id }}" class="visually-hidden">
                  {{ 'general.newsletter.email_placeholder' | t | default: 'Email address' }}
                </label>
                <input
                  type="email"
                  name="contact[email]"
                  id="newsletter-email-{{ section.id }}"
                  class="newsletter__input"
                  placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
                  required
                  autocomplete="email"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="newsletter-error-{{ section.id }}"
                  {% endif %}
                >
              </div>

              <button type="submit" class="newsletter__button button button--{{ section.settings.button_style }}">
                {%- if section.settings.button_label != blank -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  {{ 'general.newsletter.submit' | t | default: 'Subscribe' }}
                {%- endif -%}
                {%- if section.settings.show_button_icon -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                {%- endif -%}
              </button>
            </div>

            {%- if form.errors contains 'email' -%}
              <p class="newsletter__error" id="newsletter-error-{{ section.id }}" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {% endform %}

        {%- if section.settings.disclaimer != blank -%}
          <p class="newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter {
    position: relative;
  }

  .newsletter__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
  }

  .newsletter__container {
    position: relative;
    z-index: 1;
  }

  .newsletter__wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    {% if section.settings.text_alignment == 'center' %}
      display: flex;
      flex-direction: column;
      align-items: center;
    {% endif %}
  }

  .newsletter__icon {
    margin-bottom: 20px;
    color: {{ section.settings.icon_color | default: 'var(--color-primary, #2c5530)' }};
  }

  .newsletter__content {
    margin-bottom: 32px;
  }

  .newsletter__subheading {
    display: block;
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color | default: 'var(--color-primary, #2c5530)' }};
    margin-bottom: 12px;
  }

  .newsletter__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight, 600);
    line-height: 1.2;
    margin: 0 0 16px;
    color: {{ section.settings.heading_color | default: 'var(--color-text, #333)' }};
  }

  .newsletter__description {
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    line-height: 1.6;
    color: {{ section.settings.text_color | default: 'var(--color-text, #666)' }};
    max-width: 600px;
    {% if section.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  .newsletter__form-wrapper {
    width: 100%;
    max-width: 500px;
    {% if section.settings.text_alignment == 'center' %}
      margin: 0 auto;
    {% elsif section.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .newsletter__form-inner {
    display: flex;
    gap: 12px;
  }

  .newsletter__form-inner--stacked {
    flex-direction: column;
  }

  .newsletter__field {
    flex: 1;
  }

  .newsletter__input {
    width: 100%;
    padding: 14px 18px;
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: var(--color-text, #333);
    background: {{ section.settings.input_background | default: '#ffffff' }};
    border: {{ section.settings.input_border_width }}px solid {{ section.settings.input_border_color | default: '#ddd' }};
    border-radius: {{ section.settings.input_border_radius }}px;
    transition: all 0.3s ease;
  }

  .newsletter__input:focus {
    outline: none;
    border-color: var(--color-primary, #2c5530);
    box-shadow: 0 0 0 2px rgba(44, 85, 48, 0.1);
  }

  .newsletter__input::placeholder {
    color: #999;
  }

  .newsletter__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: {{ section.settings.input_border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Button styles */
  .button--primary {
    background-color: var(--color-primary, #2c5530);
    color: white;
    border: 2px solid var(--color-primary, #2c5530);
  }

  .button--primary:hover {
    background-color: var(--color-primary-dark, #1e3a21);
    border-color: var(--color-primary-dark, #1e3a21);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--color-primary, #2c5530);
    border: 2px solid var(--color-primary, #2c5530);
  }

  .button--secondary:hover {
    background-color: var(--color-primary, #2c5530);
    color: white;
  }

  .button--dark {
    background-color: var(--color-text, #333);
    color: white;
    border: 2px solid var(--color-text, #333);
  }

  .button--dark:hover {
    background-color: #000;
    border-color: #000;
  }

  .newsletter__success {
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    gap: 12px;
    padding: 20px;
    background: rgba(44, 85, 48, 0.1);
    border-radius: 8px;
    color: var(--color-primary, #2c5530);
  }

  .newsletter__success p {
    margin: 0;
    font-weight: 500;
  }

  .newsletter__error {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    color: #dc3545;
    font-size: 0.9rem;
  }

  .newsletter__disclaimer {
    margin-top: 16px;
    font-size: 0.8rem;
    color: {{ section.settings.text_color | default: 'var(--color-text, #999)' }};
    opacity: 0.7;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Compact layout */
  .newsletter--compact .newsletter__wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 48px;
  }

  .newsletter--compact .newsletter__content {
    flex: 1;
    min-width: 280px;
    margin-bottom: 0;
  }

  .newsletter--compact .newsletter__form-wrapper {
    flex: 1;
    min-width: 320px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .newsletter__form-inner:not(.newsletter__form-inner--stacked) {
      flex-direction: column;
    }

    .newsletter__heading {
      font-size: {{ section.settings.heading_size | times: 0.75 | round }}px !important;
    }

    .newsletter--compact .newsletter__wrapper {
      flex-direction: column;
      text-align: center !important;
    }

    .newsletter--compact .newsletter__content,
    .newsletter--compact .newsletter__form-wrapper {
      width: 100%;
      max-width: 100%;
    }
  }

  /* Editor mode styles */
  {% if request.design_mode %}
    .newsletter {
      outline: 2px dashed rgba(44, 85, 48, 0.3);
      outline-offset: -2px;
      min-height: 150px;
    }

    .newsletter::before {
      content: 'NEWSLETTER';
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(44, 85, 48, 0.95);
      color: white;
      padding: 4px 12px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
    }

    .editor-controls--newsletter {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.90);
      color: white;
      padding: 8px 14px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font-body-family);
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      border: 2px solid rgba(44, 85, 48, 0.5);
    }

    .editor-controls--newsletter .editor-label {
      font-weight: 600;
      color: var(--color-primary, #2c5530);
      font-size: 12px;
    }

    .editor-controls--newsletter .editor-info {
      font-size: 10px;
      opacity: 0.85;
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "📧 Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Add a newsletter signup form to grow your email list. Customize the layout, messaging, and styling."
    },
    {
      "type": "header",
      "content": "📝 Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stay Updated"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to Our Newsletter"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Get the latest updates on new products, exclusive offers, and wellness tips delivered to your inbox.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show Email Icon",
      "default": false
    },
    {
      "type": "header",
      "content": "📝 Form Settings"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "checkbox",
      "id": "show_button_icon",
      "label": "Show Button Arrow",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "form_layout",
      "label": "Form Layout",
      "options": [
        { "value": "inline", "label": "Inline (side by side)" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "inline"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "info": "Small text below the form (e.g., privacy policy note)"
    },
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section Layout",
      "options": [
        { "value": "standard", "label": "Standard (Centered)" },
        { "value": "compact", "label": "Compact (Side by Side)" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content Max Width",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "🖼️ Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show Overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color"
    },
    {
      "type": "header",
      "content": "📝 Input Styling"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input Border Color",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "input_border_width",
      "label": "Input Border Width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "input_border_radius",
      "label": "Input & Button Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "📏 Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Newsletter - Standard",
      "settings": {
        "layout": "standard",
        "text_alignment": "center",
        "subheading": "Stay Updated",
        "heading": "Subscribe to Our Newsletter",
        "description": "<p>Get the latest updates on new products, exclusive offers, and wellness tips delivered to your inbox.</p>",
        "padding_top": 60,
        "padding_bottom": 60
      }
    },
    {
      "name": "Newsletter - Compact",
      "settings": {
        "layout": "compact",
        "text_alignment": "left",
        "heading": "Join Our Mailing List",
        "description": "<p>Subscribe for exclusive offers and updates.</p>",
        "background_color": "#2c5530",
        "heading_color": "#ffffff",
        "text_color": "#ffffff",
        "subheading_color": "#a8d5ba",
        "button_style": "dark",
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
    {
      "name": "Newsletter - With Background",
      "settings": {
        "layout": "standard",
        "text_alignment": "center",
        "show_icon": true,
        "heading": "Get Exclusive Offers",
        "description": "<p>Be the first to know about new arrivals and special promotions.</p>",
        "show_overlay": true,
        "overlay_opacity": 60,
        "heading_color": "#ffffff",
        "text_color": "#ffffff",
        "subheading_color": "#ffffff",
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
{% endschema %}
