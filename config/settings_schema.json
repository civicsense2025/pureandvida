  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Custom Fonts"
      },
      {
        "type": "select",
        "id": "custom_font_heading",
        "label": "Heading Font (Custom)",
        "info": "Select a custom font for headings. If 'Use Shopify Font' is selected, the font picker below will be used.",
        "options": [
          {
            "value": "shopify_font",
            "label": "Use Shopify Font (from picker below)"
          },
          {
            "value": "nohemi",
            "label": "Nohemi"
          },
          {
            "value": "versailles",
            "label": "Versailles"
          },
          {
            "value": "myriad",
            "label": "Myriad Pro"
          }
        ],
        "default": "shopify_font"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font (Shopify)",
        "info": "Only used if 'Use Shopify Font' is selected above",
        "default": "assistant_n4"
      },
      {
        "type": "select",
        "id": "custom_font_body",
        "label": "Body Font (Custom)",
        "info": "Select a custom font for body text. If 'Use Shopify Font' is selected, the font picker below will be used.",
        "options": [
          {
            "value": "shopify_font",
            "label": "Use Shopify Font (from picker below)"
          },
          {
            "value": "nohemi",
            "label": "Nohemi"
          },
          {
            "value": "versailles",
            "label": "Versailles"
          },
          {
            "value": "myriad",
            "label": "Myriad Pro"
          }
        ],
        "default": "shopify_font"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font (Shopify)",
        "info": "Only used if 'Use Shopify Font' is selected above",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_size_heading",
        "label": "Heading Font Size (px)",
        "min": 24,
        "max": 72,
        "step": 2,
        "default": 36
      },
      {
        "type": "range",
        "id": "font_size_body",
        "label": "Body Font Size (px)",
        "min": 12,
        "max": 24,
        "step": 1,
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_width",
        "label": "Container Width (px)",
        "min": 1200,
        "max": 1920,
        "step": 20,
        "default": 1440
      },
      {
        "type": "range",
        "id": "page_width_padding",
        "label": "Page Width Padding (px)",
        "min": 10,
        "max": 60,
        "step": 5,
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section Spacing (px)",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 40
      }
    ]
  },
