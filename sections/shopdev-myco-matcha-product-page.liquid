{{ 'shopdev-myco-matcha-product-page.css' | asset_url | stylesheet_tag }}

<style>
  .shopdev-myco-matcha-product-page .bg-cream { background-color: #F5F3EE; }
  .shopdev-myco-matcha-product-page .bg-teal { background-color: #5E8778; }
  .shopdev-myco-matcha-product-page .bg-orange { background-color: #E8983B; }
  .shopdev-myco-matcha-product-page .bg-dark-green { background-color: #516D55; }
  .shopdev-myco-matcha-product-page .bg-dark-olive { background-color: #4E4E33; }
  .shopdev-myco-matcha-product-page .bg-amber { background-color: #F9A000; }
  
  .shopdev-myco-matcha-product-page .text-teal { color: #5E8778; }
  .shopdev-myco-matcha-product-page .text-orange { color: #E8983B; }
  .shopdev-myco-matcha-product-page .text-dark-green { color: #314339; }
  
  .shopdev-myco-matcha-product-page .border-teal { border-color: #5E8778; }
  .shopdev-myco-matcha-product-page .border-black { border-color: #000000; }
  
  .shopdev-myco-matcha-product-page .line-through-teal {
    position: relative;
  }
  .shopdev-myco-matcha-product-page .line-through-teal::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background-color: #5E8778;
  }
  
  .shopdev-myco-matcha-product-page .faq-item {
    border: 1px solid #000000;
    cursor: pointer;
  }
  
  .shopdev-myco-matcha-product-page .faq-item:hover {
    background-color: #f9f9f9;
  }
</style>

<div class="w-full bg-cream">
  <!-- Header -->
  <div class="max-w-[1440px] mx-auto px-[60px] py-[54px]">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-[8px]">
        <h1 class="text-dark-green text-[52px] font-light">PURE  VIDA</h1>
        <span class="text-teal text-[24px] font-bold">+</span>
      </div>
      
      <nav class="flex items-center gap-[48px]">
        <a href="#" class="text-teal text-[24px] font-semibold tracking-[0.06em]">MycoMatcha</a>
        <a href="#" class="text-[24px] tracking-[0.06em]">Order Tracking</a>
        <a href="#" class="text-[24px] tracking-[0.06em]">About</a>
        <a href="#" class="bg-orange text-white px-[22px] py-[15px] rounded-[91px] text-[20px] font-semibold tracking-[0.06em]">View Cart</a>
      </nav>
    </div>
  </div>

  <!-- Hero Section with Product -->
  <div class="max-w-[1440px] mx-auto px-[60px] pb-[100px]">
    <div class="flex gap-[60px]">
      <!-- Product Images -->
      <div class="w-[602px]">
        {% if section.settings.product_image %}
          {{ section.settings.product_image | image_url: width: 602 | image_tag: class: 'w-full h-auto' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'w-full h-auto bg-gray-200' }}
        {% endif %}
      </div>

      <!-- Product Details -->
      <div class="flex-1 pt-[10px]">
        <div class="mb-[38px]">
          <div class="flex items-center gap-[38px] mb-[38px]">
            <h2 class="text-[72px] leading-[100%] tracking-[0.02em]">{{ section.settings.product_title }}</h2>
            <div class="bg-dark-olive text-white px-[30px] py-[15px] rounded-[46px]">
              <p class="text-[22px] leading-[100%] tracking-[0.12em]">{{ section.settings.badge_text }}</p>
            </div>
          </div>
        </div>

        <div class="flex items-start gap-[10px] mb-[38px]">
          <div class="relative">
            <span class="text-teal text-[35px] tracking-[0.12em] line-through-teal">{{ section.settings.original_price }}</span>
          </div>
          <span class="text-[94px] tracking-[-0.01em]">{{ section.settings.sale_price }}</span>
        </div>

        <div class="mb-[38px]">
          <p class="text-[23px] leading-[100%] tracking-[0.08em] whitespace-pre-line">{{ section.settings.product_description | newline_to_br }}</p>
        </div>

        <div class="flex items-center gap-[24px] mb-[38px]">
          <div class="border border-teal rounded-[72px] px-[17px] py-[23px] w-[116px]">
            <p class="text-[35px] leading-[100%] text-center">+ 1</p>
          </div>
          <button class="bg-teal text-white px-[47px] py-[23px] rounded-[72px] text-[35px] leading-[100%] tracking-[0.12em]">
            {{ section.settings.button_text }}
          </button>
        </div>

        <div class="flex gap-[7px]">
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/22131a881663a5537e3980a3d571d5a61ec7bd7d.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/0902198dda288f244b470588af55e74e8facd4fc.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <svg width="29" height="9" viewBox="0 0 29 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0 8.2099L28.1993 0V4.64038C28.1993 6.61177 26.6011 8.2099 24.6297 8.2099H0Z" fill="#FD6020"/>
</svg>

          </div>
          <div class="w-[50px] h-[34px] bg-[#1F72CD] border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/bfba9b9e11ec6200260302d3e952df331df200e7.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/86700408f70341c2d7fdf34d756567c802955bb2.svg" />
          </div>
          <div class="w-[50px] h-[34px] bg-white border border-gray-300 rounded flex items-center justify-center">
            <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/6d8a0f2ef3cb91c11062e4fcb5c29a0be7daf438.svg" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Customer Reviews -->
  <div class="max-w-[1440px] mx-auto px-[127px] pb-[100px]">
    <div class="flex gap-[96px]">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <div class="w-[320px]" {{ block.shopify_attributes }}>
            <div class="flex gap-[15px] mb-[15px]">
              {% for i in (1..5) %}
                <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/210b2ce3d0f16f17b660c3752ed11ef8c3c23668.svg" />
              {% endfor %}
            </div>
            <p class="text-[16px] leading-[120%] tracking-[0.12em] mb-[15px] text-justify">{{ block.settings.review_text }}</p>
            <div class="flex items-center gap-[18px]">
              <div class="w-[43px] h-[43px] bg-gray-300 rounded-full"></div>
              <p class="text-[16px] leading-[120%] tracking-[0.12em]">{{ block.settings.reviewer_name }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Benefits Section -->
  <div class="max-w-[1440px] mx-auto px-[85px] pb-[100px]">
    <div class="flex gap-[29px] justify-center">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="w-[383px]" {{ block.shopify_attributes }}>
            <div class="flex justify-center mb-[26px]">
              <svg data-vector-hash="{{ block.settings.icon_hash }}" class="w-[45px] h-[45px]" />
            </div>
            <h3 class="text-[25px] tracking-[0.12em] text-center mb-[26px]">{{ block.settings.benefit_title }}</h3>
            <p class="text-[16px] leading-[140%] tracking-[0.06em] text-center">{{ block.settings.benefit_description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Comparison Table -->
  <div class="max-w-[1440px] mx-auto px-[163px] pb-[100px]">
    <h2 class="text-[40px] leading-[140%] tracking-[0.12em] text-center mb-[82px]">{{ section.settings.comparison_title }}</h2>
    
    <div class="bg-amber rounded-[40px] p-[40px] relative overflow-hidden">
      <div class="absolute left-0 top-0 w-[646px] h-full bg-teal"></div>
      
      <div class="relative z-10">
        <div class="flex justify-between mb-[25px]">
          <div class="w-[657px]"></div>
          <div class="flex gap-[60px]">
            <span class="text-[20px] leading-[140%] tracking-[0.12em] font-bold w-[120px]">MycoMatcha</span>
            <span class="text-[20px] leading-[140%] tracking-[0.12em] font-bold w-[40px]">Coffee</span>
          </div>
        </div>

        {% for block in section.blocks %}
          {% if block.type == 'comparison_row' %}
            <div class="flex justify-between items-center py-[13px]" {{ block.shopify_attributes }}>
              <span class="text-white text-[20px] leading-[140%] tracking-[0.12em] font-medium w-[740px]">{{ block.settings.feature_name }}</span>
              <div class="flex gap-[60px]">
                <span class="text-[20px] leading-[140%] tracking-[0.12em] w-[120px]">{{ block.settings.myco_value }}</span>
                <span class="text-[20px] leading-[140%] tracking-[0.12em] w-[40px]">{{ block.settings.coffee_value }}</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Shipping & Returns -->
  <div class="max-w-[1440px] mx-auto px-[283px] pb-[100px]">
    <h2 class="text-[40px] leading-[140%] tracking-[0.12em] text-center mb-[10px]">{{ section.settings.shipping_title }}</h2>
    <div class="text-[20px] leading-[140%] tracking-[0.04em]">
      {{ section.settings.shipping_content | newline_to_br }}
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="max-w-[1440px] mx-auto px-[369px] pb-[100px]">
    <h2 class="text-[40px] leading-[140%] tracking-[0.12em] text-center mb-[10px]">{{ section.settings.faq_title }}</h2>
    
    <div class="space-y-[20px]">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <div class="faq-item p-[12px] rounded" {{ block.shopify_attributes }}>
            <div class="flex justify-between items-center">
              <span class="text-[20px] tracking-[0.12em]">{{ block.settings.question }}</span>
              <span class="text-[20px] tracking-[0.12em]">+</span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Footer -->
  <div class="bg-dark-green">
    <div class="max-w-[1440px] mx-auto px-[95px] py-[62px]">
      <div class="flex justify-between">
        <div>
          <div class="flex items-center gap-[8px] mb-[8px]">
            <h3 class="text-white text-[52px] font-light">PURE  VIDA</h3>
            <span class="text-amber text-[20px] font-bold">+</span>
          </div>
          <p class="text-white text-[15px] tracking-[0.12em] font-light">Copyright Pura Vida 2025. All rights reserved.</p>
        </div>

        <div class="flex gap-[115px]">
          <div>
            <p class="text-white text-[15px] tracking-[0.12em] font-light mb-[10px]">Shop MycoMatcha</p>
            <h4 class="text-white text-[20px] tracking-[0.12em] font-medium mb-[10px]">About Us</h4>
            <div class="space-y-[10px]">
              <p class="text-white text-[15px] tracking-[0.12em] font-light">The Company</p>
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Terms of Service</p>
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Privacy Policy</p>
            </div>
          </div>

          <div>
            <h4 class="text-white text-[20px] tracking-[0.12em] font-medium mb-[10px]">For You</h4>
            <div class="space-y-[10px]">
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Shipping Information</p>
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Return & Refund Policy</p>
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Track Your Order</p>
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Contact Us</p>
              <p class="text-white text-[15px] tracking-[0.12em] font-light">Privacy Choices</p>
            </div>
          </div>

          <div class="flex flex-col gap-[7px]">
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/06cfb31974dbc19d991ce3d6092463e8660795b5.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/93f7af38e2ba7538fa535d6ba7e3e40b44ebbc14.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <svg width="29" height="9" viewBox="0 0 29 9" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M0 8.44593L29.01 0V4.77379C29.01 6.80186 27.3659 8.44593 25.3378 8.44593H0Z" fill="#FD6020"/>
</svg>

            </div>
            <div class="w-[51px] h-[35px] bg-[#1F72CD] border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/9628c063b747d06050dd879c2a69048cbc2beea1.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/a9c5d21d1d5ca17ce14538a8a9afa0e23a8c7b99.svg" />
            </div>
            <div class="w-[51px] h-[35px] bg-white border border-gray-300 rounded flex items-center justify-center">
              <img src="https://assets.shopdev.ai/figma-imports/85973a7c-3882-48dd-8da7-c2b3cb2bee23/787e2bd70ea9fba4a83e89bb3f11013d75e688cd.svg" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MycoMatcha Product Page",
  "class": "shopdev shopdev-myco-matcha-product-page",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "MycoMatcha"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Get 33% off today"
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original Price",
      "default": "$45"
    },
    {
      "type": "text",
      "id": "sale_price",
      "label": "Sale Price",
      "default": "$34.99"
    },
    {
      "type": "textarea",
      "id": "product_description",
      "label": "Product Description",
      "default": "Your morning coffee spikes cortisol, burns through your adrenal reserves, and leaves you crashing by 2 PM. MycoMatcha works differently.\n\nCeremonial-grade matcha delivers 25-35mg of caffeine paired with L-theanine, which crosses the blood-brain barrier to promote alpha wave activity. The result: 4-6 hours of sustained energy without the spike-crash cycle. Add four adaptogenic mushrooms that have been used in traditional medicine for over 2,000 years, and you have a formula that doesn't just wake you up. It builds resilience."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "comparison_title",
      "label": "Comparison Title",
      "default": "Matcha vs. Coffee"
    },
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Shipping Title",
      "default": "Shipping & Returns"
    },
    {
      "type": "textarea",
      "id": "shipping_content",
      "label": "Shipping Content",
      "default": "Processing & Delivery\nOrders ship within 1-2 business days. Expect delivery within 2-4 business days after shipping. Free shipping on all orders with full tracking provided.\n\n60-Day Money-Back Guarantee\nNot fully satisfied? Return your product within 60 days for a full refund, risk-free.\n\nEasy Returns Process\nReach out to support@pureandvida.com. Our team will guide you through the return process. Your satisfaction is our top priority."
    },
    {
      "type": "text",
      "id": "faq_title",
      "label": "FAQ Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon_hash",
          "label": "Icon Hash"
        },
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit Title"
        },
        {
          "type": "text",
          "id": "benefit_description",
          "label": "Benefit Description"
        }
      ]
    },
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name"
        },
        {
          "type": "text",
          "id": "myco_value",
          "label": "MycoMatcha Value"
        },
        {
          "type": "text",
          "id": "coffee_value",
          "label": "Coffee Value"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MycoMatcha Product Page",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "review_text": "\"I started drinking this before my morning runs and noticed a real difference. I don't get winded as quickly, and I can push myself further. I didn't expect Cordyceps to work this fast, but it's become my favorite pre-workout\"",
            "reviewer_name": "—Michael F."
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "\"MycoMatcha has completely replaced my morning coffee. I feel mentally sharp, energized, and focused without the jittery crash I used to get. I love knowing that Lion's Mane and L-theanine are actually supporting my brain, not just stimulating it.\"",
            "reviewer_name": "—Michael F."
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "\"I used to have trouble falling asleep when I drank coffee, even early in the day. I switched to MycoMatcha and now I still get that energy boost, but I sleep like a baby. My mood during the day is way better too.\"",
            "reviewer_name": "—Michael F."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_hash": "3c200e8b599da8ff246ae3454d468ea28d9bc778",
