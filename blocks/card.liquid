{% comment %}
  Theme Block: Card
  -----------------
  Generic card wrapper with configurable content, background, padding, and styling.
  Supports grouped override settings for colors, typography, and spacing.
{% endcomment %}

{% liquid
  # Content
  assign card_heading = block.settings.heading
  assign card_content = block.settings.content
  assign btn_text = block.settings.button_text
  assign btn_link = block.settings.button_link

  # Layout
  assign show_bg = block.settings.show_background | default: true
  assign alignment = block.settings.text_align | default: 'center'

  # Color overrides
  assign bg_color = block.settings.background_color | default: '#f9f9f9'
  assign heading_color = block.settings.heading_color
  assign text_color = block.settings.text_color
  assign border_color = block.settings.border_color
  assign btn_bg_color = block.settings.button_background_color
  assign btn_text_color = block.settings.button_text_color

  # Typography overrides
  assign heading_size = block.settings.heading_size
  assign heading_weight = block.settings.heading_weight
  assign text_size = block.settings.text_size
  assign line_height = block.settings.line_height

  # Spacing overrides
  assign padding = block.settings.padding | default: 24
  assign gap = block.settings.internal_gap
  assign border_width = block.settings.border_width
  assign border_radius = block.settings.border_radius | default: 12
%}

<div
  class="block-card{% if show_bg %} block-card--has-bg{% endif %} block-card--align-{{ alignment }}"
  {{ block.shopify_attributes }}
  style="
    {% if show_bg %}
      --block-bg: {{ bg_color }};
      --block-padding: {{ padding }}px;
      --block-radius: {{ border_radius }}px;
    {% endif %}
    {% if heading_color != blank %}--block-heading-color: {{ heading_color }};{% endif %}
    {% if text_color != blank %}--block-text-color: {{ text_color }};{% endif %}
    {% if border_color != blank %}--block-border-color: {{ border_color }};{% endif %}
    {% if heading_size != blank %}--block-heading-size: {{ heading_size }}px;{% endif %}
    {% if heading_weight != blank %}--block-heading-weight: {{ heading_weight }};{% endif %}
    {% if text_size != blank %}--block-text-size: {{ text_size }}px;{% endif %}
    {% if line_height != blank %}--block-line-height: {{ line_height }};{% endif %}
    {% if gap != blank %}--block-gap: {{ gap }}px;{% endif %}
    {% if border_width != blank %}--block-border-width: {{ border_width }}px;{% endif %}
  "
>
  {% if card_heading != blank %}
    <h3 class="block-card__heading">{{ card_heading | escape }}</h3>
  {% endif %}

  {% if card_content != blank %}
    <div class="block-card__content rte">{{ card_content }}</div>
  {% endif %}

  {% if btn_text != blank and btn_link != blank %}
    <a
      href="{{ btn_link }}"
      class="block-card__button button"
      style="
        {% if btn_bg_color != blank %}background-color: {{ btn_bg_color }};{% endif %}
        {% if btn_text_color != blank %}color: {{ btn_text_color }};{% endif %}
      "
    >
      {{ btn_text | escape }}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .block-card {
    display: flex;
    flex-direction: column;
    gap: var(--block-gap, 16px);
    border: var(--block-border-width, 0) solid var(--block-border-color, transparent);
  }

  .block-card--has-bg {
    background: var(--block-bg, #f9f9f9);
    padding: var(--block-padding, 24px);
    border-radius: var(--block-radius, 12px);
  }

  .block-card--align-left {
    text-align: left;
    align-items: flex-start;
  }

  .block-card--align-center {
    text-align: center;
    align-items: center;
  }

  .block-card--align-right {
    text-align: right;
    align-items: flex-end;
  }

  .block-card__heading {
    font-family: var(--font-heading-family);
    font-size: var(--block-heading-size, clamp(1.125rem, 3vw, 1.5rem));
    font-weight: var(--block-heading-weight, 600);
    color: var(--block-heading-color, inherit);
    margin: 0;
    line-height: 1.3;
  }

  .block-card__content {
    font-family: var(--font-body-family);
    font-size: var(--block-text-size, 1rem);
    line-height: var(--block-line-height, 1.6);
    color: var(--block-text-color, inherit);
  }

  .block-card__content p {
    margin: 0;
  }

  .block-card__content p + p {
    margin-top: 1em;
  }

  .block-card__button {
    display: inline-block;
    margin-top: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Card",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "header",
      "content": "Card Style"
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "Show Background",
      "default": true
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Color Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color"
    },
    {
      "type": "header",
      "content": "Typography Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "info": "Default: responsive 18-24px"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "info": "Default: 16px"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Spacing Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Card Padding",
      "min": 12,
      "max": 60,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "internal_gap",
      "label": "Internal Gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "info": "Space between elements. Default: 16px"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Card"
    }
  ]
}
{% endschema %}
