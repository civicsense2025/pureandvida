{%- comment -%}
  Theme Block: Collapsible Row
  ----------------------------
  Accordion-style collapsible content with icon, title, rich content, and optional button.
{%- endcomment -%}

{%- liquid
  assign is_open = block.settings.open_by_default | default: false
  assign row_pad = block.settings.row_padding | default: 16
  assign row_bg = block.settings.row_background
  assign row_border_clr = block.settings.border_color
  assign row_border_rad = block.settings.border_radius | default: 4
  assign ttl_size = block.settings.title_size | default: 16
  assign ttl_weight = block.settings.title_weight | default: 500
  assign ttl_color = block.settings.title_color
  assign cnt_padding = block.settings.content_padding | default: 16
  assign cnt_bg = block.settings.content_background
  assign cnt_color = block.settings.content_color
-%}

<details
  class="collapsible-row"
  {% if is_open %}open{% endif %}
  {{ block.shopify_attributes }}
>
  <summary
    class="collapsible-row__header"
    style="
      padding: {{ row_pad }}px;
      {% if row_bg != blank %}background-color: {{ row_bg }};{% endif %}
      {% if row_border_clr != blank %}border-color: {{ row_border_clr }};{% endif %}
      border-radius: {{ row_border_rad }}px;
    "
  >
    <div class="collapsible-row__header-content">
      {%- if block.settings.icon != blank -%}
        <span class="collapsible-row__icon" aria-hidden="true">{{ block.settings.icon }}</span>
      {%- elsif block.settings.icon_image != blank -%}
        <img
          src="{{ block.settings.icon_image | image_url: width: 48 }}"
          alt=""
          class="collapsible-row__icon-image"
          width="24"
          height="24"
        >
      {%- endif -%}
      <span
        class="collapsible-row__title"
        style="
          {% if ttl_color != blank %}color: {{ ttl_color }};{% endif %}
          font-size: {{ ttl_size }}px;
          font-weight: {{ ttl_weight }};
        "
      >
        {{ block.settings.heading | escape }}
      </span>
    </div>
    <span class="collapsible-row__toggle" aria-hidden="true">
      <span class="toggle-icon toggle-icon--plus">+</span>
    </span>
  </summary>
  <div
    class="collapsible-row__content"
    style="
      padding: {{ cnt_padding }}px;
      {% if cnt_bg != blank %}background-color: {{ cnt_bg }};{% endif %}
      {% if cnt_color != blank %}color: {{ cnt_color }};{% endif %}
    "
  >
    {%- if block.settings.row_content != blank -%}
      <div class="collapsible-row__richtext rte">
        {{ block.settings.row_content }}
      </div>
    {%- endif -%}

    {%- if block.settings.page != blank -%}
      <div class="collapsible-row__page-content rte">
        {{ block.settings.page.content }}
      </div>
    {%- endif -%}

    {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
      <a
        href="{{ block.settings.button_link }}"
        class="collapsible-row__button button"
        style="
          {% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %}
          {% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}
        "
      >
        {{ block.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</details>

{% stylesheet %}
  .collapsible-row {
    margin: 0;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .collapsible-row + .collapsible-row {
    margin-top: -1px;
  }

  .collapsible-row__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    transition: all 0.3s ease;
    min-height: 48px;
    gap: 16px;
  }

  .collapsible-row__header::-webkit-details-marker {
    display: none;
  }

  .collapsible-row__header:hover {
    opacity: 0.85;
  }

  .collapsible-row__header-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .collapsible-row__icon {
    font-size: 1.25rem;
  }

  .collapsible-row__icon-image {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .collapsible-row__title {
    flex: 1;
  }

  .collapsible-row__toggle {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    font-size: 1.5rem;
  }

  .collapsible-row[open] .collapsible-row__toggle {
    transform: rotate(45deg);
  }

  .collapsible-row__content {
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .collapsible-row__richtext p:first-child {
    margin-top: 0;
  }

  .collapsible-row__richtext p:last-child {
    margin-bottom: 0;
  }

  .collapsible-row__button {
    margin-top: 16px;
    display: inline-block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collapsible Row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collapsible heading"
    },
    {
      "type": "richtext",
      "id": "row_content",
      "label": "Content",
      "default": "<p>Collapsible content goes here.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "Page Content",
      "info": "Optional: Include content from a page"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by Default",
      "default": false
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Emoji Icon",
      "info": "Optional emoji or symbol"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image",
      "info": "Optional image icon (24x24px recommended)"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Header Padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content Padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 16,
      "step": 2,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "row_background",
      "label": "Header Background"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content Background"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Text Color"
    }
  ],
  "presets": [
    {
      "name": "Collapsible Row"
    }
  ]
}
{% endschema %}
