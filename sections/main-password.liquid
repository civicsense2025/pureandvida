{% liquid
  # @description Password page section
  # Displays password protection form for password-protected stores
%}

<div class="page-width" style="padding: 60px 20px; text-align: center; max-width: 500px; margin: 0 auto;">
  <h1 class="h1" style="margin-bottom: 20px;">{{ shop.name | escape }}</h1>
  <p style="margin-bottom: 30px;">This store is password protected. Please enter the password to continue.</p>
  
  {%- form 'storefront_password', class: 'password-form' -%}
    <div style="margin-bottom: 20px;">
      <input type="password" name="password" placeholder="Password" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px;">
    </div>
    <button type="submit" style="width: 100%; padding: 12px; background: #000; color: #fff; border: none; border-radius: 4px; cursor: pointer;">Enter</button>
  {%- endform -%}
  
  {%- if form.errors -%}
    <div style="margin-top: 20px; color: #d00;">
      {{ form.errors | default_errors }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Password"
    }
  ]
}
{% endschema %}

