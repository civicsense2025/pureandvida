{%- comment -%}
  Block Ingredient Snippet
  ------------------------
  Reusable ingredient item with image, name, description, and optional benefit tags.
  Optimized for ingredients section display.

  Parameters:
    Required:
    - block: The block object containing settings

    Block Settings Expected:
    - block.settings.image: Image picker for ingredient
    - block.settings.image_asset: Alternative asset filename
    - block.settings.name: Ingredient name
    - block.settings.description: Ingredient description
    - block.settings.benefit_tags: Optional benefit badges (richtext)
    - block.settings.name_color: Override name color (optional)
    - block.settings.description_color: Override description color (optional)

    Optional Parameters:
    - image_size: Image width for srcset (default: 400)
    - show_shopify_attributes: true/false (default: true)

  Usage:
    {% render 'block-ingredient', block: block %}

  For settings mode (non-block):
    {% render 'block-ingredient',
      image: section.settings.ingredient_1_image,
      name: section.settings.ingredient_1_name,
      description: section.settings.ingredient_1_description
    %}
{%- endcomment -%}

{%- liquid
  assign img_size = image_size | default: 400
  assign show_attrs = show_shopify_attributes | default: true

  # Support both block mode and direct settings mode
  if block
    assign ingredient_image = block.settings.image
    assign ingredient_image_asset = block.settings.image_asset
    assign ingredient_name = block.settings.name
    assign ingredient_description = block.settings.description
    assign ingredient_benefit_tags = block.settings.benefit_tags
    assign ingredient_name_color = block.settings.name_color
    assign ingredient_description_color = block.settings.description_color
  else
    assign ingredient_image = image
    assign ingredient_image_asset = image_asset
    assign ingredient_name = name
    assign ingredient_description = description
    assign ingredient_benefit_tags = benefit_tags
    assign ingredient_name_color = name_color
    assign ingredient_description_color = description_color
  endif
-%}

<div class="block-ingredient" {% if block and show_attrs %}{{ block.shopify_attributes }}{% endif %}>
  {%- if ingredient_image != blank -%}
    <div class="block-ingredient__image">
      <img
        src="{{ ingredient_image | image_url: width: img_size }}"
        srcset="
          {{ ingredient_image | image_url: width: 200 }} 200w,
          {{ ingredient_image | image_url: width: 300 }} 300w,
          {{ ingredient_image | image_url: width: img_size }} {{ img_size }}w
        "
        sizes="(max-width: 480px) 50vw, (max-width: 768px) 33vw, 20vw"
        alt="{{ ingredient_name | escape }}"
        loading="lazy"
        width="{{ ingredient_image.width }}"
        height="{{ ingredient_image.height }}"
      >
    </div>
  {%- elsif ingredient_image_asset != blank -%}
    <div class="block-ingredient__image">
      <img
        src="{{ ingredient_image_asset | asset_url }}"
        alt="{{ ingredient_name | escape }}"
        loading="lazy"
      >
    </div>
  {%- endif -%}

  {%- if ingredient_name != blank -%}
    <h3
      class="block-ingredient__name"
      {% if ingredient_name_color != blank %}style="color: {{ ingredient_name_color }};"{% endif %}
    >
      {{ ingredient_name | escape }}
    </h3>
  {%- endif -%}

  {%- if ingredient_description != blank -%}
    <p
      class="block-ingredient__description"
      {% if ingredient_description_color != blank %}style="color: {{ ingredient_description_color }};"{% endif %}
    >
      {{ ingredient_description }}
    </p>
  {%- endif -%}

  {%- if ingredient_benefit_tags != blank -%}
    <div class="block-ingredient__tags">
      {{ ingredient_benefit_tags }}
    </div>
  {%- endif -%}
</div>

<style>
  .block-ingredient {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .block-ingredient__image {
    margin-bottom: var(--spacing-md, 16px);
    width: 100%;
    max-width: 200px;
  }

  .block-ingredient__image img {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius-sm, 8px);
  }

  .block-ingredient__name {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 600;
    margin: 0 0 var(--spacing-sm, 8px);
    line-height: 1.3;
  }

  .block-ingredient__description {
    font-size: clamp(0.813rem, 2vw, 0.938rem);
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-secondary, inherit);
    opacity: 0.85;
  }

  .block-ingredient__tags {
    margin-top: var(--spacing-sm, 8px);
    font-size: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
  }

  .block-ingredient__tags span,
  .block-ingredient__tags p {
    display: inline-block;
    background: var(--color-primary-light, rgba(44, 85, 48, 0.1));
    color: var(--color-primary, #2c5530);
    padding: 2px 8px;
    border-radius: 4px;
    margin: 0;
  }
</style>
