{%- liquid
  # @description Image SEO helper for automatic alt text generation and optimization
  # Supports custom alt text via metafields with intelligent fallbacks
  # Includes width/height attributes for CLS prevention and lazy loading
  # @param image {Object} - Image object (required)
  # @param alt_text {String} - Custom alt text override (optional)
  # @param width {Number} - Image width (optional, default: 1200)
  # @param height {Number} - Image height (optional, calculated from aspect ratio if not provided)
  # @param lazy_load {Boolean} - Enable lazy loading (default: true for below-fold images)
  # @param class {String} - Additional CSS classes (optional)
  # @param sizes {String} - Responsive image sizes attribute (optional)
  # @example
  #   {% render 'image-seo', image: product.featured_media, alt_text: 'Custom alt text', width: 800 %}
-%}

{%- if image == blank -%}
  <!-- Image SEO: No image provided -->
{%- else -%}
  
  assign image_width = width | default: 1200
  assign image_height = height
  
  if image_height == blank and image.aspect_ratio != blank
    assign image_height = image_width | divided_by: image.aspect_ratio | round
  endif
  
  assign image_alt = alt_text
  
  if image_alt == blank
    if image.alt != blank
      assign image_alt = image.alt
    elsif template.name == 'product' and product
      if product.metafields.seo.image_alt != blank
        assign image_alt = product.metafields.seo.image_alt
      else
        assign image_alt = product.title | append: ' - ' | append: shop.name
      endif
    elsif template.name == 'collection' and collection
      if collection.metafields.seo.image_alt != blank
        assign image_alt = collection.metafields.seo.image_alt
      else
        assign image_alt = collection.title | append: ' - ' | append: shop.name
      endif
    elsif template.name == 'article' and article
      if article.metafields.seo.image_alt != blank
        assign image_alt = article.metafields.seo.image_alt
      else
        assign image_alt = article.title | append: ' - ' | append: shop.name
      endif
    elsif template.name == 'page' and page
      if page.metafields.seo.image_alt != blank
        assign image_alt = page.metafields.seo.image_alt
      else
        assign image_alt = page.title | append: ' - ' | append: shop.name
      endif
    else
      assign image_alt = shop.name
    endif
  endif
  
  assign lazy_loading = lazy_load
  if lazy_loading == blank
    assign lazy_loading = true
  endif
  
  assign image_sizes = sizes | default: '(min-width: 1200px) 1200px, (min-width: 768px) 768px, 100vw'
  
  assign image_classes = class | default: ''
  if lazy_loading
    assign image_classes = image_classes | append: ' lazy-load'
  endif
-%}

{%- comment -%} Generate responsive image srcset {%- endcomment -%}
{%- liquid
  assign srcset_sizes = '375,768,1200,1920' | split: ','
  assign srcset_parts = ''
  
  for size in srcset_sizes
    assign size_num = size | plus: 0
    if size_num <= image_width
      if srcset_parts != blank
        assign srcset_parts = srcset_parts | append: ', '
      endif
      assign srcset_parts = srcset_parts | append: image | image_url: width: size_num | append: ' ' | append: size_num | append: 'w'
    endif
  endfor
-%}

<img 
  src="{{ image | image_url: width: image_width }}"
  {%- if srcset_parts != blank -%}
  srcset="{{ srcset_parts }}"
  sizes="{{ image_sizes }}"
  {%- endif -%}
  alt="{{ image_alt | escape }}"
  {%- if image_width != blank -%}
  width="{{ image_width }}"
  {%- endif -%}
  {%- if image_height != blank -%}
  height="{{ image_height }}"
  {%- endif -%}
  {%- if lazy_loading -%}
  loading="lazy"
  decoding="async"
  {%- else -%}
  loading="eager"
  {%- endif -%}
  {%- if image_classes != blank -%}
  class="{{ image_classes }}"
  {%- endif -%}
  {%- if image.focal_point != blank -%}
  style="object-position: {{ image.focal_point }}"
  {%- endif -%}
>

{%- comment -%} WebP format support (if available) {%- endcomment -%}
{%- if settings.seo_enable_webp -%}
<picture>
  <source 
    srcset="{{ image | image_url: width: image_width, format: 'webp' }}"
    type="image/webp"
    {%- if lazy_loading -%}
    loading="lazy"
    {%- endif -%}
  >
  <img 
    src="{{ image | image_url: width: image_width }}"
    alt="{{ image_alt | escape }}"
    {%- if image_width != blank -%}
    width="{{ image_width }}"
    {%- endif -%}
    {%- if image_height != blank -%}
    height="{{ image_height }}"
    {%- endif -%}
    {%- if lazy_loading -%}
    loading="lazy"
    decoding="async"
    {%- else -%}
    loading="eager"
    {%- endif -%}
    {%- if image_classes != blank -%}
    class="{{ image_classes }}"
    {%- endif -%}
  >
</picture>
{%- endif -%}
{%- endif -%}
