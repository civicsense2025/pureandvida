        "default": 12
      },
      {
        "type": "range",
        "id": "radius_xl",
        "label": "Extra Large Radius (px)",
        "min": 0,
        "max": 48,
        "step": 4,
        "default": 16
      }
    ]
  },
  {
    "name": "Animations & Transitions",
    "settings": [
      {
        "type": "range",
        "id": "transition_fast",
        "label": "Fast Transition (ms)",
        "min": 100,
        "max": 300,
        "step": 50,
        "default": 150
      },
      {
        "type": "range",
        "id": "transition_base",
        "label": "Base Transition (ms)",
        "min": 200,
        "max": 500,
        "step": 50,
        "default": 250
      },
      {
        "type": "range",
        "id": "transition_slow",
        "label": "Slow Transition (ms)",
        "min": 300,
        "max": 800,
        "step": 50,
        "default": 350
      },
      {
        "type": "range",
        "id": "animation_duration",
        "label": "Animation Duration (ms)",
        "min": 200,
        "max": 1000,
        "step": 100,
        "default": 300
      }
    ]
  },
  {
