{% comment %}
  Theme Block: FAQ Item
  ---------------------
  Accordion-style FAQ item using details/summary pattern.
  Question/answer format with grouped override settings.
{% endcomment %}

{% liquid
  # Content
  assign faq_question = block.settings.question
  assign faq_answer = block.settings.answer
  assign faq_open = block.settings.open_by_default | default: false
  assign faq_icon_text = block.settings.icon_text | default: '+'

  # Color overrides
  assign question_bg = block.settings.question_background
  assign question_color = block.settings.question_color
  assign answer_bg = block.settings.answer_background
  assign answer_color = block.settings.answer_color
  assign border_color = block.settings.border_color
  assign icon_color = block.settings.icon_color

  # Typography overrides
  assign question_size = block.settings.question_size
  assign question_weight = block.settings.question_weight
  assign answer_size = block.settings.answer_size
  assign answer_line_height = block.settings.answer_line_height
  assign icon_size = block.settings.icon_size | default: 24

  # Spacing overrides
  assign question_padding = block.settings.question_padding
  assign answer_padding = block.settings.answer_padding
  assign border_radius = block.settings.border_radius
  assign border_width = block.settings.border_width
%}

<details
  class="block-faq-item"
  {% if faq_open %}open{% endif %}
  {{ block.shopify_attributes }}
  style="
    {% if border_color != blank %}--block-border-color: {{ border_color }};{% endif %}
    {% if border_radius != blank %}--block-border-radius: {{ border_radius }}px;{% endif %}
    {% if border_width != blank %}--block-border-width: {{ border_width }}px;{% endif %}
  "
>
  <summary
    class="block-faq-item__question"
    style="
      {% if question_bg != blank %}--block-question-bg: {{ question_bg }};{% endif %}
      {% if question_color != blank %}--block-question-color: {{ question_color }};{% endif %}
      {% if question_size != blank %}--block-question-size: {{ question_size }}px;{% endif %}
      {% if question_weight != blank %}--block-question-weight: {{ question_weight }};{% endif %}
      {% if question_padding != blank %}--block-question-padding: {{ question_padding }}px;{% endif %}
      {% if icon_color != blank %}--block-icon-color: {{ icon_color }};{% endif %}
      --block-icon-size: {{ icon_size }}px;
    "
  >
    <span class="block-faq-item__question-text">{{ faq_question | escape }}</span>
    <span class="block-faq-item__icon" aria-hidden="true">
      {{ faq_icon_text }}
    </span>
  </summary>
  <div
    class="block-faq-item__answer"
    style="
      {% if answer_bg != blank %}--block-answer-bg: {{ answer_bg }};{% endif %}
      {% if answer_color != blank %}--block-answer-color: {{ answer_color }};{% endif %}
      {% if answer_size != blank %}--block-answer-size: {{ answer_size }}px;{% endif %}
      {% if answer_line_height != blank %}--block-answer-line-height: {{ answer_line_height }};{% endif %}
      {% if answer_padding != blank %}--block-answer-padding: {{ answer_padding }}px;{% endif %}
    "
  >
    <div class="block-faq-item__answer-content rte">
      {% if faq_answer != blank %}
        {{ faq_answer }}
      {% endif %}
    </div>
  </div>
</details>

{% stylesheet %}
  .block-faq-item {
    margin: 0;
    border: var(--block-border-width, 1px) solid var(--block-border-color, rgba(0,0,0,0.1));
    border-radius: var(--block-border-radius, 0);
    overflow: hidden;
  }

  .block-faq-item + .block-faq-item {
    margin-top: -1px;
  }

  .block-faq-item__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    transition: all 0.3s ease;
    min-height: 48px;
    gap: 16px;
    padding: var(--block-question-padding, 15px);
    background: var(--block-question-bg, transparent);
    color: var(--block-question-color, inherit);
    font-size: var(--block-question-size, 18px);
    font-weight: var(--block-question-weight, 500);
  }

  .block-faq-item__question::-webkit-details-marker {
    display: none;
  }

  .block-faq-item__question:hover {
    opacity: 0.85;
  }

  .block-faq-item__question-text {
    flex: 1;
  }

  .block-faq-item__icon {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    font-size: var(--block-icon-size, 24px);
    color: var(--block-icon-color, inherit);
  }

  .block-faq-item[open] .block-faq-item__icon {
    transform: rotate(45deg);
  }

  .block-faq-item__answer {
    transition: all 0.3s ease;
    padding: var(--block-answer-padding, 15px);
    background: var(--block-answer-bg, transparent);
    color: var(--block-answer-color, inherit);
    font-size: var(--block-answer-size, 16px);
    line-height: var(--block-answer-line-height, 1.6);
    border-top: var(--block-border-width, 1px) solid var(--block-border-color, rgba(0,0,0,0.1));
  }

  .block-faq-item__answer-content p {
    margin: 0;
  }

  .block-faq-item__answer-content p + p {
    margin-top: 1em;
  }

  @media screen and (max-width: 767px) {
    .block-faq-item__question {
      font-size: clamp(0.9rem, 2.5vw, var(--block-question-size, 18px)) !important;
      padding: clamp(12px, 3vw, var(--block-question-padding, 15px)) !important;
    }

    .block-faq-item__answer {
      padding: clamp(12px, 3vw, var(--block-answer-padding, 15px)) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ Item",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "What is your question?"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "Answer",
      "default": "<p>Your answer goes here.</p>"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by Default",
      "default": false
    },
    {
      "type": "text",
      "id": "icon_text",
      "label": "Toggle Icon",
      "default": "+",
      "info": "Symbol shown on the toggle button"
    },
    {
      "type": "header",
      "content": "Color Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "color",
      "id": "question_background",
      "label": "Question Background",
      "default": ""
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question Text Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "answer_background",
      "label": "Answer Background",
      "default": ""
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer Text Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": ""
    },
    {
      "type": "header",
      "content": "Typography Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Question Font Size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "info": "Default: 18px"
    },
    {
      "type": "select",
      "id": "question_weight",
      "label": "Question Font Weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "answer_size",
      "label": "Answer Font Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "info": "Default: 16px"
    },
    {
      "type": "range",
      "id": "answer_line_height",
      "label": "Answer Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 16,
      "max": 36,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "question_padding",
      "label": "Question Padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "info": "Default: 15px"
    },
    {
      "type": "range",
      "id": "answer_padding",
      "label": "Answer Padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "info": "Default: 15px"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "info": "Default: 1px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "info": "Default: 0"
    }
  ],
  "presets": [
    {
      "name": "FAQ Item"
    }
  ]
}
{% endschema %}
