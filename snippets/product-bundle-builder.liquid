{%- liquid
  # @description Renders bundle builder UI for product bundles and upsells
  # @param product {Product} - The product object
  # @param block {Block} - The block object for settings
  # @example
  #   {% render 'product-bundle-builder', product: product, block: block %}
-%}

{%- liquid
  assign bundle_products = product.metafields.custom.bundle_products
  assign bundle_product_ids = bundle_products | split: ','
-%}

{%- if bundle_product_ids.size > 0 -%}
  <div class="product-bundle-builder" data-bundle-builder>
    <h3 class="bundle-builder__title">{{ block.settings.bundle_title | default: 'Complete Your Bundle' }}</h3>
    <p class="bundle-builder__description">{{ block.settings.bundle_description | default: 'Add these products to save more' }}</p>
    
    <div class="bundle-builder__products">
      {%- for product_id in bundle_product_ids -%}
        {%- assign bundle_product = all_products[product_id] -%}
        {%- if bundle_product != blank -%}
          <div class="bundle-builder__item" data-bundle-item="{{ bundle_product.id }}">
            <label>
              <input 
                type="checkbox" 
                data-bundle-checkbox
                data-product-id="{{ bundle_product.id }}"
                data-variant-id="{{ bundle_product.selected_or_first_available_variant.id }}"
                data-price="{{ bundle_product.selected_or_first_available_variant.price }}"
              >
              <div class="bundle-item__image">
                {%- if bundle_product.featured_media -%}
                  <img src="{{ bundle_product.featured_media | image_url: width: 100 }}" alt="{{ bundle_product.title }}" loading="lazy">
                {%- endif -%}
              </div>
              <div class="bundle-item__info">
                <span class="bundle-item__title">{{ bundle_product.title }}</span>
                <span class="bundle-item__price">{{ bundle_product.selected_or_first_available_variant.price | money }}</span>
              </div>
            </label>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bundle-builder__summary">
      <div class="bundle-summary__total">
        <span class="bundle-summary__label">{{ 'products.product.bundle.total' | t | default: 'Bundle Total:' }}</span>
        <span class="bundle-summary__price" data-bundle-total>{{ product.selected_or_first_available_variant.price | money }}</span>
      </div>
      {%- if block.settings.show_bundle_savings -%}
        <div class="bundle-summary__savings" data-bundle-savings hidden>
          <span class="bundle-summary__label">{{ 'products.product.bundle.savings' | t | default: 'You Save:' }}</span>
          <span class="bundle-summary__price" data-bundle-savings-amount>$0.00</span>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

