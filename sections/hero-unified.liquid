{% liquid
  # @description Unified Hero Section - Consolidates all hero section variants into one flexible component
  # Supports 4 layout regions (header, media, content, footer), 9 block types, and 6 presets
  # Uses external CSS/JS for performance

  # Layout class mapping
  case section.settings.layout
    when 'split-left'
      assign layout_class = 'hero-unified--split hero-unified--media-left'
    when 'split-right'
      assign layout_class = 'hero-unified--split hero-unified--media-right'
    when 'stacked'
      assign layout_class = 'hero-unified--stacked'
    when 'overlay'
      assign layout_class = 'hero-unified--overlay'
    else
      assign layout_class = 'hero-unified--split hero-unified--media-left'
  endcase

  # Height class
  case section.settings.section_height
    when 'small'
      assign height_class = 'hero-unified--height-small'
    when 'medium'
      assign height_class = 'hero-unified--height-medium'
    when 'large'
      assign height_class = 'hero-unified--height-large'
    when 'viewport'
      assign height_class = 'hero-unified--height-viewport'
    else
      assign height_class = 'hero-unified--height-auto'
  endcase

  # Filter blocks by position
  assign header_blocks = section.blocks | where: 'settings.position', 'header'
  assign media_blocks = section.blocks | where: 'settings.position', 'media'
  assign content_blocks = section.blocks | where: 'settings.position', 'content'
  assign footer_blocks = section.blocks | where: 'settings.position', 'footer'

  # Check if quantity selector is used (for conditional JS loading)
  assign needs_quantity_js = false
  for block in section.blocks
    if block.type == 'button' and block.settings.show_quantity
      assign needs_quantity_js = true
      break
    endif
  endfor
%}

{{ 'hero-unified.css' | asset_url | stylesheet_tag }}

<section
  id="hero-{{ section.id }}"
  class="hero-unified {{ layout_class }} {{ height_class }} color-{{ section.settings.color_scheme }}"
  style="
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hero-media-width: {{ section.settings.media_width }}%;
    {% if section.settings.background_color != blank %}--hero-bg-color: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.text_color != blank %}--hero-text-color: {{ section.settings.text_color }};{% endif %}
    {% if section.settings.overlay_opacity > 0 %}--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};{% endif %}
  "
  {% if request.design_mode %}data-section-type="hero-unified" data-section-id="{{ section.id }}"{% endif %}
>
  {%- comment -%} Background Image {%- endcomment -%}
  {% if section.settings.background_image != blank %}
    <div class="hero-unified__background">
      {{ section.settings.background_image | image_url: width: 1920 | image_tag:
        class: 'hero-unified__bg-image',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw'
      }}
      {% if section.settings.show_overlay %}
        <div class="hero-unified__overlay"></div>
      {% endif %}
    </div>
  {% endif %}

  {%- comment -%} Design Mode Controls {%- endcomment -%}
  {% if request.design_mode %}
    <div class="hero-unified__editor-controls">
      <span class="hero-unified__editor-badge">HERO</span>
      <span class="hero-unified__editor-info">{{ section.settings.layout | replace: '-', ' ' | capitalize }}</span>
    </div>
  {% endif %}

  <div class="hero-unified__container page-width">
    {%- comment -%} Header Region {%- endcomment -%}
    {% if header_blocks.size > 0 or request.design_mode %}
      <div class="hero-unified__header" {% if request.design_mode %}data-region="header"{% endif %}>
        {% for block in header_blocks %}
          {% render 'hero-block', block: block, product: section.settings.product %}
        {% endfor %}
        {% if header_blocks.size == 0 and request.design_mode %}
          <div class="hero-unified__empty-region">Header region - drag blocks here</div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Main Grid (Media + Content) {%- endcomment -%}
    <div class="hero-unified__main">
      {%- comment -%} Media Region {%- endcomment -%}
      {% if media_blocks.size > 0 or section.settings.layout contains 'split' %}
        <div class="hero-unified__media" {% if request.design_mode %}data-region="media"{% endif %}>
          {% for block in media_blocks %}
            {% render 'hero-block', block: block, product: section.settings.product %}
          {% endfor %}
          {% if media_blocks.size == 0 and request.design_mode %}
            <div class="hero-unified__empty-region">Media region - add images here</div>
          {% endif %}
        </div>
      {% endif %}

      {%- comment -%} Content Region {%- endcomment -%}
      <div class="hero-unified__content" {% if request.design_mode %}data-region="content"{% endif %} style="text-align: {{ section.settings.content_alignment }};">
        {% for block in content_blocks %}
          {% render 'hero-block', block: block, product: section.settings.product %}
        {% endfor %}
        {% if content_blocks.size == 0 and request.design_mode %}
          <div class="hero-unified__empty-region">Content region - add text, pricing, buttons here</div>
        {% endif %}
      </div>
    </div>

    {%- comment -%} Footer Region {%- endcomment -%}
    {% if footer_blocks.size > 0 or request.design_mode %}
      <div class="hero-unified__footer" {% if request.design_mode %}data-region="footer"{% endif %}>
        {% for block in footer_blocks %}
          {% render 'hero-block', block: block, product: section.settings.product %}
        {% endfor %}
        {% if footer_blocks.size == 0 and request.design_mode %}
          <div class="hero-unified__empty-region">Footer region - add trust signals here</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% if needs_quantity_js %}
  <script src="{{ 'hero-unified.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Hero (Unified)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "A flexible hero section with draggable blocks. Choose a preset to get started, or customize every detail."
    },
    {
      "type": "header",
      "content": "Quick Start"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product",
      "info": "Optional. Enables Add to Cart and pulls pricing automatically."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Style",
      "options": [
        { "value": "split-left", "label": "Split - Media Left" },
        { "value": "split-right", "label": "Split - Media Right" },
        { "value": "stacked", "label": "Stacked - Centered" },
        { "value": "overlay", "label": "Overlay - Text on Image" }
      ],
      "default": "split-left",
      "info": "On mobile, all layouts stack vertically."
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Media Column Width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50,
      "info": "Only applies to split layouts."
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (400px)" },
        { "value": "medium", "label": "Medium (600px)" },
        { "value": "large", "label": "Large (800px)" },
        { "value": "viewport", "label": "Full Viewport" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended: 1920x800px. Works best with overlay enabled."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "info": "Overrides color scheme background."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "info": "Overrides color scheme text color."
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Add dark overlay",
      "default": false,
      "info": "Darkens background for better text readability."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "header", "label": "Header" },
            { "value": "content", "label": "Content" }
          ],
          "default": "header"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Title Text",
          "default": "Your Headline Here"
        },
        {
          "type": "checkbox",
          "id": "show_trademark",
          "label": "Add trademark symbol (TM)",
          "default": false
        },
        {
          "type": "select",
          "id": "divider_style",
          "label": "Divider Style",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "plus", "label": "Plus signs (+++)" },
            { "value": "dots", "label": "Dots (...)" },
            { "value": "line", "label": "Line" }
          ],
          "default": "none"
        },
        {
