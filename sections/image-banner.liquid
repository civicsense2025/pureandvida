{% liquid
  # @description Image banner section with overlay text, heading, description, and call-to-action button
  # Supports separate mobile images and customizable overlay opacity
  # @settings image {Image} - Desktop banner image
  # @settings mobile_image {Image} - Mobile banner image (optional)
  # @settings heading {String} - Banner heading
  # @settings description {String} - Banner description text
  # @settings button_text {String} - CTA button text
  # @settings button_link {URL} - CTA button link
  # @settings overlay_color {Color} - Overlay color
  # @settings overlay_opacity {Number} - Overlay opacity (0-1)
  # @example
  #   Add to index.json or page.json for promotional banners
%}

<section class="image-banner-section" style="position: relative; height: {{ section.settings.banner_height }}px; overflow: hidden;{% if section.settings.section_padding_top > 0 or section.settings.section_padding_bottom > 0 %} margin-top: {{ section.settings.section_padding_top }}px; margin-bottom: {{ section.settings.section_padding_bottom }}px;{% endif %}">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.heading | escape }}" class="image-banner-image image-banner-image--desktop" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
  {%- endif -%}
  {%- if section.settings.mobile_image != blank -%}
    <img src="{{ section.settings.mobile_image | image_url: width: 768 }}" alt="{{ section.settings.heading | escape }}" class="image-banner-image image-banner-image--mobile" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
  {%- elsif section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 768 }}" alt="{{ section.settings.heading | escape }}" class="image-banner-image image-banner-image--mobile" style="width: 100%; height: 100%; object-fit: cover; display: none;" loading="lazy">
  {%- endif -%}
  
  <div class="image-banner-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity }};"></div>
  
  <div class="image-banner-content" style="position: absolute; {% if section.settings.content_position == 'top' %}top: {{ section.settings.content_vertical_offset }}%; transform: translate(-50%, 0);{% elsif section.settings.content_position == 'bottom' %}bottom: {{ section.settings.content_vertical_offset }}%; top: auto; transform: translate(-50%, 0);{% else %}top: 50%; transform: translate(-50%, -50%);{% endif %} left: 50%; text-align: {{ section.settings.text_alignment }}; width: 90%; max-width: {{ section.settings.content_width }}px; z-index: 1; padding: {{ section.settings.content_padding }}px;">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-banner-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} font-size: {{ section.settings.heading_size }}px; font-weight: {{ section.settings.heading_weight }}; margin-bottom: {{ section.settings.heading_spacing }}px; line-height: {{ section.settings.heading_line_height }};">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="image-banner-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %} font-size: {{ section.settings.description_size }}px; margin-bottom: {{ section.settings.description_spacing }}px; line-height: {{ section.settings.description_line_height }};">{{ section.settings.description | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="image-banner-button" style="{% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %} padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px; text-decoration: none; display: inline-block; border-radius: {{ section.settings.button_border_radius }}px; font-size: {{ section.settings.button_text_size }}px; font-weight: {{ section.settings.button_text_weight }}; border: {{ section.settings.button_border_width }}px solid {% if section.settings.button_border_color != blank %}{{ section.settings.button_border_color }}{% else %}transparent{% endif %};">
        {{ section.settings.button_text | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  .image-banner-image--mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .image-banner-section {
      height: {{ section.settings.mobile_banner_height }}px !important;
    }
    
    .image-banner-image--desktop {
      display: none;
    }
    
    .image-banner-image--mobile {
      display: block;
    }
    
    .image-banner-heading {
      font-size: {{ section.settings.mobile_heading_size }}px !important;
    }
    
    .image-banner-description {
      font-size: {{ section.settings.mobile_description_size }}px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional: Different image for mobile devices"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile Heading Size (px)",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "min": 1.0,
      "max": 1.5,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Bottom Spacing (px)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size (px)",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Mobile Description Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Description Bottom Spacing (px)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button Text Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 16
    },
    {
      "type": "select",
      "id": "button_text_weight",
      "label": "Button Text Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Button Padding Vertical (px)",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 15
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Button Padding Horizontal (px)",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius (px)",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 4
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Button Border Width (px)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_vertical_offset",
      "label": "Content Vertical Offset (%)",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 0,
      "info": "Offset from top/bottom when position is set to Top or Bottom"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content Padding (px)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner Height (px)",
      "min": 200,
      "max": 800,
      "step": 50,
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "label": "Mobile Banner Height (px)",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 400
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Max Width (px)",
      "min": 400,
      "max": 1200,
      "step": 50,
      "default": 800
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Padding Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ],
  "templates": ["index", "page", "product", "collection"]
}
{% endschema %}

