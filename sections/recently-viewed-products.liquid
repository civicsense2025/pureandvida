{% liquid
  # @description Recently viewed products section with LocalStorage tracking and carousel display
  # Tracks products viewed by user and displays them in a carousel
  # @settings heading {String} - Section heading
  # @settings products_to_show {Number} - Maximum number of products to display (2-10)
  # @settings enable_carousel {Boolean} - Enable carousel slider
  # @example
  #   Add to product.json or index.json to show recently viewed products
%}

<div class="recently-viewed-products page-width" 
     data-recently-viewed 
     data-products-to-show="{{ section.settings.products_to_show | default: 4 }}"
     style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  {% if section.settings.heading != blank %}
    <h2 class="recently-viewed-products__heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">{{ section.settings.heading | escape }}</h2>
  {% endif %}
  
  <div class="recently-viewed-products__container" data-recently-viewed-container>
    {% comment %} Products will be loaded via JavaScript from LocalStorage {% endcomment %}
    <div class="recently-viewed-products__loading" data-recently-viewed-loading>
      <p>{{ 'products.product.loading' | t | default: 'Loading...' }}</p>
    </div>
    <ul class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down" role="list" data-recently-viewed-grid hidden>
      {% comment %} Products will be inserted here via JavaScript {% endcomment %}
    </ul>
  </div>
</div>

<script>
  (function() {
    const RECENTLY_VIEWED_KEY = 'shopify_recently_viewed';
    const MAX_PRODUCTS = {{ section.settings.products_to_show | default: 4 }};
    const currentProductId = {{ product.id | default: 0 }};
    const container = document.querySelector('[data-recently-viewed]');
    
    if (!container) return;

    // Save current product to recently viewed
    if (currentProductId) {
      let recentlyViewed = JSON.parse(localStorage.getItem(RECENTLY_VIEWED_KEY) || '[]');
      recentlyViewed = recentlyViewed.filter(id => id !== currentProductId);
      recentlyViewed.unshift(currentProductId);
      recentlyViewed = recentlyViewed.slice(0, MAX_PRODUCTS);
      localStorage.setItem(RECENTLY_VIEWED_KEY, JSON.stringify(recentlyViewed));
    }

    // Load and display recently viewed products
    function loadRecentlyViewed() {
      const recentlyViewed = JSON.parse(localStorage.getItem(RECENTLY_VIEWED_KEY) || '[]');
      const productIds = recentlyViewed.filter(id => id !== currentProductId).slice(0, MAX_PRODUCTS);
      
      if (productIds.length === 0) {
        container.style.display = 'none';
        return;
      }

      const grid = container.querySelector('[data-recently-viewed-grid]');
      const loading = container.querySelector('[data-recently-viewed-loading]');
      
      if (!grid) return;

      // Fetch product data
      const productPromises = productIds.map(productId => {
        return fetch(`/products/${productId}?view=card`)
          .then(response => response.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            return doc.querySelector('.product-card, .card-wrapper');
          })
          .catch(() => null);
      });

      Promise.all(productPromises).then(products => {
        if (loading) loading.style.display = 'none';
        
        products.forEach(productHTML => {
          if (productHTML) {
            const li = document.createElement('li');
            li.className = 'grid__item';
            li.innerHTML = productHTML.outerHTML;
            grid.appendChild(li);
          }
        });

        if (grid.children.length > 0) {
          grid.hidden = false;
        } else {
          container.style.display = 'none';
        }
      });
    }

    // Initialize on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadRecentlyViewed);
    } else {
      loadRecentlyViewed();
    }
  })();
</script>

{% schema %}
{
  "name": "Recently Viewed Products",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed Products"
    }
  ]
}
{% endschema %}

