{% comment %}
  Renders individual footer blocks
  Accepts:
  - block: {Object} Block object
  - section: {Object} Section object
{% endcomment %}

{% case block.type %}

  {% when 'logo' %}
    <div class="footer__logo" {{ block.shopify_attributes }}>
      {% render 'logo',
        logo_image: block.settings.logo_image,
        logo_text: block.settings.logo_text,
        logo_width: block.settings.logo_width,
        logo_height: block.settings.logo_width,
        logo_text_size: block.settings.logo_text_size,
        logo_text_color: block.settings.logo_text_color,
        show_plus: block.settings.show_plus,
        logo_link: routes.root_url,
        class_name: 'footer-logo'
      %}
    </div>

  {% when 'link_list' %}
    {% liquid
      # Build column styles
      assign column_style = ''
      assign column_min_width = block.settings.column_width | default: 140
      assign column_style = column_style | append: 'min-width: ' | append: column_min_width | append: 'px;'
      if block.settings.column_background != blank
        assign column_style = column_style | append: 'background-color: ' | append: block.settings.column_background | append: ';'
      endif
      if block.settings.column_padding != blank and block.settings.column_padding > 0
        assign column_style = column_style | append: 'padding: ' | append: block.settings.column_padding | append: 'px;'
      endif
      if block.settings.column_radius != blank and block.settings.column_radius > 0
        assign column_style = column_style | append: 'border-radius: ' | append: block.settings.column_radius | append: 'px;'
      endif
      assign link_gap = block.settings.link_spacing | default: 8
      assign column_style = column_style | append: 'gap: ' | append: link_gap | append: 'px;'

      # Build heading styles
      assign heading_style = ''
      if block.settings.heading_color != blank
        assign heading_style = heading_style | append: 'color: ' | append: block.settings.heading_color | append: ';'
      endif
      assign heading_size = block.settings.heading_size | default: 14
      assign heading_style = heading_style | append: 'font-size: ' | append: heading_size | append: 'px;'
      assign heading_weight = block.settings.heading_weight | default: '600'
      assign heading_style = heading_style | append: 'font-weight: ' | append: heading_weight | append: ';'
      assign heading_transform = block.settings.heading_transform | default: 'uppercase'
      assign heading_style = heading_style | append: 'text-transform: ' | append: heading_transform | append: ';'
      assign heading_margin = block.settings.heading_spacing | default: 12
      assign heading_style = heading_style | append: 'margin-bottom: ' | append: heading_margin | append: 'px;'

      # Build link styles
      assign link_style = ''
      if block.settings.link_color != blank
        assign link_style = link_style | append: 'color: ' | append: block.settings.link_color | append: ';'
      endif
      assign link_size = block.settings.link_size | default: 14
      assign link_style = link_style | append: 'font-size: ' | append: link_size | append: 'px;'
      assign link_weight = block.settings.link_weight | default: '400'
      assign link_style = link_style | append: 'font-weight: ' | append: link_weight | append: ';'
      assign link_transform = block.settings.link_transform | default: 'none'
      assign link_style = link_style | append: 'text-transform: ' | append: link_transform | append: ';'
      if block.settings.link_letter_spacing != blank and block.settings.link_letter_spacing > 0
        assign letter_spacing_em = block.settings.link_letter_spacing | divided_by: 100.0
        assign link_style = link_style | append: 'letter-spacing: ' | append: letter_spacing_em | append: 'em;'
      endif
      assign link_underline = block.settings.link_underline | default: 'hover'
      if link_underline == 'none'
        assign link_style = link_style | append: 'text-decoration: none;'
      elsif link_underline == 'always'
        assign link_style = link_style | append: 'text-decoration: underline;'
      else
        assign link_style = link_style | append: 'text-decoration: none;'
      endif

      # Generate unique ID for hover styles
      assign block_id = block.id | replace: '-', ''
    %}

    {% if block.settings.link_hover_color != blank or link_underline == 'hover' %}
      <style>
        .footer__link-{{ block_id }}:hover {
          {% if block.settings.link_hover_color != blank %}color: {{ block.settings.link_hover_color }} !important;{% endif %}
          {% if link_underline == 'hover' %}text-decoration: underline !important;{% endif %}
        }
      </style>
    {% endif %}

    <div class="footer__column" style="{{ column_style }}" {{ block.shopify_attributes }}>
      {% if block.settings.heading != blank %}
        <h3 class="footer__heading" style="{{ heading_style }}">
          {{ block.settings.heading | escape }}
        </h3>
      {% endif %}
      {% if block.settings.menu != blank %}
        {% for link in block.settings.menu.links %}
          <a href="{{ link.url }}" class="footer__link footer__link-{{ block_id }}" style="{{ link_style }}">
            {{ link.title | escape }}
          </a>
        {% endfor %}
      {% endif %}
      {% if block.settings.custom_links != blank %}
        {% assign links = block.settings.custom_links | newline_to_br | split: '<br />' %}
        {% for link_line in links %}
          {% assign link_parts = link_line | split: '|' %}
          {% if link_parts.size == 2 %}
            <a href="{{ link_parts[0] | strip }}" class="footer__link footer__link-{{ block_id }}" style="{{ link_style }}">
              {{ link_parts[1] | strip | escape }}
            </a>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>

  {% when 'newsletter' %}
    <div class="footer__newsletter" {{ block.shopify_attributes }}>
      {% if block.settings.heading != blank %}
        <h3 class="footer__heading"{% if block.settings.heading_color != blank %} style="color: {{ block.settings.heading_color }};"{% endif %}>
          {{ block.settings.heading | escape }}
        </h3>
      {% endif %}
      {% if block.settings.description != blank %}
        <p{% if block.settings.text_color != blank %} style="color: {{ block.settings.text_color }};"{% endif %}>
          {{ block.settings.description }}
        </p>
      {% endif %}
      {% form 'customer', class: 'footer__newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ block.settings.placeholder | default: 'Enter your email' }}" required aria-label="{{ 'newsletter.email' | t | default: 'Email' }}">
        <button type="submit"{% if block.settings.button_color != blank or block.settings.button_text_color != blank %} style="{% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %}{% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}"{% endif %}>
          {{ block.settings.button_text | default: 'Subscribe' }}
        </button>
      {% endform %}
    </div>

  {% when 'social_icons' %}
    <div class="footer__social-wrapper" {{ block.shopify_attributes }}>
      {% if block.settings.heading != blank %}
        <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
      {% endif %}
      <div class="footer__social">
        {% liquid
          assign icon_style = ''
          if block.settings.icon_color != blank
            assign icon_style = icon_style | append: 'color: ' | append: block.settings.icon_color | append: ';'
          endif
          if block.settings.icon_background != blank
            assign icon_style = icon_style | append: 'background-color: ' | append: block.settings.icon_background | append: ';'
          endif
        %}

        {% if block.settings.facebook != blank %}
          <a href="{{ block.settings.facebook }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {% endif %}

        {% if block.settings.instagram != blank %}
          <a href="{{ block.settings.instagram }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        {% endif %}

        {% if block.settings.twitter != blank %}
          <a href="{{ block.settings.twitter }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {% endif %}

        {% if block.settings.youtube != blank %}
          <a href="{{ block.settings.youtube }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        {% endif %}

        {% if block.settings.tiktok != blank %}
          <a href="{{ block.settings.tiktok }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
        {% endif %}

        {% if block.settings.pinterest != blank %}
          <a href="{{ block.settings.pinterest }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="Pinterest">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
          </a>
        {% endif %}

        {% if block.settings.linkedin != blank %}
          <a href="{{ block.settings.linkedin }}" target="_blank" rel="noopener noreferrer" class="footer__social-link"{% if icon_style != blank %} style="{{ icon_style }}"{% endif %} aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

  {% when 'payment_icons' %}
    <div class="footer__payment-wrapper" {{ block.shopify_attributes }}>
      {% if block.settings.heading != blank %}
        <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
      {% endif %}
      <div class="footer__payment-methods">
        {% unless shop.enabled_payment_types == empty %}
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {% endfor %}
        {% endunless %}
      </div>
    </div>

  {% when 'copyright' %}
    <div class="footer__copyright"{% if block.settings.text_color != blank %} style="color: {{ block.settings.text_color }};"{% endif %} {{ block.shopify_attributes }}>
      {{ block.settings.text }}
    </div>

  {% when 'text' %}
    <div class="footer__text-block" {{ block.shopify_attributes }}>
      {% if block.settings.heading != blank %}
        <h3 class="footer__heading"{% if block.settings.heading_color != blank %} style="color: {{ block.settings.heading_color }};"{% endif %}>
          {{ block.settings.heading | escape }}
        </h3>
      {% endif %}
      {% if block.settings.text != blank %}
        <div class="footer__text"{% if block.settings.text_color != blank %} style="color: {{ block.settings.text_color }};"{% endif %}>
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>

{% endcase %}
