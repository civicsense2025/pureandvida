{% comment %}
  Block Column Snippet
  --------------------
  Reusable column block with icon/image, title, description, and optional link.
  Used by multicolumn, benefits, and similar grid sections.

  Parameters:
    Required:
    - block: The block object containing settings

    Block Settings Expected:
    - block.settings.image: Image picker
    - block.settings.icon: Icon name (none, checkmark, star, heart, etc.)
    - block.settings.title: Column title
    - block.settings.text: Column description (richtext)
    - block.settings.link_label: Link text (optional)
    - block.settings.link: Link URL (optional)

    Section Settings (pass these):
    - image_ratio: adapt, square, portrait, landscape, circle
    - image_width: Percentage (20-100)
    - image_border_radius: Pixels
    - icon_size: Pixels
    - icon_color: Color value
    - content_alignment: left, center, right
    - button_style: link, primary, secondary
    - heading_color: Color for title
    - text_color: Color for description

  Usage:
    {% render 'block-column',
      block: block,
      image_ratio: section.settings.image_ratio,
      image_width: section.settings.image_width,
      image_border_radius: section.settings.image_border_radius,
      icon_size: section.settings.icon_size,
      icon_color: section.settings.icon_color,
      content_alignment: section.settings.content_alignment,
      button_style: section.settings.button_style,
      heading_color: section.settings.heading_color,
      text_color: section.settings.text_color
    %}
{% endcomment %}

{% liquid
  assign col_image_ratio = image_ratio | default: 'square'
  assign col_image_width = image_width | default: 100
  assign col_image_radius = image_border_radius | default: 8
  assign col_icon_size = icon_size | default: 48
  assign col_icon_color = icon_color | default: 'var(--color-primary, #2c5530)'
  assign col_alignment = content_alignment | default: 'center'
  assign col_button_style = button_style | default: 'link'
  assign col_heading_color = heading_color | default: 'var(--color-text, #333)'
  assign col_text_color = text_color | default: 'var(--color-text, #666)'
%}

<div class="block-column" {{ block.shopify_attributes }}>
  {% comment %} Media (Image or Icon) {% endcomment %}
  {% if block.settings.image != blank %}
    <div
      class="block-column__media"
      style="
        {% case col_image_ratio %}
          {% when 'square' %}aspect-ratio: 1 / 1;
          {% when 'portrait' %}aspect-ratio: 3 / 4;
          {% when 'landscape' %}aspect-ratio: 4 / 3;
          {% when 'circle' %}aspect-ratio: 1 / 1; border-radius: 50%; overflow: hidden;
          {% when 'adapt' %}aspect-ratio: {{ block.settings.image.aspect_ratio }};
        {% endcase %}
        max-width: {{ col_image_width }}%;
        border-radius: {{ col_image_radius }}px;
        {% if col_alignment == 'center' %}margin: 0 auto;{% endif %}
        {% if col_alignment == 'right' %}margin-left: auto;{% endif %}
      "
    >
      <img
        src="{{ block.settings.image | image_url: width: 600 }}"
        srcset="
          {{ block.settings.image | image_url: width: 200 }} 200w,
          {{ block.settings.image | image_url: width: 400 }} 400w,
          {{ block.settings.image | image_url: width: 600 }} 600w
        "
        sizes="(max-width: 768px) 50vw, 25vw"
        alt="{{ block.settings.image.alt | escape | default: block.settings.title | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="lazy"
        class="block-column__image"
      >
    </div>
  {% elsif block.settings.icon != blank and block.settings.icon != 'none' %}
    <div
      class="block-column__icon"
      style="
        --icon-size: {{ col_icon_size }}px;
        --icon-color: {{ col_icon_color }};
        {% if col_alignment == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
        {% if col_alignment == 'right' %}margin-left: auto;{% endif %}
      "
    >
      {% render 'render-icon', icon: block.settings.icon, size: col_icon_size, color: col_icon_color %}
    </div>
  {% endif %}

  {% comment %} Content {% endcomment %}
  <div class="block-column__content">
    {% if block.settings.title != blank %}
      <h3 class="block-column__title" style="color: {{ col_heading_color }};">
        {{ block.settings.title }}
      </h3>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="block-column__text rte" style="color: {{ col_text_color }};">
        {{ block.settings.text }}
      </div>
    {% endif %}

    {% if block.settings.link_label != blank %}
      <a
        href="{{ block.settings.link }}"
        class="block-column__link{% if col_button_style != 'link' %} button button--{{ col_button_style }}{% endif %}"
        {% if block.settings.link == blank %}aria-disabled="true"{% endif %}
      >
        {{ block.settings.link_label }}
        {% if col_button_style == 'link' %}
          {% render 'render-icon', icon: 'arrow-right', size: 16 %}
        {% endif %}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .block-column {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .block-column__media {
    width: 100%;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .block-column__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .block-column__icon {
    width: var(--icon-size);
    height: var(--icon-size);
    margin-bottom: 20px;
    color: var(--icon-color);
  }

  .block-column__icon svg {
    width: 100%;
    height: 100%;
  }

  .block-column__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .block-column__title {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  .block-column__text {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 16px;
    flex: 1;
  }

  .block-column__text p {
    margin: 0;
  }

  .block-column__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary, #2c5530);
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .block-column__link:not(.button):hover {
    gap: 10px;
  }

  .block-column__link.button {
    padding: 12px 24px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
  }
</style>
