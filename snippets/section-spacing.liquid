{%- comment -%}
  Section Spacing Snippet
  -----------------------
  Outputs CSS padding properties based on section spacing settings.

  Parameters:
    - padding_top: 'none', 'small', 'medium', or 'large' (default: 'medium')
    - padding_bottom: 'none', 'small', 'medium', or 'large' (default: 'medium')

  Usage in section style block:
    <style>
      #{{ section.id }} {
        {% render 'section-spacing',
          padding_top: section.settings.padding_top,
          padding_bottom: section.settings.padding_bottom
        %}
      }
    </style>
{%- endcomment -%}

{%- liquid
  case padding_top
    when 'none'
      assign pt = '0'
    when 'small'
      assign pt = 'var(--spacing-lg, 24px)'
    when 'medium'
      assign pt = 'var(--spacing-2xl, 48px)'
    when 'large'
      assign pt = 'var(--spacing-3xl, 64px)'
    else
      assign pt = 'var(--spacing-2xl, 48px)'
  endcase

  case padding_bottom
    when 'none'
      assign pb = '0'
    when 'small'
      assign pb = 'var(--spacing-lg, 24px)'
    when 'medium'
      assign pb = 'var(--spacing-2xl, 48px)'
    when 'large'
      assign pb = 'var(--spacing-3xl, 64px)'
    else
      assign pb = 'var(--spacing-2xl, 48px)'
  endcase
-%}
padding-top: {{ pt }};
padding-bottom: {{ pb }};
