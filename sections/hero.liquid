      "info": "Lowest quantity customers can select."
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10,
      "info": "Highest quantity customers can select."
    },
    {
      "type": "header",
      "content": "🛒 Call-to-Action Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add to cart",
