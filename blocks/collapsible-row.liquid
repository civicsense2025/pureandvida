{% comment %}
  Theme Block: Collapsible Row
  ----------------------------
  Accordion-style collapsible content with icon, title, rich content, and optional button.
  Supports grouped override settings for colors, typography, and spacing.
{% endcomment %}

{% liquid
  # Content
  assign row_heading = block.settings.heading
  assign row_content = block.settings.row_content
  assign row_page = block.settings.page
  assign row_icon = block.settings.icon
  assign row_icon_image = block.settings.icon_image
  assign is_open = block.settings.open_by_default | default: false

  # Button
  assign btn_text = block.settings.button_text
  assign btn_link = block.settings.button_link
  assign btn_color = block.settings.button_color
  assign btn_text_color = block.settings.button_text_color

  # Color overrides
  assign header_bg = block.settings.row_background
  assign header_color = block.settings.title_color
  assign content_bg = block.settings.content_background
  assign content_color = block.settings.content_color
  assign border_color = block.settings.border_color
  assign toggle_color = block.settings.toggle_color

  # Typography overrides
  assign title_size = block.settings.title_size
  assign title_weight = block.settings.title_weight
  assign content_size = block.settings.content_size
  assign content_line_height = block.settings.content_line_height

  # Spacing overrides
  assign header_padding = block.settings.row_padding
  assign content_padding = block.settings.content_padding
  assign border_radius = block.settings.border_radius
  assign border_width = block.settings.border_width
%}

<details
  class="block-collapsible-row"
  {% if is_open %}open{% endif %}
  {{ block.shopify_attributes }}
  style="
    {% if border_color != blank %}--block-border-color: {{ border_color }};{% endif %}
    {% if border_radius != blank %}--block-border-radius: {{ border_radius }}px;{% endif %}
    {% if border_width != blank %}--block-border-width: {{ border_width }}px;{% endif %}
  "
>
  <summary
    class="block-collapsible-row__header"
    style="
      {% if header_bg != blank %}--block-header-bg: {{ header_bg }};{% endif %}
      {% if header_color != blank %}--block-header-color: {{ header_color }};{% endif %}
      {% if header_padding != blank %}--block-header-padding: {{ header_padding }}px;{% endif %}
      {% if title_size != blank %}--block-title-size: {{ title_size }}px;{% endif %}
      {% if title_weight != blank %}--block-title-weight: {{ title_weight }};{% endif %}
      {% if toggle_color != blank %}--block-toggle-color: {{ toggle_color }};{% endif %}
    "
  >
    <div class="block-collapsible-row__header-content">
      {% if row_icon != blank %}
        <span class="block-collapsible-row__icon" aria-hidden="true">{{ row_icon }}</span>
      {% elsif row_icon_image != blank %}
        <img
          src="{{ row_icon_image | image_url: width: 48 }}"
          alt=""
          class="block-collapsible-row__icon-image"
          width="24"
          height="24"
        >
      {% endif %}
      <span class="block-collapsible-row__title">
        {{ row_heading | escape }}
      </span>
    </div>
    <span class="block-collapsible-row__toggle" aria-hidden="true">
      <span class="toggle-icon">+</span>
    </span>
  </summary>
  <div
    class="block-collapsible-row__content"
    style="
      {% if content_bg != blank %}--block-content-bg: {{ content_bg }};{% endif %}
      {% if content_color != blank %}--block-content-color: {{ content_color }};{% endif %}
      {% if content_padding != blank %}--block-content-padding: {{ content_padding }}px;{% endif %}
      {% if content_size != blank %}--block-content-size: {{ content_size }}px;{% endif %}
      {% if content_line_height != blank %}--block-content-line-height: {{ content_line_height }};{% endif %}
    "
  >
    {% if row_content != blank %}
      <div class="block-collapsible-row__richtext rte">
        {{ row_content }}
      </div>
    {% endif %}

    {% if row_page != blank %}
      <div class="block-collapsible-row__page-content rte">
        {{ row_page.content }}
      </div>
    {% endif %}

    {% if btn_text != blank and btn_link != blank %}
      <a
        href="{{ btn_link }}"
        class="block-collapsible-row__button button"
        style="
          {% if btn_color != blank %}background-color: {{ btn_color }};{% endif %}
          {% if btn_text_color != blank %}color: {{ btn_text_color }};{% endif %}
        "
      >
        {{ btn_text }}
      </a>
    {% endif %}
  </div>
</details>

{% stylesheet %}
  .block-collapsible-row {
    margin: 0;
    border: var(--block-border-width, 1px) solid var(--block-border-color, rgba(0,0,0,0.1));
    border-radius: var(--block-border-radius, 4px);
    overflow: hidden;
  }

  .block-collapsible-row + .block-collapsible-row {
    margin-top: -1px;
  }

  .block-collapsible-row__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    transition: all 0.3s ease;
    min-height: 48px;
    gap: 16px;
    padding: var(--block-header-padding, 16px);
    background: var(--block-header-bg, transparent);
  }

  .block-collapsible-row__header::-webkit-details-marker {
    display: none;
  }

  .block-collapsible-row__header:hover {
    opacity: 0.85;
  }

  .block-collapsible-row__header-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .block-collapsible-row__icon {
    font-size: 1.25rem;
  }

  .block-collapsible-row__icon-image {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .block-collapsible-row__title {
    flex: 1;
    color: var(--block-header-color, inherit);
    font-size: var(--block-title-size, 16px);
    font-weight: var(--block-title-weight, 500);
  }

  .block-collapsible-row__toggle {
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    font-size: 1.5rem;
    color: var(--block-toggle-color, inherit);
  }

  .block-collapsible-row[open] .block-collapsible-row__toggle {
    transform: rotate(45deg);
  }

  .block-collapsible-row__content {
    padding: var(--block-content-padding, 16px);
    background: var(--block-content-bg, transparent);
    color: var(--block-content-color, inherit);
    font-size: var(--block-content-size, 15px);
    line-height: var(--block-content-line-height, 1.6);
    border-top: var(--block-border-width, 1px) solid var(--block-border-color, rgba(0,0,0,0.1));
  }

  .block-collapsible-row__richtext p:first-child,
  .block-collapsible-row__page-content p:first-child {
    margin-top: 0;
  }

  .block-collapsible-row__richtext p:last-child,
  .block-collapsible-row__page-content p:last-child {
    margin-bottom: 0;
  }

  .block-collapsible-row__button {
    margin-top: 16px;
    display: inline-block;
  }

  @media screen and (max-width: 767px) {
    .block-collapsible-row__header {
      padding: clamp(12px, 3vw, var(--block-header-padding, 16px)) !important;
    }

    .block-collapsible-row__content {
      padding: clamp(12px, 3vw, var(--block-content-padding, 16px)) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collapsible Row",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collapsible heading"
    },
    {
      "type": "richtext",
      "id": "row_content",
      "label": "Content",
      "default": "<p>Collapsible content goes here.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "Page Content",
      "info": "Optional: Include content from a page"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by Default",
      "default": false
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Emoji Icon",
      "info": "Optional emoji or symbol"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icon Image",
      "info": "Optional image icon (24x24px recommended)"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": ""
    },
    {
      "type": "header",
      "content": "Color Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "color",
      "id": "row_background",
      "label": "Header Background",
      "default": ""
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "toggle_color",
      "label": "Toggle Icon Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Content Background",
      "default": ""
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Text Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": ""
    },
    {
      "type": "header",
      "content": "Typography Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "info": "Default: 16px"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Content Font Size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "info": "Default: 15px"
    },
    {
      "type": "range",
      "id": "content_line_height",
      "label": "Content Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Spacing Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Header Padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "info": "Default: 16px"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content Padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "info": "Default: 16px"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "info": "Default: 1px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "info": "Default: 4px"
    }
  ],
  "presets": [
    {
      "name": "Collapsible Row"
    }
  ]
}
{% endschema %}
