{% liquid
  # @description Image banner section with overlay text, heading, description, and call-to-action button
  # Supports separate mobile images and customizable overlay opacity
  # @settings image {Image} - Desktop banner image
  # @settings mobile_image {Image} - Mobile banner image (optional)
  # @settings heading {String} - Banner heading
  # @settings description {String} - Banner description text
  # @settings button_text {String} - CTA button text
  # @settings button_link {URL} - CTA button link
  # @settings overlay_color {Color} - Overlay color
  # @settings overlay_opacity {Number} - Overlay opacity (0-1)
  # @example
  #   Add to index.json or page.json for promotional banners
%}

<section class="image-banner-section" style="position: relative; height: {{ section.settings.banner_height }}px; overflow: hidden;">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.heading | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
  {%- elsif section.settings.mobile_image != blank -%}
    <img src="{{ section.settings.mobile_image | image_url: width: 768 }}" alt="{{ section.settings.heading | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
  {%- endif -%}
  
  <div class="image-banner-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity }};"></div>
  
  <div class="image-banner-content" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: {{ section.settings.text_alignment }}; width: 90%; max-width: {{ section.settings.content_width }}px; z-index: 1;">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-banner-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} font-size: {{ section.settings.heading_size }}px; margin-bottom: 20px;">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="image-banner-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %} font-size: {{ section.settings.description_size }}px; margin-bottom: 30px;">{{ section.settings.description | escape }}</p>
    {%- endif -%}
    
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="image-banner-button" style="{% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %} padding: 15px 30px; text-decoration: none; display: inline-block; border-radius: 4px;">
        {{ section.settings.button_text | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .image-banner-section {
      height: {{ section.settings.mobile_banner_height }}px !important;
    }
    {%- if section.settings.mobile_image != blank -%}
      .image-banner-section img:first-child {
        display: none;
      }
    {%- endif -%}
  }
</style>

{% schema %}
{
  "name": "Image Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional: Different image for mobile devices"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (px)",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size (px)",
      "min": 14,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner Height (px)",
      "min": 200,
      "max": 800,
      "step": 50,
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "label": "Mobile Banner Height (px)",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 400
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Max Width (px)",
      "min": 400,
      "max": 1200,
      "step": 50,
      "default": 800
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    }
  ],
  "presets": [
    {
      "name": "Image Banner"
    }
  ],
  "templates": ["index", "page", "product", "collection"]
}
{% endschema %}

