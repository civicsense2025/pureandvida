{% liquid
  # @description Testimonials section displaying customer reviews and testimonials
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # Supports both grid and carousel layouts with comprehensive customization
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings layout_style {String} - Layout style: 'grid' or 'carousel'
  # @settings heading {String} - Section heading
  # @settings columns_desktop {Number} - Number of columns on desktop
  # @blocks testimonial_item - Individual testimonial with stars, text, author, avatar, and date
  # @example
  #   Use blocks mode for dynamic testimonials, settings mode for fixed 6-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
  assign layout_style = section.settings.layout_style | default: 'grid'
-%}

<{{ structural_element }} class="testimonials-section{% if layout_style == 'carousel' %} testimonials-section--carousel{% endif %}" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;">
  <div class="testimonials-content page-width" style="{% if section.settings.content_width != blank %}max-width: {{ section.settings.content_width }}px; margin: 0 auto;{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; font-size: {{ section.settings.heading_size }}px; font-weight: {{ section.settings.heading_weight }}; margin-bottom: {{ section.settings.heading_spacing }}px;">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="testimonials-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; font-size: {{ section.settings.description_size }}px; margin-bottom: {{ section.settings.description_spacing }}px;">{{ section.settings.description }}</p>
    {%- endif -%}
    
    {%- comment -%} Count testimonial items {%- endcomment -%}
    {%- assign testimonial_count = 0 -%}
    {%- if section.settings.content_mode == 'blocks' -%}
      {%- assign testimonial_count = section.blocks.size -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        {%- assign text_key = 'testimonial_' | append: i | append: '_text' -%}
        {%- assign author_key = 'testimonial_' | append: i | append: '_author' -%}
        {%- assign text = section.settings[text_key] -%}
        {%- assign author = section.settings[author_key] -%}
        {%- if text != blank or author != blank -%}
          {%- assign testimonial_count = testimonial_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    
    {%- if testimonial_count > 0 -%}
      {%- if layout_style == 'carousel' -%}
        {%- comment -%} Carousel Layout {%- endcomment -%}
        <div class="testimonials-carousel__wrapper" 
             data-carousel-id="testimonials-{{ section.id }}"
             data-items-desktop="{{ section.settings.carousel_items_desktop }}"
             data-items-mobile="{{ section.settings.carousel_items_mobile }}"
             data-autoplay="{{ section.settings.carousel_autoplay }}"
             data-autoplay-speed="{{ section.settings.carousel_autoplay_speed }}"
             data-gap="{{ section.settings.item_spacing }}">
          
          <div class="testimonials-carousel__container" role="region" aria-label="Testimonials carousel">
            <div class="testimonials-carousel__track" data-carousel-track>
              {%- if section.settings.content_mode == 'blocks' -%}
                {%- for block in section.blocks -%}
                  <div class="testimonials-carousel__slide" data-carousel-slide>
                    {% render 'testimonial-card',
                      show_stars: block.settings.show_stars,
                      stars_image: block.settings.stars_image,
                      stars_asset: block.settings.stars_asset,
                      text: block.settings.text,
                      author_name: block.settings.author_name,
                      avatar: block.settings.avatar,
                      avatar_asset: block.settings.avatar_asset,
                      date: block.settings.date,
                      text_color: block.settings.text_color,
                      author_color: block.settings.author_color,
                      date_color: block.settings.date_color
                    %}
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..6) -%}
                  {%- assign text_key = 'testimonial_' | append: i | append: '_text' -%}
                  {%- assign author_key = 'testimonial_' | append: i | append: '_author' -%}
                  {%- assign avatar_key = 'testimonial_' | append: i | append: '_avatar' -%}
                  {%- assign date_key = 'testimonial_' | append: i | append: '_date' -%}
                  {%- assign text = section.settings[text_key] -%}
                  {%- assign author = section.settings[author_key] -%}
                  {%- assign avatar = section.settings[avatar_key] -%}
                  {%- assign date = section.settings[date_key] -%}
                  {%- if text != blank or author != blank -%}
                    <div class="testimonials-carousel__slide" data-carousel-slide>
                      {% render 'testimonial-card',
                        show_stars: true,
                        stars_image: section.settings.stars_image,
                        stars_asset: '',
                        text: text,
                        author_name: author,
                        avatar: avatar,
                        avatar_asset: '',
                        date: date,
                        text_color: section.settings.default_text_color,
                        author_color: section.settings.default_author_color,
                        date_color: section.settings.default_date_color
                      %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.carousel_show_arrows -%}
            <button class="testimonials-carousel__button testimonials-carousel__button--prev" 
                    data-carousel-prev 
                    aria-label="Previous testimonials"
                    type="button">
              <span aria-hidden="true">‹</span>
            </button>
            <button class="testimonials-carousel__button testimonials-carousel__button--next" 
                    data-carousel-next 
                    aria-label="Next testimonials"
                    type="button">
              <span aria-hidden="true">›</span>
            </button>
          {%- endif -%}

          {%- if section.settings.carousel_show_dots and testimonial_count > section.settings.carousel_items_desktop -%}
            <div class="testimonials-carousel__dots" data-carousel-dots role="tablist" aria-label="Testimonials navigation">
              {%- assign total_slides = testimonial_count | divided_by: section.settings.carousel_items_desktop | ceil -%}
              {%- for i in (1..total_slides) -%}
                <button class="testimonials-carousel__dot{% if forloop.first %} testimonials-carousel__dot--active{% endif %}" 
                        data-carousel-dot 
                        data-slide-index="{{ forloop.index0 }}"
                        aria-label="Go to slide {{ forloop.index }}"
                        type="button"
                        role="tab"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="visually-hidden">Slide {{ forloop.index }}</span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%} Grid Layout {%- endcomment -%}
        <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
          {%- if section.settings.content_mode == 'blocks' -%}
            {%- for block in section.blocks -%}
              <div class="testimonial-card" {{ block.shopify_attributes }}>
                {% render 'testimonial-card',
                  show_stars: block.settings.show_stars,
                  stars_image: block.settings.stars_image,
                  stars_asset: block.settings.stars_asset,
                  text: block.settings.text,
                  author_name: block.settings.author_name,
                  avatar: block.settings.avatar,
                  avatar_asset: block.settings.avatar_asset,
                  date: block.settings.date,
                  text_color: block.settings.text_color,
                  author_color: block.settings.author_color,
                  date_color: block.settings.date_color
                %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              {%- assign text_key = 'testimonial_' | append: i | append: '_text' -%}
              {%- assign author_key = 'testimonial_' | append: i | append: '_author' -%}
              {%- assign avatar_key = 'testimonial_' | append: i | append: '_avatar' -%}
              {%- assign date_key = 'testimonial_' | append: i | append: '_date' -%}
              {%- assign text = section.settings[text_key] -%}
              {%- assign author = section.settings[author_key] -%}
              {%- assign avatar = section.settings[avatar_key] -%}
              {%- assign date = section.settings[date_key] -%}
              {%- if text != blank or author != blank -%}
                <div class="testimonial-card">
                  {% render 'testimonial-card',
                    show_stars: true,
                    stars_image: section.settings.stars_image,
                    stars_asset: '',
                    text: text,
                    author_name: author,
                    avatar: avatar,
                    avatar_asset: '',
                    date: date,
                    text_color: section.settings.default_text_color,
                    author_color: section.settings.default_author_color,
                    date_color: section.settings.default_date_color
                  %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</{{ structural_element }}>

<style>
  /* Testimonials Section Base Styles */
  .testimonial-card {
    background: {% if section.settings.card_background_color != blank %}{{ section.settings.card_background_color }}{% else %}transparent{% endif %};
    padding: {{ section.settings.card_padding }}px;
    border-radius: {{ section.settings.card_border_radius }}px;
    {%- if section.settings.card_border_width > 0 -%}
      border: {{ section.settings.card_border_width }}px solid {% if section.settings.card_border_color != blank %}{{ section.settings.card_border_color }}{% else %}rgba(0,0,0,0.1){% endif %};
    {%- endif -%}
    {%- if section.settings.card_shadow -%}
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    {%- endif -%}
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .testimonial-stars {
    margin-bottom: {{ section.settings.stars_spacing }}px;
    {%- if section.settings.stars_color != blank -%}
      color: {{ section.settings.stars_color }};
    {%- endif -%}
  }

  .testimonial-stars img {
    max-width: 100px;
    height: auto;
  }

  .testimonial-text {
    flex: 1;
    margin-bottom: {{ section.settings.text_spacing }}px;
    font-size: {{ section.settings.text_size }}px;
    line-height: {{ section.settings.text_line_height }};
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: {{ section.settings.author_gap }}px;
    margin-top: auto;
  }

  .testimonial-author-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .testimonial-avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .testimonial-name {
    font-weight: {{ section.settings.author_weight }};
    font-size: {{ section.settings.author_size }}px;
  }

  .testimonial-date {
    font-size: {{ section.settings.date_size }}px;
    opacity: 0.7;
  }

  /* Grid Layout Responsive Styles */
  .testimonials-grid {
    display: grid;
    gap: clamp(15px, 3vw, {{ section.settings.item_spacing }}px);
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .testimonials-grid {
      grid-template-columns: 1fr !important;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr) !important;
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }
  
  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  
  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr) !important;
    }
  }

  /* Carousel Layout Styles */
  .testimonials-section--carousel .testimonials-carousel__wrapper {
    margin-top: {{ section.settings.carousel_margin_top }}px;
  }

  .testimonials-section--carousel .testimonial-card {
    height: auto;
  }
</style>

{% schema %}
{
  "name": "Testimonials Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content Management"
    },
    {
      "type": "select",
      "id": "content_mode",
      "label": "Content Management",
      "options": [
        { "value": "blocks", "label": "Use Blocks (Dynamic)" },
        { "value": "settings", "label": "Use Settings (Fixed)" }
      ],
      "default": "blocks"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop - Grid Only)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Only applies when layout style is Grid"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile - Grid Only)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1,
      "info": "Only applies when layout style is Grid"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "range",
      "id": "carousel_items_desktop",
      "label": "Items Per Slide (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Only applies when layout style is Carousel"
    },
    {
      "type": "range",
      "id": "carousel_items_mobile",
      "label": "Items Per Slide (Mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1,
      "info": "Only applies when layout style is Carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_show_dots",
      "label": "Show Dot Indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Enable Auto-play",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_speed",
      "label": "Auto-play Speed (ms)",
      "min": 2000,
      "max": 10000,
      "step": 500,
      "default": 5000,
      "info": "Only applies when auto-play is enabled"
    },
    {
      "type": "range",
      "id": "carousel_margin_top",
      "label": "Carousel Top Margin (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (px)",
      "min": 20,
      "max": 72,
      "step": 2,
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Bottom Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Description Bottom Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 15
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card Background Color"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Padding (px)",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius (px)",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card Border Width (px)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color"
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Enable Card Shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Text Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "color",
      "id": "default_text_color",
      "label": "Default Text Color",
      "info": "Used in settings mode, can be overridden per block"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Text Bottom Spacing (px)",
      "min": 0,
      "max": 40,
      "step": 5,
      "default": 15
    },
    {
      "type": "range",
      "id": "author_size",
      "label": "Author Name Size (px)",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "select",
      "id": "author_weight",
      "label": "Author Name Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "default_author_color",
      "label": "Default Author Color",
      "info": "Used in settings mode, can be overridden per block"
    },
    {
      "type": "range",
      "id": "date_size",
      "label": "Date Size (px)",
      "min": 10,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "color",
      "id": "default_date_color",
      "label": "Default Date Color",
      "info": "Used in settings mode, can be overridden per block"
    },
    {
      "type": "header",
      "content": "Stars & Avatar"
    },
    {
      "type": "range",
      "id": "stars_spacing",
      "label": "Stars Bottom Spacing (px)",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 10
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Stars Color",
      "info": "For text stars (★★★★★)"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar Size (px)",
      "min": 30,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "author_gap",
      "label": "Author Info Gap (px)",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 12
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Padding Top (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Padding Bottom (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Max Width (px)",
      "min": 0,
      "max": 1920,
      "step": 20,
      "default": 0,
      "info": "0 = full width"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Structural Elements"
    },
    {
      "type": "select",
      "id": "structural_element",
      "label": "HTML Element",
      "options": [
        { "value": "section", "label": "Section (default)" },
        { "value": "article", "label": "Article" },
        { "value": "aside", "label": "Aside" },
        { "value": "div", "label": "Div" }
      ],
      "default": "section",
      "info": "Choose the semantic HTML element for this section"
    },
    {
      "type": "header",
      "content": "Default Stars Image (Settings Mode)"
    },
    {
      "type": "image_picker",
      "id": "stars_image",
      "label": "Default Stars Image",
      "info": "Used in settings mode when no individual star image is set"
    },
