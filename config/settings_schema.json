      {
        "type": "range",
        "id": "font_size_body",
        "label": "Body Text (px)",
        "min": 14,
        "max": 28,
        "step": 1,
        "default": 24,
        "info": "Figma: 24px for main body"
      },
      {
        "type": "range",
        "id": "font_size_small",
        "label": "Small Text (px)",
        "min": 12,
        "max": 20,
        "step": 1,
        "default": 16,
