{% comment %}
  Theme Block: Blog Card
  ----------------------
  Blog article card for featured blog sections.
  Displays article image, tags, title, excerpt, meta info, and read more link.
  Supports grouped override settings for colors, typography, and spacing.
{% endcomment %}

{% liquid
  # Content
  assign article = block.settings.article
  assign show_image = block.settings.show_image | default: true
  assign show_tags = block.settings.show_tags | default: true
  assign show_excerpt = block.settings.show_excerpt | default: true
  assign show_author = block.settings.show_author | default: true
  assign show_date = block.settings.show_date | default: true
  assign show_read_more = block.settings.show_read_more | default: true
  assign excerpt_length = block.settings.excerpt_length | default: 20
  assign read_more_text = block.settings.read_more_text | default: 'Read more'
  assign date_format = '%B %d, %Y'

  # Image settings
  assign image_ratio = block.settings.image_ratio | default: '3/2'
  assign image_radius = block.settings.image_border_radius | default: 8

  # Color overrides
  assign bg_color = block.settings.background_color
  assign title_color = block.settings.title_color
  assign excerpt_color = block.settings.excerpt_color
  assign meta_color = block.settings.meta_color
  assign tag_bg_color = block.settings.tag_background_color
  assign tag_text_color = block.settings.tag_text_color
  assign link_color = block.settings.link_color
  assign border_color = block.settings.border_color

  # Typography overrides
  assign title_size = block.settings.title_size
  assign title_weight = block.settings.title_weight
  assign excerpt_size = block.settings.excerpt_size
  assign meta_size = block.settings.meta_size

  # Spacing overrides
  assign content_padding = block.settings.padding | default: 20
  assign gap = block.settings.internal_gap
  assign border_radius = block.settings.card_border_radius | default: 8
  assign border_width = block.settings.border_width
%}

{% if article != blank %}
  <article
    class="block-blog-card"
    {{ block.shopify_attributes }}
    style="
      --block-image-ratio: {{ image_ratio }};
      --block-image-radius: {{ image_radius }}px;
      --block-card-radius: {{ border_radius }}px;
      --block-content-padding: {{ content_padding }}px;
      {% if bg_color != blank %}--block-bg: {{ bg_color }};{% endif %}
      {% if title_color != blank %}--block-title-color: {{ title_color }};{% endif %}
      {% if excerpt_color != blank %}--block-excerpt-color: {{ excerpt_color }};{% endif %}
      {% if meta_color != blank %}--block-meta-color: {{ meta_color }};{% endif %}
      {% if tag_bg_color != blank %}--block-tag-bg: {{ tag_bg_color }};{% endif %}
      {% if tag_text_color != blank %}--block-tag-color: {{ tag_text_color }};{% endif %}
      {% if link_color != blank %}--block-link-color: {{ link_color }};{% endif %}
      {% if border_color != blank %}--block-border-color: {{ border_color }};{% endif %}
      {% if title_size != blank %}--block-title-size: {{ title_size }}px;{% endif %}
      {% if title_weight != blank %}--block-title-weight: {{ title_weight }};{% endif %}
      {% if excerpt_size != blank %}--block-excerpt-size: {{ excerpt_size }}px;{% endif %}
      {% if meta_size != blank %}--block-meta-size: {{ meta_size }}px;{% endif %}
      {% if gap != blank %}--block-gap: {{ gap }}px;{% endif %}
      {% if border_width != blank %}--block-border-width: {{ border_width }}px;{% endif %}
    "
  >
    {% if show_image %}
      <a href="{{ article.url }}" class="block-blog-card__image-link">
        {% if article.image != blank %}
          <div class="block-blog-card__image-wrapper">
            <img
              src="{{ article.image | image_url: width: 800 }}"
              srcset="
                {{ article.image | image_url: width: 400 }} 400w,
                {{ article.image | image_url: width: 600 }} 600w,
                {{ article.image | image_url: width: 800 }} 800w
              "
              sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
              alt="{{ article.image.alt | default: article.title | escape }}"
              class="block-blog-card__image"
              loading="lazy"
              width="800"
              height="533"
            >
          </div>
        {% else %}
          <div class="block-blog-card__image-placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </a>
    {% endif %}

    <div class="block-blog-card__content">
      {% if show_tags and article.tags.size > 0 %}
        <div class="block-blog-card__tags">
          {% for tag in article.tags limit: 2 %}
            <span class="block-blog-card__tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <h3 class="block-blog-card__title">
        <a href="{{ article.url }}">{{ article.title | escape }}</a>
      </h3>

      {% if show_excerpt and article.excerpt_or_content != blank %}
        <p class="block-blog-card__excerpt">
          {{ article.excerpt_or_content | strip_html | truncatewords: excerpt_length }}
        </p>
      {% endif %}

      <div class="block-blog-card__meta">
        {% if show_author %}
          <span class="block-blog-card__author">{{ article.author }}</span>
        {% endif %}
        {% if show_date %}
          {% if show_author %}
            <span class="block-blog-card__separator" aria-hidden="true">|</span>
          {% endif %}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="block-blog-card__date">
            {{ article.published_at | date: date_format }}
          </time>
        {% endif %}
      </div>

      {% if show_read_more %}
        <a href="{{ article.url }}" class="block-blog-card__read-more">
          {{ read_more_text }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
  </article>
{% else %}
  <div class="block-blog-card block-blog-card--placeholder" {{ block.shopify_attributes }}>
    <div class="block-blog-card__image-placeholder" style="aspect-ratio: {{ image_ratio }};">
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="block-blog-card__content" style="padding: {{ content_padding }}px;">
      <p class="block-blog-card__placeholder-text">Select an article in block settings</p>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .block-blog-card {
    background: var(--block-bg, var(--color-background, #fff));
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: var(--block-card-radius, 8px);
    border: var(--block-border-width, 0) solid var(--block-border-color, transparent);
  }

  .block-blog-card__image-link {
    display: block;
    overflow: hidden;
  }

  .block-blog-card__image-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--block-image-ratio, 3/2);
    border-radius: var(--block-image-radius, 8px) var(--block-image-radius, 8px) 0 0;
  }

  .block-blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .block-blog-card:hover .block-blog-card__image {
    transform: scale(1.05);
  }

  .block-blog-card__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt, #f5f5f5);
    aspect-ratio: var(--block-image-ratio, 3/2);
  }

  .block-blog-card__image-placeholder .placeholder-svg {
    width: 60px;
    height: 60px;
    opacity: 0.4;
  }

  .block-blog-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--block-gap, 12px);
    padding: var(--block-content-padding, 20px);
  }

  .block-blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .block-blog-card__tag {
    display: inline-block;
    padding: 4px 12px;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--block-tag-bg, var(--color-primary, #000));
    color: var(--block-tag-color, var(--color-background, #fff));
    border-radius: 2px;
  }

  .block-blog-card__title {
    font-family: var(--font-heading-family);
    font-size: var(--block-title-size, clamp(1rem, 2.5vw, 1.25rem));
    font-weight: var(--block-title-weight, 600);
    line-height: 1.3;
    margin: 0;
  }

  .block-blog-card__title a {
    color: var(--block-title-color, inherit);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .block-blog-card__title a:hover {
    opacity: 0.7;
  }

  .block-blog-card__excerpt {
    font-family: var(--font-body-family);
    font-size: var(--block-excerpt-size, 0.9rem);
    line-height: 1.6;
    color: var(--block-excerpt-color, inherit);
    margin: 0;
    opacity: 0.8;
    flex: 1;
  }

  .block-blog-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: var(--block-meta-size, 0.8rem);
    color: var(--block-meta-color, inherit);
    opacity: 0.7;
  }

  .block-blog-card__separator {
    opacity: 0.5;
  }

  .block-blog-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--block-link-color, var(--color-primary, #000));
    transition: gap 0.2s ease;
    margin-top: auto;
  }

  .block-blog-card__read-more:hover {
    gap: 10px;
  }

  .block-blog-card__placeholder-text {
    color: var(--color-text-secondary);
    font-style: italic;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Card",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "article",
      "id": "article",
