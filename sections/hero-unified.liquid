          "info": "Optional. Shows as overlapping image."
        },
        {
          "type": "select",
          "id": "style",
          "label": "Image Style",
          "options": [
            { "value": "single", "label": "Single Image" },
            { "value": "stacked", "label": "Stacked (overlapping)" },
            { "value": "side-by-side", "label": "Side by Side" }
          ],
          "default": "single"
        }
      ]
    },
    {
      "type": "tagline",
      "name": "Tagline",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "header", "label": "Header" },
            { "value": "content", "label": "Content" }
          ],
          "default": "content"
        },
        {
          "type": "text",
          "id": "line_1",
          "label": "Line 1",
          "default": "Coffee borrows energy."
        },
        {
          "type": "text",
          "id": "line_2",
          "label": "Line 2",
          "default": "MycoMatcha creates it."
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "content", "label": "Content" },
            { "value": "footer", "label": "Footer" }
          ],
          "default": "content"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Description",
          "default": "<p>Add your product description or promotional text here.</p>"
        }
      ]
    },
    {
      "type": "pricing",
      "name": "Pricing",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "content", "label": "Content" },
            { "value": "footer", "label": "Footer" }
          ],
          "default": "content"
        },
        {
          "type": "checkbox",
          "id": "show_compare_price",
          "label": "Show compare-at price",
          "default": false,
          "info": "Shows crossed-out original price."
        },
        {
          "type": "text",
          "id": "custom_price",
          "label": "Custom Price Override",
          "placeholder": "34.99",
          "info": "Number only. Leave blank to use product price."
        },
        {
          "type": "text",
          "id": "custom_compare_price",
          "label": "Custom Compare Price",
          "placeholder": "$49.99",
          "info": "Original price to show crossed out."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Price Size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "content", "label": "Content" },
            { "value": "footer", "label": "Footer" }
          ],
          "default": "content"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link",
          "info": "Ignored if product selected (uses Add to Cart)."
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button Style",
          "options": [
            { "value": "primary", "label": "Primary (solid)" },
            { "value": "secondary", "label": "Secondary (outline)" },
            { "value": "link", "label": "Text Link" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "show_quantity",
