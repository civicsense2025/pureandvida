{% liquid
  # @description Password page footer section
  # Displays copyright, social links, and Shopify attribution for password-protected storefront
%}

<footer class="password-footer">
  <div class="password-footer__inner page-width">
    {% if section.settings.show_social_links %}
      <div class="password-footer__social">
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_twitter_link != blank %}
          <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
            </svg>
          </a>
        {% endif %}
        {% if settings.social_tiktok_link != blank %}
          <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="password-footer__login">
      <a href="#" data-open-password-modal>
        {{ section.settings.login_text | default: 'Enter using password' }}
      </a>
    </div>

    {% if section.settings.show_copyright %}
      <div class="password-footer__copyright">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
      </div>
    {% endif %}

    {% if section.settings.show_powered_by %}
      <div class="password-footer__powered-by">
        {{ powered_by_link }}
      </div>
    {% endif %}
  </div>
</footer>

<style>
  .password-footer {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color | default: 'transparent' }};
    text-align: center;
  }

  .password-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .password-footer__social {
    display: flex;
    gap: 1.5rem;
  }

  .password-footer__social a {
    color: {{ section.settings.text_color | default: 'var(--color-text-light)' }};
    transition: color 0.2s ease;
  }

  .password-footer__social a:hover {
    color: {{ section.settings.link_hover_color | default: 'var(--color-primary)' }};
  }

  .password-footer__login a {
    font-size: 1.4rem;
    color: {{ section.settings.link_color | default: 'var(--color-primary)' }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .password-footer__login a:hover {
    color: {{ section.settings.link_hover_color | default: 'var(--color-secondary)' }};
  }

  .password-footer__copyright,
  .password-footer__powered-by {
    font-size: 1.2rem;
    color: {{ section.settings.text_color | default: 'var(--color-text-light)' }};
  }

  .password-footer__copyright p {
    margin: 0;
  }

  .password-footer__powered-by a {
    color: inherit;
  }
</style>

{% schema %}
{
  "name": "Password Footer",
  "tag": "div",
  "class": "section-password-footer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "login_text",
      "label": "Login Link Text",
      "default": "Enter using password"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "Show Social Media Links",
      "default": true,
      "info": "Uses social links from theme settings"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show Copyright",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Additional Copyright Text",
      "default": "All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
