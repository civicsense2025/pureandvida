{%- liquid
  # @description Main product section displaying product information, media gallery, variants, and add to cart
  # Core product page section with media display, variant selection, pricing, and purchase functionality
  # Supports 20+ customizable blocks for complete product page customization
  # @settings enable_video_looping {Boolean} - Enable video looping
  # @settings hide_variants {Boolean} - Hide variant-specific images
  # @settings gallery_style {String} - Gallery style: 'grid', 'carousel', 'stacked'
  # @settings info_position {String} - Product info position: 'right', 'left', 'below'
  # @settings sticky_product_info {Boolean} - Make product info sticky on scroll
  # @blocks product_title - Product title with badges
  # @blocks product_price - Price display with savings calculator
  # @blocks variant_picker - Variant selector (multiple styles)
  # @blocks quantity_selector - Quantity selector with min/max
  # @blocks add_to_cart - Add to cart button
  # @blocks product_description - Product description
  # @blocks product_tabs - Tabbed product information
  # @blocks trust_badges - Security, shipping, guarantee badges
  # @blocks social_proof - Reviews count, recent purchases
  # @blocks stock_indicator - Stock count, low stock alerts
  # @blocks product_badges - Dynamic product badges
  # @blocks shipping_calculator - Delivery estimates
  # @blocks size_guide - Size chart modal
  # @blocks product_videos - Embedded videos
  # @blocks product_3d_model - AR/3D product views
  # @blocks bundle_builder - Product bundles and upsells
  # @blocks subscription - Recurring delivery options
  # @blocks gift_options - Gift wrapping, messages
  # @blocks custom_fields - Text inputs, file uploads
  # @blocks related_products - Smart recommendations
  # @example
  #   Add to product.json template for product page layout
-%}

<div class="product page-width{% if section.settings.sticky_product_info %} product--sticky-info{% endif %}" 
     id="ProductSection-{{ section.id }}" 
     data-section="{{ section.id }}"
     role="region"
     aria-label="{{ 'products.product.product_information' | t | default: 'Product Information' }}">
  {%- liquid
    assign layout_position = section.settings.info_position
    assign gallery_style = section.settings.gallery_style
  -%}

  {%- comment -%} Product Media Gallery {%- endcomment -%}
  {%- if layout_position != 'below' -%}
    <div class="product__media-wrapper product__media-wrapper--{{ gallery_style }}" role="region" aria-label="{{ 'products.product.product_images' | t | default: 'Product Images' }}">
      <div class="product__media-list" data-product-gallery role="list" aria-label="{{ 'products.product.product_images' | t | default: 'Product Images' }}">
        {%- if product.selected_or_first_available_variant.featured_media != null -%}
          {%- assign media = product.selected_or_first_available_variant.featured_media -%}
          <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
            {% render 'product-media', media: media, loop: section.settings.enable_video_looping, variant_image: section.settings.hide_variants %}
          </div>
        {%- endif -%}
        {%- for media in product.media -%}
          {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
            <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
              {% render 'product-media', media: media, loop: section.settings.enable_video_looping, variant_image: section.settings.hide_variants %}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Product Info Wrapper with Blocks {%- endcomment -%}
  <div class="product__info-wrapper" 
       id="ProductInfo-{{ section.id }}"
       role="region"
       aria-label="{{ 'products.product.product_details' | t | default: 'Product Details' }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'product_title' -%}
          {%- if block.settings.show_title -%}
            <div class="product__title-wrapper" {{ block.shopify_attributes }}>
              <h1 class="product__title" 
                  style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}"
                  id="ProductTitle-{{ section.id }}"
                  aria-label="{{ 'products.product.product_title' | t | default: 'Product Title' }}">
                {{ product.title | escape }}
              </h1>
              {%- if block.settings.show_badges -%}
                {% render 'product-badges', product: product, block: block %}
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'product_price' -%}
          {%- if block.settings.show_price -%}
            <div class="product__price-wrapper" {{ block.shopify_attributes }}>
              <div class="product__price" 
                   id="ProductPrice-{{ section.id }}"
                   aria-label="{{ 'products.product.price' | t | default: 'Price' }}"
                   role="text"
                   aria-live="polite">
                <div class="price">
                  <div class="price__container">
                    <div class="price__regular">
                      <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
                      <span class="price-item price-item--regular" style="{% if block.settings.price_color != blank %}color: {{ block.settings.price_color }};{% endif %}">
                        {{ product.selected_or_first_available_variant.price | money }}
                      </span>
                    </div>
                    {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                      <div class="price__sale">
                        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.regular_price' | t }}</span>
                        <span>
                          <s class="price-item price-item--regular">
                            {{ product.selected_or_first_available_variant.compare_at_price | money }}
                          </s>
                        </span>
                        <span class="visually-hidden visually-hidden--inline">{{ 'products.product.price.sale_price' | t }}</span>
                        <span class="price-item price-item--sale price-item--last" style="{% if block.settings.sale_price_color != blank %}color: {{ block.settings.sale_price_color }};{% endif %}">
                          {{ product.selected_or_first_available_variant.price | money }}
                        </span>
                      </div>
                      {%- if block.settings.show_savings -%}
                        {%- liquid
                          assign savings = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price
                          assign savings_percent = savings | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round
                        -%}
                        <div class="price__savings">
                          <span>{{ 'products.product.save' | t }} {{ savings | money }} ({{ savings_percent }}%)</span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="product__variant-picker-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-variant-picker', product: product, section: section, block: block %}
            </div>
          {%- endunless -%}

        {%- when 'quantity_selector' -%}
          {%- if block.settings.show_quantity -%}
            <div class="product__quantity-wrapper" {{ block.shopify_attributes }}>
              <label class="form__label" for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity.label' | t }}
              </label>
              <div class="quantity-selector" role="group" aria-label="{{ 'products.product.quantity.label' | t | default: 'Quantity' }}">
                <button type="button" 
                        class="quantity-btn" 
                        data-action="decrease" 
                        aria-label="{{ 'products.product.quantity.decrease' | t | default: 'Decrease quantity' }}"
                        aria-controls="Quantity-{{ section.id }}">-</button>
                <input 
                  type="number" 
                  id="Quantity-{{ section.id }}"
                  name="quantity" 
                  value="{{ block.settings.default_quantity | default: 1 }}" 
                  min="{{ block.settings.min_quantity | default: 1 }}" 
                  max="{{ block.settings.max_quantity | default: 99 }}"
                  class="quantity-input"
                  form="product-form-{{ section.id }}"
                  aria-label="{{ 'products.product.quantity.label' | t | default: 'Quantity' }}"
                  aria-valuemin="{{ block.settings.min_quantity | default: 1 }}"
                  aria-valuemax="{{ block.settings.max_quantity | default: 99 }}"
                  aria-valuenow="{{ block.settings.default_quantity | default: 1 }}"
                >
                <button type="button" 
                        class="quantity-btn" 
                        data-action="increase" 
                        aria-label="{{ 'products.product.quantity.increase' | t | default: 'Increase quantity' }}"
                        aria-controls="Quantity-{{ section.id }}">+</button>
              </div>
            </div>
          {%- endif -%}

        {%- when 'add_to_cart' -%}
          <div class="product__add-to-cart-wrapper" {{ block.shopify_attributes }}>
            <product-form class="product-form">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                {% render 'icon-error' %}
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product', product, id: 'product-form-' | append: section.id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
                <div class="product-form__buttons">
                  <button
                    type="submit"
                    name="add"
                    class="product-form__submit button button--full-width button--primary"
                    style="{% if block.settings.button_color != blank %}background-color: {{ block.settings.button_color }};{% endif %}{% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}"
                    {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                    aria-label="{% if product.selected_or_first_available_variant.available %}{{ block.settings.button_text | default: 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}"
                    aria-describedby="ProductPrice-{{ section.id }}"
                  >
                    <span>
                      {%- if product.selected_or_first_available_variant.available -%}
                        {{ block.settings.button_text | default: 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <div class="loading-overlay__spinner hidden">
                      <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </button>
                </div>
              {%- endform -%}
            </product-form>
          </div>

        {%- when 'product_description' -%}
          {%- if block.settings.show_description and product.description != blank -%}
            <div class="product__description-wrapper" {{ block.shopify_attributes }}>
              <div class="product__description rte" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">
                {%- if block.settings.description_style == 'truncated' -%}
                  <div class="product__description-truncated">
                    <div class="product__description-preview">
                      {{ product.description | strip_html | truncate: block.settings.truncate_length | default: 200 }}
                    </div>
                    <button type="button" class="product__description-read-more" data-read-more>
                      {{ 'products.product.read_more' | t }}
                    </button>
                    <div class="product__description-full" hidden>
                      {{ product.description }}
                    </div>
                  </div>
                {%- else -%}
                  {{ product.description }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'product_tabs' -%}
          {%- if block.settings.show_tabs -%}
            <div class="product__tabs-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-tabs', product: product, block: block %}
            </div>
          {%- endif -%}

        {%- when 'trust_badges' -%}
          {%- if block.settings.show_trust_badges -%}
            <div class="product__trust-badges-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-trust-badges', block: block %}
            </div>
          {%- endif -%}

        {%- when 'social_proof' -%}
          {%- if block.settings.show_social_proof -%}
            <div class="product__social-proof-wrapper" {{ block.shopify_attributes }}>
              {%- if block.settings.show_reviews_count -%}
                <div class="product__reviews-count">
                  <span>{{ 'products.product.reviews_count' | t: count: block.settings.reviews_count | default: 0 }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.show_recent_purchases -%}
                <div class="product__recent-purchases">
                  <span>{{ 'products.product.recent_purchases' | t: count: block.settings.recent_purchases_count | default: 0 }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'stock_indicator' -%}
          {%- if block.settings.show_stock -%}
            <div class="product__stock-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-stock-indicator', product: product, variant: product.selected_or_first_available_variant, block: block %}
            </div>
          {%- endif -%}

        {%- when 'product_badges' -%}
          {%- if block.settings.show_badges -%}
            <div class="product__badges-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-badges', product: product, block: block %}
            </div>
          {%- endif -%}

        {%- when 'shipping_calculator' -%}
          {%- if block.settings.show_shipping_calculator -%}
            <div class="product__shipping-wrapper" {{ block.shopify_attributes }}>
              <div class="product__shipping-calculator">
                <p>{{ 'products.product.shipping_calculator' | t }}</p>
                {%- if block.settings.shipping_text != blank -%}
                  <p>{{ block.settings.shipping_text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'size_guide' -%}
          {%- if block.settings.show_size_guide -%}
            <div class="product__size-guide-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-size-guide', product: product, block: block %}
            </div>
          {%- endif -%}

        {%- when 'product_videos' -%}
          {%- if block.settings.show_videos and product.metafields.custom.video_url != blank -%}
            <div class="product__videos-wrapper" {{ block.shopify_attributes }}>
              <div class="product__video">
                {%- if product.metafields.custom.video_url contains 'youtube' or product.metafields.custom.video_url contains 'youtu.be' -%}
                  <iframe src="{{ product.metafields.custom.video_url }}" frameborder="0" allowfullscreen></iframe>
                {%- elsif product.metafields.custom.video_url contains 'vimeo' -%}
                  <iframe src="{{ product.metafields.custom.video_url }}" frameborder="0" allowfullscreen></iframe>
                {%- else -%}
                  <video controls>
                    <source src="{{ product.metafields.custom.video_url }}" type="video/mp4">
                  </video>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'product_3d_model' -%}
          {%- if block.settings.show_3d_model -%}
            <div class="product__3d-wrapper" {{ block.shopify_attributes }}>
              {%- for media in product.media -%}
                {%- if media.media_type == 'model' -%}
                  {{ media | model_viewer_tag: image_size: "1024x", toggleable: true }}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        {%- when 'bundle_builder' -%}
          {%- if block.settings.show_bundle_builder and product.metafields.custom.bundle_products != blank -%}
            <div class="product__bundle-wrapper" {{ block.shopify_attributes }}>
              {% render 'product-bundle-builder', product: product, block: block %}
            </div>
          {%- endif -%}

        {%- when 'subscription' -%}
          {%- if block.settings.show_subscription -%}
            <div class="product__subscription-wrapper" {{ block.shopify_attributes }}>
              <div class="product__subscription">
                <label>
                  <input type="checkbox" name="properties[Subscription]" value="true" form="product-form-{{ section.id }}">
                  {{ block.settings.subscription_text | default: 'Subscribe and save' }}
                </label>
              </div>
            </div>
          {%- endif -%}

        {%- when 'gift_options' -%}
          {%- if block.settings.show_gift_options -%}
            <div class="product__gift-wrapper" {{ block.shopify_attributes }}>
              <div class="product__gift-options">
                {%- if block.settings.show_gift_wrapping -%}
                  <label>
                    <input type="checkbox" name="properties[Gift Wrapping]" value="true" form="product-form-{{ section.id }}">
                    {{ block.settings.gift_wrapping_text | default: 'Add gift wrapping' }}
                  </label>
                {%- endif -%}
                {%- if block.settings.show_gift_message -%}
                  <label>
                    {{ block.settings.gift_message_label | default: 'Gift Message' }}
                    <textarea name="properties[Gift Message]" form="product-form-{{ section.id }}" placeholder="{{ block.settings.gift_message_placeholder | default: 'Enter your gift message' }}"></textarea>
                  </label>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        {%- when 'custom_fields' -%}
          {%- if block.settings.show_custom_fields -%}
            <div class="product__custom-fields-wrapper" {{ block.shopify_attributes }}>
              {%- if block.settings.custom_field_1_label != blank -%}
                <label>
                  {{ block.settings.custom_field_1_label }}
                  <input type="text" name="properties[{{ block.settings.custom_field_1_label }}]" form="product-form-{{ section.id }}" {% if block.settings.custom_field_1_required %}required{% endif %}>
                </label>
              {%- endif -%}
              {%- if block.settings.custom_field_2_label != blank -%}
                <label>
                  {{ block.settings.custom_field_2_label }}
                  <input type="text" name="properties[{{ block.settings.custom_field_2_label }}]" form="product-form-{{ section.id }}" {% if block.settings.custom_field_2_required %}required{% endif %}>
                </label>
              {%- endif -%}
              {%- if block.settings.show_file_upload -%}
                <label>
                  {{ block.settings.file_upload_label | default: 'Upload File' }}
                  <input type="file" name="properties[{{ block.settings.file_upload_label }}]" form="product-form-{{ section.id }}" accept="{{ block.settings.file_upload_types | default: 'image/*' }}">
                </label>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- when 'related_products' -%}
          {%- if block.settings.show_related_products -%}
            <div class="product__related-wrapper" {{ block.shopify_attributes }}>
              {%- comment -%} Related products will be handled by separate section {%- endcomment -%}
            </div>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Product Media Gallery Below (if layout position is 'below') {%- endcomment -%}
  {%- if layout_position == 'below' -%}
    <div class="product__media-wrapper product__media-wrapper--{{ gallery_style }}">
      <div class="product__media-list" data-product-gallery>
        {%- if product.selected_or_first_available_variant.featured_media != null -%}
          {%- assign media = product.selected_or_first_available_variant.featured_media -%}
          <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
            {% render 'product-media', media: media, loop: section.settings.enable_video_looping, variant_image: section.settings.hide_variants %}
          </div>
        {%- endif -%}
        {%- for media in product.media -%}
          {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
            <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
              {% render 'product-media', media: media, loop: section.settings.enable_video_looping, variant_image: section.settings.hide_variants %}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} NoScript Variant Selector {%- endcomment -%}
  <noscript class="product-form__noscript-wrapper-{{ section.id }}">
    <div class="product-form__input{% if product.has_only_default_variant %} hidden{% endif %}">
      <label class="form__label" for="Variants-{{ section.id }}">{{ 'products.product.product_variants' | t }}</label>
      <div class="select">
        <select name="id" id="Variants-{{ section.id }}" class="select__select" form="product-form-{{ section.id }}">
          {%- for variant in product.variants -%}
            <option
              {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}
              {% if variant.available == false %}disabled{% endif %}
              value="{{ variant.id }}"
            >
              {{ variant.title }}
              {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
              - {{ variant.price | money | strip_html }}
            </option>
          {%- endfor -%}
        </select>
        {% render 'icon-caret' %}
      </div>
    </div>
  </noscript>
</div>

{%- comment -%} Structured Data (JSON-LD) - Enhanced Product Schema {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "{{ product.title | escape }}",
  "description": "{{ product.description | strip_html | escape }}",
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [
    {%- for image in product.images limit: 10 -%}
      "https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- if product.vendor != blank -%}
  "brand": {
    "@type": "Brand",
    "name": "{{ product.vendor | escape }}"
  },
  {%- endif -%}
  {%- if product.selected_or_first_available_variant.sku != blank -%}
  "sku": "{{ product.selected_or_first_available_variant.sku | escape }}",
  {%- endif -%}
  {%- if product.selected_or_first_available_variant.barcode != blank -%}
  "gtin": "{{ product.selected_or_first_available_variant.barcode | escape }}",
  {%- endif -%}
  {%- if product.metafields.seo.mpn != blank -%}
  "mpn": "{{ product.metafields.seo.mpn | escape }}",
  {%- endif -%}
  {%- if product.type != blank -%}
  "category": "{{ product.type | escape }}",
  {%- endif -%}
  {%- if product.tags.size > 0 -%}
  "keywords": "{{ product.tags | join: ', ' | escape }}",
  {%- endif -%}
  {%- if product.variants.size > 1 -%}
  "hasVariant": [
    {%- for variant in product.variants limit: 50 -%}
    {
      "@type": "ProductModel",
      "name": "{{ product.title | escape }} - {{ variant.title | escape }}",
      "sku": "{{ variant.sku | escape }}",
      {%- if variant.barcode != blank -%}
      "gtin": "{{ variant.barcode | escape }}",
      {%- endif -%}
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}",
        "priceCurrency": "{{ cart.currency.iso_code }}",
        "price": "{{ variant.price | money_without_currency | remove: ',' }}",
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}"
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
    "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
    {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
      "priceCurrency": "{{ cart.currency.iso_code }}",
      "referenceQuantity": {
        "@type": "QuantitativeValue",
        "value": 1
      }
    },
    {%- endif -%}
    "seller": {
      "@type": "Organization",
      "name": "{{ shop.name | escape }}"
    }
  }{% if product.metafields.reviews.rating.value != blank %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ product.metafields.reviews.rating.value }}",
    "reviewCount": "{{ product.metafields.reviews.rating_count.value | default: 0 }}",
    "bestRating": "5",
    "worstRating": "1"
  }{% endif %}
  {%- if product.metafields.seo.additional_properties != blank -%}
  ,
  "additionalProperty": [
    {%- assign additional_props = product.metafields.seo.additional_properties.value -%}
    {%- for prop in additional_props -%}
    {
      "@type": "PropertyValue",
      "name": "{{ prop.name | escape }}",
      "value": "{{ prop.value | escape }}"
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>

