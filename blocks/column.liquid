{% comment %}
  Theme Block: Column
  -------------------
  Multi-purpose column block with icon/image, title, description, and optional link.
  Supports grouped override settings for colors, typography, and spacing.
{% endcomment %}

{% liquid
  # Content
  assign col_image = block.settings.image
  assign col_icon = block.settings.icon
  assign col_title = block.settings.title
  assign col_text = block.settings.text
  assign col_link_label = block.settings.link_label
  assign col_link = block.settings.link
  assign btn_style = block.settings.button_style | default: 'link'

  # Image settings
  assign image_ratio = block.settings.image_ratio | default: 'square'
  assign image_width = block.settings.image_width | default: 100
  assign image_radius = block.settings.image_border_radius | default: 8
  assign icon_size = block.settings.icon_size | default: 48

  # Color overrides
  assign bg_color = block.settings.background_color
  assign heading_color = block.settings.heading_color
  assign text_color = block.settings.text_color
  assign icon_color = block.settings.icon_color | default: 'var(--color-primary, #2c5530)'
  assign link_color = block.settings.link_color
  assign border_color = block.settings.border_color

  # Typography overrides
  assign heading_size = block.settings.heading_size
  assign heading_weight = block.settings.heading_weight
  assign text_size = block.settings.text_size
  assign line_height = block.settings.line_height

  # Spacing overrides
  assign alignment = block.settings.content_alignment | default: 'center'
  assign padding_y = block.settings.padding_vertical
  assign padding_x = block.settings.padding_horizontal
  assign gap = block.settings.internal_gap
  assign border_width = block.settings.border_width
  assign card_radius = block.settings.border_radius
%}

<div
  class="block-column block-column--align-{{ alignment }}"
  {{ block.shopify_attributes }}
  style="
    --block-icon-size: {{ icon_size }}px;
    --block-icon-color: {{ icon_color }};
    {% if bg_color != blank %}--block-bg: {{ bg_color }};{% endif %}
    {% if heading_color != blank %}--block-heading-color: {{ heading_color }};{% endif %}
    {% if text_color != blank %}--block-text-color: {{ text_color }};{% endif %}
    {% if link_color != blank %}--block-link-color: {{ link_color }};{% endif %}
    {% if border_color != blank %}--block-border-color: {{ border_color }};{% endif %}
    {% if heading_size != blank %}--block-heading-size: {{ heading_size }}px;{% endif %}
    {% if heading_weight != blank %}--block-heading-weight: {{ heading_weight }};{% endif %}
    {% if text_size != blank %}--block-text-size: {{ text_size }}px;{% endif %}
    {% if line_height != blank %}--block-line-height: {{ line_height }};{% endif %}
    {% if padding_y != blank %}--block-padding-y: {{ padding_y }}px;{% endif %}
    {% if padding_x != blank %}--block-padding-x: {{ padding_x }}px;{% endif %}
    {% if gap != blank %}--block-gap: {{ gap }}px;{% endif %}
    {% if border_width != blank %}--block-border-width: {{ border_width }}px;{% endif %}
    {% if card_radius != blank %}--block-radius: {{ card_radius }}px;{% endif %}
  "
>
  {% comment %} Media (Image or Icon) {% endcomment %}
  {% if col_image != blank %}
    <div
      class="block-column__media"
      style="
        {% case image_ratio %}
          {% when 'square' %}aspect-ratio: 1 / 1;
          {% when 'portrait' %}aspect-ratio: 3 / 4;
          {% when 'landscape' %}aspect-ratio: 4 / 3;
          {% when 'circle' %}aspect-ratio: 1 / 1; border-radius: 50%; overflow: hidden;
          {% when 'adapt' %}aspect-ratio: {{ col_image.aspect_ratio }};
        {% endcase %}
        max-width: {{ image_width }}%;
        border-radius: {{ image_radius }}px;
      "
    >
      <img
        src="{{ col_image | image_url: width: 600 }}"
        srcset="
          {{ col_image | image_url: width: 200 }} 200w,
          {{ col_image | image_url: width: 400 }} 400w,
          {{ col_image | image_url: width: 600 }} 600w
        "
        sizes="(max-width: 768px) 50vw, 25vw"
        alt="{{ col_image.alt | escape | default: col_title | escape }}"
        width="{{ col_image.width }}"
        height="{{ col_image.height }}"
        loading="lazy"
        class="block-column__image"
      >
    </div>
  {% elsif col_icon != blank and col_icon != 'none' %}
    <div class="block-column__icon">
      {% render 'render-icon', icon: col_icon, size: icon_size, color: icon_color %}
    </div>
  {% endif %}

  {% comment %} Content {% endcomment %}
  <div class="block-column__content">
    {% if col_title != blank %}
      <h3 class="block-column__title">{{ col_title }}</h3>
    {% endif %}

    {% if col_text != blank %}
      <div class="block-column__text rte">{{ col_text }}</div>
    {% endif %}

    {% if col_link_label != blank %}
      <a
        href="{{ col_link }}"
        class="block-column__link{% if btn_style != 'link' %} button button--{{ btn_style }}{% endif %}"
        {% if col_link == blank %}aria-disabled="true"{% endif %}
      >
        {{ col_link_label }}
        {% if btn_style == 'link' %}
          <span aria-hidden="true">&rarr;</span>
        {% endif %}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .block-column {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--block-bg, transparent);
    padding: var(--block-padding-y, 0) var(--block-padding-x, 0);
    gap: var(--block-gap, 16px);
    border: var(--block-border-width, 0) solid var(--block-border-color, transparent);
    border-radius: var(--block-radius, 0);
  }

  .block-column--align-left {
    text-align: left;
  }

  .block-column--align-left .block-column__media,
  .block-column--align-left .block-column__icon {
    margin-right: auto;
  }

  .block-column--align-center {
    text-align: center;
  }

  .block-column--align-center .block-column__media,
  .block-column--align-center .block-column__icon {
    margin-left: auto;
    margin-right: auto;
  }

  .block-column--align-right {
    text-align: right;
  }

  .block-column--align-right .block-column__media,
  .block-column--align-right .block-column__icon {
    margin-left: auto;
  }

  .block-column__media {
    width: 100%;
    overflow: hidden;
  }

  .block-column__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .block-column__icon {
    width: var(--block-icon-size, 48px);
    height: var(--block-icon-size, 48px);
    color: var(--block-icon-color, var(--color-primary, #2c5530));
  }

  .block-column__icon svg {
    width: 100%;
    height: 100%;
  }

  .block-column__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .block-column__title {
    font-family: var(--font-heading-family);
    font-size: var(--block-heading-size, 1.25rem);
    font-weight: var(--block-heading-weight, 600);
    color: var(--block-heading-color, inherit);
    line-height: 1.3;
    margin: 0;
  }

  .block-column__text {
    font-family: var(--font-body-family);
    font-size: var(--block-text-size, 0.95rem);
    line-height: var(--block-line-height, 1.7);
    color: var(--block-text-color, inherit);
    flex: 1;
  }

  .block-column__text p {
    margin: 0;
  }

  .block-column__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--block-link-color, var(--color-primary, #2c5530));
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .block-column__link:not(.button):hover {
    gap: 10px;
  }

  .block-column__link.button {
    padding: 12px 24px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Column",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "checkmark", "label": "Checkmark" },
        { "value": "star", "label": "Star" },
        { "value": "heart", "label": "Heart" },
        { "value": "truck", "label": "Truck" },
        { "value": "shield", "label": "Shield" },
        { "value": "leaf", "label": "Leaf" },
        { "value": "gift", "label": "Gift" },
        { "value": "clock", "label": "Clock" },
        { "value": "arrow-right", "label": "Arrow" }
      ],
      "default": "none",
      "info": "Only shown if no image is selected"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Column Title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Add your column description here.</p>"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Link Style",
      "options": [
        { "value": "link", "label": "Text Link" },
        { "value": "primary", "label": "Primary Button" },
        { "value": "secondary", "label": "Secondary Button" }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to Image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width",
      "min": 20,
      "max": 100,
      "step": 10,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 24,
      "max": 80,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Color Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#2c5530"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": ""
    },
    {
      "type": "header",
      "content": "Typography Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "info": "Default: 20px"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "info": "Default: 15px"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "header",
      "content": "Spacing Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "internal_gap",
      "label": "Internal Gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "info": "Space between elements. Default: 16px"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Column"
    }
  ]
}
{% endschema %}
