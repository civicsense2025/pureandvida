{% liquid
  # @description Customer login section
  # Displays login form for customers
%}

<div class="page-width" style="padding: 40px 20px; max-width: 500px; margin: 0 auto;">
  <h1 class="h1" style="margin-bottom: 30px; text-align: center;">Login</h1>
  
  {%- form 'customer_login', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div style="padding: 15px; background: #fee; border: 1px solid #d00; border-radius: 4px; margin-bottom: 20px; color: #d00;">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}
    
    <div style="margin-bottom: 20px;">
      <label for="customer_email" style="display: block; margin-bottom: 5px;">Email</label>
      <input type="email" name="customer[email]" id="customer_email" autocomplete="email" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px;">
    </div>
    
    <div style="margin-bottom: 20px;">
      <label for="customer_password" style="display: block; margin-bottom: 5px;">Password</label>
      <input type="password" name="customer[password]" id="customer_password" autocomplete="current-password" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px;">
    </div>
    
    <div style="margin-bottom: 20px;">
      <a href="{{ routes.account_recover_url }}" style="color: #000; text-decoration: underline;">Forgot password?</a>
    </div>
    
    <button type="submit" style="width: 100%; padding: 12px; background: #000; color: #fff; border: none; border-radius: 4px; cursor: pointer; margin-bottom: 20px;">Login</button>
  {%- endform -%}
  
  <div style="text-align: center; padding-top: 20px; border-top: 1px solid #eee;">
    <p style="margin-bottom: 15px;">Don't have an account?</p>
    <a href="{{ routes.account_register_url }}" style="padding: 12px 24px; background: #000; color: #fff; text-decoration: none; border-radius: 4px; display: inline-block;">Create Account</a>
  </div>
</div>

{% schema %}
{
  "name": "Customer Login",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Customer Login"
    }
  ]
}
{% endschema %}
