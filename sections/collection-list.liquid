{%- liquid
  # @description Collection list section displaying featured collections in a grid layout
  # Supports multiple collection blocks with custom images and titles
  # @settings heading {String} - Section heading
  # @settings columns_desktop {Number} - Number of columns on desktop (2-6)
  # @settings show_collection_title {Boolean} - Display collection titles
  # @settings show_product_count {Boolean} - Display product count
  # @blocks collection - Individual collection block with collection picker and custom image
  # @example
  #   Add to index.json or page.json to showcase featured collections
-%}

<section class="collection-list-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-list-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; margin-bottom: {{ section.settings.heading_spacing }}px;">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="collection-list-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; margin-bottom: 40px;">{{ section.settings.description | escape }}</p>
    {%- endif -%}
    
    <div class="collection-list-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'collection' and block.settings.collection != blank -%}
          {%- assign collection = block.settings.collection -%}
          <div class="collection-item" {{ block.shopify_attributes }}>
            <a href="{{ collection.url }}" style="text-decoration: none; display: block;">
              {%- if collection.featured_image != blank -%}
                <div class="collection-image" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; overflow: hidden; margin-bottom: 15px;">
                  <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
              {%- elsif block.settings.custom_image != blank -%}
                <div class="collection-image" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; overflow: hidden; margin-bottom: 15px;">
                  <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
              {%- endif -%}
              
              {%- if section.settings.show_collection_title -%}
                <h3 class="collection-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% elsif section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %} text-align: center;">{{ collection.title | escape }}</h3>
              {%- endif -%}
              
              {%- if section.settings.show_product_count -%}
                <p class="collection-count" style="{% if section.settings.count_color != blank %}color: {{ section.settings.count_color }};{% endif %} text-align: center; margin-top: 5px;">
                  {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
                </p>
              {%- endif -%}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .collection-list-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Collection List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Bottom Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ],
      "default": "4/3"
    },
    {
      "type": "header",
      "content": "Collection Info"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show Collection Title",
      "default": true
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count",
      "default": false
    },
    {
      "type": "color",
      "id": "count_color",
      "label": "Product Count Color"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image",
          "info": "Optional: Override collection featured image"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "info": "Overrides section default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List"
    }
  ],
  "templates": ["index", "page", "product", "collection"]
}
{% endschema %}

