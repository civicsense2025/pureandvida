{% comment %}
  Block Blog Card Snippet
  -----------------------
  Reusable blog article card for featured blog sections.
  Displays article image, tags, title, excerpt, meta info, and read more link.

  Parameters:
    Required:
    - article: The article object

    Optional Display Settings:
    - show_image: Boolean (default: true)
    - show_tags: Boolean (default: true)
    - show_excerpt: Boolean (default: true)
    - show_author: Boolean (default: true)
    - show_date: Boolean (default: true)
    - show_read_more: Boolean (default: true)

    Style Settings:
    - image_ratio: Aspect ratio string (1/1, 4/3, 3/2, 16/9, 2/3)
    - card_border_radius: Pixels
    - card_padding: Pixels
    - excerpt_length: Words to truncate
    - date_format: Date format string
    - read_more_text: Text for read more link

    Color Settings:
    - title_color: Title text color
    - excerpt_color: Excerpt text color
    - meta_color: Meta text color
    - tag_color: Tag background color
    - link_color: Read more link color

  Usage:
    {% render 'block-blog-card',
      article: article,
      show_image: section.settings.show_image,
      show_tags: section.settings.show_tags,
      image_ratio: section.settings.image_ratio,
      card_border_radius: section.settings.card_border_radius,
      card_padding: section.settings.card_padding
    %}
{% endcomment %}

{% liquid
  assign card_show_image = show_image | default: true
  assign card_show_tags = show_tags | default: true
  assign card_show_excerpt = show_excerpt | default: true
  assign card_show_author = show_author | default: true
  assign card_show_date = show_date | default: true
  assign card_show_read_more = show_read_more | default: true

  assign card_image_ratio = image_ratio | default: '3/2'
  assign card_border_radius = card_border_radius | default: 8
  assign card_content_padding = card_padding | default: 20
  assign card_excerpt_length = excerpt_length | default: 20
  assign card_date_format = date_format | default: '%B %d, %Y'
  assign card_read_more_text = read_more_text | default: 'Read more'

  assign card_title_color = title_color
  assign card_excerpt_color = excerpt_color
  assign card_meta_color = meta_color
  assign card_tag_color = tag_color
  assign card_link_color = link_color
%}

<article class="block-blog-card" style="border-radius: {{ card_border_radius }}px;">
  {% if card_show_image %}
    <a href="{{ article.url }}" class="block-blog-card__image-link">
      {% if article.image != blank %}
        <div class="block-blog-card__image-wrapper" style="aspect-ratio: {{ card_image_ratio }};">
          <img
            src="{{ article.image | image_url: width: 800 }}"
            srcset="
              {{ article.image | image_url: width: 400 }} 400w,
              {{ article.image | image_url: width: 600 }} 600w,
              {{ article.image | image_url: width: 800 }} 800w
            "
            sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
            alt="{{ article.image.alt | default: article.title | escape }}"
            class="block-blog-card__image"
            loading="lazy"
            style="border-radius: {{ card_border_radius }}px {{ card_border_radius }}px 0 0;"
            width="800"
            height="533"
          >
        </div>
      {% else %}
        <div class="block-blog-card__image-placeholder" style="aspect-ratio: {{ card_image_ratio }};">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </a>
  {% endif %}

  <div class="block-blog-card__content" style="padding: {{ card_content_padding }}px;">
    {% if card_show_tags and article.tags.size > 0 %}
      <div class="block-blog-card__tags">
        {% for tag in article.tags limit: 2 %}
          <span
            class="block-blog-card__tag"
            {% if card_tag_color != blank %}style="background-color: {{ card_tag_color }};"{% endif %}
          >
            {{ tag }}
          </span>
        {% endfor %}
      </div>
    {% endif %}

    <h3 class="block-blog-card__title" {% if card_title_color != blank %}style="color: {{ card_title_color }};"{% endif %}>
      <a href="{{ article.url }}">{{ article.title | escape }}</a>
    </h3>

    {% if card_show_excerpt and article.excerpt_or_content != blank %}
      <p
        class="block-blog-card__excerpt"
        {% if card_excerpt_color != blank %}style="color: {{ card_excerpt_color }};"{% endif %}
      >
        {{ article.excerpt_or_content | strip_html | truncatewords: card_excerpt_length }}
      </p>
    {% endif %}

    <div class="block-blog-card__meta">
      {% if card_show_author %}
        <span class="block-blog-card__author" {% if card_meta_color != blank %}style="color: {{ card_meta_color }};"{% endif %}>
          {{ article.author }}
        </span>
      {% endif %}

      {% if card_show_date %}
        {% if card_show_author %}
          <span class="block-blog-card__separator" aria-hidden="true">|</span>
        {% endif %}
        <time
          datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
          class="block-blog-card__date"
          {% if card_meta_color != blank %}style="color: {{ card_meta_color }};"{% endif %}
        >
          {{ article.published_at | date: card_date_format }}
        </time>
      {% endif %}
    </div>

    {% if card_show_read_more %}
      <a
        href="{{ article.url }}"
        class="block-blog-card__read-more"
        {% if card_link_color != blank %}style="color: {{ card_link_color }};"{% endif %}
      >
        {{ card_read_more_text }}
        <span aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>
</article>

<style>
  .block-blog-card {
    background: var(--blog-card-background, var(--color-background, #fff));
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .block-blog-card__image-link {
    display: block;
    overflow: hidden;
  }

  .block-blog-card__image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .block-blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .block-blog-card:hover .block-blog-card__image {
    transform: scale(1.05);
  }

  .block-blog-card__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt, #f5f5f5);
  }

  .block-blog-card__image-placeholder .placeholder-svg {
    width: 60px;
    height: 60px;
    opacity: 0.4;
  }

  .block-blog-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .block-blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .block-blog-card__tag {
    display: inline-block;
    padding: 4px 12px;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-primary, #000);
    color: var(--color-background, #fff);
    border-radius: 2px;
  }

  .block-blog-card__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  .block-blog-card__title a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .block-blog-card__title a:hover {
    opacity: 0.7;
  }

  .block-blog-card__excerpt {
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 16px;
    opacity: 0.8;
    flex: 1;
  }

  .block-blog-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8rem;
    margin-bottom: 12px;
    opacity: 0.7;
  }

  .block-blog-card__separator {
    opacity: 0.5;
  }

  .block-blog-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-primary, #000);
    transition: gap 0.2s ease;
    margin-top: auto;
  }

  .block-blog-card__read-more:hover {
    gap: 10px;
  }
</style>
