<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web/src/regular/style.css" />

<style>
  {%- if section.settings.custom_font -%}
    @font-face {
      font-family: 'CustomFont';
      src: url('{{ section.settings.custom_font | file_url }}');
      font-weight: normal;
      font-style: normal;
    }
    .shopdev * {
      font-family: 'CustomFont', sans-serif;
    }
  {%- endif -%}
  .shopdev .bg-cream { background-color: #F5F3EE; }
  .shopdev .bg-teal { background-color: #5E8778; }
  .shopdev .bg-orange { background-color: #E8983B; }
  .shopdev .bg-dark-green { background-color: #516D55; }
  .shopdev .bg-dark-olive { background-color: #4E4E33; }
  .shopdev .bg-amber { background-color: #F9A000; }
  
  .shopdev .text-teal { color: #5E8778; }
  .shopdev .text-orange { color: #E8983B; }
  .shopdev .text-dark-green { color: #314339; }
  
  .shopdev .border-teal { border-color: #5E8778; }
  .shopdev .border-black { border-color: #000000; }
  
  .shopdev .line-through-teal {
    position: relative;
  }
  .shopdev .line-through-teal::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background-color: #5E8778;
  }
  
  .shopdev .faq-item {
    border: 1px solid #000000;
    cursor: pointer;
  }
  
  .shopdev .faq-item:hover {
    background-color: #f9f9f9;
  }
  .shopdev .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .shopdev .faq-item.active .faq-answer {
    max-height: 500px;
  }
  .shopdev .mobile-menu {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }
  .shopdev .mobile-menu.active {
    transform: translateX(0);
  }
  .shopdev .testimonial-carousel {
    overflow: hidden;
  }
  .shopdev .testimonial-track {
    display: flex;
    transition: transform 0.5s ease;
  }
  .shopdev .testimonial-slide {
    min-width: 100%;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .shopdev .testimonial-slide {
      min-width: 33.333%;
    }
  }
  
  /* Utility Classes */
  .shopdev .w-full { width: 100%; }
  .shopdev .flex { display: flex; }
  .shopdev .flex-col { flex-direction: column; }
  .shopdev .flex-row { flex-direction: row; }
  .shopdev .items-center { align-items: center; }
  .shopdev .items-start { align-items: flex-start; }
  .shopdev .items-stretch { align-items: stretch; }
  .shopdev .justify-between { justify-content: space-between; }
  .shopdev .justify-center { justify-content: center; }
  .shopdev .justify-start { justify-content: flex-start; }
  .shopdev .gap-4 { gap: 1rem; }
  .shopdev .gap-\[7px\] { gap: 7px; }
  .shopdev .gap-\[8px\] { gap: 8px; }
  .shopdev .gap-\[10px\] { gap: 10px; }
  .shopdev .gap-\[15px\] { gap: 15px; }
  .shopdev .gap-\[18px\] { gap: 18px; }
  .shopdev .gap-\[20px\] { gap: 20px; }
  .shopdev .gap-\[24px\] { gap: 24px; }
  .shopdev .gap-\[29px\] { gap: 29px; }
  .shopdev .gap-\[30px\] { gap: 30px; }
  .shopdev .gap-\[38px\] { gap: 38px; }
  .shopdev .gap-\[40px\] { gap: 40px; }
  .shopdev .gap-\[48px\] { gap: 48px; }
  .shopdev .gap-\[60px\] { gap: 60px; }
  .shopdev .gap-\[115px\] { gap: 115px; }
  .shopdev .max-w-\[1440px\] { max-width: 1440px; }
  .shopdev .mx-auto { margin-left: auto; margin-right: auto; }
  .shopdev .px-4 { padding-left: 1rem; padding-right: 1rem; }
  .shopdev .px-\[17px\] { padding-left: 17px; padding-right: 17px; }
  .shopdev .px-\[20px\] { padding-left: 20px; padding-right: 20px; }
  .shopdev .px-\[22px\] { padding-left: 22px; padding-right: 22px; }
  .shopdev .px-\[30px\] { padding-left: 30px; padding-right: 30px; }
  .shopdev .px-\[47px\] { padding-left: 47px; padding-right: 47px; }
  .shopdev .py-3 { padding-top: 0.75rem; padding-bottom: 0.75rem; }
  .shopdev .py-4 { padding-top: 1rem; padding-bottom: 1rem; }
  .shopdev .py-\[10px\] { padding-top: 10px; padding-bottom: 10px; }
  .shopdev .py-\[12px\] { padding-top: 12px; padding-bottom: 12px; }
  .shopdev .py-\[15px\] { padding-top: 15px; padding-bottom: 15px; }
  .shopdev .py-\[23px\] { padding-top: 23px; padding-bottom: 23px; }
  .shopdev .py-\[30px\] { padding-top: 30px; padding-bottom: 30px; }
  .shopdev .py-\[62px\] { padding-top: 62px; padding-bottom: 62px; }
  .shopdev .pt-\[10px\] { padding-top: 10px; }
  .shopdev .pb-\[10px\] { padding-bottom: 10px; }
  .shopdev .pb-\[15px\] { padding-bottom: 15px; }
  .shopdev .pb-\[20px\] { padding-bottom: 20px; }
  .shopdev .pb-\[26px\] { padding-bottom: 26px; }
  .shopdev .pb-\[38px\] { padding-bottom: 38px; }
  .shopdev .pb-\[40px\] { padding-bottom: 40px; }
  .shopdev .pb-\[50px\] { padding-bottom: 50px; }
  .shopdev .pb-\[82px\] { padding-bottom: 82px; }
  .shopdev .pb-\[100px\] { padding-bottom: 100px; }
  .shopdev .mb-\[8px\] { margin-bottom: 8px; }
  .shopdev .mb-\[10px\] { margin-bottom: 10px; }
  .shopdev .mb-\[15px\] { margin-bottom: 15px; }
  .shopdev .mb-\[20px\] { margin-bottom: 20px; }
  .shopdev .mb-\[26px\] { margin-bottom: 26px; }
  .shopdev .mb-\[38px\] { margin-bottom: 38px; }
  .shopdev .mb-\[40px\] { margin-bottom: 40px; }
  .shopdev .mt-4 { margin-top: 1rem; }
  .shopdev .mt-8 { margin-top: 2rem; }
  .shopdev .mt-\[10px\] { margin-top: 10px; }
  .shopdev .pr-4 { padding-right: 1rem; }
  .shopdev .p-4 { padding: 1rem; }
  .shopdev .p-\[12px\] { padding: 12px; }
  .shopdev .p-\[15px\] { padding: 15px; }
  .shopdev .p-\[20px\] { padding: 20px; }
  .shopdev .p-\[40px\] { padding: 40px; }
  .shopdev .text-center { text-align: center; }
  .shopdev .text-justify { text-align: justify; }
  .shopdev .text-left { text-align: left; }
  .shopdev .text-white { color: #ffffff; }
  .shopdev .text-\[14px\] { font-size: 14px; }
  .shopdev .text-\[16px\] { font-size: 16px; }
  .shopdev .text-\[18px\] { font-size: 18px; }
  .shopdev .text-\[20px\] { font-size: 20px; }
  .shopdev .text-\[24px\] { font-size: 24px; }
  .shopdev .text-\[28px\] { font-size: 28px; }
  .shopdev .text-\[32px\] { font-size: 32px; }
  .shopdev .text-\[35px\] { font-size: 35px; }
  .shopdev .text-\[36px\] { font-size: 36px; }
  .shopdev .text-\[40px\] { font-size: 40px; }
  .shopdev .text-\[52px\] { font-size: 52px; }
  .shopdev .text-\[72px\] { font-size: 72px; }
  .shopdev .text-\[94px\] { font-size: 94px; }
  .shopdev .font-light { font-weight: 300; }
  .shopdev .font-semibold { font-weight: 600; }
  .shopdev .font-bold { font-weight: 700; }
  .shopdev .font-medium { font-weight: 500; }
  .shopdev .leading-\[100%\] { line-height: 100%; }
  .shopdev .leading-\[120%\] { line-height: 120%; }
  .shopdev .leading-\[140%\] { line-height: 140%; }
  .shopdev .tracking-\[-0\.01em\] { letter-spacing: -0.01em; }
  .shopdev .tracking-\[0\.02em\] { letter-spacing: 0.02em; }
  .shopdev .tracking-\[0\.04em\] { letter-spacing: 0.04em; }
  .shopdev .tracking-\[0\.06em\] { letter-spacing: 0.06em; }
  .shopdev .tracking-\[0\.08em\] { letter-spacing: 0.08em; }
  .shopdev .tracking-\[0\.12em\] { letter-spacing: 0.12em; }
  .shopdev .whitespace-pre-line { white-space: pre-line; }
  .shopdev .rounded { border-radius: 0.25rem; }
  .shopdev .rounded-\[10px\] { border-radius: 10px; }
  .shopdev .rounded-\[20px\] { border-radius: 20px; }
  .shopdev .rounded-\[40px\] { border-radius: 40px; }
  .shopdev .rounded-\[46px\] { border-radius: 46px; }
  .shopdev .rounded-\[72px\] { border-radius: 72px; }
  .shopdev .rounded-\[91px\] { border-radius: 91px; }
  .shopdev .rounded-full { border-radius: 9999px; }
  .shopdev .border { border-width: 1px; }
  .shopdev .border-b { border-bottom-width: 1px; }
  .shopdev .border-gray-200 { border-color: #e5e7eb; }
  .shopdev .border-gray-300 { border-color: #d1d5db; }
  .shopdev .h-auto { height: auto; }
  .shopdev .h-\[34px\] { height: 34px; }
  .shopdev .h-\[35px\] { height: 35px; }
  .shopdev .h-\[40px\] { height: 40px; }
  .shopdev .h-full { height: 100%; }
  .shopdev .w-\[20px\] { width: 20px; }
  .shopdev .w-\[40px\] { width: 40px; }
  .shopdev .w-\[50px\] { width: 50px; }
  .shopdev .w-\[51px\] { width: 51px; }
  .shopdev .w-\[116px\] { width: 116px; }
  .shopdev .w-\[602px\] { width: 602px; }
  .shopdev .flex-1 { flex: 1 1 0%; }
  .shopdev .flex-shrink-0 { flex-shrink: 0; }
  .shopdev .min-w-\[100%\] { min-width: 100%; }
  .shopdev .space-y-\[10px\] > * + * { margin-top: 10px; }
  .shopdev .space-y-\[15px\] > * + * { margin-top: 15px; }
  .shopdev .space-y-\[20px\] > * + * { margin-top: 20px; }
  .shopdev .relative { position: relative; }
  .shopdev .absolute { position: absolute; }
  .shopdev .fixed { position: fixed; }
  .shopdev .top-0 { top: 0; }
  .shopdev .left-0 { left: 0; }
  .shopdev .z-10 { z-index: 10; }
  .shopdev .z-50 { z-index: 50; }
  .shopdev .overflow-hidden { overflow: hidden; }
  .shopdev .cursor-pointer { cursor: pointer; }
  .shopdev .grid { display: grid; }
  .shopdev .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
  .shopdev .bg-white { background-color: #ffffff; }
  .shopdev .bg-opacity-10 { background-color: rgba(255, 255, 255, 0.1); }
  .shopdev .bg-\[#1F72CD\] { background-color: #1F72CD; }
  .shopdev .text-gray-600 { color: #4b5563; }
  
  @media (min-width: 640px) {
    .shopdev .sm\:px-8 { padding-left: 2rem; padding-right: 2rem; }
    .shopdev .sm\:flex-row { flex-direction: row; }
    .shopdev .sm\:items-center { align-items: center; }
    .shopdev .sm\:gap-\[24px\] { gap: 24px; }
    .shopdev .sm\:gap-\[38px\] { gap: 38px; }
    .shopdev .sm\:text-\[52px\] { font-size: 52px; }
    .shopdev .sm\:w-auto { width: auto; }
  }
  
  @media (min-width: 768px) {
    .shopdev .md\:px-\[60px\] { padding-left: 60px; padding-right: 60px; }
    .shopdev .md\:px-\[85px\] { padding-left: 85px; padding-right: 85px; }
    .shopdev .md\:px-\[163px\] { padding-left: 163px; padding-right: 163px; }
    .shopdev .md\:px-\[283px\] { padding-left: 283px; padding-right: 283px; }
    .shopdev .md\:px-\[369px\] { padding-left: 369px; padding-right: 369px; }
    .shopdev .md\:px-\[8\] { padding-left: 2rem; padding-right: 2rem; }
    .shopdev .md\:px-\[30px\] { padding-left: 30px; padding-right: 30px; }
    .shopdev .md\:py-\[15px\] { padding-top: 15px; padding-bottom: 15px; }
    .shopdev .md\:py-\[23px\] { padding-top: 23px; padding-bottom: 23px; }
    .shopdev .md\:py-\[54px\] { padding-top: 54px; padding-bottom: 54px; }
    .shopdev .md\:py-\[62px\] { padding-top: 62px; padding-bottom: 62px; }
    .shopdev .md\:pb-\[26px\] { padding-bottom: 26px; }
    .shopdev .md\:pb-\[38px\] { padding-bottom: 38px; }
    .shopdev .md\:pb-\[82px\] { padding-bottom: 82px; }
    .shopdev .md\:pb-\[100px\] { padding-bottom: 100px; }
    .shopdev .md\:mb-\[26px\] { margin-bottom: 26px; }
    .shopdev .md\:mb-\[38px\] { margin-bottom: 38px; }
    .shopdev .md\:mb-\[82px\] { margin-bottom: 82px; }
    .shopdev .md\:text-\[16px\] { font-size: 16px; }
    .shopdev .md\:text-\[20px\] { font-size: 20px; }
    .shopdev .md\:text-\[22px\] { font-size: 22px; }
    .shopdev .md\:text-\[23px\] { font-size: 23px; }
    .shopdev .md\:text-\[24px\] { font-size: 24px; }
    .shopdev .md\:text-\[25px\] { font-size: 25px; }
    .shopdev .md\:text-\[35px\] { font-size: 35px; }
    .shopdev .md\:text-\[40px\] { font-size: 40px; }
    .shopdev .md\:text-\[52px\] { font-size: 52px; }
    .shopdev .md\:text-\[94px\] { font-size: 94px; }
    .shopdev .md\:leading-\[100%\] { line-height: 100%; }
    .shopdev .md\:rounded-\[40px\] { border-radius: 40px; }
    .shopdev .md\:gap-\[29px\] { gap: 29px; }
    .shopdev .md\:gap-\[60px\] { gap: 60px; }
    .shopdev .md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .shopdev .md\:flex { display: flex; }
    .shopdev .md\:flex-row { flex-direction: row; }
    .shopdev .md\:hidden { display: none; }
    .shopdev .md\:space-y-\[20px\] > * + * { margin-top: 20px; }
    .shopdev .md\:p-\[40px\] { padding: 40px; }
    .shopdev .md\:w-\[45px\] { width: 45px; }
    .shopdev .md\:h-\[45px\] { height: 45px; }
    .shopdev .md\:block { display: block; }
  }
  
  @media (min-width: 1024px) {
    .shopdev .lg\:px-\[95px\] { padding-left: 95px; padding-right: 95px; }
    .shopdev .lg\:px-\[127px\] { padding-left: 127px; padding-right: 127px; }
    .shopdev .lg\:px-\[163px\] { padding-left: 163px; padding-right: 163px; }
    .shopdev .lg\:flex { display: flex; }
    .shopdev .lg\:flex-row { flex-direction: row; }
    .shopdev .lg\:hidden { display: none; }
    .shopdev .lg\:gap-\[60px\] { gap: 60px; }
