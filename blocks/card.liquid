{%- comment -%}
  Theme Block: Card
  -----------------
  Generic card wrapper with configurable background, padding, and border radius.
  Use as a container for custom content.
{%- endcomment -%}

{%- liquid
  assign card_bg = block.settings.show_background | default: false
  assign card_bg_color = block.settings.background_color | default: '#f9f9f9'
  assign card_padding = block.settings.padding | default: 24
  assign card_radius = block.settings.border_radius | default: 12
  assign card_align = block.settings.text_align | default: 'center'
-%}

<div
  class="block-card{% if card_bg %} block-card--has-bg{% endif %}"
  {{ block.shopify_attributes }}
  style="
    {% if card_bg %}
      background: {{ card_bg_color }};
      padding: {{ card_padding }}px;
      border-radius: {{ card_radius }}px;
    {% endif %}
    text-align: {{ card_align }};
  "
>
  {%- if block.settings.heading != blank -%}
    <h3 class="block-card__heading">{{ block.settings.heading | escape }}</h3>
  {%- endif -%}

  {%- if block.settings.content != blank -%}
    <div class="block-card__content rte">
      {{ block.settings.content }}
    </div>
  {%- endif -%}

  {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
    <a href="{{ block.settings.button_link }}" class="block-card__button button">
      {{ block.settings.button_text | escape }}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .block-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .block-card__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .block-card__content {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.6;
  }

  .block-card__content p {
    margin: 0;
  }

  .block-card__content p + p {
    margin-top: 1em;
  }

  .block-card__button {
    display: inline-block;
    margin-top: 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Card",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "Show Background",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Card"
    }
  ]
}
{% endschema %}
