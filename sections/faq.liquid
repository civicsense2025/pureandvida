        { "value": "blocks", "label": "Blocks Mode (Flexible - Add/Remove)" },
        { "value": "settings", "label": "Settings Mode (Fixed - 10 Slots)" }
      ],
      "default": "blocks",
      "info": "Blocks: Dynamic, drag-and-drop, unlimited questions. Settings: Fixed 10 slots, simpler for non-technical users."
    },
    {
      "type": "header",
