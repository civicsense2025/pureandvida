{% liquid
  # @description Hero title section with title, subtitle, and divider
  # @settings title {String} - Main hero title
  # @settings subtitle {String} - Hero subtitle text
  # @example
  #   Add to index.json template for homepage hero title section
  assign structural_element = section.settings.structural_element | default: 'section'
%}

<{{ structural_element }} class="hero-title-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}">
  <div class="hero-title-content page-width" style="text-align: {{ section.settings.text_alignment }};">
    {% if section.settings.title != blank %}
      <h1 class="hero-main-title" style="{% if section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %}">
        <span class="hero-title-line1">{{ section.settings.title | escape }}</span>
        {% if section.settings.show_trademark %}
          <span class="hero-trademark">™</span>
        {% endif %}
      </h1>
    {% endif %}
    {% if section.settings.show_divider %}
      <div class="hero-divider">{{ section.settings.divider_text }}</div>
    {% endif %}
    {% if section.settings.subtitle != blank %}
      <p class="hero-subtitle" style="{% if section.settings.subtitle_color != blank %}color: {{ section.settings.subtitle_color }};{% endif %}">{{ section.settings.subtitle | escape }}</p>
    {% endif %}
  </div>
</{{ structural_element }}>

<style>
  /* Hero Title Section - Responsive Styles */
  .hero-title-section {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .hero-title-content {
    padding: 0 clamp(1rem, 4vw, 2rem);
  }

  .hero-main-title {
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.1;
    margin: 0 0 clamp(0.75rem, 2vw, 1.5rem) 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .hero-title-line1 {
    display: inline;
  }

  .hero-trademark {
    font-size: clamp(0.875rem, 2vw, 1.25rem);
    vertical-align: super;
  }

  .hero-divider {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    margin: clamp(0.5rem, 2vw, 1rem) 0;
    letter-spacing: clamp(0.1em, 0.5vw, 0.3em);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    line-height: 1.5;
    margin: clamp(0.5rem, 2vw, 1rem) 0 0 0;
    max-width: 100%;
  }

  /* Mobile - 479px and below */
  @media screen and (max-width: 479px) {
    .hero-title-section {
      padding: 1.5rem 0;
    }

    .hero-title-content {
      padding: 0 1rem;
    }

    .hero-main-title {
      font-size: 1.75rem;
      line-height: 1.2;
    }

    .hero-trademark {
      font-size: 0.75rem;
    }

    .hero-divider {
      font-size: 0.875rem;
      letter-spacing: 0.1em;
    }

    .hero-subtitle {
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }

  /* Small tablets - 480px to 767px */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .hero-title-section {
      padding: 2rem 0;
    }

    .hero-main-title {
      font-size: 2.25rem;
    }

    .hero-trademark {
      font-size: 0.875rem;
    }

    .hero-divider {
      font-size: 1rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }
  }

  /* Tablets - 768px to 1023px */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .hero-title-section {
      padding: 2.5rem 0;
    }

    .hero-main-title {
      font-size: 3rem;
    }

    .hero-trademark {
      font-size: 1rem;
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Title",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "MYCOMATCHA"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color"
    },
    {
      "type": "checkbox",
      "id": "show_trademark",
      "label": "Show Trademark (™)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Divider",
      "default": true
    },
    {
      "type": "text",
      "id": "divider_text",
      "label": "Divider Text",
      "default": "+++++++++"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The magic of matcha meets the wisdom of mushrooms"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Structural Elements"
    },
    {
      "type": "select",
      "id": "structural_element",
      "label": "HTML Element",
      "options": [
        { "value": "section", "label": "Section (default)" },
        { "value": "article", "label": "Article" },
        { "value": "aside", "label": "Aside" },
        { "value": "div", "label": "Div" }
      ],
      "default": "section",
      "info": "Choose the semantic HTML element for this section"
    }
  ],
  "presets": [
    {
      "name": "Hero Title"
    }
  ]
}
{% endschema %}

