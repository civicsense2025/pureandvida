{%- liquid
  # @description Footer section with customizable columns, social media, newsletter, and payment icons
  # Supports multiple link list blocks for footer columns
  # @settings logo_text {String} - Footer logo text
  # @settings copyright_text {String} - Copyright text
  # @settings show_newsletter {Boolean} - Display newsletter signup
  # @settings show_social_media {Boolean} - Display social media icons
  # @settings show_payment_icons {Boolean} - Display payment method icons
  # @blocks link_list - Footer column with heading and links
  # @example
  #   Section is automatically included in theme.liquid layout
-%}

<footer class="footer pure-vida-footer" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}">
  <div class="footer__content page-width">
    <div class="footer__left">
      <div class="footer__logo">
        <span class="footer__logo-text" style="{% if section.settings.logo_text_color != blank %}color: {{ section.settings.logo_text_color }};{% endif %}">{{ section.settings.logo_text | default: "PURE VIDA" }}</span>
        {%- if section.settings.show_plus -%}
          <span class="footer__plus" style="{% if section.settings.logo_text_color != blank %}color: {{ section.settings.logo_text_color }};{% endif %}">+</span>
        {%- endif -%}
      </div>
      {%- if section.settings.copyright_text != blank -%}
        <p class="footer__copyright" style="{% if section.settings.copyright_color != blank %}color: {{ section.settings.copyright_color }};{% endif %}">{{ section.settings.copyright_text }}</p>
      {%- else -%}
        <p class="footer__copyright" style="{% if section.settings.copyright_color != blank %}color: {{ section.settings.copyright_color }};{% endif %}">Copyright Pura Vida 2025. All rights reserved.</p>
      {%- endif -%}
    </div>

    <div class="footer__middle">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer__column" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer__heading" style="{% if block.settings.heading_color != blank %}color: {{ block.settings.heading_color }};{% endif %}">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <a href="{{ link.url }}" class="footer__link" style="{% if block.settings.link_color != blank %}color: {{ block.settings.link_color }};{% endif %}">{{ link.title | escape }}</a>
              {%- endfor -%}
            {%- endif -%}
            {%- if block.settings.custom_links != blank -%}
              {%- assign links = block.settings.custom_links | newline_to_br | split: '<br />' -%}
              {%- for link_line in links -%}
                {%- assign link_parts = link_line | split: '|' -%}
                {%- if link_parts.size == 2 -%}
                  <a href="{{ link_parts[0] | strip }}" class="footer__link" style="{% if block.settings.link_color != blank %}color: {{ block.settings.link_color }};{% endif %}">{{ link_parts[1] | strip | escape }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__right">
      {%- if section.settings.show_newsletter -%}
        <div class="footer__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h3 class="footer__heading" style="{% if section.settings.newsletter_heading_color != blank %}color: {{ section.settings.newsletter_heading_color }};{% endif %}">{{ section.settings.newsletter_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.newsletter_description != blank -%}
            <p style="{% if section.settings.newsletter_text_color != blank %}color: {{ section.settings.newsletter_text_color }};{% endif %}">{{ section.settings.newsletter_description }}</p>
          {%- endif -%}
          {%- form 'customer', class: 'footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}" required>
            <button type="submit" style="{% if section.settings.newsletter_button_color != blank %}background-color: {{ section.settings.newsletter_button_color }};{% endif %}{% if section.settings.newsletter_button_text_color != blank %}color: {{ section.settings.newsletter_button_text_color }};{% endif %}">
              {{ section.settings.newsletter_button_text | default: "Subscribe" }}
            </button>
          {%- endform -%}
        </div>
      {%- endif -%}
      
      {%- if section.settings.show_social_media -%}
        <div class="footer__social">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social_media' and block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" target="_blank" rel="noopener noreferrer" class="footer__social-link" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 24 }}" alt="{{ block.settings.platform | escape }}">
                {%- else -%}
                  {{ block.settings.platform | escape }}
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment-methods">
          {% render 'payment-icons' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "PURE VIDA"
    },
    {
      "type": "color",
      "id": "logo_text_color",
      "label": "Logo Text Color"
    },
    {
      "type": "checkbox",
      "id": "show_plus",
      "label": "Show Plus Sign (+)",
      "default": true
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "<p>Copyright Pura Vida 2025. All rights reserved.</p>"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright Text Color"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Signup",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "color",
      "id": "newsletter_heading_color",
      "label": "Newsletter Heading Color"
    },
    {
      "type": "textarea",
      "id": "newsletter_description",
      "label": "Newsletter Description"
    },
    {
      "type": "color",
      "id": "newsletter_text_color",
      "label": "Newsletter Text Color"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "newsletter_button_color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "newsletter_button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show Social Media Links",
      "default": true
    },
    {
      "type": "header",
      "content": "Payment Icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link List",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Links"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "textarea",
          "id": "custom_links",
          "label": "Custom Links",
          "info": "Format: URL|Link Text (one per line)"
        },
        {
          "type": "color",
          "id": "link_color",
          "label": "Link Color"
        }
      ]
    },
    {
      "type": "social_media",
      "name": "Social Media",
      "settings": [
        {
          "type": "text",
          "id": "platform",
          "label": "Platform Name",
          "default": "Facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "About Us"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "For You"
        }
      }
    ]
  }
}
{% endschema %}
