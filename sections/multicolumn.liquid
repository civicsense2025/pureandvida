    },
    {
      "type": "checkbox",
      "id": "show_card_background",
      "label": "Show Card Background",
      "default": false
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 24,
      "step": 2,
