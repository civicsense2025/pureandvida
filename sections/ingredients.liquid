{% liquid
  # @description Ingredients section displaying product ingredients with images and descriptions
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # Supports both grid and carousel layouts
  # @settings content_mode (String) - Content mode: 'blocks' or 'settings'
  # @settings layout_style (String) - Layout style: 'grid' or 'carousel'
  # @settings heading (String) - Section heading
  # @settings show_hero_image (Boolean) - Display hero ingredients image
  # @settings columns_desktop (Number) - Number of columns on desktop
  # @blocks ingredient_item - Individual ingredient with image, name, and description
  # @example
  #   Use blocks mode for dynamic ingredients, settings mode for fixed 8-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
  assign layout_style = section.settings.layout_style | default: 'grid'
  
  # Count ingredient items once so both Theme Editor UI and markup can access it
  assign ingredient_count = 0
  if section.settings.content_mode == 'blocks'
    assign ingredient_count = section.blocks.size
  else
    for i in (1..8)
      assign name_key = 'ingredient_' | append: i | append: '_name'
      assign desc_key = 'ingredient_' | append: i | append: '_description'
      assign name = section.settings[name_key]
      assign desc = section.settings[desc_key]
      if name != blank or desc != blank
        assign ingredient_count = ingredient_count | plus: 1
      endif
    endfor
  endif
%}

<{{ structural_element }} class="ingredients-section{% if layout_style == 'carousel' %} ingredients-section--carousel{% endif %}"
     {% if request.design_mode %}data-section-type="ingredients" data-layout="{{ layout_style }}" data-columns="{{ section.settings.columns_desktop }}" data-items="{{ ingredient_count }}"{% endif %}
     style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  {%- if section.settings.show_gradient -%}
    <div class="ingredients-gradient"></div>
  {%- endif -%}

  {%- if request.design_mode -%}
    <div class="editor-controls editor-controls--ingredients">
      <span class="editor-label">🌿 Ingredients</span>
      <span class="editor-info">{{ layout_style | capitalize }} | {% if layout_style == 'grid' %}{{ section.settings.columns_desktop }} cols{% else %}{{ section.settings.carousel_items_desktop }} per slide{% endif %} | {{ ingredient_count }} items{% if section.settings.show_hero_image %} | Hero Image{% endif %}</span>
    </div>
  {%- endif -%}

  <div class="ingredients-content page-width">
    <div class="ingredients-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ingredients-title" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">
          {%- if section.settings.heading_small != blank -%}
            <span class="ingredients-title-small">{{ section.settings.heading_small | escape }}</span>
          {%- endif -%}
          <span class="ingredients-title-large">{{ section.settings.heading | escape }}</span>
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="ingredients-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_hero_image -%}
      <div class="ingredients-image">
        {%- if section.settings.ingredients_image != blank -%}
          <img src="{{ section.settings.ingredients_image | image_url: width: 548 }}" alt="MycoMatcha Ingredients" loading="lazy">
        {%- else -%}
          <img src="{{ '55839acdac0cccc8f69f297d49bbcfde60b91904.png' | asset_url }}" alt="MycoMatcha Ingredients" loading="lazy">
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if ingredient_count > 0 -%}
      {%- if layout_style == 'carousel' -%}
        {%- comment -%} Carousel Layout {%- endcomment -%}
        <div class="ingredients-carousel__wrapper" 
             data-carousel-id="ingredients-{{ section.id }}"
             data-items-desktop="{{ section.settings.carousel_items_desktop }}"
             data-items-mobile="{{ section.settings.carousel_items_mobile }}"
             data-autoplay="{{ section.settings.carousel_autoplay }}"
             data-autoplay-speed="{{ section.settings.carousel_autoplay_speed }}"
             data-gap="{{ section.settings.item_spacing }}">
          
          <div class="ingredients-carousel__container" role="region" aria-label="Ingredients carousel">
            <div class="ingredients-carousel__track" data-carousel-track>
              {%- if section.settings.content_mode == 'blocks' -%}
                {%- for block in section.blocks -%}
                  <div class="ingredients-carousel__slide" data-carousel-slide>
                    <div class="ingredient-card" {{ block.shopify_attributes }}>
                      {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                      {%- elsif block.settings.image_asset != blank -%}
                        <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.name != blank -%}
                        <h3 class="ingredient-name" style="{% if block.settings.name_color != blank %}color: {{ block.settings.name_color }};{% endif %}">{{ block.settings.name | escape }}</h3>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <p class="ingredient-description" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
                      {%- endif -%}
                      {%- if block.settings.benefit_tags != blank -%}
                        <div class="ingredient-benefits">
                          {{ block.settings.benefit_tags }}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..8) -%}
                  {%- assign name_key = 'ingredient_' | append: i | append: '_name' -%}
                  {%- assign desc_key = 'ingredient_' | append: i | append: '_description' -%}
                  {%- assign image_key = 'ingredient_' | append: i | append: '_image' -%}
                  {%- assign name = section.settings[name_key] -%}
                  {%- assign desc = section.settings[desc_key] -%}
                  {%- assign image = section.settings[image_key] -%}
                  {%- if name != blank or desc != blank -%}
                    <div class="ingredients-carousel__slide" data-carousel-slide>
                      <div class="ingredient-card">
                        {%- if image != blank -%}
                          <img src="{{ image | image_url: width: 400 }}" alt="{{ name | escape }}" loading="lazy">
                        {%- endif -%}
                        {%- if name != blank -%}
                          <h3 class="ingredient-name">{{ name | escape }}</h3>
                        {%- endif -%}
                        {%- if desc != blank -%}
                          <p class="ingredient-description">{{ desc }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.carousel_show_arrows -%}
            <button class="ingredients-carousel__button ingredients-carousel__button--prev" 
                    data-carousel-prev 
                    aria-label="Previous ingredients"
                    type="button">
              <span aria-hidden="true">‹</span>
            </button>
            <button class="ingredients-carousel__button ingredients-carousel__button--next" 
                    data-carousel-next 
                    aria-label="Next ingredients"
                    type="button">
              <span aria-hidden="true">›</span>
            </button>
          {%- endif -%}

          {%- if section.settings.carousel_show_dots and ingredient_count > section.settings.carousel_items_desktop -%}
            <div class="ingredients-carousel__dots" data-carousel-dots role="tablist" aria-label="Ingredients navigation">
              {%- assign total_slides = ingredient_count | divided_by: section.settings.carousel_items_desktop | ceil -%}
              {%- for i in (1..total_slides) -%}
                <button class="ingredients-carousel__dot{% if forloop.first %} ingredients-carousel__dot--active{% endif %}" 
                        data-carousel-dot 
                        data-slide-index="{{ forloop.index0 }}"
                        aria-label="Go to slide {{ forloop.index }}"
                        type="button"
                        role="tab"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="visually-hidden">Slide {{ forloop.index }}</span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%} Grid Layout {%- endcomment -%}
        <div class="ingredients-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
          {%- if section.settings.content_mode == 'blocks' -%}
            {%- for block in section.blocks -%}
              <div class="ingredient-card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                {%- elsif block.settings.image_asset != blank -%}
                  <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                {%- endif -%}
                {%- if block.settings.name != blank -%}
                  <h3 class="ingredient-name" style="{% if block.settings.name_color != blank %}color: {{ block.settings.name_color }};{% endif %}">{{ block.settings.name | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="ingredient-description" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if block.settings.benefit_tags != blank -%}
                  <div class="ingredient-benefits">
                    {{ block.settings.benefit_tags }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Settings mode - Fixed fields {%- endcomment -%}
            {%- for i in (1..8) -%}
              {%- assign name_key = 'ingredient_' | append: i | append: '_name' -%}
              {%- assign desc_key = 'ingredient_' | append: i | append: '_description' -%}
              {%- assign image_key = 'ingredient_' | append: i | append: '_image' -%}
              {%- assign name = section.settings[name_key] -%}
              {%- assign desc = section.settings[desc_key] -%}
              {%- assign image = section.settings[image_key] -%}
              {%- if name != blank or desc != blank -%}
                <div class="ingredient-card">
                  {%- if image != blank -%}
                    <img src="{{ image | image_url: width: 400 }}" alt="{{ name | escape }}" loading="lazy">
                  {%- endif -%}
                  {%- if name != blank -%}
                    <h3 class="ingredient-name">{{ name | escape }}</h3>
                  {%- endif -%}
                  {%- if desc != blank -%}
                    <p class="ingredient-description">{{ desc }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</{{ structural_element }}>

<style>
  {% if request.design_mode %}
  /* Theme Editor Visual Controls */
  .ingredients-section {
    position: relative;
    outline: 2px dashed rgba(76, 175, 80, 0.3);
    outline-offset: -2px;
  }

  .ingredients-section:hover {
    outline-color: rgba(76, 175, 80, 0.6);
  }

  .editor-controls--ingredients {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.90);
    color: white;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 11px;
    font-family: var(--font-body-family);
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    pointer-events: none;
    max-width: 450px;
  }

  .editor-label {
    font-weight: 600;
    color: #a5d6a7;
    font-size: 12px;
  }

  .editor-info {
    opacity: 0.85;
    font-size: 10px;
    line-height: 1.4;
  }

  /* Grid Visualizer */
  {% if section.settings.layout_style == 'grid' %}
  .ingredients-grid {
    position: relative;
  }

  .ingredients-grid::before {
    content: '{{ section.settings.columns_desktop }}-Column Ingredient Grid';
    position: absolute;
    top: -24px;
    left: 0;
    background: rgba(76, 175, 80, 0.9);
    color: white;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-family: monospace;
    pointer-events: none;
    z-index: 10;
  }
  {% endif %}

  /* Ingredient Card Indicators */
  .ingredient-card {
    position: relative;
    outline: 1px dashed rgba(139, 195, 74, 0.2);
    outline-offset: -1px;
  }

  .ingredient-card:hover {
    outline-color: rgba(139, 195, 74, 0.5);
    background: rgba(139, 195, 74, 0.05);
  }

  /* Hero Image Indicator */
  {% if section.settings.show_hero_image %}
  .ingredients-image::before {
    content: 'Hero Ingredient Image';
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(46, 125, 50, 0.9);
    color: white;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-family: monospace;
    pointer-events: none;
    z-index: 10;
  }

  .ingredients-image {
    position: relative;
  }
  {% endif %}

  /* Carousel Indicators */
  {% if section.settings.layout_style == 'carousel' %}
  .ingredients-carousel__wrapper::before {
    content: 'Carousel: {{ section.settings.carousel_items_desktop }} items/slide{% if section.settings.carousel_autoplay %} • Autoplay{% endif %}';
    position: absolute;
    top: -24px;
    left: 0;
    background: rgba(255, 152, 0, 0.9);
    color: white;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-family: monospace;
    pointer-events: none;
    z-index: 10;
  }

  .ingredients-carousel__wrapper {
    position: relative;
  }
  {% endif %}

  /* Header Section Indicator */
  .ingredients-header {
    position: relative;
  }

  .ingredients-header::before {
    content: 'Section Header';
    position: absolute;
    top: -20px;
    left: 0;
    background: rgba(104, 159, 56, 0.8);
    color: white;
    padding: 2px 6px;
    border-radius: 2px;
    font-size: 9px;
    font-family: monospace;
    pointer-events: none;
    z-index: 5;
  }
  {% endif %}

  /* Ingredients Section Responsive Styles */
  .ingredients-grid {
    display: grid;
    gap: clamp(20px, 4vw, {{ section.settings.item_spacing }}px);
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .ingredients-grid {
      grid-template-columns: 1fr !important;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .ingredients-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .ingredients-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }
  
  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .ingredients-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  
  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .ingredients-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 5 }}, 1fr) !important;
    }
  }

  /* Carousel Layout Styles */
  .ingredients-section--carousel .ingredients-carousel__wrapper {
    margin-top: 20px;
  }

  .ingredients-section--carousel .ingredient-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
</style>

{% schema %}
{
  "name": "🌿 Ingredients Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Showcase product ingredients with images and descriptions. Choose between flexible blocks (add/remove/reorder) or fixed settings (8 pre-defined slots). Supports both grid and carousel layouts."
    },
    {
      "type": "header",
      "content": "📝 Content Management Mode"
    },
    {
      "type": "select",
      "id": "content_mode",
      "label": "How to Manage Content",
      "options": [
        { "value": "blocks", "label": "Blocks Mode (Flexible - Add/Remove)" },
        { "value": "settings", "label": "Settings Mode (Fixed - 8 Slots)" }
      ],
      "default": "blocks",
      "info": "Blocks: Dynamic, drag-and-drop, unlimited items. Settings: Fixed 8 ingredient slots, simpler interface."
    },
    {
      "type": "header",
      "content": "✏️ Section Header & Description"
    },
    {
      "type": "text",
      "id": "heading_small",
      "label": "Small Heading Text",
      "default": "What's Inside + ",
      "info": "Optional small text that appears before the main heading. Example: 'What's Inside +', 'Our Ingredients:', 'Made With:'"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Why It Matters",
      "info": "Primary section headline. Displays large and prominent. Example: 'Why It Matters', 'Pure Ingredients', 'What's Inside'"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "info": "Custom color for both small and main heading text. Leave blank to use theme default."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Horizontal alignment for heading text."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "MycoMatcha pairs ceremonial-grade matcha with Lion's Mane, Reishi, Cordyceps, and Turkey Tail — four adaptogenic mushrooms that support focus, energy, and balance.",
      "info": "Introductory paragraph below the heading. Explain what makes your ingredients special. 1-3 sentences recommended."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "info": "Custom color for description text. Leave blank to use theme default."
    },
    {
      "type": "header",
      "content": "🖼️ Hero Image (Optional)"
    },
    {
      "type": "paragraph",
      "content": "Display a large featured image above your ingredient list. Great for showing all ingredients together or lifestyle imagery."
    },
    {
      "type": "checkbox",
      "id": "show_hero_image",
      "label": "Show Hero Image",
      "default": true,
      "info": "Display a featured image between the header and ingredient list."
    },
    {
      "type": "image_picker",
      "id": "ingredients_image",
      "label": "Hero Image",
      "info": "Recommended: 1200x600px or larger. Shows all ingredients together or lifestyle shot."
    },
    {
      "type": "header",
      "content": "📐 Layout & Display Style"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Display Style",
      "options": [
        { "value": "grid", "label": "Grid (All ingredients visible)" },
        { "value": "carousel", "label": "Carousel (Swipeable slides)" }
      ],
      "default": "grid",
      "info": "Grid: Traditional layout, all ingredients visible at once. Carousel: Slides with navigation, great for many items."
    },
    {
      "type": "paragraph",
      "content": "**Grid Layout Controls:** These settings only apply when Display Style is set to Grid."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "col",
      "default": 5,
      "info": "How many ingredients appear side-by-side on desktop. Common: 5 (showcase), 4 (balanced), 3 (detailed)."
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "col",
      "default": 1,
      "info": "Columns on mobile devices. Usually 1 (vertical stack) or 2 (compact grid)."
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Space Between Items",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30,
      "info": "Gap between ingredient cards. Standard: 20-30px (comfortable), 40-50px (spacious), 10-15px (compact)."
    },
    {
      "type": "header",
      "content": "🎠 Carousel Settings"
    },
    {
      "type": "paragraph",
      "content": "**Carousel Controls:** These settings only apply when Display Style is set to Carousel."
    },
    {
      "type": "range",
      "id": "carousel_items_desktop",
      "label": "Items Per Slide (Desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "How many ingredients visible at once on desktop. More items = compact view, fewer = detailed view."
    },
    {
      "type": "range",
      "id": "carousel_items_mobile",
      "label": "Items Per Slide (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "info": "Items visible per slide on mobile. Usually 1 for best readability."
    },
    {
      "type": "checkbox",
      "id": "carousel_show_arrows",
      "label": "Show Navigation Arrows",
      "default": true,
      "info": "Display left/right arrows for manual navigation."
    },
    {
      "type": "checkbox",
      "id": "carousel_show_dots",
      "label": "Show Dot Indicators",
      "default": true,
      "info": "Display dots below carousel showing current slide position."
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Enable Auto-play",
      "default": false,
      "info": "Automatically advance slides. Use carefully - can be distracting for users reading content."
    },
    {
      "type": "range",
      "id": "carousel_autoplay_speed",
      "label": "Auto-play Speed",
      "min": 2000,
      "max": 9999,
      "step": 500,
      "unit": "ms",
      "default": 5000,
      "info": "Milliseconds between auto-advance. 5000ms = 5 seconds. Give users time to read!"
    },
    {
      "type": "header",
      "content": "🎨 Styling & Colors"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40,
      "info": "Vertical spacing above and below section content. Standard: 40-60px."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "info": "Section background color. Leave blank for transparent."
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Enable Gradient Overlay",
      "default": true,
      "info": "Adds a subtle gradient effect to the background for visual depth."
    },
    {
      "type": "header",
      "content": "⚙️ Advanced Settings"
    },
    {
      "type": "select",
      "id": "structural_element",
      "label": "HTML Semantic Element",
      "options": [
        { "value": "section", "label": "Section (recommended)" },
        { "value": "article", "label": "Article" },
        { "value": "aside", "label": "Aside" },
        { "value": "div", "label": "Div" }
      ],
      "default": "section",
      "info": "Choose semantic HTML element for better SEO and accessibility. Section is recommended for most use cases."
    },
    {
      "type": "header",
      "content": "Fixed Ingredients (Settings Mode)"
