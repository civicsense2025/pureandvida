{% liquid
  # @description Reusable carousel component with navigation, dots, and responsive settings
  # @param carousel_id {String} - Unique ID for this carousel instance
  # @param items {Array} - Array of items to display in carousel
  # @param items_per_slide_desktop {Number} - Number of items visible on desktop
  # @param items_per_slide_mobile {Number} - Number of items visible on mobile
  # @param show_arrows {Boolean} - Show navigation arrows
  # @param show_dots {Boolean} - Show dot indicators
  # @param autoplay {Boolean} - Enable auto-play
  # @param autoplay_speed {Number} - Auto-play speed in milliseconds
  # @param gap {Number} - Gap between items in pixels
  # @param class_name {String} - Additional CSS classes
  # @example
  #   {% render 'carousel', carousel_id: 'testimonials-1', items: section.blocks, items_per_slide_desktop: 3, items_per_slide_mobile: 1 %}
%}

{% assign carousel_id = carousel_id | default: 'carousel-' | append: section.id %}
{% assign items_per_slide_desktop = items_per_slide_desktop | default: 3 %}
{% assign items_per_slide_mobile = items_per_slide_mobile | default: 1 %}
{% assign show_arrows = show_arrows | default: true %}
{% assign show_dots = show_dots | default: true %}
{% assign autoplay = autoplay | default: false %}
{% assign autoplay_speed = autoplay_speed | default: 5000 %}
{% assign gap = gap | default: 30 %}
{% assign class_name = class_name | default: 'carousel' %}

<div class="{{ class_name }}__wrapper" 
     data-carousel-id="{{ carousel_id }}"
     data-items-desktop="{{ items_per_slide_desktop }}"
     data-items-mobile="{{ items_per_slide_mobile }}"
     data-autoplay="{{ autoplay }}"
     data-autoplay-speed="{{ autoplay_speed }}"
     data-gap="{{ gap }}">
  
  <div class="{{ class_name }}__container" role="region" aria-label="Carousel">
    <div class="{{ class_name }}__track" data-carousel-track>
      {% for item in items %}
        <div class="{{ class_name }}__slide" data-carousel-slide>
          {{ item }}
        </div>
      {% endfor %}
    </div>
  </div>

  {% if show_arrows %}
    <button class="{{ class_name }}__button {{ class_name }}__button--prev" 
            data-carousel-prev 
            aria-label="Previous slide"
            type="button">
      <span aria-hidden="true">‹</span>
    </button>
    <button class="{{ class_name }}__button {{ class_name }}__button--next" 
            data-carousel-next 
            aria-label="Next slide"
            type="button">
      <span aria-hidden="true">›</span>
    </button>
  {% endif %}

  {% if show_dots and items.size > items_per_slide_desktop %}
    <div class="{{ class_name }}__dots" data-carousel-dots role="tablist" aria-label="Carousel navigation">
      {% assign total_slides = items.size | divided_by: items_per_slide_desktop | ceil %}
      {% for i in (1..total_slides) %}
        <button class="{{ class_name }}__dot{% if forloop.first %} {{ class_name }}__dot--active{% endif %}" 
                data-carousel-dot 
                data-slide-index="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
          <span class="visually-hidden">Slide {{ forloop.index }}</span>
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>

