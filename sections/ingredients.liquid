{% liquid
  # @description Ingredients section displaying product ingredients with images and descriptions
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings heading {String} - Section heading
  # @settings show_hero_image {Boolean} - Display hero ingredients image
  # @settings columns_desktop {Number} - Number of columns on desktop
  # @blocks ingredient_item - Individual ingredient with image, name, and description
  # @example
  #   Use blocks mode for dynamic ingredients, settings mode for fixed 8-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
%}

<{{ structural_element }} class="ingredients-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  {%- if section.settings.show_gradient -%}
    <div class="ingredients-gradient"></div>
  {%- endif -%}
  
  <div class="ingredients-content page-width">
    <div class="ingredients-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ingredients-title" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">
          {%- if section.settings.heading_small != blank -%}
            <span class="ingredients-title-small">{{ section.settings.heading_small | escape }}</span>
          {%- endif -%}
          <span class="ingredients-title-large">{{ section.settings.heading | escape }}</span>
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="ingredients-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_hero_image -%}
      <div class="ingredients-image">
        {%- if section.settings.ingredients_image != blank -%}
          <img src="{{ section.settings.ingredients_image | image_url: width: 548 }}" alt="MycoMatcha Ingredients">
        {%- else -%}
          <img src="{{ '55839acdac0cccc8f69f297d49bbcfde60b91904.png' | asset_url }}" alt="MycoMatcha Ingredients">
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ingredients-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
      {%- if section.settings.content_mode == 'blocks' -%}
        {%- for block in section.blocks -%}
          <div class="ingredient-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.name | escape }}">
            {%- elsif block.settings.image_asset != blank -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name | escape }}">
            {%- endif -%}
            {%- if block.settings.name != blank -%}
              <h3 class="ingredient-name" style="{% if block.settings.name_color != blank %}color: {{ block.settings.name_color }};{% endif %}">{{ block.settings.name | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="ingredient-description" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
            {%- endif -%}
            {%- if block.settings.benefit_tags != blank -%}
              <div class="ingredient-benefits">
                {{ block.settings.benefit_tags }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Settings mode - Fixed fields {%- endcomment -%}
        {%- for i in (1..8) -%}
          {%- assign name_key = 'ingredient_' | append: i | append: '_name' -%}
          {%- assign desc_key = 'ingredient_' | append: i | append: '_description' -%}
          {%- assign image_key = 'ingredient_' | append: i | append: '_image' -%}
          {%- assign name = section.settings[name_key] -%}
          {%- assign desc = section.settings[desc_key] -%}
          {%- assign image = section.settings[image_key] -%}
          {%- if name != blank or desc != blank -%}
            <div class="ingredient-card">
              {%- if image != blank -%}
                <img src="{{ image | image_url: width: 400 }}" alt="{{ name | escape }}">
              {%- endif -%}
              {%- if name != blank -%}
                <h3 class="ingredient-name">{{ name | escape }}</h3>
              {%- endif -%}
              {%- if desc != blank -%}
                <p class="ingredient-description">{{ desc }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</{{ structural_element }}>

<style>
  /* Ingredients Section Responsive Styles */
  .ingredients-grid {
    display: grid;
    gap: clamp(20px, 4vw, {{ section.settings.item_spacing }}px);
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .ingredients-grid {
      grid-template-columns: 1fr !important;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .ingredients-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .ingredients-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }
  
  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .ingredients-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  
  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .ingredients-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr) !important;
    }
  }
</style>

