{% liquid
  # @description Hero section for homepage with product showcase, customizable text, pricing, and CTAs
  # Supports dual product images, taglines, pricing display, discount badges, and multiple layout options
  # @settings title {String} - Main hero title
  # @settings subtitle {String} - Hero subtitle text
  # @settings product_image_1 {Image} - Primary product image
  # @settings product_image_2 {Image} - Secondary product image
  # @settings show_pricing {Boolean} - Display product pricing
  # @settings background_image {Image} - Background image
  # @settings background_color {Color} - Background color
  # @example
  #   Add to index.json template for homepage hero section
%}

<section class="hero-section" {% if request.design_mode %}data-section-type="hero" data-section-id="{{ section.id }}"{% endif %} style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}{% if section.settings.background_image != blank %}background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}'); background-size: {{ section.settings.background_size }}; background-position: {{ section.settings.background_position }};{% endif %}padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.show_gradient -%}
    <div class="hero-gradient" style="opacity: {{ section.settings.gradient_opacity }}%;"></div>
  {%- endif -%}

  {%- if request.design_mode -%}
    <div class="editor-controls">
      <span class="editor-label">Hero Section</span>
      <span class="editor-layout-indicator">Layout: {{ section.settings.image_position | replace: 'row', 'Image Left' | replace: 'row-reverse', 'Image Right' }}</span>
    </div>
  {%- endif -%}
  
  <div class="hero-content page-width" style="text-align: {{ section.settings.text_alignment }};">
    <div class="hero-title-section">
      {%- if section.settings.title != blank -%}
        <h1 class="hero-main-title" style="{% if section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %}">
          <span class="hero-title-line1">{{ section.settings.title | escape }}</span>
          {%- if section.settings.show_trademark -%}
            <span class="hero-trademark">™</span>
          {%- endif -%}
        </h1>
      {%- endif -%}
      {%- if section.settings.show_divider -%}
        <div class="hero-divider">{{ section.settings.divider_text }}</div>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="hero-subtitle" style="{% if section.settings.subtitle_color != blank %}color: {{ section.settings.subtitle_color }};{% endif %}">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>

    <div class="hero-product-section" style="flex-direction: {{ section.settings.image_position }};">
      <div class="hero-product-images">
        {%- if section.settings.product_image_1 != blank -%}
          <img src="{{ section.settings.product_image_1 | image_url: width: 805 }}" alt="MycoMatcha Product" class="hero-product-img-1">
        {%- else -%}
          <img src="{{ '0a5553f60213dd436dd5e60b282c6b7cbec1de3a.png' | asset_url }}" alt="MycoMatcha Product" class="hero-product-img-1">
        {%- endif -%}
        
        {%- if section.settings.product_image_2 != blank -%}
          <img src="{{ section.settings.product_image_2 | image_url: width: 850 }}" alt="MycoMatcha Pouch" class="hero-product-img-2">
        {%- else -%}
          <img src="{{ 'f713d8714eed491eeccc4f7f9c3589229c1b0783.png' | asset_url }}" alt="MycoMatcha Pouch" class="hero-product-img-2">
        {%- endif -%}
      </div>

      <div class="hero-product-info">
        <div class="hero-tagline">
          {%- if section.settings.tagline_line_1 != blank -%}
            <p class="hero-tagline-line1" style="{% if section.settings.tagline_color != blank %}color: {{ section.settings.tagline_color }};{% endif %}">{{ section.settings.tagline_line_1 | escape }}</p>
          {%- endif -%}
          {%- if section.settings.tagline_line_2 != blank -%}
            <p class="hero-tagline-line2" style="{% if section.settings.tagline_color != blank %}color: {{ section.settings.tagline_color }};{% endif %}">{{ section.settings.tagline_line_2 | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_pricing -%}
          <div class="hero-pricing">
            {%- if section.settings.show_compare_price -%}
              <div class="hero-price-compare">
                <span class="hero-price-old" style="{% if section.settings.compare_price_color != blank %}color: {{ section.settings.compare_price_color }};{% endif %}">
                  {%- if section.settings.custom_compare_price != blank -%}
                    {{ section.settings.custom_compare_price }}
                  {%- elsif section.settings.product != blank -%}
                    {{ section.settings.product.selected_or_first_available_variant.compare_at_price | money }}
                  {%- else -%}
                    $45
                  {%- endif -%}
                </span>
              </div>
            {%- endif -%}
            <div class="hero-price-current">
              <span class="hero-price-currency" style="{% if section.settings.price_color != blank %}color: {{ section.settings.price_color }};{% endif %}">$</span>
              <span class="hero-price-amount" style="{% if section.settings.price_color != blank %}color: {{ section.settings.price_color }};{% endif %}">
                {%- if section.settings.custom_price != blank -%}
                  {{ section.settings.custom_price }}
                {%- elsif section.settings.product != blank -%}
                  {{ section.settings.product.selected_or_first_available_variant.price | money | remove: '$' }}
                {%- else -%}
                  34.99
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.description_paragraph_1 != blank or section.settings.description_paragraph_2 != blank -%}
          <div class="hero-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}">
            {%- if section.settings.description_paragraph_1 != blank -%}
              <p>{{ section.settings.description_paragraph_1 }}</p>
            {%- endif -%}
            {%- if section.settings.description_paragraph_2 != blank -%}
              <p>{{ section.settings.description_paragraph_2 }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="hero-cta-section">
          {%- if section.settings.show_quantity_selector -%}
            <div class="hero-quantity-selector">
              <button type="button" class="quantity-btn" data-action="decrease">-</button>
              <input type="number" class="quantity-input" value="{{ section.settings.default_quantity }}" min="{{ section.settings.min_quantity }}" max="{{ section.settings.max_quantity }}" id="hero-quantity">
              <button type="button" class="quantity-btn" data-action="increase">+</button>
            </div>
          {%- endif -%}
          {%- if section.settings.product != blank -%}
            {%- assign featured_product = section.settings.product -%}
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="hero-add-to-cart-form">
              <input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="{{ section.settings.default_quantity }}" id="cart-quantity">
              <button type="submit" class="hero-add-to-cart-btn" style="{% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %}">
                {{ section.settings.button_text | default: "Add to cart" }}
              </button>
            </form>
          {%- else -%}
            <a href="{{ section.settings.button_link | default: routes.collections_url }}" class="hero-add-to-cart-btn" style="{% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}{% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %} text-decoration: none; display: inline-block;">
              {{ section.settings.button_text | default: "Add to cart" }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.show_payment_methods -%}
          <div class="hero-payment-methods">
            {% render 'payment-icons' %}
          </div>
        {%- endif -%}

        {%- if section.settings.show_discount_badge and section.settings.discount_badge_text != blank -%}
          <div class="hero-discount-badge" style="{% if section.settings.badge_background_color != blank %}background-color: {{ section.settings.badge_background_color }};{% endif %}{% if section.settings.badge_text_color != blank %}color: {{ section.settings.badge_text_color }};{% endif %}">
            {{ section.settings.discount_badge_text | escape }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quantityInput = document.getElementById('hero-quantity');
    const cartQuantityInput = document.getElementById('cart-quantity');
    const quantityBtns = document.querySelectorAll('.quantity-btn');

    if (quantityInput && cartQuantityInput) {
      quantityBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const action = this.dataset.action;
          const min = parseInt(quantityInput.min) || 1;
          const max = parseInt(quantityInput.max) || 999;
          let currentValue = parseInt(quantityInput.value) || min;
          
          if (action === 'increase' && currentValue < max) {
            currentValue++;
          } else if (action === 'decrease' && currentValue > min) {
            currentValue--;
          }
          
          quantityInput.value = currentValue;
          if (cartQuantityInput) {
            cartQuantityInput.value = currentValue;
          }
        });
      });
    }
  });
</script>

<style>
  /* Hero Section Responsive Layout */
  .hero-section {
    position: relative;
    min-height: {{ section.settings.min_height }}px;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
  }

  {% if request.design_mode %}
  /* Theme Editor Visual Controls */
  .hero-section {
    outline: 2px dashed rgba(0, 120, 255, 0.3);
    outline-offset: -2px;
  }

  .hero-section:hover {
    outline-color: rgba(0, 120, 255, 0.6);
  }

  .editor-controls {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.85);
    color: white;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    display: flex;
    gap: 12px;
    align-items: center;
    pointer-events: none;
  }

  .editor-label {
    font-weight: 600;
    color: #00d4ff;
  }

  .editor-layout-indicator {
    opacity: 0.8;
  }

  .hero-title-section,
  .hero-product-section,
  .hero-product-info {
    position: relative;
  }

  .hero-title-section::before,
  .hero-product-info::before {
    content: '';
    position: absolute;
    top: -8px;
    left: -8px;
    right: -8px;
    bottom: -8px;
    border: 1px dashed rgba(0, 200, 255, 0.2);
    border-radius: 4px;
    pointer-events: none;
  }

  .hero-title-section:hover::before,
  .hero-product-info:hover::before {
    border-color: rgba(0, 200, 255, 0.5);
  }

  /* Spacing Guides */
  .hero-content {
    position: relative;
  }

  .hero-content::after {
    content: 'Section Padding: {{ section.settings.padding_top }}px / {{ section.settings.padding_bottom }}px';
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 165, 0, 0.9);
    color: white;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-family: monospace;
    pointer-events: none;
    white-space: nowrap;
  }
  {% endif %}

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .hero-product-section {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-product-images {
    display: flex;
    gap: 1rem;
    flex: 1;
    min-width: 300px;
  }

  .hero-product-img-1,
  .hero-product-img-2 {
    max-width: 100%;
    height: auto;
  }

  .hero-product-info {
    flex: 1;
    min-width: 300px;
  }

  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .hero-section {
      min-height: auto;
      padding: 2rem 0;
    }

    .hero-product-section {
      flex-direction: column !important;
    }

    .hero-product-images {
      flex-direction: column;
      width: 100%;
    }

    .hero-product-info {
      width: 100%;
    }
  }

  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .hero-product-section {
      flex-direction: column !important;
    }

    .hero-product-images {
      flex-direction: row;
      justify-content: center;
    }
  }

  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .hero-product-section {
      gap: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "🎯 Hero Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** This section has been enhanced with visual editing guides and comprehensive customization options. Changes preview in real-time in the theme editor."
    },
    {
      "type": "header",
      "content": "📦 Product Settings"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product",
      "info": "Select a product to enable Add to Cart functionality. Leave blank to use a custom link instead."
    },
    {
      "type": "header",
      "content": "🖼️ Images & Media"
    },
    {
      "type": "image_picker",
      "id": "product_image_1",
      "label": "Product Image 1",
      "info": "Primary product image. Recommended: 800x800px or larger, square aspect ratio."
    },
    {
      "type": "image_picker",
      "id": "product_image_2",
      "label": "Product Image 2",
      "info": "Secondary product image (e.g., packaging, lifestyle shot). Same size as Image 1 recommended."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Optional background image. Recommended: 1920x600px or larger. Works best with gradient overlay enabled."
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background Image Size",
      "options": [
        { "value": "cover", "label": "Cover (fill entire area)" },
        { "value": "contain", "label": "Contain (show full image)" },
        { "value": "auto", "label": "Original size" }
      ],
      "default": "cover",
      "info": "How the background image should fit the section."
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Image Position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Where to position the background image."
    },
    {
      "type": "header",
      "content": "✏️ Title & Headline"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "MYCOMATCHA",
      "info": "Primary headline. Displays large and bold at the top of the section."
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "info": "Leave blank to use theme default text color."
    },
    {
      "type": "checkbox",
      "id": "show_trademark",
      "label": "Show Trademark Symbol (™)",
      "default": true,
      "info": "Displays a small ™ symbol after the title."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Divider Line",
      "default": true,
      "info": "Decorative line between title and subtitle."
    },
    {
      "type": "text",
      "id": "divider_text",
      "label": "Divider Text/Pattern",
      "default": "+++++++++",
      "info": "Text or symbols to use as divider. Examples: +++, ---, •••"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The magic of matcha meets the wisdom of mushrooms",
      "info": "Supporting headline below the title. Keep it concise and compelling."
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "info": "Leave blank to use theme default text color."
    },
    {
      "type": "header",
      "content": "💬 Tagline & Description"
    },
    {
      "type": "text",
      "id": "tagline_line_1",
      "label": "Tagline Line 1",
      "default": "Coffee borrows energy.",
      "info": "First line of your value proposition tagline."
    },
    {
      "type": "text",
      "id": "tagline_line_2",
      "label": "Tagline Line 2",
      "default": "MycoMatcha creates it.",
      "info": "Second line of your tagline. Creates a comparison or contrast."
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline Color",
      "info": "Color for both tagline lines."
    },
    {
      "type": "textarea",
      "id": "description_paragraph_1",
      "label": "Description - Paragraph 1",
      "default": "Your morning coffee spikes cortisol, burns through your adrenal reserves, and leaves you crashing by 2 PM. MycoMatcha works differently.",
      "info": "First paragraph of detailed product description. Explain the problem or key benefit."
    },
    {
      "type": "textarea",
      "id": "description_paragraph_2",
      "label": "Description - Paragraph 2",
      "default": "Ceremonial-grade matcha delivers 25-35mg of caffeine paired with L-theanine, which crosses the blood-brain barrier to promote alpha wave activity. The result: 4-6 hours of sustained energy without the spike-crash cycle. Add four adaptogenic mushrooms that have been used in traditional medicine for over 2,000 years, and you have a formula that doesn't just wake you up. It builds resilience.",
      "info": "Second paragraph. Provide details, science, or social proof."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Text Color",
      "info": "Color for both description paragraphs."
    },
    {
      "type": "header",
      "content": "💰 Pricing Display"
    },
    {
      "type": "checkbox",
      "id": "show_pricing",
      "label": "Show Pricing",
      "default": true,
      "info": "Display price information. Pulls from selected product or uses custom values below."
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show Compare-At Price",
      "default": true,
      "info": "Show crossed-out original price to highlight discount."
    },
    {
      "type": "text",
      "id": "custom_compare_price",
      "label": "Custom Compare-At Price",
      "placeholder": "$45.00",
