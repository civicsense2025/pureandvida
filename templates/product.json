{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "gallery_style": "stacked",
        "info_position": "right",
        "sticky_product_info": false,
        "enable_video_looping": false,
        "hide_variants": false
      },
      "blocks": {
        "product_badges": {
          "type": "product_badges",
          "settings": {
            "show_badges": true,
            "badge_new": true,
            "badge_sale": true,
            "badge_featured": false
          }
        },
        "product_title": {
          "type": "product_title",
          "settings": {
            "show_title": true,
            "show_badges": false
          }
        },
        "product_price": {
          "type": "product_price",
          "settings": {
            "show_price": true,
            "show_savings": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_style": "dropdown",
            "show_unavailable": false
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {
            "show_quantity": true,
            "default_quantity": 1,
            "min_quantity": 1,
            "max_quantity": 99
          }
        },
        "add_to_cart": {
          "type": "add_to_cart",
          "settings": {
            "button_text": "Add to cart"
          }
        },
        "trust_badges": {
          "type": "trust_badges",
          "settings": {
            "show_trust_badges": true,
            "badge_secure": true,
            "badge_shipping": true,
            "badge_guarantee": true
          }
        },
        "product_description": {
          "type": "product_description",
          "settings": {
            "show_description": true,
            "description_style": "full"
          }
        },
        "product_tabs": {
          "type": "product_tabs",
          "settings": {
            "show_tabs": true,
            "tab_description": true,
            "tab_specifications": false,
            "tab_ingredients": false,
            "tab_benefits": false,
            "tab_reviews": false,
            "tab_faq": false
          }
        }
      },
      "block_order": [
        "product_badges",
        "product_title",
        "product_price",
        "variant_picker",
        "quantity_selector",
        "add_to_cart",
        "trust_badges",
        "product_description",
        "product_tabs"
      ]
    },
    "product-recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "recommendation_type": "related",
        "products_to_show": 4,
        "display_style": "grid",
        "columns_desktop": 4,
        "columns_mobile": 2,
        "heading_alignment": "center"
      }
    }
  },
  "order": [
    "main",
    "product-recommendations"
  ]
}
