    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge Background Color",
      "info": "Background color of the badge. Bright colors work well (red, orange, green)."
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "info": "Text color inside badge. Should contrast strongly with badge background."
    },
    {
      "type": "header",
      "content": "💳 Additional Features"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show Payment Method Icons",
      "default": true,
      "info": "Display icons for accepted payment methods (Visa, Mastercard, PayPal, etc.) to build trust."
    },
    {
      "type": "header",
      "content": "📐 Layout & Structure"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Product Images Position",
      "options": [
        { "value": "row", "label": "Left Side" },
        { "value": "row-reverse", "label": "Right Side" }
      ],
      "default": "row",
      "info": "Position product images on left or right. Product info appears on opposite side."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Title & Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
