{% liquid
  # @description Collection list section displaying featured collections in grid or carousel layout
  # Supports multiple collection blocks with custom images and titles
  # @settings heading {String} - Section heading
  # @settings layout_style {String} - Layout style: 'grid' or 'carousel'
  # @settings columns_desktop {Number} - Number of columns on desktop (2-6)
  # @settings show_collection_title {Boolean} - Display collection titles
  # @settings show_product_count {Boolean} - Display product count
  # @blocks collection - Individual collection block with collection picker and custom image
  # @example
  #   Add to index.json or page.json to showcase featured collections
  assign layout_style = section.settings.layout_style | default: 'grid'
-%}

<section class="collection-list-section{% if layout_style == 'carousel' %} collection-list-section--carousel{% endif %}" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-list-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; margin-bottom: {{ section.settings.heading_spacing }}px;">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="collection-list-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; margin-bottom: 40px;">{{ section.settings.description | escape }}</p>
    {%- endif -%}
    
    {%- comment -%} Count collection items {%- endcomment -%}
    {%- assign collection_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'collection' and block.settings.collection != blank -%}
        {%- assign collection_count = collection_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- if collection_count > 0 -%}
      {%- if layout_style == 'carousel' -%}
        {%- comment -%} Carousel Layout {%- endcomment -%}
        <div class="collection-list-carousel__wrapper" 
             data-carousel-id="collection-list-{{ section.id }}"
             data-items-desktop="{{ section.settings.carousel_items_desktop }}"
             data-items-mobile="{{ section.settings.carousel_items_mobile }}"
             data-autoplay="{{ section.settings.carousel_autoplay }}"
             data-autoplay-speed="{{ section.settings.carousel_autoplay_speed }}"
             data-gap="{{ section.settings.item_spacing }}">
          
          <div class="collection-list-carousel__container" role="region" aria-label="Collections carousel">
            <div class="collection-list-carousel__track" data-carousel-track>
              {%- for block in section.blocks -%}
                {%- if block.type == 'collection' and block.settings.collection != blank -%}
                  {%- assign collection = block.settings.collection -%}
                  <div class="collection-list-carousel__slide" data-carousel-slide>
                    <div class="collection-item" {{ block.shopify_attributes }}>
                      <a href="{{ collection.url }}" style="text-decoration: none; display: block;">
                        {%- if collection.featured_image != blank -%}
                          <div class="collection-image" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; overflow: hidden; margin-bottom: 15px;">
                            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                          </div>
                        {%- elsif block.settings.custom_image != blank -%}
                          <div class="collection-image" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; overflow: hidden; margin-bottom: 15px;">
                            <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                          </div>
                        {%- endif -%}
                        
                        {%- if section.settings.show_collection_title -%}
                          <h3 class="collection-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% elsif section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %} text-align: center;">{{ collection.title | escape }}</h3>
                        {%- endif -%}
                        
                        {%- if section.settings.show_product_count -%}
                          <p class="collection-count" style="{% if section.settings.count_color != blank %}color: {{ section.settings.count_color }};{% endif %} text-align: center; margin-top: 5px;">
                            {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
                          </p>
                        {%- endif -%}
                      </a>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.carousel_show_arrows -%}
            <button class="collection-list-carousel__button collection-list-carousel__button--prev" 
                    data-carousel-prev 
                    aria-label="Previous collections"
                    type="button">
              <span aria-hidden="true">‹</span>
            </button>
            <button class="collection-list-carousel__button collection-list-carousel__button--next" 
                    data-carousel-next 
                    aria-label="Next collections"
                    type="button">
              <span aria-hidden="true">›</span>
            </button>
          {%- endif -%}

          {%- if section.settings.carousel_show_dots and collection_count > section.settings.carousel_items_desktop -%}
            <div class="collection-list-carousel__dots" data-carousel-dots role="tablist" aria-label="Collections navigation">
              {%- assign total_slides = collection_count | divided_by: section.settings.carousel_items_desktop | ceil -%}
              {%- for i in (1..total_slides) -%}
                <button class="collection-list-carousel__dot{% if forloop.first %} collection-list-carousel__dot--active{% endif %}" 
                        data-carousel-dot 
                        data-slide-index="{{ forloop.index0 }}"
                        aria-label="Go to slide {{ forloop.index }}"
                        type="button"
                        role="tab"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="visually-hidden">Slide {{ forloop.index }}</span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%} Grid Layout {%- endcomment -%}
        <div class="collection-list-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' and block.settings.collection != blank -%}
              {%- assign collection = block.settings.collection -%}
              <div class="collection-item" {{ block.shopify_attributes }}>
                <a href="{{ collection.url }}" style="text-decoration: none; display: block;">
                  {%- if collection.featured_image != blank -%}
                    <div class="collection-image" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; overflow: hidden; margin-bottom: 15px;">
                      <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                    </div>
                  {%- elsif block.settings.custom_image != blank -%}
                    <div class="collection-image" style="aspect-ratio: {{ section.settings.image_aspect_ratio }}; overflow: hidden; margin-bottom: 15px;">
                      <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
                    </div>
                  {%- endif -%}
                  
                  {%- if section.settings.show_collection_title -%}
                    <h3 class="collection-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% elsif section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %} text-align: center;">{{ collection.title | escape }}</h3>
                  {%- endif -%}
                  
                  {%- if section.settings.show_product_count -%}
                    <p class="collection-count" style="{% if section.settings.count_color != blank %}color: {{ section.settings.count_color }};{% endif %} text-align: center; margin-top: 5px;">
                      {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
                    </p>
                  {%- endif -%}
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  /* Collection List Responsive Grid */
  .collection-list-grid {
    display: grid;
    gap: clamp(15px, 3vw, {{ section.settings.item_spacing }}px);
  }

  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .collection-list-grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .collection-list-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }

  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .collection-list-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }

  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .collection-list-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }

  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .collection-list-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr) !important;
    }
  }

  /* Carousel Layout Styles */
  .collection-list-section--carousel .collection-list-carousel__wrapper {
    margin-top: 20px;
  }
</style>

{% schema %}
{
  "name": "Collection List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Bottom Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (Desktop - Grid Only)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Only applies when layout style is Grid"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (Mobile - Grid Only)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Only applies when layout style is Grid"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item Spacing (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "range",
      "id": "carousel_items_desktop",
      "label": "Items Per Slide (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Only applies when layout style is Carousel"
    },
    {
      "type": "range",
      "id": "carousel_items_mobile",
      "label": "Items Per Slide (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Only applies when layout style is Carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_show_dots",
      "label": "Show Dot Indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Enable Auto-play",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_speed",
      "label": "Auto-play Speed (ms)",
      "min": 2000,
      "max": 10000,
      "step": 500,
      "default": 5000,
      "info": "Only applies when auto-play is enabled"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ],
      "default": "4/3"
    },
    {
      "type": "header",
      "content": "Collection Info"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show Collection Title",
      "default": true
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count",
      "default": false
    },
    {
      "type": "color",
      "id": "count_color",
      "label": "Product Count Color"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image",
          "info": "Optional: Override collection featured image"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "info": "Overrides section default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List"
    }
  ],
  "templates": ["index", "page", "product", "collection"]
}
{% endschema %}

