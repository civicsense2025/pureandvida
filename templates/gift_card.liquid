{% layout none %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <meta name="robots" content="noindex, nofollow">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | format_address }} - {{ shop.name }}</title>

    {{ content_for_header }}

    {%- liquid
      assign nohemi_regular = 'Nohemi-Regular.otf' | asset_url
      assign nohemi_semibold = 'Nohemi-SemiBold.otf' | asset_url
      assign versailles = 'Jen Wagner Co. - Versailles Regular.ttf' | asset_url
      assign myriad = 'MyriadPro-Regular.otf' | asset_url
    -%}

    {% style %}
      @font-face {
        font-family: 'Nohemi';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_regular }}) format('opentype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 600;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_semibold }}) format('opentype');
      }

      @font-face {
        font-family: 'Versailles';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url({{ versailles }}) format('truetype');
      }

      @font-face {
        font-family: 'MyriadPro';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url({{ myriad }}) format('opentype');
      }

      :root {
        --font-heading-family: 'Versailles', serif;
        --font-body-family: 'MyriadPro', sans-serif;
        --color-primary: {{ settings.color_primary | default: '#4A7C59' }};
        --color-secondary: {{ settings.color_secondary | default: '#8B9D83' }};
        --color-accent: {{ settings.color_accent | default: '#C4A962' }};
        --color-background: {{ settings.color_background | default: '#FDFBF7' }};
        --color-text: {{ settings.color_text | default: '#2C3E2D' }};
        --color-text-light: {{ settings.color_text_light | default: '#5A6B5C' }};
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-size: 62.5%;
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: 2rem;
        font-family: var(--font-body-family);
        font-size: 1.6rem;
        line-height: 1.6;
        color: var(--color-text);
        background-color: var(--color-background);
        text-align: center;
      }

      h1, h2, h3 {
        font-family: var(--font-heading-family);
        font-weight: 400;
        line-height: 1.2;
        margin: 0;
      }

      .gift-card {
        max-width: 40rem;
        width: 100%;
      }

      .gift-card__header {
        margin-bottom: 2rem;
      }

      .gift-card__logo {
        font-family: var(--font-heading-family);
        font-size: 3.2rem;
        color: var(--color-primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
      }

      .gift-card__logo .plus {
        color: var(--color-accent);
      }

      .gift-card__image-wrapper {
        position: relative;
        margin-bottom: 2rem;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
      }

      .gift-card__image {
        width: 100%;
        height: auto;
        display: block;
      }

      .gift-card__badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #dc2626;
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 4px;
        font-size: 1.2rem;
        font-weight: 600;
        text-transform: uppercase;
      }

      .gift-card__amount {
        font-family: var(--font-heading-family);
        font-size: 4.8rem;
        color: var(--color-primary);
        margin-bottom: 0.5rem;
      }

      .gift-card__balance-text {
        font-size: 1.4rem;
        color: var(--color-text-light);
        margin-bottom: 2rem;
      }

      .gift-card__code-wrapper {
        background: white;
        border: 2px dashed var(--color-secondary);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .gift-card__code-label {
        font-size: 1.2rem;
        color: var(--color-text-light);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
      }

      .gift-card__code {
        font-family: 'Courier New', monospace;
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        color: var(--color-text);
        word-break: break-all;
      }

      .gift-card__qr {
        margin: 2rem 0;
      }

      .gift-card__qr img {
        margin: 0 auto;
        display: block;
      }

      .gift-card__actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .gift-card__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.2rem 2.4rem;
        font-family: var(--font-body-family);
        font-size: 1.6rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .gift-card__button--primary {
        background-color: var(--color-primary);
        color: white;
        border: none;
      }

      .gift-card__button--primary:hover {
        background-color: var(--color-secondary);
      }

      .gift-card__button--secondary {
        background-color: transparent;
        color: var(--color-primary);
        border: 2px solid var(--color-primary);
      }

      .gift-card__button--secondary:hover {
        background-color: var(--color-primary);
        color: white;
      }

      .gift-card__copy-success {
        display: none;
        color: #059669;
        font-size: 1.4rem;
        margin-top: 0.5rem;
      }

      .gift-card__copy-success.is-visible {
        display: block;
      }

      .gift-card__expiry {
        margin-top: 2rem;
        font-size: 1.4rem;
        color: var(--color-text-light);
      }

      .gift-card__print {
        margin-top: 2rem;
      }

      .gift-card__print a {
        color: var(--color-text-light);
        font-size: 1.4rem;
      }

      .gift-card__apple-wallet {
        margin-top: 1.5rem;
      }

      .gift-card__apple-wallet img {
        height: 44px;
        width: auto;
      }

      @media print {
        .gift-card__actions,
        .gift-card__print,
        .gift-card__apple-wallet {
          display: none;
        }
      }

      @media screen and (max-width: 480px) {
        .gift-card__amount {
          font-size: 3.6rem;
        }

        .gift-card__code {
          font-size: 1.6rem;
        }
      }
    {% endstyle %}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>

  <body>
    <div class="gift-card">
      <header class="gift-card__header">
        <a href="{{ shop.url }}" class="gift-card__logo">
          <span>Pure</span>
          <span class="plus">+</span>
          <span>Vida</span>
        </a>
      </header>

      <main>
        <div class="gift-card__image-wrapper">
          {%- if gift_card.expired -%}
            <span class="gift-card__badge">{{ 'gift_cards.issued.expired' | t }}</span>
          {%- endif -%}
          <img
            class="gift-card__image"
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_cards.issued.title' | t }}"
            width="570"
            height="340"
            loading="eager"
          >
        </div>

        <div class="gift-card__amount">
          {{ gift_card.balance | money }}
        </div>

        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="gift-card__balance-text">
            {{ 'gift_cards.issued.initial_value' | t }}: {{ gift_card.initial_value | money }}
          </p>
        {%- endif -%}

        <div class="gift-card__code-wrapper">
          <p class="gift-card__code-label">{{ 'gift_cards.issued.gift_card_code' | t }}</p>
          <p class="gift-card__code" id="gift-card-code">{{ gift_card.code | format_code }}</p>
        </div>

        <p class="gift-card__copy-success" id="copy-success">
          {{ 'gift_cards.issued.copy_code_success' | t }}
        </p>

        <div class="gift-card__qr" id="qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>

        <div class="gift-card__actions">
          <button class="gift-card__button gift-card__button--primary" id="copy-button" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            {{ 'gift_cards.issued.copy_code' | t }}
          </button>
          <a href="{{ shop.url }}" class="gift-card__button gift-card__button--secondary">
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
        </div>

        {%- if gift_card.pass_url -%}
          <div class="gift-card__apple-wallet">
            <a href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
                width="120"
                height="40"
                loading="lazy"
              >
            </a>
          </div>
        {%- endif -%}

        {%- if gift_card.expires_on -%}
          <p class="gift-card__expiry">
            {{ 'gift_cards.issued.expiration_notice' | t: expires_on: gift_card.expires_on | date: format: 'date' }}
          </p>
        {%- endif -%}

        <div class="gift-card__print">
          <a href="#" onclick="window.print(); return false;">
            {{ 'gift_cards.issued.print_gift_card' | t }}
          </a>
        </div>
      </main>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Generate QR code
        var qrContainer = document.getElementById('qr-code');
        if (qrContainer && typeof QRCode !== 'undefined') {
          new QRCode(qrContainer, {
            text: qrContainer.dataset.identifier,
            width: 120,
            height: 120,
            colorDark: '{{ settings.color_text | default: "#2C3E2D" }}',
            colorLight: '{{ settings.color_background | default: "#FDFBF7" }}'
          });
        }

        // Copy to clipboard
        var copyButton = document.getElementById('copy-button');
        var giftCardCode = document.getElementById('gift-card-code');
        var copySuccess = document.getElementById('copy-success');

        if (copyButton && giftCardCode) {
          copyButton.addEventListener('click', function() {
            var code = giftCardCode.textContent.replace(/\s/g, '');
            navigator.clipboard.writeText(code).then(function() {
              copySuccess.classList.add('is-visible');
              setTimeout(function() {
                copySuccess.classList.remove('is-visible');
              }, 3000);
            }).catch(function() {
              // Fallback for older browsers
              var textArea = document.createElement('textarea');
              textArea.value = code;
              textArea.style.position = 'fixed';
              textArea.style.left = '-999999px';
              document.body.appendChild(textArea);
              textArea.select();
              try {
                document.execCommand('copy');
                copySuccess.classList.add('is-visible');
                setTimeout(function() {
                  copySuccess.classList.remove('is-visible');
                }, 3000);
              } catch (err) {
                console.error('Failed to copy');
              }
              document.body.removeChild(textArea);
            });
          });
        }
      });
    </script>
  </body>
</html>
