{% comment %}
  Block Collection Item Snippet
  -----------------------------
  Reusable collection card for collection list sections.
  Displays collection image, title, and optional product count.

  Parameters:
    Required:
    - collection: The collection object
    - block: The block object (optional, for shopify_attributes)

    Optional:
    - custom_image: Override image (from block settings)
    - image_aspect_ratio: Aspect ratio string (1/1, 4/3, 3/4, 16/9)
    - show_title: Boolean to show collection title
    - show_product_count: Boolean to show product count
    - title_color: Custom title color
    - count_color: Custom count color

  Usage:
    {% render 'block-collection-item',
      collection: collection,
      block: block,
      image_aspect_ratio: section.settings.image_aspect_ratio,
      show_title: section.settings.show_collection_title,
      show_product_count: section.settings.show_product_count,
      title_color: section.settings.title_color,
      count_color: section.settings.count_color
    %}
{% endcomment %}

{% liquid
  assign item_aspect_ratio = image_aspect_ratio | default: '4/3'
  assign item_show_title = show_title | default: true
  assign item_show_count = show_product_count | default: false
  assign item_title_color = title_color
  assign item_count_color = count_color

  # Get the image to display
  if custom_image != blank
    assign display_image = custom_image
  elsif collection.featured_image != blank
    assign display_image = collection.featured_image
  else
    assign display_image = blank
  endif
%}

<div class="block-collection-item" {% if block %}{{ block.shopify_attributes }}{% endif %}>
  <a href="{{ collection.url }}" class="block-collection-item__link">
    {% if display_image != blank %}
      <div class="block-collection-item__image" style="aspect-ratio: {{ item_aspect_ratio }};">
        <img
          src="{{ display_image | image_url: width: 600 }}"
          srcset="
            {{ display_image | image_url: width: 300 }} 300w,
            {{ display_image | image_url: width: 450 }} 450w,
            {{ display_image | image_url: width: 600 }} 600w
          "
          sizes="(max-width: 479px) 100vw, (max-width: 767px) 50vw, 25vw"
          alt="{{ collection.title | escape }}"
          loading="lazy"
          class="block-collection-item__img"
          width="600"
          height="450"
        >
      </div>
    {% else %}
      <div class="block-collection-item__placeholder" style="aspect-ratio: {{ item_aspect_ratio }};">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 525 525" fill="none">
          <rect width="525" height="525" fill="#E8E8E8"/>
          <path d="M262.5 312.5C295.637 312.5 322.5 285.637 322.5 252.5C322.5 219.363 295.637 192.5 262.5 192.5C229.363 192.5 202.5 219.363 202.5 252.5C202.5 285.637 229.363 312.5 262.5 312.5Z" stroke="#CACACA" stroke-width="8"/>
        </svg>
      </div>
    {% endif %}

    {% if item_show_title %}
      <h3
        class="block-collection-item__title"
        {% if item_title_color != blank %}style="color: {{ item_title_color }};"{% endif %}
      >
        {{ collection.title | escape }}
      </h3>
    {% endif %}

    {% if item_show_count %}
      <p
        class="block-collection-item__count"
        {% if item_count_color != blank %}style="color: {{ item_count_color }};"{% endif %}
      >
        {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
      </p>
    {% endif %}
  </a>
</div>

<style>
  .block-collection-item {
    position: relative;
  }

  .block-collection-item__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .block-collection-item__image {
    overflow: hidden;
    margin-bottom: 15px;
    border-radius: var(--collection-image-radius, 0);
  }

  .block-collection-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .block-collection-item:hover .block-collection-item__img {
    transform: scale(1.05);
  }

  .block-collection-item__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    margin-bottom: 15px;
  }

  .block-collection-item__placeholder svg {
    width: 50%;
    height: auto;
    opacity: 0.5;
  }

  .block-collection-item__title {
    font-family: var(--font-heading-family);
    font-size: clamp(0.9rem, 2.5vw, 1.125rem);
    font-weight: 600;
    text-align: center;
    margin: 0;
    line-height: 1.3;
  }

  .block-collection-item__count {
    font-family: var(--font-body-family);
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    text-align: center;
    margin: 5px 0 0;
    opacity: 0.7;
  }
</style>
