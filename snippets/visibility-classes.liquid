{%- comment -%}
  Visibility Classes Snippet
  --------------------------
  Outputs CSS classes for responsive visibility based on section settings.
  Include this snippet once in a section to generate visibility styles.

  Parameters:
    - show_on_mobile: true/false (default: true)
    - show_on_desktop: true/false (default: true)
    - section_id: The section ID to scope styles (required)

  Usage in section:
    {% render 'visibility-classes',
      show_on_mobile: section.settings.show_on_mobile,
      show_on_desktop: section.settings.show_on_desktop,
      section_id: section.id
    %}

  Then add the appropriate class to your section wrapper:
    <div class="{% unless show_on_mobile %}hide-mobile{% endunless %} {% unless show_on_desktop %}hide-desktop{% endunless %}">
{%- endcomment -%}

{%- liquid
  assign mobile = show_on_mobile | default: true
  assign desktop = show_on_desktop | default: true
-%}

{%- unless mobile and desktop -%}
  <style>
    {%- unless mobile -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section_id }},
        #{{ section_id }} {
          display: none !important;
        }
      }
    {%- endunless -%}

    {%- unless desktop -%}
      @media screen and (min-width: 750px) {
        #shopify-section-{{ section_id }},
        #{{ section_id }} {
          display: none !important;
        }
      }
    {%- endunless -%}
  </style>
{%- endunless -%}
