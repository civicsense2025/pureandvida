{% layout none %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <meta name="robots" content="noindex, nofollow">

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value, shop: shop.name }} - {{ shop.name }}</title>

    {{ content_for_header }}

    {% liquid
      # Font asset URLs - matching theme.liquid
      assign nohemi_light_woff = 'Nohemi-Light-BF6438cc5702321.woff' | asset_url
      assign nohemi_light_otf = 'Nohemi-Light.otf' | asset_url
      assign nohemi_light_ttf = 'Nohemi-Light-BF6438cc5899919.ttf' | asset_url

      assign nohemi_regular_woff = 'Nohemi-Regular-BF6438cc579d934.woff' | asset_url
      assign nohemi_regular_otf = 'Nohemi-Regular.otf' | asset_url
      assign nohemi_regular_ttf = 'Nohemi-Regular-BF6438cc4d0e493.ttf' | asset_url

      assign nohemi_medium_woff = 'Nohemi-Medium-BF6438cc57ddecd.woff' | asset_url
      assign nohemi_medium_otf = 'Nohemi-Medium.otf' | asset_url
      assign nohemi_medium_ttf = 'Nohemi-Medium-BF6438cc5883899.ttf' | asset_url

      assign nohemi_semibold_woff = 'Nohemi-SemiBold-BF6438cc57db2ff.woff' | asset_url
      assign nohemi_semibold_otf = 'Nohemi-SemiBold.otf' | asset_url
      assign nohemi_semibold_ttf = 'Nohemi-SemiBold-BF6438cc588a48a.ttf' | asset_url

      assign nohemi_bold_woff = 'Nohemi-Bold-BF6438cc577b524.woff' | asset_url
      assign nohemi_bold_otf = 'Nohemi-Bold.otf' | asset_url
      assign nohemi_bold_ttf = 'Nohemi-Bold-BF6438cc587b5b5.ttf' | asset_url

      assign versailles = 'Jen Wagner Co. - Versailles Regular.ttf' | asset_url
      assign myriad = 'MyriadPro-Regular.otf' | asset_url

      # Determine font families based on theme settings
      if settings.custom_font_body == 'nohemi'
        assign body_font_family = 'Nohemi'
      elsif settings.custom_font_body == 'versailles'
        assign body_font_family = 'Versailles'
      elsif settings.custom_font_body == 'myriad'
        assign body_font_family = 'MyriadPro'
      else
        assign body_font_family = settings.font_body.family | default: 'MyriadPro'
      endif

      if settings.custom_font_heading == 'nohemi'
        assign heading_font_family = 'Nohemi'
      elsif settings.custom_font_heading == 'versailles'
        assign heading_font_family = 'Versailles'
      elsif settings.custom_font_heading == 'myriad'
        assign heading_font_family = 'MyriadPro'
      else
        assign heading_font_family = settings.font_heading.family | default: 'Versailles'
      endif
    %}

    {% style %}
      /* Font faces - matching theme.liquid for consistency */
      @font-face {
        font-family: 'Nohemi';
        font-weight: 300;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_light_woff }}') format('woff'),
             url('{{ nohemi_light_otf }}') format('opentype'),
             url('{{ nohemi_light_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_regular_woff }}') format('woff'),
             url('{{ nohemi_regular_otf }}') format('opentype'),
             url('{{ nohemi_regular_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 500;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_medium_woff }}') format('woff'),
             url('{{ nohemi_medium_otf }}') format('opentype'),
             url('{{ nohemi_medium_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 600;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_semibold_woff }}') format('woff'),
             url('{{ nohemi_semibold_otf }}') format('opentype'),
             url('{{ nohemi_semibold_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_bold_woff }}') format('woff'),
             url('{{ nohemi_bold_otf }}') format('opentype'),
             url('{{ nohemi_bold_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Versailles';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url('{{ versailles }}') format('truetype');
      }

      @font-face {
        font-family: 'MyriadPro';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url('{{ myriad }}') format('opentype');
      }

      :root {
        /* Typography - pulled from theme settings */
        --font-heading-family: {{ heading_font_family }}, serif;
        --font-body-family: {{ body_font_family }}, sans-serif;

        /* Colors - pulled from theme settings */
        --color-primary: {{ settings.color_primary | default: '#5E877A' }};
        --color-secondary: {{ settings.color_secondary | default: '#E8983B' }};
        --color-accent: {{ settings.color_accent | default: '#5E877A' }};
        --color-background: {{ settings.color_background | default: '#FDFBF7' }};
        --color-text: {{ settings.color_text | default: '#2C3E2D' }};
        --color-text-secondary: {{ settings.color_text_secondary | default: '#5A6B5C' }};

        /* Product badge colors */
        --color-badge-expired: {{ settings.color_product_badge_sale | default: '#DC2626' }};
        --color-success: {{ settings.color_product_badge_new | default: '#059669' }};

        /* Button system */
        --button-primary-bg: {{ settings.button_primary_bg | default: settings.color_primary | default: '#5E877A' }};
        --button-primary-text: {{ settings.button_primary_text | default: '#ffffff' }};
        --button-primary-hover: {{ settings.button_primary_hover | default: '#4A6D62' }};
        --button-outline-border: {{ settings.button_outline_border | default: settings.color_primary | default: '#5E877A' }};
        --button-outline-text: {{ settings.button_outline_text | default: settings.color_text | default: '#1E1E1E' }};

        /* Spacing */
        --spacing-sm: {{ settings.spacing_sm | default: 8 }}px;
        --spacing-md: {{ settings.spacing_md | default: 16 }}px;
        --spacing-lg: {{ settings.spacing_lg | default: 24 }}px;
        --spacing-xl: {{ settings.spacing_xl | default: 32 }}px;

        /* Border radius */
        --radius-sm: {{ settings.radius_sm | default: 4 }}px;
        --radius-md: {{ settings.radius_md | default: 8 }}px;
        --radius-lg: {{ settings.radius_lg | default: 12 }}px;

        /* Shadows */
        --shadow-lg: 0 10px 40px rgba(0, 0, 0, 0.1);

        /* Transitions */
        --transition-base: {{ settings.transition_base | default: 250 }}ms ease;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-size: 62.5%;
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: var(--spacing-xl);
        font-family: var(--font-body-family);
        font-size: 1.6rem;
        line-height: 1.6;
        color: var(--color-text);
        background-color: var(--color-background);
        text-align: center;
      }

      h1, h2, h3 {
        font-family: var(--font-heading-family);
        font-weight: 400;
        line-height: 1.2;
        margin: 0;
      }

      .gift-card {
        max-width: 40rem;
        width: 100%;
      }

      .gift-card__header {
        margin-bottom: var(--spacing-xl);
      }

      .gift-card__logo {
        font-family: var(--font-heading-family);
        font-size: 3.2rem;
        color: var(--color-primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
      }

      .gift-card__logo-image {
        max-height: 60px;
        width: auto;
      }

      .gift-card__logo .plus {
        color: var(--color-secondary);
      }

      .gift-card__image-wrapper {
        position: relative;
        margin-bottom: var(--spacing-xl);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
      }

      .gift-card__image {
        width: 100%;
        height: auto;
        display: block;
      }

      .gift-card__badge {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
        background: var(--color-badge-expired);
        color: white;
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: var(--radius-sm);
        font-size: 1.2rem;
        font-weight: 600;
        text-transform: uppercase;
      }

      .gift-card__amount {
        font-family: var(--font-heading-family);
        font-size: 4.8rem;
        color: var(--color-primary);
        margin-bottom: var(--spacing-sm);
      }

      .gift-card__balance-text {
        font-size: 1.4rem;
        color: var(--color-text-secondary);
        margin-bottom: var(--spacing-xl);
      }

      .gift-card__code-wrapper {
        background: white;
        border: 2px dashed var(--color-secondary);
        border-radius: var(--radius-md);
        padding: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
      }

      .gift-card__code-label {
        font-size: 1.2rem;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: var(--spacing-sm);
      }

      .gift-card__code {
        font-family: 'Courier New', monospace;
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        color: var(--color-text);
        word-break: break-all;
      }

      .gift-card__qr {
        margin: var(--spacing-xl) 0;
      }

      .gift-card__qr img {
        margin: 0 auto;
        display: block;
      }

      .gift-card__actions {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
      }

      .gift-card__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-sm);
        padding: 1.2rem 2.4rem;
        font-family: var(--font-body-family);
        font-size: 1.6rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: all var(--transition-base);
      }

      .gift-card__button--primary {
        background-color: var(--button-primary-bg);
        color: var(--button-primary-text);
        border: none;
      }

      .gift-card__button--primary:hover {
        background-color: var(--button-primary-hover);
      }

      .gift-card__button--secondary {
        background-color: transparent;
        color: var(--button-outline-text);
        border: 2px solid var(--button-outline-border);
      }

      .gift-card__button--secondary:hover {
        background-color: var(--button-primary-bg);
        color: var(--button-primary-text);
        border-color: var(--button-primary-bg);
      }

      .gift-card__copy-success {
        display: none;
        color: var(--color-success);
        font-size: 1.4rem;
        margin-top: var(--spacing-sm);
      }

      .gift-card__copy-success.is-visible {
        display: block;
      }

      .gift-card__expiry {
        margin-top: var(--spacing-xl);
        font-size: 1.4rem;
        color: var(--color-text-secondary);
      }

      .gift-card__print {
        margin-top: var(--spacing-xl);
      }

      .gift-card__print a {
        color: var(--color-text-secondary);
        font-size: 1.4rem;
      }

      .gift-card__apple-wallet {
        margin-top: var(--spacing-lg);
      }

      .gift-card__apple-wallet img {
        height: 44px;
        width: auto;
      }

      @media print {
        .gift-card__actions,
        .gift-card__print,
        .gift-card__apple-wallet {
          display: none;
        }
      }

      @media screen and (max-width: 480px) {
        .gift-card__amount {
          font-size: 3.6rem;
        }

        .gift-card__code {
          font-size: 1.6rem;
        }
      }
    {% endstyle %}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  </head>

  <body>
    <div class="gift-card">
      <header class="gift-card__header">
        <a href="{{ shop.url }}" class="gift-card__logo">
          {% if settings.logo != blank %}
            <img
              src="{{ settings.logo | image_url: height: 60 }}"
              alt="{{ shop.name | escape }}"
              class="gift-card__logo-image"
              loading="eager"
            >
          {% else %}
            {%- comment -%} Fallback to text logo - customize per brand {%- endcomment -%}
            <span>Pure</span>
            <span class="plus">+</span>
            <span>Vida</span>
          {% endif %}
        </a>
      </header>

      <main>
        <div class="gift-card__image-wrapper">
          {% if gift_card.expired %}
            <span class="gift-card__badge">{{ 'gift_cards.issued.expired' | t }}</span>
          {% endif %}
          <img
            class="gift-card__image"
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_cards.issued.subtext' | t }}"
            width="570"
            height="340"
            loading="eager"
          >
        </div>

        <div class="gift-card__amount">
          {{ gift_card.balance | money }}
        </div>

        {% if gift_card.balance != gift_card.initial_value %}
          <p class="gift-card__balance-text">
            {{ 'gift_cards.issued.initial_value' | t }}: {{ gift_card.initial_value | money }}
          </p>
        {% endif %}

        <div class="gift-card__code-wrapper">
          <p class="gift-card__code-label">{{ 'gift_cards.issued.gift_card_code' | t }}</p>
          <p class="gift-card__code" id="gift-card-code">{{ gift_card.code | format_code }}</p>
        </div>

        <p class="gift-card__copy-success" id="copy-success">
          {{ 'gift_cards.issued.copy_code_success' | t }}
        </p>

        <div class="gift-card__qr" id="qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>

        <div class="gift-card__actions">
          <button class="gift-card__button gift-card__button--primary" id="copy-button" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            {{ 'gift_cards.issued.copy_code' | t }}
          </button>
          <a href="{{ shop.url }}" class="gift-card__button gift-card__button--secondary">
            {{ 'gift_cards.issued.shop_link' | t }}
          </a>
        </div>

        {% if gift_card.pass_url %}
          <div class="gift-card__apple-wallet">
            <a href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
                width="120"
                height="40"
                loading="lazy"
              >
            </a>
          </div>
        {% endif %}

        {% if gift_card.expires_on %}
          <p class="gift-card__expiry">
            {{ 'gift_cards.issued.expiration_notice' | t: expires_on: gift_card.expires_on | date: format: 'date' }}
          </p>
        {% endif %}

        <div class="gift-card__print">
          <a href="#" onclick="window.print(); return false;">
            {{ 'gift_cards.issued.print_gift_card' | t }}
          </a>
        </div>
      </main>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Generate QR code
        var qrContainer = document.getElementById('qr-code');
        if (qrContainer && typeof QRCode !== 'undefined') {
          new QRCode(qrContainer, {
            text: qrContainer.dataset.identifier,
            width: 120,
            height: 120,
            colorDark: '{{ settings.color_text | default: "#2C3E2D" }}',
            colorLight: '{{ settings.color_background | default: "#FDFBF7" }}'
          });
        }

        // Copy to clipboard
        var copyButton = document.getElementById('copy-button');
        var giftCardCode = document.getElementById('gift-card-code');
        var copySuccess = document.getElementById('copy-success');

        if (copyButton && giftCardCode) {
          copyButton.addEventListener('click', function() {
            var code = giftCardCode.textContent.replace(/\s/g, '');
            navigator.clipboard.writeText(code).then(function() {
              copySuccess.classList.add('is-visible');
              setTimeout(function() {
                copySuccess.classList.remove('is-visible');
              }, 3000);
            }).catch(function() {
              // Fallback for older browsers
              var textArea = document.createElement('textarea');
              textArea.value = code;
              textArea.style.position = 'fixed';
              textArea.style.left = '-999999px';
              document.body.appendChild(textArea);
              textArea.select();
              try {
                document.execCommand('copy');
                copySuccess.classList.add('is-visible');
                setTimeout(function() {
                  copySuccess.classList.remove('is-visible');
                }, 3000);
              } catch (err) {
                console.error('Failed to copy');
              }
              document.body.removeChild(textArea);
            });
          });
        }
      });
    </script>
  </body>
</html>
