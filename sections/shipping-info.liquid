{% liquid
  # @description Shipping and returns information section
  # Displays collapsible or always-visible shipping/returns content
  # All content is fully editable via Theme Editor
%}

<section class="shipping-info-section" style="background-color: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;">
  <div class="page-width" style="max-width: {{ section.settings.max_width }}px; margin: 0 auto;">

    {% if section.settings.heading != blank %}
      <h2 class="shipping-info__heading" style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size }}px; text-align: {{ section.settings.heading_alignment }}; margin-bottom: {{ section.settings.heading_spacing }}px;">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="shipping-info__content">
      {% if section.settings.layout == 'accordion' %}
        {% comment %} Accordion Layout {% endcomment %}
        <div class="shipping-info__accordion">
          {% for block in section.blocks %}
            <details class="shipping-info__item" {% if section.settings.first_open and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="shipping-info__summary" style="background-color: {{ section.settings.item_bg_color }}; color: {{ section.settings.item_heading_color }}; padding: {{ section.settings.item_padding }}px;">
                <span class="shipping-info__item-title">
                  {% if block.settings.icon != blank %}
                    <span class="shipping-info__icon">{{ block.settings.icon }}</span>
                  {% endif %}
                  {{ block.settings.title | escape }}
                </span>
                <span class="shipping-info__toggle" style="color: {{ section.settings.toggle_color }};">{{ section.settings.toggle_icon | default: '+' }}</span>
              </summary>
              <div class="shipping-info__details" style="color: {{ section.settings.content_color }}; padding: {{ section.settings.content_padding }}px;">
                {{ block.settings.content }}
              </div>
            </details>
          {% endfor %}
        </div>

      {% else %}
        {% comment %} Grid/Cards Layout {% endcomment %}
        <div class="shipping-info__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: {{ section.settings.grid_gap }}px;">
          {% for block in section.blocks %}
            <div class="shipping-info__card" style="background-color: {{ section.settings.item_bg_color }}; border-radius: {{ section.settings.card_radius }}px; padding: {{ section.settings.card_padding }}px;" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="shipping-info__card-icon" style="color: {{ section.settings.icon_color }}; font-size: {{ section.settings.icon_size }}px;">
                  {{ block.settings.icon }}
                </div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="shipping-info__card-title" style="color: {{ section.settings.item_heading_color }};">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}
              <div class="shipping-info__card-content" style="color: {{ section.settings.content_color }};">
                {{ block.settings.content }}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% comment %} Rich Text Content (Alternative to blocks) {% endcomment %}
      {% if section.settings.rich_content != blank %}
        <div class="shipping-info__rich-content" style="color: {{ section.settings.content_color }};">
          {{ section.settings.rich_content }}
        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  .shipping-info-section {
    width: 100%;
  }

  .shipping-info__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    margin: 0;
    line-height: 1.2;
  }

  /* Accordion Styles */
  .shipping-info__accordion {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_spacing }}px;
  }

  .shipping-info__item {
    border: 1px solid {{ section.settings.border_color | default: '#e5e7eb' }};
    border-radius: {{ section.settings.item_radius }}px;
    overflow: hidden;
  }

  .shipping-info__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    font-size: {{ section.settings.item_heading_size }}px;
    font-weight: 600;
  }

  .shipping-info__summary::-webkit-details-marker {
    display: none;
  }

  .shipping-info__item-title {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .shipping-info__icon {
    font-size: 1.2em;
  }

  .shipping-info__toggle {
    font-size: 24px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .shipping-info__item[open] .shipping-info__toggle {
    transform: rotate(45deg);
  }

  .shipping-info__details {
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.7;
    border-top: 1px solid {{ section.settings.border_color | default: '#e5e7eb' }};
  }

  .shipping-info__details p {
    margin: 0 0 1em 0;
  }

  .shipping-info__details p:last-child {
    margin-bottom: 0;
  }

  /* Grid/Cards Styles */
  .shipping-info__grid {
    display: grid;
    gap: 30px;
  }

  @media screen and (max-width: 767px) {
    .shipping-info__grid {
      grid-template-columns: 1fr !important;
    }
  }

  .shipping-info__card {
    display: flex;
    flex-direction: column;
    gap: 15px;
    box-shadow: {{ section.settings.card_shadow }};
  }

  .shipping-info__card-icon {
    line-height: 1;
  }

  .shipping-info__card-title {
    font-size: {{ section.settings.item_heading_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .shipping-info__card-content {
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.7;
  }

  .shipping-info__card-content p {
    margin: 0 0 1em 0;
  }

  .shipping-info__card-content p:last-child {
    margin-bottom: 0;
  }

  /* Rich Content Styles */
  .shipping-info__rich-content {
    font-size: {{ section.settings.content_size }}px;
    line-height: 1.8;
    white-space: pre-line;
  }

  {% if request.design_mode %}
  .shipping-info-section {
    position: relative;
    outline: 2px dashed rgba(255, 165, 0, 0.3);
    outline-offset: -2px;
  }

  .shipping-info__item:hover,
  .shipping-info__card:hover {
    outline: 1px dashed rgba(255, 165, 0, 0.5);
  }
  {% endif %}
</style>

{% schema %}
{
  "name": "Shipping & Returns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping & Returns"
    },
    {
      "type": "richtext",
      "id": "rich_content",
      "label": "Rich Content (Alternative to blocks)",
      "info": "Use this for simple content, or leave blank and use blocks below for structured content"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Style",
      "options": [
        { "value": "accordion", "label": "Accordion (Collapsible)" },
        { "value": "grid", "label": "Grid (Cards)" }
      ],
      "default": "accordion"
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "Open First Item by Default",
      "default": true,
      "info": "Only applies to accordion layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Grid Layout)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Only applies to grid layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 15,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "default": 1000,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 24,
      "max": 72,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Bottom Spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_heading_size",
      "label": "Item Title Size",
      "min": 16,
      "max": 28,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_size",
      "label": "Content Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Item Styling"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item Spacing (Accordion)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item Title Padding",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content Padding",
      "min": 15,
      "max": 40,
      "step": 5,
      "default": 25,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "item_radius",
      "label": "Item Border Radius (Accordion)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius (Grid)",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Padding (Grid)",
      "min": 20,
      "max": 50,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "card_shadow",
      "label": "Card Shadow (Grid)",
      "default": "0 4px 6px rgba(0, 0, 0, 0.1)",
      "info": "CSS box-shadow value"
    },
    {
      "type": "text",
      "id": "toggle_icon",
      "label": "Toggle Icon",
      "default": "+",
      "info": "Icon shown on accordion items"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Block Icon Size (Grid)",
      "min": 24,
      "max": 60,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "item_bg_color",
      "label": "Item/Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "item_heading_color",
      "label": "Item Title Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "toggle_color",
      "label": "Toggle Icon Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Block Icon Color",
      "default": "#5E8778"
    }
  ],
  "blocks": [
    {
      "type": "info_block",
      "name": "Info Block",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji or Symbol)",
          "info": "Optional icon before title"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping Information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your shipping information here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping & Returns",
      "settings": {
        "heading": "Shipping & Returns",
        "layout": "accordion"
      },
      "blocks": [
        {
          "type": "info_block",
          "settings": {
            "icon": "",
            "title": "Processing & Delivery",
            "content": "<p>Orders ship within 1-2 business days. Expect delivery within 2-4 business days after shipping. Free shipping on all orders with full tracking provided.</p>"
          }
        },
        {
          "type": "info_block",
          "settings": {
            "icon": "",
            "title": "60-Day Money-Back Guarantee",
            "content": "<p>Not fully satisfied? Return your product within 60 days for a full refund, risk-free.</p>"
          }
        },
        {
          "type": "info_block",
          "settings": {
            "icon": "",
            "title": "Easy Returns Process",
            "content": "<p>Reach out to our support team. We'll guide you through the return process. Your satisfaction is our top priority.</p>"
          }
        }
      ]
    },
    {
      "name": "Shipping - Cards Layout",
      "settings": {
        "heading": "Shipping & Returns",
        "layout": "grid",
        "columns": 3
      },
      "blocks": [
        {
          "type": "info_block",
          "settings": {
            "icon": "",
            "title": "Free Shipping",
            "content": "<p>Free shipping on all orders. Ships within 1-2 business days.</p>"
          }
        },
        {
          "type": "info_block",
          "settings": {
            "icon": "",
            "title": "Money-Back Guarantee",
            "content": "<p>60-day hassle-free returns. Full refund guaranteed.</p>"
          }
        },
        {
          "type": "info_block",
          "settings": {
            "icon": "",
            "title": "Support",
            "content": "<p>Questions? Contact us anytime for assistance.</p>"
          }
        }
      ]
    }
  ],
  "templates": ["index", "page", "product", "collection"]
}
{% endschema %}
