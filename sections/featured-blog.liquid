{% liquid
  # @description Featured blog posts section showcasing articles from a selected blog
  # @settings blog {Blog} - Blog to feature articles from
  # @settings post_count {Number} - Number of posts to display
  # @settings show_image {Boolean} - Display article images
  # @settings show_excerpt {Boolean} - Display article excerpts
  # @settings show_date {Boolean} - Display publish date
  # @settings show_author {Boolean} - Display author name
  # @example
  #   Add to homepage or any template to showcase blog content

  assign selected_blog = blogs[section.settings.blog]
  assign post_count = section.settings.post_count | default: 3
%}

{% if request.design_mode %}
  <div class="editor-controls editor-controls--blog">
    <span class="editor-label">Featured Blog</span>
    <span class="editor-info">
      {% if selected_blog %}{{ selected_blog.title }}{% else %}No blog selected{% endif %} |
      {{ post_count }} posts |
      {{ section.settings.columns }} columns
    </span>
  </div>
{% endif %}

<section
  class="featured-blog-section"
  style="
    {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="featured-blog-section__container page-width">
    {%- if section.settings.heading != blank -%}
      <div class="featured-blog-section__header" style="text-align: {{ section.settings.heading_alignment }};">
        <h2
          class="featured-blog-section__heading"
          style="
            {% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %}
            font-size: {{ section.settings.heading_size }}px;
            font-weight: {{ section.settings.heading_weight }};
            margin-bottom: {{ section.settings.heading_spacing }}px;
          "
        >
          {{ section.settings.heading | escape }}
        </h2>

        {%- if section.settings.description != blank -%}
          <p
            class="featured-blog-section__description"
            style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %}"
          >
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if selected_blog != blank and selected_blog.articles.size > 0 -%}
      <div
        class="featured-blog-section__grid"
        style="
          grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
          gap: {{ section.settings.grid_gap }}px;
        "
      >
        {%- for article in selected_blog.articles limit: post_count -%}
          <article class="blog-card" style="border-radius: {{ section.settings.card_border_radius }}px;">
            {%- if section.settings.show_image -%}
              <a href="{{ article.url }}" class="blog-card__image-link">
                {%- if article.image != blank -%}
                  <div class="blog-card__image-wrapper" style="aspect-ratio: {{ section.settings.image_ratio }};">
                    <img
                      src="{{ article.image | image_url: width: 800 }}"
                      srcset="
                        {{ article.image | image_url: width: 400 }} 400w,
                        {{ article.image | image_url: width: 600 }} 600w,
                        {{ article.image | image_url: width: 800 }} 800w
                      "
                      sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
                      alt="{{ article.image.alt | default: article.title | escape }}"
                      class="blog-card__image"
                      loading="lazy"
                      style="border-radius: {{ section.settings.card_border_radius }}px {{ section.settings.card_border_radius }}px 0 0;"
                    >
                  </div>
                {%- else -%}
                  <div class="blog-card__image-placeholder" style="aspect-ratio: {{ section.settings.image_ratio }};">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </a>
            {%- endif -%}

            <div class="blog-card__content" style="padding: {{ section.settings.card_padding }}px;">
              {%- if section.settings.show_tags and article.tags.size > 0 -%}
                <div class="blog-card__tags">
                  {%- for tag in article.tags limit: 2 -%}
                    <span
                      class="blog-card__tag"
                      style="{% if section.settings.tag_color != blank %}background-color: {{ section.settings.tag_color }};{% endif %}"
                    >
                      {{ tag }}
                    </span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <h3 class="blog-card__title" style="{% if section.settings.title_color != blank %}color: {{ section.settings.title_color }};{% endif %}">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>

              {%- if section.settings.show_excerpt and article.excerpt_or_content != blank -%}
                <p
                  class="blog-card__excerpt"
                  style="{% if section.settings.excerpt_color != blank %}color: {{ section.settings.excerpt_color }};{% endif %}"
                >
                  {{ article.excerpt_or_content | strip_html | truncatewords: section.settings.excerpt_length }}
                </p>
              {%- endif -%}

              <div class="blog-card__meta">
                {%- if section.settings.show_author -%}
                  <span class="blog-card__author" style="{% if section.settings.meta_color != blank %}color: {{ section.settings.meta_color }};{% endif %}">
                    {{ article.author }}
                  </span>
                {%- endif -%}

                {%- if section.settings.show_date -%}
                  {%- if section.settings.show_author -%}
                    <span class="blog-card__separator" aria-hidden="true">|</span>
                  {%- endif -%}
                  <time
                    datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
                    class="blog-card__date"
                    style="{% if section.settings.meta_color != blank %}color: {{ section.settings.meta_color }};{% endif %}"
                  >
                    {{ article.published_at | date: section.settings.date_format }}
                  </time>
                {%- endif -%}
              </div>

              {%- if section.settings.show_read_more -%}
                <a
                  href="{{ article.url }}"
                  class="blog-card__read-more"
                  style="{% if section.settings.link_color != blank %}color: {{ section.settings.link_color }};{% endif %}"
                >
                  {{ section.settings.read_more_text | default: 'Read more' }}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and selected_blog.articles.size > post_count -%}
        <div class="featured-blog-section__view-all" style="text-align: center; margin-top: 40px;">
          <a
            href="{{ selected_blog.url }}"
            class="featured-blog-section__view-all-link"
            style="
              {% if section.settings.button_color != blank %}background-color: {{ section.settings.button_color }};{% endif %}
              {% if section.settings.button_text_color != blank %}color: {{ section.settings.button_text_color }};{% endif %}
            "
          >
            {{ section.settings.view_all_text | default: 'View all posts' }}
          </a>
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <div class="featured-blog-section__placeholder">
        <p>Select a blog in the section settings to display articles</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .featured-blog-section {
    position: relative;
  }

  .featured-blog-section__header {
    margin-bottom: 40px;
  }

  .featured-blog-section__heading {
    font-family: var(--font-heading-family);
    margin: 0;
  }

  .featured-blog-section__description {
    font-family: var(--font-body-family);
    font-size: 1rem;
    opacity: 0.8;
    margin: 16px 0 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .featured-blog-section__grid {
    display: grid;
    gap: 30px;
  }

  /* Blog Card Styles */
  .blog-card {
    background: {% if section.settings.card_background != blank %}{{ section.settings.card_background }}{% else %}var(--color-background, #fff){% endif %};
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    {% if section.settings.card_shadow %}
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    {% endif %}
    {% if section.settings.card_border_width > 0 %}
      border: {{ section.settings.card_border_width }}px solid {% if section.settings.card_border_color != blank %}{{ section.settings.card_border_color }}{% else %}rgba(0,0,0,0.1){% endif %};
    {% endif %}
  }

  .blog-card:hover {
    {% if section.settings.card_hover_lift %}
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    {% endif %}
  }

  .blog-card__image-link {
    display: block;
    overflow: hidden;
  }

  .blog-card__image-wrapper {
    position: relative;
    overflow: hidden;
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.05);
  }

  .blog-card__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt, #f5f5f5);
  }

  .blog-card__image-placeholder .placeholder-svg {
    width: 60px;
    height: 60px;
    opacity: 0.4;
  }

  .blog-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .blog-card__tag {
    display: inline-block;
    padding: 4px 12px;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-primary, #000);
    color: var(--color-background, #fff);
    border-radius: 2px;
  }

  .blog-card__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  .blog-card__title a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .blog-card__title a:hover {
    opacity: 0.7;
  }

  .blog-card__excerpt {
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 16px;
    opacity: 0.8;
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8rem;
    margin-bottom: 12px;
    opacity: 0.7;
  }

  .blog-card__separator {
    opacity: 0.5;
  }

  .blog-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-primary, #000);
    transition: gap 0.2s ease;
    margin-top: auto;
  }

  .blog-card__read-more:hover {
    gap: 10px;
  }

  /* View All Button */
  .featured-blog-section__view-all-link {
    display: inline-block;
    padding: 14px 32px;
    background: var(--color-primary, #000);
    color: var(--color-background, #fff);
    text-decoration: none;
    font-weight: 500;
    border-radius: 4px;
    transition: opacity 0.2s ease;
    min-height: 48px;
  }

  .featured-blog-section__view-all-link:hover {
    opacity: 0.9;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 767px) {
    .featured-blog-section__grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* Tablet */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .featured-blog-section__grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  {% if request.design_mode %}
    .featured-blog-section {
      outline: 2px dashed rgba(0, 188, 212, 0.3);
      outline-offset: -2px;
    }

    .featured-blog-section::before {
      content: 'FEATURED BLOG';
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(0, 188, 212, 0.95);
      color: white;
      padding: 4px 12px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
    }

    .blog-card {
      outline: 1px dashed rgba(0, 188, 212, 0.2);
    }

    .editor-controls--blog {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.90);
      color: white;
      padding: 8px 14px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font-body-family);
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      border: 2px solid rgba(0, 188, 212, 0.5);
    }

    .editor-controls--blog .editor-label {
      font-weight: 600;
      color: rgba(0, 188, 212, 1);
      font-size: 12px;
    }

    .editor-controls--blog .editor-info {
      font-size: 10px;
      opacity: 0.85;
    }

    .featured-blog-section__placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 200px;
      background: rgba(0, 188, 212, 0.05);
      border: 2px dashed rgba(0, 188, 212, 0.3);
      border-radius: 8px;
      color: var(--color-text);
    }
  {% endif %}
</style>

{% schema %}
{
  "name": "📝 Featured Blog",
  "tag": "section",
  "class": "section-featured-blog",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Showcase blog articles in a customizable grid layout. Select a blog and configure the display options to highlight your content."
    },
    {
      "type": "header",
      "content": "📋 Blog Selection"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Select which blog to display posts from"
    },
    {
      "type": "range",
      "id": "post_count",
      "label": "Number of Posts",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "✏️ Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest from Our Blog"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading Spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/2", "label": "Classic (3:2)" },
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "2/3", "label": "Portrait (2:3)" }
      ],
      "default": "3/2"
    },
    {
      "type": "header",
      "content": "📰 Card Display"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show Tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_length",
      "label": "Excerpt Length (words)",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Date",
      "default": true
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "Date Format",
      "default": "%B %d, %Y",
      "info": "Examples: %B %d, %Y = January 01, 2025"
    },
    {
      "type": "checkbox",
      "id": "show_read_more",
      "label": "Show Read More Link",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read More Text",
      "default": "Read more"
    },
    {
      "type": "header",
      "content": "🎨 Card Styling"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Content Padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card Border Width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color"
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Card Shadow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "card_hover_lift",
      "label": "Lift Card on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "🎨 Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt Color"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Text Color"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag Background Color"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Read More Link Color"
    },
    {
      "type": "header",
      "content": "🔗 View All Link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View all posts"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color"
    },
    {
      "type": "header",
      "content": "🎨 Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "📏 Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Featured Blog - Grid",
      "settings": {
        "heading": "Latest from Our Blog",
        "post_count": 3,
        "columns": 3,
        "show_image": true,
        "show_excerpt": true,
        "show_date": true,
        "show_author": true
      }
    },
    {
      "name": "Featured Blog - Minimal",
      "settings": {
        "heading": "Blog",
        "post_count": 4,
        "columns": 2,
        "show_image": true,
        "show_excerpt": false,
        "show_date": true,
        "show_author": false,
        "show_tags": false,
        "card_shadow": false,
        "card_border_radius": 0
      }
    }
  ]
}
{% endschema %}
