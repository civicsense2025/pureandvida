    },
    {
      "type": "text",
      "id": "custom_price",
      "label": "Custom Current Price",
      "placeholder": "34.99",
      "info": "Override product price. Enter number only (e.g., 34.99). Leave blank to use product's actual price."
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Current Price Color",
      "info": "Color for the current/sale price."
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare-At Price Color",
      "info": "Color for the crossed-out original price. Typically gray or lighter."
    },
    {
      "type": "header",
      "content": "🔢 Quantity Selector"
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Enable Quantity Selector",
