{% liquid
  # @description Main article section with full customization
  # Displays individual blog article with featured image, content, author, date, and navigation
  # Supports multiple layouts, social sharing, comments, and related articles
%}

{%- render 'visibility-classes',
  show_on_mobile: section.settings.show_on_mobile,
  show_on_desktop: section.settings.show_on_desktop,
  section_id: section.id
-%}

<article
  id="{{ section.id }}"
  class="main-article color-scheme-{{ section.settings.color_scheme }}"
  itemscope
  itemtype="http://schema.org/BlogPosting"
>
  <style>
    #{{ section.id }} {
      {% render 'color-scheme', scheme: section.settings.color_scheme %}
      {% render 'section-spacing', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
    }

    #{{ section.id }} .article-container {
      {% render 'container-width', width: section.settings.container_width %}
    }

    /* Hero Section */
    #{{ section.id }} .article-hero {
      {%- if section.settings.hero_layout == 'full-width' -%}
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        margin-bottom: var(--spacing-xl);
      {%- elsif section.settings.hero_layout == 'contained' -%}
        margin-bottom: var(--spacing-xl);
        border-radius: {{ section.settings.image_border_radius }}px;
        overflow: hidden;
      {%- endif -%}
    }

    #{{ section.id }} .article-hero-image {
      width: 100%;
      height: auto;
      {%- if section.settings.hero_layout == 'full-width' -%}
        max-height: {{ section.settings.hero_height }}vh;
        object-fit: cover;
      {%- else -%}
        aspect-ratio: {{ section.settings.image_ratio }};
        object-fit: cover;
      {%- endif -%}
    }

    /* Article Header */
    #{{ section.id }} .article-header {
      text-align: {{ section.settings.header_alignment }};
      margin-bottom: var(--spacing-xl);
      {%- if section.settings.header_alignment == 'center' -%}
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
      {%- endif -%}
    }

    #{{ section.id }} .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
      margin-bottom: var(--spacing-md);
      {%- if section.settings.header_alignment == 'center' -%}
        justify-content: center;
      {%- endif -%}
    }

    #{{ section.id }} .article-tag {
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: calc(var(--font-body-size) * 0.75);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--section-accent, var(--color-primary));
      background: rgba(0,0,0,0.05);
      border-radius: var(--button-radius);
      text-decoration: none;
    }

    #{{ section.id }} .article-tag:hover {
      background: rgba(0,0,0,0.1);
    }

    #{{ section.id }} .article-title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-size) * {{ section.settings.title_scale | divided_by: 100.0 }});
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-md);
      line-height: 1.2;
    }

    #{{ section.id }} .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      align-items: center;
      {%- if section.settings.header_alignment == 'center' -%}
        justify-content: center;
      {%- endif -%}
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text));
      opacity: 0.7;
    }

    #{{ section.id }} .article-meta-divider {
      width: 4px;
      height: 4px;
      background: currentColor;
      border-radius: 50%;
      opacity: 0.5;
    }

    #{{ section.id }} .article-author {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    #{{ section.id }} .author-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* Article Content */
    #{{ section.id }} .article-content-wrapper {
      display: grid;
      gap: var(--spacing-xl);
      {%- if section.settings.layout == 'sidebar' -%}
        grid-template-columns: 1fr 280px;
      {%- else -%}
        grid-template-columns: 1fr;
      {%- endif -%}
    }

    @media screen and (max-width: 989px) {
      #{{ section.id }} .article-content-wrapper {
        grid-template-columns: 1fr;
      }
    }

    #{{ section.id }} .article-content {
      {%- if section.settings.layout == 'centered' -%}
        max-width: {{ section.settings.content_width }}px;
        margin: 0 auto;
      {%- endif -%}
    }

    #{{ section.id }} .article-body {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * {{ section.settings.body_scale | divided_by: 100.0 }});
      line-height: {{ section.settings.line_height }};
      color: var(--section-text, var(--color-text));
    }

    #{{ section.id }} .article-body h2,
    #{{ section.id }} .article-body h3,
    #{{ section.id }} .article-body h4 {
      font-family: var(--font-heading-family);
      color: var(--section-heading, var(--color-heading));
      margin-top: var(--spacing-xl);
      margin-bottom: var(--spacing-md);
    }

    #{{ section.id }} .article-body p {
      margin: 0 0 var(--spacing-md);
    }

    #{{ section.id }} .article-body img {
      max-width: 100%;
      height: auto;
      border-radius: {{ section.settings.image_border_radius }}px;
      margin: var(--spacing-lg) 0;
    }

    #{{ section.id }} .article-body a {
      color: var(--link-color, var(--color-primary));
      text-decoration: {% if section.settings.link_underline %}underline{% else %}none{% endif %};
    }

    #{{ section.id }} .article-body a:hover {
      text-decoration: underline;
    }

    #{{ section.id }} .article-body blockquote {
      margin: var(--spacing-lg) 0;
      padding: var(--spacing-md) var(--spacing-lg);
      border-left: 4px solid var(--section-accent, var(--color-primary));
      background: rgba(0,0,0,0.03);
      font-style: italic;
      border-radius: 0 {{ section.settings.image_border_radius }}px {{ section.settings.image_border_radius }}px 0;
    }

    #{{ section.id }} .article-body ul,
    #{{ section.id }} .article-body ol {
      margin: 0 0 var(--spacing-md);
      padding-left: var(--spacing-lg);
    }

    #{{ section.id }} .article-body li {
      margin-bottom: var(--spacing-xs);
    }

    /* Sidebar */
    #{{ section.id }} .article-sidebar {
      position: sticky;
      top: var(--spacing-lg);
    }

    #{{ section.id }} .sidebar-section {
      padding: var(--spacing-lg);
      background: rgba(0,0,0,0.03);
      border-radius: {{ section.settings.image_border_radius }}px;
      margin-bottom: var(--spacing-lg);
    }

    #{{ section.id }} .sidebar-title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-size) * 0.4);
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-md);
    }

    /* Social Sharing */
    #{{ section.id }} .article-share {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      {%- if section.settings.header_alignment == 'center' -%}
        justify-content: center;
      {%- endif -%}
      margin: var(--spacing-xl) 0;
      padding: var(--spacing-lg) 0;
      border-top: 1px solid var(--section-border, rgba(0,0,0,0.1));
      border-bottom: 1px solid var(--section-border, rgba(0,0,0,0.1));
    }

    #{{ section.id }} .share-label {
      font-size: calc(var(--font-body-size) * 0.9375);
      font-weight: 500;
      color: var(--section-text, var(--color-text));
      margin-right: var(--spacing-sm);
    }

    #{{ section.id }} .share-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      color: var(--section-text, var(--color-text));
      background: rgba(0,0,0,0.05);
      border-radius: 50%;
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    #{{ section.id }} .share-link:hover {
      background: var(--section-heading, var(--color-heading));
      color: var(--section-bg, #fff);
    }

    /* Article Footer */
    #{{ section.id }} .article-footer {
      margin-top: var(--spacing-xl);
    }

    /* Author Bio */
    #{{ section.id }} .author-bio {
      display: flex;
      gap: var(--spacing-lg);
      padding: var(--spacing-lg);
      background: rgba(0,0,0,0.03);
      border-radius: {{ section.settings.image_border_radius }}px;
      margin-bottom: var(--spacing-xl);
    }

    #{{ section.id }} .author-bio-avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    #{{ section.id }} .author-bio-name {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-size) * 0.45);
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-xs);
    }

    #{{ section.id }} .author-bio-text {
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text));
      opacity: 0.8;
      margin: 0;
      line-height: 1.6;
    }

    @media screen and (max-width: 749px) {
      #{{ section.id }} .author-bio {
        flex-direction: column;
        text-align: center;
        align-items: center;
      }
    }

    /* Navigation */
    #{{ section.id }} .article-navigation {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: var(--spacing-md);
      align-items: center;
      padding: var(--spacing-lg) 0;
      border-top: 1px solid var(--section-border, rgba(0,0,0,0.1));
    }

    #{{ section.id }} .nav-link {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      text-decoration: none;
      color: var(--section-text, var(--color-text));
      transition: color var(--transition-fast);
    }

    #{{ section.id }} .nav-link:hover {
      color: var(--section-heading, var(--color-heading));
    }

    #{{ section.id }} .nav-link--prev {
      text-align: left;
    }

    #{{ section.id }} .nav-link--next {
      text-align: right;
    }

    #{{ section.id }} .nav-label {
      font-size: calc(var(--font-body-size) * 0.75);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.6;
    }

    #{{ section.id }} .nav-title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-size) * 0.4);
      font-weight: var(--font-heading-weight);
      line-height: 1.3;
    }

    #{{ section.id }} .nav-back {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: calc(var(--font-body-size) * 0.9375);
      font-weight: 500;
      color: var(--section-text, var(--color-text));
      background: rgba(0,0,0,0.05);
      border-radius: var(--button-radius);
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    #{{ section.id }} .nav-back:hover {
      background: rgba(0,0,0,0.1);
    }

    @media screen and (max-width: 749px) {
      #{{ section.id }} .article-navigation {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto;
      }

      #{{ section.id }} .nav-back {
        grid-column: 1 / -1;
        justify-self: center;
        order: -1;
        margin-bottom: var(--spacing-md);
      }

      #{{ section.id }} .nav-title {
        display: none;
      }
    }

    /* Comments */
    #{{ section.id }} .article-comments {
      margin-top: var(--spacing-xxl);
      padding-top: var(--spacing-xl);
      border-top: 1px solid var(--section-border, rgba(0,0,0,0.1));
    }

    #{{ section.id }} .comments-title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-size) * 0.6);
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-lg);
    }

    #{{ section.id }} .comment {
      padding: var(--spacing-lg) 0;
      border-bottom: 1px solid var(--section-border, rgba(0,0,0,0.1));
    }

    #{{ section.id }} .comment:last-child {
      border-bottom: none;
    }

    #{{ section.id }} .comment-meta {
      display: flex;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-sm);
      font-size: calc(var(--font-body-size) * 0.875);
    }

    #{{ section.id }} .comment-author {
      font-weight: 600;
      color: var(--section-heading, var(--color-heading));
    }

    #{{ section.id }} .comment-date {
      color: var(--section-text, var(--color-text));
      opacity: 0.6;
    }

    #{{ section.id }} .comment-body {
      font-size: var(--font-body-size);
      color: var(--section-text, var(--color-text));
      line-height: 1.6;
    }

    #{{ section.id }} .comment-form {
      margin-top: var(--spacing-xl);
    }

    #{{ section.id }} .comment-form-title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-heading-size) * 0.5);
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-lg);
    }

    #{{ section.id }} .comment-form-fields {
      display: grid;
      gap: var(--spacing-md);
    }

    #{{ section.id }} .comment-form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-md);
    }

    @media screen and (max-width: 749px) {
      #{{ section.id }} .comment-form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="article-container">
    {%- comment -%} Featured Image {%- endcomment -%}
    {%- if article.image != blank and section.settings.show_featured_image -%}
      <div class="article-hero">
        <img
          src="{{ article.image | image_url: width: 1600 }}"
          srcset="{{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1200 }} 1200w, {{ article.image | image_url: width: 1600 }} 1600w"
          sizes="100vw"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="article-hero-image"
          loading="eager"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          itemprop="image"
        >
      </div>
    {%- endif -%}

    {%- comment -%} Article Header {%- endcomment -%}
    <header class="article-header">
      {%- if section.settings.show_tags and article.tags.size > 0 -%}
        <div class="article-tags">
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <h1 class="article-title" itemprop="headline">{{ article.title | escape }}</h1>

      {%- if section.settings.show_meta -%}
        <div class="article-meta">
          {%- if section.settings.show_author -%}
            <span class="article-author" itemprop="author" itemscope itemtype="http://schema.org/Person">
              <span itemprop="name">{{ article.author }}</span>
            </span>
            {%- if section.settings.show_date -%}
              <span class="article-meta-divider"></span>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.show_date -%}
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
              {{ article.published_at | date: section.settings.date_format }}
            </time>
          {%- endif -%}

          {%- if section.settings.show_reading_time -%}
            {%- assign words = article.content | strip_html | split: ' ' | size -%}
            {%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
            <span class="article-meta-divider"></span>
            <span>{{ minutes }} min read</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    {%- comment -%} Content Wrapper {%- endcomment -%}
    <div class="article-content-wrapper">
      <div class="article-content">
        {%- comment -%} Article Body {%- endcomment -%}
        <div class="article-body" itemprop="articleBody">
          {{ article.content }}
        </div>

        {%- comment -%} Social Sharing {%- endcomment -%}
        {%- if section.settings.show_share -%}
          <div class="article-share">
            <span class="share-label">{{ section.settings.share_label | default: 'Share:' }}</span>
            {%- if section.settings.share_facebook -%}
              <a
                href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}"
                target="_blank"
                rel="noopener"
                class="share-link"
                aria-label="Share on Facebook"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.share_twitter -%}
              <a
                href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url }}{{ article.url }}"
                target="_blank"
                rel="noopener"
                class="share-link"
                aria-label="Share on Twitter"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.44 4.83c-.8.37-1.5.38-2.22.02.93-.56.98-.96 1.32-2.02-.88.52-1.86.9-2.9 1.1-.82-.88-2-1.43-3.3-1.43-2.5 0-4.55 2.04-4.55 4.54 0 .36.03.7.1 1.04-3.77-.2-7.12-2-9.36-4.75-.4.67-.6 1.45-.6 2.3 0 1.56.8 2.95 2 3.77-.74-.03-1.44-.23-2.05-.57v.06c0 2.2 1.56 4.03 3.64 4.44-.67.2-1.37.2-2.06.08.58 1.8 2.26 3.12 4.25 3.16C5.78 18.1 3.37 18.74 1 18.46c2 1.3 4.4 2.04 6.97 2.04 8.35 0 12.92-6.92 12.92-12.93 0-.2 0-.4-.02-.6.9-.63 1.96-1.22 2.56-2.14z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.share_pinterest -%}
              <a
                href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&media={{ article.image | image_url: width: 1200 }}&description={{ article.title | url_encode }}"
                target="_blank"
                rel="noopener"
                class="share-link"
                aria-label="Share on Pinterest"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.14.5C5.86.5 2.7 5 2.7 8.75c0 2.27.86 4.3 2.7 5.05.3.12.57 0 .66-.33l.27-1.06c.1-.32.06-.44-.2-.73-.52-.62-.86-1.44-.86-2.6 0-3.33 2.5-6.32 6.5-6.32 3.55 0 5.5 2.17 5.5 5.07 0 3.8-1.7 7.02-4.2 7.02-1.37 0-2.4-1.14-2.07-2.54.4-1.68 1.16-3.48 1.16-4.7 0-1.07-.58-1.98-1.78-1.98-1.4 0-2.55 1.47-2.55 3.42 0 1.25.43 2.1.43 2.1l-1.7 7.2c-.5 2.13-.08 4.75-.04 5 .02.17.22.2.3.1.14-.18 1.82-2.26 2.4-4.33.16-.58.93-3.63.93-3.63.45.9 1.8 1.66 3.22 1.66 4.25 0 7.13-3.87 7.13-9.05C20.5 4.15 17.18.5 12.14.5z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.share_linkedin -%}
              <a
                href="https://www.linkedin.com/shareArticle?mini=true&url={{ shop.url }}{{ article.url }}&title={{ article.title | url_encode }}"
                target="_blank"
                rel="noopener"
                class="share-link"
                aria-label="Share on LinkedIn"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43c-1.14 0-2.07-.93-2.07-2.07 0-1.14.93-2.07 2.07-2.07 1.14 0 2.07.93 2.07 2.07 0 1.14-.93 2.07-2.07 2.07zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.share_email -%}
              <a
                href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}"
                class="share-link"
                aria-label="Share via Email"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-10 5L2 7"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Article Footer {%- endcomment -%}
        <footer class="article-footer">
          {%- comment -%} Author Bio Block {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'author_bio' -%}
              <div class="author-bio" {{ block.shopify_attributes }}>
                {%- if block.settings.author_image != blank -%}
                  <img
                    src="{{ block.settings.author_image | image_url: width: 160 }}"
                    alt="{{ article.author }}"
                    class="author-bio-avatar"
                    width="80"
                    height="80"
                  >
                {%- endif -%}
                <div class="author-bio-content">
                  <p class="author-bio-name">{{ block.settings.author_name | default: article.author }}</p>
                  <p class="author-bio-text">{{ block.settings.author_text }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Navigation {%- endcomment -%}
          {%- if section.settings.show_navigation -%}
            <nav class="article-navigation" aria-label="Article navigation">
              {%- if blog.previous_article -%}
                <a href="{{ blog.previous_article.url }}" class="nav-link nav-link--prev">
                  <span class="nav-label">← Previous</span>
                  <span class="nav-title">{{ blog.previous_article.title | truncate: 50 }}</span>
                </a>
              {%- else -%}
                <span></span>
              {%- endif -%}

              <a href="{{ blog.url }}" class="nav-back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"/>
                  <rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/>
                  <rect x="3" y="14" width="7" height="7"/>
                </svg>
                {{ section.settings.back_text | default: 'All articles' }}
              </a>

              {%- if blog.next_article -%}
                <a href="{{ blog.next_article.url }}" class="nav-link nav-link--next">
                  <span class="nav-label">Next →</span>
                  <span class="nav-title">{{ blog.next_article.title | truncate: 50 }}</span>
                </a>
              {%- else -%}
                <span></span>
              {%- endif -%}
            </nav>
          {%- endif -%}
        </footer>

        {%- comment -%} Comments {%- endcomment -%}
        {%- if blog.comments_enabled? and section.settings.show_comments -%}
          <div class="article-comments" id="comments">
            {%- if article.comments_count > 0 -%}
              <h2 class="comments-title">
                {{ article.comments_count }} {{ article.comments_count | pluralize: 'Comment', 'Comments' }}
              </h2>

              {%- paginate article.comments by section.settings.comments_per_page -%}
                {%- for comment in article.comments -%}
                  <div class="comment">
                    <div class="comment-meta">
                      <span class="comment-author">{{ comment.author }}</span>
                      <span class="comment-date">{{ comment.created_at | date: section.settings.date_format }}</span>
                    </div>
                    <div class="comment-body">{{ comment.content }}</div>
                  </div>
                {%- endfor -%}

                {%- if paginate.pages > 1 -%}
                  <nav class="search-pagination" aria-label="Comments pagination">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}#comments" class="pagination-link">← Previous</a>
                    {%- endif -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}#comments" class="pagination-link">Next →</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}
              {%- endpaginate -%}
            {%- endif -%}

            {%- comment -%} Comment Form {%- endcomment -%}
            <div class="comment-form">
              <h3 class="comment-form-title">{{ section.settings.comment_form_title | default: 'Leave a comment' }}</h3>
              {% form 'new_comment', article %}
                <div class="comment-form-fields">
                  {%- if form.errors -%}
                    <div class="form-error" role="alert">
                      {{ form.errors | default_errors }}
                    </div>
                  {%- endif -%}

                  <div class="comment-form-row">
                    {% render 'form-field',
                      type: 'text',
                      name: 'comment[author]',
                      label: 'Name',
                      required: true,
                      autocomplete: 'name'
                    %}
                    {% render 'form-field',
                      type: 'email',
                      name: 'comment[email]',
                      label: 'Email',
                      required: true,
                      autocomplete: 'email'
                    %}
                  </div>

                  {% render 'form-field',
                    type: 'textarea',
                    name: 'comment[body]',
                    label: 'Comment',
                    required: true,
                    rows: 5
                  %}

                  <div>
                    {% render 'button',
                      type: 'submit',
                      text: section.settings.comment_button_text | default: 'Post comment',
                      style: 'primary'
                    %}
                  </div>
                </div>
              {% endform %}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Sidebar {%- endcomment -%}
      {%- if section.settings.layout == 'sidebar' -%}
        <aside class="article-sidebar">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'table_of_contents' -%}
                <div class="sidebar-section" {{ block.shopify_attributes }}>
                  <h3 class="sidebar-title">{{ block.settings.title | default: 'In this article' }}</h3>
                  <div id="toc-{{ section.id }}"></div>
                </div>

              {%- when 'related_articles' -%}
                <div class="sidebar-section" {{ block.shopify_attributes }}>
                  <h3 class="sidebar-title">{{ block.settings.title | default: 'Related articles' }}</h3>
                  {%- assign related_count = block.settings.articles_count -%}
                  {%- assign shown = 0 -%}
                  {%- for related in blog.articles limit: related_count -%}
                    {%- if related.id != article.id and shown < related_count -%}
                      <a href="{{ related.url }}" style="display: block; margin-bottom: var(--spacing-md); text-decoration: none; color: var(--section-text);">
                        <span style="font-size: calc(var(--font-body-size) * 0.9375); line-height: 1.4;">{{ related.title }}</span>
                      </a>
                      {%- assign shown = shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </aside>
      {%- endif -%}
    </div>
  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | json }},
      "articleBody": {{ article.content | strip_html | json }},
      {%- if article.image -%}
        "image": {{ article.image | image_url: width: 1200 | json }},
      {%- endif -%}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
  </script>
</article>

