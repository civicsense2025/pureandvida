      "default": ""
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta Text Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "tag_background_color",
      "label": "Tag Background Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag Text Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Read More Link Color",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": ""
    },
