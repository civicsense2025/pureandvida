{% liquid
  # @description Renders size guide modal or inline size chart
  # @param product {Product} - The product object
  # @param block {Block} - The block object for settings
  # @example
  #   {% render 'product-size-guide', product: product, block: block %}
%}

{% liquid
  assign size_guide_text = block.settings.size_guide_text | default: 'Size Guide'
  assign size_guide_content = product.metafields.custom.size_chart
%}

<div class="product-size-guide">
  <button 
    type="button" 
    class="size-guide-button" 
    data-size-guide-trigger
    aria-label="{{ size_guide_text }}"
  >
    {{ size_guide_text }}
  </button>

  <div class="size-guide-modal" data-size-guide-modal hidden>
    <div class="size-guide-modal__overlay" data-size-guide-close></div>
    <div class="size-guide-modal__content">
      <div class="size-guide-modal__header">
        <h2 class="size-guide-modal__title">{{ size_guide_text }}</h2>
        <button 
          type="button" 
          class="size-guide-modal__close" 
          data-size-guide-close
          aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
        >
          {% render 'render-icon', icon: 'close-filled' %}
        </button>
      </div>
      <div class="size-guide-modal__body">
        {% if size_guide_content != blank %}
          <div class="rte">
            {{ size_guide_content }}
          </div>
        {% elsif product.metafields.custom.size_chart_image != blank %}
          <img src="{{ product.metafields.custom.size_chart_image | image_url: width: 800 }}" alt="Size Guide" loading="lazy" width="800" height="600">
        {% else %}
          <p>{{ 'products.product.size_guide.no_chart' | t | default: 'Size guide information coming soon.' }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

