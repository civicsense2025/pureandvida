{% liquid
  # @description Main page section with full customization and block support
  # Displays page content with customizable title, featured image, styling, and modular blocks
  # Supports color schemes, visibility controls, and section spacing
  # @settings show_page_title {Boolean} - Display page title
  # @settings show_featured_image {Boolean} - Display page featured image
  # @settings color_scheme {String} - Color scheme selection
  # @blocks text, image, video, divider, cta_banner, accordion, custom_html
%}

{% render 'visibility-classes',
  show_on_mobile: section.settings.show_on_mobile,
  show_on_desktop: section.settings.show_on_desktop,
  section_id: section.id
%}

<div
  id="{{ section.id }}"
  class="main-page color-scheme-{{ section.settings.color_scheme }}{% if section.settings.custom_css_class != blank %} {{ section.settings.custom_css_class }}{% endif %}"
>
  <style>
    #{{ section.id }} {
      {% render 'color-scheme', scheme: section.settings.color_scheme %}
      {% render 'section-spacing', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
      {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    }

    #{{ section.id }} .page-container {
      {% render 'container-width', width: section.settings.container_width %}
    }

    /* Page Header */
    #{{ section.id }} .page-header {
      text-align: {{ section.settings.header_alignment }};
      margin-bottom: var(--spacing-xl);
    }

    #{{ section.id }} .page-title {
      font-family: var(--font-heading-family);
      font-size: clamp(1.75rem, 5vw, calc(var(--font-heading-size) * {{ section.settings.title_scale | divided_by: 100.0 }}));
      font-weight: var(--font-heading-weight);
      color: {% if section.settings.title_color != blank %}{{ section.settings.title_color }}{% else %}var(--section-heading, var(--color-heading)){% endif %};
      margin: 0 0 var(--spacing-sm);
      line-height: 1.2;
    }

    #{{ section.id }} .page-subtitle {
      font-family: var(--font-body-family);
      font-size: clamp(0.875rem, 2.5vw, calc(var(--font-body-size) * 1.125));
      color: var(--section-text, var(--color-text-secondary));
      opacity: 0.8;
      margin: 0;
    }

    /* Featured Image */
    #{{ section.id }} .page-featured-image {
      text-align: {{ section.settings.image_alignment }};
      margin-bottom: {{ section.settings.image_spacing }}px;
    }

    #{{ section.id }} .page-featured-image img {
      max-width: {% if section.settings.image_full_width %}100%{% else %}{{ section.settings.image_max_width }}px{% endif %};
      height: auto;
      border-radius: {{ section.settings.image_border_radius }}px;
      {% if section.settings.image_shadow %}box-shadow: var(--shadow-lg);{% endif %}
    }

    /* Page Content (RTE) */
    #{{ section.id }} .page-content {
      {% if section.settings.content_width != blank %}
        max-width: {{ section.settings.content_width }}px;
        margin-left: {% if section.settings.header_alignment == 'center' %}auto{% else %}0{% endif %};
        margin-right: {% if section.settings.header_alignment == 'center' %}auto{% else %}0{% endif %};
      {% endif %}
    }

    #{{ section.id }} .rte {
      font-family: var(--font-body-family);
      font-size: clamp(0.875rem, 2vw, var(--font-body-size));
      line-height: 1.7;
      color: {% if section.settings.text_color != blank %}{{ section.settings.text_color }}{% else %}var(--section-text, var(--color-text)){% endif %};
      text-align: {{ section.settings.text_alignment }};
    }

    #{{ section.id }} .rte p { margin-bottom: var(--spacing-md); }
    #{{ section.id }} .rte h2 { font-family: var(--font-heading-family); font-size: clamp(1.25rem, 3vw, 1.75rem); margin: var(--spacing-xl) 0 var(--spacing-md); color: var(--section-heading, var(--color-heading)); }
    #{{ section.id }} .rte h3 { font-family: var(--font-heading-family); font-size: clamp(1.125rem, 2.5vw, 1.5rem); margin: var(--spacing-lg) 0 var(--spacing-sm); color: var(--section-heading, var(--color-heading)); }
    #{{ section.id }} .rte h4 { font-family: var(--font-heading-family); font-size: clamp(1rem, 2vw, 1.25rem); margin: var(--spacing-md) 0 var(--spacing-sm); color: var(--section-heading, var(--color-heading)); }
    #{{ section.id }} .rte ul, #{{ section.id }} .rte ol { padding-left: var(--spacing-xl); margin-bottom: var(--spacing-md); }
    #{{ section.id }} .rte li { margin-bottom: var(--spacing-xs); }
    #{{ section.id }} .rte a { color: var(--color-primary); text-decoration: underline; min-height: 44px; display: inline-flex; align-items: center; }
    #{{ section.id }} .rte a:hover { color: var(--color-secondary); }
    #{{ section.id }} .rte img { max-width: 100%; height: auto; border-radius: var(--radius-md); margin: var(--spacing-md) 0; }
    #{{ section.id }} .rte blockquote { border-left: 4px solid var(--color-primary); padding-left: var(--spacing-lg); margin: var(--spacing-lg) 0; font-style: italic; color: var(--color-text-secondary); }
    #{{ section.id }} .rte table { width: 100%; border-collapse: collapse; margin: var(--spacing-lg) 0; }
    #{{ section.id }} .rte th, #{{ section.id }} .rte td { padding: var(--spacing-sm); border: 1px solid var(--color-text-secondary); text-align: left; }

    /* Block Styles */
    #{{ section.id }} .page-blocks {
      margin-top: var(--spacing-xl);
    }

    #{{ section.id }} .page-block {
      margin-bottom: var(--spacing-lg);
    }

    #{{ section.id }} .page-block:last-child {
      margin-bottom: 0;
    }

    /* Text Block */
    #{{ section.id }} .block-text {
      text-align: var(--block-text-align, left);
    }

    #{{ section.id }} .block-text__heading {
      font-family: var(--font-heading-family);
      font-size: clamp(1.25rem, 3vw, 1.75rem);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-sm);
    }

    #{{ section.id }} .block-text__content {
      font-size: var(--font-body-size);
      line-height: 1.7;
    }

    /* Image Block */
    #{{ section.id }} .block-image {
      text-align: var(--block-image-align, center);
    }

    #{{ section.id }} .block-image img {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius-md);
    }

    #{{ section.id }} .block-image__caption {
      font-size: calc(var(--font-body-size) * 0.875);
      color: var(--color-text-secondary);
      margin-top: var(--spacing-sm);
    }

    /* Video Block */
    #{{ section.id }} .block-video {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      border-radius: var(--radius-md);
    }

    #{{ section.id }} .block-video iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    /* Divider Block */
    #{{ section.id }} .block-divider {
      border: none;
      height: var(--block-divider-height, 1px);
      background: var(--block-divider-color, var(--color-text-secondary));
      margin: var(--spacing-xl) auto;
      width: var(--block-divider-width, 100%);
      max-width: var(--block-divider-max-width, 100%);
      opacity: 0.3;
    }

    /* CTA Banner Block */
    #{{ section.id }} .block-cta {
      background: var(--block-cta-bg, var(--color-primary));
      color: var(--block-cta-text, white);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      text-align: center;
    }

    #{{ section.id }} .block-cta__heading {
      font-family: var(--font-heading-family);
      font-size: clamp(1.25rem, 3vw, 1.75rem);
      margin: 0 0 var(--spacing-sm);
    }

    #{{ section.id }} .block-cta__text {
      margin: 0 0 var(--spacing-lg);
      opacity: 0.9;
    }

    #{{ section.id }} .block-cta__button {
      display: inline-block;
      padding: var(--spacing-sm) var(--spacing-xl);
      background: var(--block-cta-btn-bg, white);
      color: var(--block-cta-btn-text, var(--color-primary));
      text-decoration: none;
      border-radius: var(--button-radius);
      font-weight: 500;
      transition: opacity var(--transition-fast);
    }

    #{{ section.id }} .block-cta__button:hover {
      opacity: 0.9;
    }

    /* Accordion Block */
    #{{ section.id }} .block-accordion {
      border: 1px solid var(--color-text-secondary);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    #{{ section.id }} .block-accordion__header {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--spacing-md);
      background: transparent;
      border: none;
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      font-weight: 500;
      color: var(--section-text, var(--color-text));
      cursor: pointer;
      text-align: left;
    }

    #{{ section.id }} .block-accordion__icon {
      transition: transform var(--transition-fast);
    }

    #{{ section.id }} .block-accordion[open] .block-accordion__icon {
      transform: rotate(180deg);
    }

    #{{ section.id }} .block-accordion__content {
      padding: 0 var(--spacing-md) var(--spacing-md);
      line-height: 1.7;
    }

    /* Custom HTML Block */
    #{{ section.id }} .block-custom-html {
      /* Allow custom styles from block content */
    }

    /* Responsive */
    @media screen and (max-width: 767px) {
      #{{ section.id }} .page-title {
        font-size: 1.5rem;
      }

      #{{ section.id }} .page-featured-image img {
        max-width: 100%;
      }

      #{{ section.id }} .rte {
        font-size: 0.9375rem;
      }

      #{{ section.id }} .rte table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
      }
    }
  </style>

  <div class="page-container page-width">
    {% if section.settings.show_page_title and page.title != blank %}
      <header class="page-header">
        <h1 class="page-title">{{ page.title | escape }}</h1>
        {% if section.settings.page_subtitle != blank %}
          <p class="page-subtitle">{{ section.settings.page_subtitle }}</p>
        {% endif %}
      </header>
    {% endif %}

    {% if section.settings.show_featured_image and page.featured_image != blank %}
      <div class="page-featured-image">
        <img
          src="{{ page.featured_image | image_url: width: 1600 }}"
          alt="{{ page.title | escape }}"
          width="1600"
          height="auto"
          loading="eager"
        >
      </div>
    {% endif %}

    {% if page.content != blank %}
      <div class="page-content">
        <div class="rte">
          {{ page.content }}
        </div>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="page-blocks">
        {% for block in section.blocks %}
          <div class="page-block" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'text' %}
                <div class="block-text" style="--block-text-align: {{ block.settings.text_alignment }};">
                  {% if block.settings.heading != blank %}
                    <h3 class="block-text__heading">{{ block.settings.heading }}</h3>
                  {% endif %}
                  {% if block.settings.content != blank %}
                    <div class="block-text__content rte">{{ block.settings.content }}</div>
                  {% endif %}
                </div>

              {% when 'image' %}
                <div class="block-image" style="--block-image-align: {{ block.settings.alignment }};">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.alt_text | default: block.settings.caption | escape }}"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      loading="lazy"
                      style="max-width: {{ block.settings.max_width }}px;"
                    >
                    {% if block.settings.caption != blank %}
                      <p class="block-image__caption">{{ block.settings.caption }}</p>
                    {% endif %}
                  {% endif %}
                </div>

              {% when 'video' %}
                {% if block.settings.video_url != blank %}
                  <div class="block-video">
                    {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
                      {% assign youtube_id = block.settings.video_url | split: 'v=' | last | split: '&' | first %}
                      {% if youtube_id == block.settings.video_url %}
                        {% assign youtube_id = block.settings.video_url | split: '/' | last | split: '?' | first %}
                      {% endif %}
                      <iframe src="https://www.youtube.com/embed/{{ youtube_id }}" frameborder="0" allowfullscreen title="{{ block.settings.video_title | default: 'Video' }}"></iframe>
                    {% elsif block.settings.video_url contains 'vimeo.com' %}
                      {% assign vimeo_id = block.settings.video_url | split: '/' | last | split: '?' | first %}
                      <iframe src="https://player.vimeo.com/video/{{ vimeo_id }}" frameborder="0" allowfullscreen title="{{ block.settings.video_title | default: 'Video' }}"></iframe>
                    {% endif %}
                  </div>
                {% endif %}

              {% when 'divider' %}
                <hr
                  class="block-divider"
                  style="
                    --block-divider-height: {{ block.settings.height }}px;
                    --block-divider-width: {{ block.settings.width }}%;
                    --block-divider-max-width: {{ block.settings.max_width }}px;
                    {% if block.settings.color != blank %}--block-divider-color: {{ block.settings.color }};{% endif %}
                  "
                >

              {% when 'cta_banner' %}
                <div
                  class="block-cta"
                  style="
                    {% if block.settings.background_color != blank %}--block-cta-bg: {{ block.settings.background_color }};{% endif %}
                    {% if block.settings.text_color != blank %}--block-cta-text: {{ block.settings.text_color }};{% endif %}
                    {% if block.settings.button_background != blank %}--block-cta-btn-bg: {{ block.settings.button_background }};{% endif %}
                    {% if block.settings.button_text_color != blank %}--block-cta-btn-text: {{ block.settings.button_text_color }};{% endif %}
                  "
                >
                  {% if block.settings.heading != blank %}
                    <h3 class="block-cta__heading">{{ block.settings.heading }}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="block-cta__text">{{ block.settings.text }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="block-cta__button">{{ block.settings.button_label }}</a>
                  {% endif %}
                </div>

              {% when 'accordion' %}
                <details class="block-accordion" {% if block.settings.open_by_default %}open{% endif %}>
                  <summary class="block-accordion__header">
                    <span>{{ block.settings.heading | default: 'Section' }}</span>
                    <svg class="block-accordion__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="block-accordion__content rte">
                    {{ block.settings.content }}
                  </div>
                </details>

              {% when 'custom_html' %}
                <div class="block-custom-html">
                  {{ block.settings.html_content }}
                </div>
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% comment %} Page Structured Data {% endcomment %}
{% if section.settings.enable_structured_data %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ page.title | escape }}",
  "url": "{{ shop.url }}{{ page.url }}",
  {% if page.description != blank %}
  "description": "{{ page.description | strip_html | escape }}",
  {% elsif page.content != blank %}
  "description": "{{ page.content | strip_html | truncate: 160 | escape }}",
  {% endif %}
  {% if page.featured_image %}
  "image": "https:{{ page.featured_image | image_url: width: 1200 }}",
  {% endif %}
  "mainEntity": {
    "@type": "Article",
    "headline": "{{ page.title | escape }}",
    "author": {
      "@type": "Organization",
      "name": "{{ shop.name | escape }}"
    },
    "publisher": {
      "@type": "Organization",
      "name": "{{ shop.name | escape }}"
    }
  }
}
</script>
{% endif %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse" },
        { "value": "accent", "label": "Accent" },
        { "value": "subtle", "label": "Subtle" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color (Custom)"
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        { "value": "narrow", "label": "Narrow (800px)" },
        { "value": "medium", "label": "Medium (1000px)" },
        { "value": "wide", "label": "Wide (1200px)" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Page Title"
    },
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "text",
      "id": "page_subtitle",
      "label": "Subtitle",
      "info": "Optional subtitle below page title"
    },
    {
      "type": "range",
      "id": "title_scale",
      "label": "Title scale",
      "min": 75,
      "max": 150,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Featured Image"
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "image_full_width",
      "label": "Full width image",
      "default": false
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width",
      "min": 400,
      "max": 1600,
      "step": 100,
      "default": 1200,
      "unit": "px",
      "info": "Only applies when full width is disabled"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "image_shadow",
      "label": "Show image shadow",
      "default": false
    },
    {
      "type": "select",
      "id": "image_alignment",
      "label": "Image alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "image_spacing",
      "label": "Image bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 400,
      "max": 1600,
      "step": 50,
      "default": 800,
      "unit": "px",
      "info": "Set to 0 for full width"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" },
        { "value": "justify", "label": "Justify" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "custom_css_class",
      "label": "Custom CSS class"
    },
    {
      "type": "checkbox",
      "id": "enable_structured_data",
      "label": "Enable structured data",
      "default": true,
      "info": "Adds JSON-LD schema for SEO"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "info": "Describe the image for accessibility"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "range",
          "id": "max_width",
          "label": "Max width",
          "min": 200,
          "max": 1200,
          "step": 50,
          "default": 800,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "alignment",
