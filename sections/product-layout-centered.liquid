{% liquid
  # @description Centered product layout - Image above, info below (centered layout)
  # Alternative product page layout with centered arrangement
  # This is a preset configuration of main-product with centered layout defaults
  # @example
  #   Add to product.json template for centered product page layout
%}

{%- comment -%} Note: This layout section uses the same blocks as main-product. 
     For full functionality, use main-product.liquid with info_position set to 'below'.
     This section serves as a preset template. {%- endcomment -%}

<div class="product-layout-centered">
  <p style="padding: 2rem; text-align: center; color: #666;">
    This is a layout preset. Use the main "Product information" section and set "Product Info Position" to "Below Images" for the centered layout.
  </p>
</div>

{% schema %}
{
  "name": "Product Layout - Centered",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Gallery Style",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "max_content_width",
      "label": "Max Content Width (px)",
      "min": 600,
      "max": 1200,
      "step": 50,
      "default": 900
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Product Layout - Centered"
    }
  ]
}
{% endschema %}

