{% liquid
  # @description Benefits section displaying product benefits in grid or carousel layout
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # Supports both grid and carousel layouts
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings layout_style {String} - Layout style: 'grid' or 'carousel'
  # @settings heading {String} - Section heading
  # @settings columns_desktop {Number} - Number of columns on desktop
  # @blocks benefit_item - Individual benefit with icon, title, and description
  # @example
  #   Use blocks mode for dynamic add/remove, settings mode for fixed 6-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
  assign layout_style = section.settings.layout_style | default: 'grid'
%}

<{{ structural_element }} class="benefits-section{% if layout_style == 'carousel' %} benefits-section--carousel{% endif %}"
     {% if request.design_mode %}data-section-type="benefits" data-layout="{{ layout_style }}" data-columns="{{ section.settings.columns_desktop }}" data-items="{{ benefit_count }}"{% endif %}
     style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">

  {%- if request.design_mode -%}
    <div class="editor-controls editor-controls--benefits">
      <span class="editor-label">✨ Benefits Section</span>
      <span class="editor-info">{{ layout_style | capitalize }} | {% if layout_style == 'grid' %}{{ section.settings.columns_desktop }} cols{% else %}{{ section.settings.carousel_items_desktop }} per slide{% endif %} | {{ benefit_count }} items | Mode: {{ section.settings.content_mode | capitalize }}</span>
    </div>
  {%- endif -%}

  <div class="benefits-content page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="benefits-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- comment -%} Count benefit items {%- endcomment -%}
    {%- assign benefit_count = 0 -%}
    {%- if section.settings.content_mode == 'blocks' -%}
      {%- assign benefit_count = section.blocks.size -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        {%- assign title_key = 'benefit_' | append: i | append: '_title' -%}
        {%- assign desc_key = 'benefit_' | append: i | append: '_description' -%}
        {%- assign title = section.settings[title_key] -%}
        {%- assign desc = section.settings[desc_key] -%}
        {%- if title != blank or desc != blank -%}
          {%- assign benefit_count = benefit_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    
    {%- if benefit_count > 0 -%}
      {%- if layout_style == 'carousel' -%}
        {%- comment -%} Carousel Layout {%- endcomment -%}
        <div class="benefits-carousel__wrapper" 
             data-carousel-id="benefits-{{ section.id }}"
             data-items-desktop="{{ section.settings.carousel_items_desktop }}"
             data-items-mobile="{{ section.settings.carousel_items_mobile }}"
             data-autoplay="{{ section.settings.carousel_autoplay }}"
             data-autoplay-speed="{{ section.settings.carousel_autoplay_speed }}"
             data-gap="{{ section.settings.item_spacing }}">
          
          <div class="benefits-carousel__container" role="region" aria-label="Benefits carousel">
            <div class="benefits-carousel__track" data-carousel-track>
              {%- if section.settings.content_mode == 'blocks' -%}
                {%- for block in section.blocks -%}
                  <div class="benefits-carousel__slide" data-carousel-slide>
                    <div class="benefit-item" {{ block.shopify_attributes }}>
                      {%- if block.settings.icon != blank -%}
                        <div class="benefit-icon">
                          <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                        </div>
                      {%- elsif block.settings.icon_asset != blank -%}
                        <div class="benefit-icon">
                          <img src="{{ block.settings.icon_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                        </div>
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                        <h3 class="benefit-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}">{{ block.settings.title | escape }}</h3>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <p class="benefit-description" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..6) -%}
                  {%- assign title_key = 'benefit_' | append: i | append: '_title' -%}
                  {%- assign desc_key = 'benefit_' | append: i | append: '_description' -%}
                  {%- assign icon_key = 'benefit_' | append: i | append: '_icon' -%}
                  {%- assign title = section.settings[title_key] -%}
                  {%- assign desc = section.settings[desc_key] -%}
                  {%- assign icon = section.settings[icon_key] -%}
                  {%- if title != blank or desc != blank -%}
                    <div class="benefits-carousel__slide" data-carousel-slide>
                      <div class="benefit-item">
                        {%- if icon != blank -%}
                          <div class="benefit-icon">
                            <img src="{{ icon | image_url: width: 100 }}" alt="{{ title | escape }}" loading="lazy">
                          </div>
                        {%- endif -%}
                        {%- if title != blank -%}
                          <h3 class="benefit-title">{{ title | escape }}</h3>
                        {%- endif -%}
                        {%- if desc != blank -%}
                          <p class="benefit-description">{{ desc }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.carousel_show_arrows -%}
            <button class="benefits-carousel__button benefits-carousel__button--prev" 
                    data-carousel-prev 
                    aria-label="Previous benefits"
                    type="button">
              <span aria-hidden="true">‹</span>
            </button>
            <button class="benefits-carousel__button benefits-carousel__button--next" 
                    data-carousel-next 
                    aria-label="Next benefits"
                    type="button">
              <span aria-hidden="true">›</span>
            </button>
          {%- endif -%}

          {%- if section.settings.carousel_show_dots and benefit_count > section.settings.carousel_items_desktop -%}
            <div class="benefits-carousel__dots" data-carousel-dots role="tablist" aria-label="Benefits navigation">
              {%- assign total_slides = benefit_count | divided_by: section.settings.carousel_items_desktop | ceil -%}
              {%- for i in (1..total_slides) -%}
                <button class="benefits-carousel__dot{% if forloop.first %} benefits-carousel__dot--active{% endif %}" 
                        data-carousel-dot 
                        data-slide-index="{{ forloop.index0 }}"
                        aria-label="Go to slide {{ forloop.index }}"
                        type="button"
                        role="tab"
                        aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="visually-hidden">Slide {{ forloop.index }}</span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%} Grid Layout {%- endcomment -%}
        <div class="benefits-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
          {%- if section.settings.content_mode == 'blocks' -%}
            {%- for block in section.blocks -%}
              <div class="benefit-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="benefit-icon">
                    <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                  </div>
                {%- elsif block.settings.icon_asset != blank -%}
                  <div class="benefit-icon">
                    <img src="{{ block.settings.icon_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                  </div>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="benefit-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="benefit-description" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Settings mode - Fixed fields {%- endcomment -%}
            {%- for i in (1..6) -%}
              {%- assign title_key = 'benefit_' | append: i | append: '_title' -%}
              {%- assign desc_key = 'benefit_' | append: i | append: '_description' -%}
              {%- assign icon_key = 'benefit_' | append: i | append: '_icon' -%}
              {%- assign title = section.settings[title_key] -%}
              {%- assign desc = section.settings[desc_key] -%}
              {%- assign icon = section.settings[icon_key] -%}
              {%- if title != blank or desc != blank -%}
                <div class="benefit-item">
                  {%- if icon != blank -%}
                    <div class="benefit-icon">
                      <img src="{{ icon | image_url: width: 100 }}" alt="{{ title | escape }}" loading="lazy">
                    </div>
                  {%- endif -%}
                  {%- if title != blank -%}
                    <h3 class="benefit-title">{{ title | escape }}</h3>
                  {%- endif -%}
                  {%- if desc != blank -%}
                    <p class="benefit-description">{{ desc }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</{{ structural_element }}>

<style>
  {% if request.design_mode %}
  /* Theme Editor Visual Controls */
  .benefits-section {
    position: relative;
    outline: 2px dashed rgba(255, 100, 150, 0.3);
    outline-offset: -2px;
  }

  .benefits-section:hover {
    outline-color: rgba(255, 100, 150, 0.6);
  }

  .editor-controls--benefits {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.90);
    color: white;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 11px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    pointer-events: none;
    max-width: 400px;
  }

  .editor-label {
    font-weight: 600;
    color: #ffa5c4;
    font-size: 12px;
  }

  .editor-info {
    opacity: 0.85;
    font-size: 10px;
    line-height: 1.4;
  }

  /* Grid Visualizer */
  {% if section.settings.layout_style == 'grid' %}
  .benefits-grid {
    position: relative;
  }

  .benefits-grid::before {
    content: '{{ section.settings.columns_desktop }}-Column Grid';
    position: absolute;
    top: -24px;
    left: 0;
    background: rgba(255, 100, 150, 0.9);
    color: white;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-family: monospace;
    pointer-events: none;
    z-index: 10;
  }
  {% endif %}

  /* Block Indicators */
  .benefit-item {
    position: relative;
    outline: 1px dashed rgba(255, 150, 200, 0.2);
    outline-offset: -1px;
  }

  .benefit-item:hover {
    outline-color: rgba(255, 150, 200, 0.5);
    background: rgba(255, 150, 200, 0.05);
  }

  /* Carousel Indicators */
  {% if section.settings.layout_style == 'carousel' %}
  .benefits-carousel__wrapper::before {
    content: 'Carousel: {{ section.settings.carousel_items_desktop }} items/slide{% if section.settings.carousel_autoplay %} • Autoplay{% endif %}';
    position: absolute;
    top: -24px;
    left: 0;
    background: rgba(255, 140, 0, 0.9);
    color: white;
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-family: monospace;
    pointer-events: none;
    z-index: 10;
  }
  {% endif %}
  {% endif %}

  /* Benefits Section Responsive Styles */
  .benefits-grid {
    display: grid;
    gap: clamp(20px, 4vw, {{ section.settings.item_spacing }}px);
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .benefits-grid {
      grid-template-columns: 1fr !important;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .benefits-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }
  
  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  
  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .benefits-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr) !important;
    }
  }

  /* Carousel Layout Styles */
  .benefits-section--carousel .benefits-carousel__wrapper {
    margin-top: 20px;
  }

  .benefits-section--carousel .benefit-item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
</style>

{% schema %}
{
  "name": "✨ Benefits Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Display product benefits in a grid or carousel. Choose between flexible blocks (add/remove/reorder) or fixed settings (6 pre-defined slots)."
    },
    {
      "type": "header",
      "content": "📝 Content Management Mode"
    },
    {
      "type": "select",
      "id": "content_mode",
      "label": "How to Manage Content",
      "options": [
        { "value": "blocks", "label": "Blocks Mode (Flexible - Add/Remove)" },
        { "value": "settings", "label": "Settings Mode (Fixed - 6 Slots)" }
      ],
      "default": "blocks",
      "info": "Blocks: Dynamic, drag-and-drop, unlimited items. Settings: Fixed 6 slots, simpler for non-technical users."
    },
    {
      "type": "header",
      "content": "📐 Layout & Display Style"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Display Style",
      "options": [
        { "value": "grid", "label": "Grid (All items visible)" },
        { "value": "carousel", "label": "Carousel (Swipeable slides)" }
      ],
      "default": "grid",
      "info": "Grid: Traditional layout, all benefits visible at once. Carousel: Slides with navigation arrows, great for many items."
    },
    {
      "type": "paragraph",
      "content": "**Grid Layout Controls:** These settings only apply when Display Style is set to Grid."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "col",
      "default": 3,
      "info": "How many benefit items appear side-by-side on desktop. Common: 3 (balanced), 4 (compact), 2 (spacious)."
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "col",
      "default": 1,
      "info": "Columns on mobile devices. Usually 1 (vertical stack) or 2 (compact grid)."
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Space Between Items",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30,
      "info": "Gap between benefit items. Standard: 20-30px (comfortable), 40-50px (spacious), 10-15px (compact)."
    },
    {
      "type": "header",
      "content": "🎠 Carousel Settings"
    },
    {
      "type": "paragraph",
      "content": "**Carousel Controls:** These settings only apply when Display Style is set to Carousel."
    },
    {
      "type": "range",
      "id": "carousel_items_desktop",
      "label": "Items Per Slide (Desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "info": "Only applies when layout style is Carousel"
    },
    {
      "type": "range",
      "id": "carousel_items_mobile",
      "label": "Items Per Slide (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "info": "Only applies when layout style is Carousel"
    },
    {
      "type": "checkbox",
      "id": "carousel_show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_show_dots",
      "label": "Show Dot Indicators",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Enable Auto-play",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_speed",
      "label": "Auto-play Speed (ms)",
      "min": 2000,
      "max": 9999,
      "step": 500,
      "default": 5000,
      "info": "Only applies when auto-play is enabled"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Benefits"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "header",
      "content": "Fixed Benefits (Settings Mode)"
    },
    {
      "type": "text",
      "id": "benefit_1_title",
      "label": "Benefit 1 - Title"
    },
    {
      "type": "textarea",
      "id": "benefit_1_description",
      "label": "Benefit 1 - Description"
    },
    {
      "type": "image_picker",
      "id": "benefit_1_icon",
      "label": "Benefit 1 - Icon"
    },
    {
      "type": "text",
      "id": "benefit_2_title",
      "label": "Benefit 2 - Title"
    },
    {
      "type": "textarea",
      "id": "benefit_2_description",
      "label": "Benefit 2 - Description"
    },
    {
      "type": "image_picker",
      "id": "benefit_2_icon",
      "label": "Benefit 2 - Icon"
    },
    {
      "type": "text",
      "id": "benefit_3_title",
      "label": "Benefit 3 - Title"
    },
    {
      "type": "textarea",
      "id": "benefit_3_description",
      "label": "Benefit 3 - Description"
    },
    {
      "type": "image_picker",
      "id": "benefit_3_icon",
      "label": "Benefit 3 - Icon"
    },
    {
      "type": "text",
      "id": "benefit_4_title",
      "label": "Benefit 4 - Title"
    },
    {
      "type": "textarea",
      "id": "benefit_4_description",
      "label": "Benefit 4 - Description"
    },
    {
      "type": "image_picker",
      "id": "benefit_4_icon",
      "label": "Benefit 4 - Icon"
    },
    {
      "type": "text",
      "id": "benefit_5_title",
      "label": "Benefit 5 - Title"
    },
    {
      "type": "textarea",
      "id": "benefit_5_description",
      "label": "Benefit 5 - Description"
    },
    {
      "type": "image_picker",
      "id": "benefit_5_icon",
      "label": "Benefit 5 - Icon"
    },
    {
      "type": "text",
      "id": "benefit_6_title",
      "label": "Benefit 6 - Title"
    },
    {
      "type": "textarea",
      "id": "benefit_6_description",
      "label": "Benefit 6 - Description"
    },
    {
      "type": "image_picker",
      "id": "benefit_6_icon",
      "label": "Benefit 6 - Icon"
    },
    {
      "type": "header",
      "content": "Structural Elements"
    },
    {
      "type": "select",
      "id": "structural_element",
      "label": "HTML Element",
      "options": [
        { "value": "section", "label": "Section (default)" },
        { "value": "article", "label": "Article" },
        { "value": "aside", "label": "Aside" },
        { "value": "div", "label": "Div" }
      ],
      "default": "section",
      "info": "Choose the semantic HTML element for this section"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "⭐ Benefit: {{ block.settings.title }}",
      "settings": [
        {
          "type": "paragraph",
          "content": "Add a single benefit item. Includes optional icon, title, description, and custom colors."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Benefit Title",
          "info": "Short, impactful headline for this benefit. Examples: 'Fast Shipping', 'Organic Ingredients', '30-Day Guarantee'"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit Description",
          "default": "Benefit description",
          "info": "Explain the benefit in 1-2 sentences. Keep it concise and customer-focused."
        },
        {
          "type": "header",
          "content": "🎨 Icon & Visuals"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image",
          "info": "Upload an icon or illustration. Recommended: 100x100px square, PNG with transparency."
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Icon Asset Filename (Alternative)",
          "info": "If you've uploaded icon to theme assets, enter filename here (e.g., 'shipping-icon.svg'). Leave blank if using image picker above."
        },
        {
          "type": "header",
          "content": "🎨 Colors"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "info": "Custom color for this benefit's title. Leave blank to use theme default."
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description Color",
          "info": "Custom color for this benefit's description text. Leave blank to use theme default."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits - 3 Column Grid",
      "settings": {
        "heading": "Why Choose Us",
        "layout_style": "grid",
        "columns_desktop": 3,
        "columns_mobile": 1,
        "item_spacing": 30,
        "content_mode": "blocks",
        "heading_alignment": "center",
        "section_padding": 60
      },
