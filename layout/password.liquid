<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% liquid
      assign load_shopify_fonts = false
      if settings.custom_font_heading == 'shopify_font' and settings.font_heading.system? == false
        assign load_shopify_fonts = true
      endif
      if settings.custom_font_body == 'shopify_font' and settings.font_body.system? == false
        assign load_shopify_fonts = true
      endif
    %}
    {% if load_shopify_fonts %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endif %}

    <title>{{ shop.name }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% liquid
      if settings.custom_font_body == 'shopify_font'
        assign body_font_bold = settings.font_body | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.font_body | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      endif
      if settings.custom_font_heading == 'shopify_font'
        assign heading_font_to_load = settings.font_heading
      endif
    %}

    {% style %}
      {% if settings.custom_font_body == 'shopify_font' %}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {{ body_font_bold | font_face: font_display: 'swap' }}
        {{ body_font_italic | font_face: font_display: 'swap' }}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {% endif %}
      {% if settings.custom_font_heading == 'shopify_font' %}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
      {% endif %}

      /* Custom Fonts from Assets - Multiple formats for browser compatibility */
      {% assign nohemi_light_woff = 'Nohemi-Light-BF6438cc5702321.woff' | asset_url %}
      {% assign nohemi_light_otf = 'Nohemi-Light.otf' | asset_url %}
      {% assign nohemi_light_ttf = 'Nohemi-Light-BF6438cc5899919.ttf' | asset_url %}

      {% assign nohemi_regular_woff = 'Nohemi-Regular-BF6438cc579d934.woff' | asset_url %}
      {% assign nohemi_regular_otf = 'Nohemi-Regular.otf' | asset_url %}
      {% assign nohemi_regular_ttf = 'Nohemi-Regular-BF6438cc4d0e493.ttf' | asset_url %}

      {% assign nohemi_medium_woff = 'Nohemi-Medium-BF6438cc57ddecd.woff' | asset_url %}
      {% assign nohemi_medium_otf = 'Nohemi-Medium.otf' | asset_url %}
      {% assign nohemi_medium_ttf = 'Nohemi-Medium-BF6438cc5883899.ttf' | asset_url %}

      {% assign nohemi_semibold_woff = 'Nohemi-SemiBold-BF6438cc57db2ff.woff' | asset_url %}
      {% assign nohemi_semibold_otf = 'Nohemi-SemiBold.otf' | asset_url %}
      {% assign nohemi_semibold_ttf = 'Nohemi-SemiBold-BF6438cc588a48a.ttf' | asset_url %}

      {% assign nohemi_bold_woff = 'Nohemi-Bold-BF6438cc577b524.woff' | asset_url %}
      {% assign nohemi_bold_otf = 'Nohemi-Bold.otf' | asset_url %}
      {% assign nohemi_bold_ttf = 'Nohemi-Bold-BF6438cc587b5b5.ttf' | asset_url %}

      {% assign versailles = 'Jen Wagner Co. - Versailles Regular.ttf' | asset_url %}
      {% assign myriad = 'MyriadPro-Regular.otf' | asset_url %}

      @font-face {
        font-family: 'Nohemi';
        font-weight: 300;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_light_woff }}') format('woff'),
             url('{{ nohemi_light_otf }}') format('opentype'),
             url('{{ nohemi_light_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_regular_woff }}') format('woff'),
             url('{{ nohemi_regular_otf }}') format('opentype'),
             url('{{ nohemi_regular_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 500;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_medium_woff }}') format('woff'),
             url('{{ nohemi_medium_otf }}') format('opentype'),
             url('{{ nohemi_medium_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 600;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_semibold_woff }}') format('woff'),
             url('{{ nohemi_semibold_otf }}') format('opentype'),
             url('{{ nohemi_semibold_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        src: url('{{ nohemi_bold_woff }}') format('woff'),
             url('{{ nohemi_bold_otf }}') format('opentype'),
             url('{{ nohemi_bold_ttf }}') format('truetype');
      }

      @font-face {
        font-family: 'Versailles';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url('{{ versailles }}') format('truetype');
      }

      @font-face {
        font-family: 'MyriadPro';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url('{{ myriad }}') format('opentype');
      }

      :root {
        /* Typography */
        {% case settings.custom_font_heading %}
          {% when 'nohemi' %}
            --font-heading-family: 'Nohemi', sans-serif;
          {% when 'versailles' %}
            --font-heading-family: 'Versailles', serif;
          {% when 'myriad' %}
            --font-heading-family: 'MyriadPro', sans-serif;
          {% when 'shopify_font' %}
            --font-heading-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
          {% else %}
            --font-heading-family: 'Nohemi', sans-serif;
        {% endcase %}

        {% case settings.custom_font_body %}
          {% when 'nohemi' %}
            --font-body-family: 'Nohemi', sans-serif;
          {% when 'versailles' %}
            --font-body-family: 'Versailles', serif;
          {% when 'myriad' %}
            --font-body-family: 'MyriadPro', sans-serif;
          {% when 'shopify_font' %}
            --font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
          {% else %}
            --font-body-family: 'MyriadPro', sans-serif;
        {% endcase %}

        --font-body-weight: 400;
        --font-heading-weight: 600;

        /* Colors */
        --color-primary: {{ settings.color_primary | default: '#4A7C59' }};
        --color-secondary: {{ settings.color_secondary | default: '#8B9D83' }};
        --color-accent: {{ settings.color_accent | default: '#C4A962' }};
        --color-background: {{ settings.color_background | default: '#FDFBF7' }};
        --color-text: {{ settings.color_text | default: '#2C3E2D' }};
        --color-text-light: {{ settings.color_text_light | default: '#5A6B5C' }};

        /* Layout */
        --page-width: {{ settings.page_width | default: 1200 }}px;
        --spacing-unit: {{ settings.spacing_unit | default: 8 }}px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-size: 62.5%;
        height: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100%;
        margin: 0;
        font-family: var(--font-body-family);
        font-size: 1.6rem;
        font-weight: var(--font-body-weight);
        line-height: 1.6;
        color: var(--color-text);
        background-color: var(--color-background);
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading-family);
        font-weight: var(--font-heading-weight);
        line-height: 1.2;
        margin: 0 0 1rem;
      }

      .password-page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .password-header {
        padding: 2rem;
        text-align: center;
      }

      .password-header__logo {
        font-family: var(--font-heading-family);
        font-size: 2.4rem;
        font-weight: var(--font-heading-weight);
        color: var(--color-primary);
        text-decoration: none;
      }

      .password-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
      }

      .password-content {
        max-width: 50rem;
        text-align: center;
      }

      .password-content h1 {
        font-size: 3.6rem;
        margin-bottom: 1.5rem;
        color: var(--color-primary);
      }

      .password-content p {
        font-size: 1.8rem;
        color: var(--color-text-light);
        margin-bottom: 3rem;
      }

      .password-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 3rem;
      }

      .password-form input[type="password"] {
        padding: 1.2rem 1.6rem;
        font-size: 1.6rem;
        font-family: var(--font-body-family);
        border: 1px solid var(--color-secondary);
        border-radius: 4px;
        background: white;
        color: var(--color-text);
      }

      .password-form input[type="password"]:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 2px rgba(74, 124, 89, 0.2);
      }

      .password-form button {
        padding: 1.2rem 2.4rem;
        font-size: 1.6rem;
        font-family: var(--font-body-family);
        font-weight: 500;
        color: white;
        background-color: var(--color-primary);
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .password-form button:hover {
        background-color: var(--color-secondary);
      }

      .password-login-link {
        font-size: 1.4rem;
        color: var(--color-text-light);
      }

      .password-login-link a {
        color: var(--color-primary);
        text-decoration: underline;
      }

      .password-footer {
        padding: 2rem;
        text-align: center;
        font-size: 1.4rem;
        color: var(--color-text-light);
      }

      .password-footer a {
        color: var(--color-primary);
        text-decoration: none;
      }

      .password-footer a:hover {
        text-decoration: underline;
      }

      /* Modal */
      .password-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        align-items: center;
        justify-content: center;
        z-index: 1000;
      }

      .password-modal.is-open {
        display: flex;
      }

      .password-modal__content {
        background: white;
        padding: 3rem;
        border-radius: 8px;
        max-width: 40rem;
        width: 90%;
        position: relative;
      }

      .password-modal__close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        font-size: 2.4rem;
        cursor: pointer;
        color: var(--color-text-light);
        line-height: 1;
      }

      .password-modal__close:hover {
        color: var(--color-text);
      }

      @media screen and (max-width: 749px) {
        .password-content h1 {
          font-size: 2.8rem;
        }

        .password-content p {
          font-size: 1.6rem;
        }
      }
    {% endstyle %}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="password-page">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'main-password-header' %}

    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'main-password-footer' %}

    <div id="password-modal" class="password-modal">
      <div class="password-modal__content">
        <button class="password-modal__close" aria-label="Close">&times;</button>
        <h2>Enter store using password</h2>
        {% form 'storefront_password', class: 'password-form' %}
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Password"
            autocomplete="current-password"
            required
          >
          {% if form.errors %}
            <p style="color: #c53030; font-size: 1.4rem;">{{ form.errors.messages.password }}</p>
          {% endif %}
          <button type="submit">Enter</button>
        {% endform %}
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('password-modal');
        const openButtons = document.querySelectorAll('[data-open-password-modal]');
        const closeButton = modal.querySelector('.password-modal__close');

        openButtons.forEach(function(button) {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            modal.classList.add('is-open');
          });
        });

        closeButton.addEventListener('click', function() {
          modal.classList.remove('is-open');
        });

        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            modal.classList.remove('is-open');
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && modal.classList.contains('is-open')) {
            modal.classList.remove('is-open');
          }
        });
      });
    </script>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
