{%- liquid
  # @description Benefits section displaying product benefits in a grid layout
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings heading {String} - Section heading
  # @settings columns_desktop {Number} - Number of columns on desktop
  # @blocks benefit_item - Individual benefit with icon, title, and description
  # @example
  #   Use blocks mode for dynamic add/remove, settings mode for fixed 6-item layout
-%}

<section class="benefits-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding }}px 0;">
  <div class="benefits-content page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="benefits-heading" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }};">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    <div class="benefits-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: {{ section.settings.item_spacing }}px;">
      {%- if section.settings.content_mode == 'blocks' -%}
        {%- for block in section.blocks -%}
          <div class="benefit-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="benefit-icon">
                <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}">
              </div>
            {%- elsif block.settings.icon_asset != blank -%}
              <div class="benefit-icon">
                <img src="{{ block.settings.icon_asset | asset_url }}" alt="{{ block.settings.title | escape }}">
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="benefit-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="benefit-description" style="{% if block.settings.description_color != blank %}color: {{ block.settings.description_color }};{% endif %}">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Settings mode - Fixed fields {%- endcomment -%}
        {%- for i in (1..6) -%}
          {%- assign title_key = 'benefit_' | append: i | append: '_title' -%}
          {%- assign desc_key = 'benefit_' | append: i | append: '_description' -%}
          {%- assign icon_key = 'benefit_' | append: i | append: '_icon' -%}
          {%- assign title = section.settings[title_key] -%}
          {%- assign desc = section.settings[desc_key] -%}
          {%- assign icon = section.settings[icon_key] -%}
          {%- if title != blank or desc != blank -%}
            <div class="benefit-item">
              {%- if icon != blank -%}
                <div class="benefit-icon">
                  <img src="{{ icon | image_url: width: 100 }}" alt="{{ title | escape }}">
                </div>
              {%- endif -%}
              {%- if title != blank -%}
                <h3 class="benefit-title">{{ title | escape }}</h3>
              {%- endif -%}
              {%- if desc != blank -%}
                <p class="benefit-description">{{ desc }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  /* Benefits Section Responsive Styles */
  .benefits-grid {
    display: grid;
    gap: clamp(20px, 4vw, {{ section.settings.item_spacing }}px);
  }
  
  /* Mobile Portrait (max-width: 479px) */
  @media screen and (max-width: 479px) {
    .benefits-grid {
      grid-template-columns: 1fr !important;
    }
  }
  
  /* Mobile Landscape (480px - 767px) */
  @media screen and (min-width: 480px) and (max-width: 767px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }
  
  /* Tablet Portrait (768px - 1023px) */
  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .benefits-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, 1fr) !important;
    }
  }
  
  /* Tablet Landscape (1024px - 1199px) */
  @media screen and (min-width: 1024px) and (max-width: 1199px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
  
  /* Desktop (1200px+) */
  @media screen and (min-width: 1200px) {
    .benefits-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr) !important;
    }
  }
</style>

