{%- liquid
  # @description Advanced meta tag generator with template-specific logic, metafield support, and intelligent fallbacks
  # Provides character limit validation, truncation, and support for all template types
  # @param template_type {String} - Template type override (optional)
  # @param custom_title {String} - Custom title override (optional)
  # @param custom_description {String} - Custom description override (optional)
  # @example
  #   {% render 'seo-meta-advanced' %}
-%}

{%- comment -%} Character limits for SEO {%- endcomment -%}
{%- liquid
  assign title_max_length = 60
  assign description_max_length = 160
  assign title_min_length = 30
  assign description_min_length = 120
-%}

{%- comment -%} Get meta title with priority: custom > metafield > template-specific > default {%- endcomment -%}
{%- liquid
  assign seo_title = custom_title
  
  if seo_title == blank
    if template.name == 'product'
      if product.metafields.seo.title != blank
        assign seo_title = product.metafields.seo.title
      else
        assign seo_title = product.title | escape
      endif
    elsif template.name == 'collection'
      if collection.metafields.seo.title != blank
        assign seo_title = collection.metafields.seo.title
      else
        assign seo_title = collection.title | escape
      endif
    elsif template.name == 'article'
      if article.metafields.seo.title != blank
        assign seo_title = article.metafields.seo.title
      else
        assign seo_title = article.title | escape
      endif
    elsif template.name == 'page'
      if page.metafields.seo.title != blank
        assign seo_title = page.metafields.seo.title
      else
        assign seo_title = page.title | escape
      endif
    elsif template.name == 'index'
      if settings.seo_homepage_title != blank
        assign seo_title = settings.seo_homepage_title
      else
        assign seo_title = shop.name
      endif
    else
      assign seo_title = page_title | default: shop.name
    endif
  endif
  
  if seo_title == blank
    assign seo_title = shop.name
  endif
  
  assign seo_title_length = seo_title | size
  if seo_title_length > title_max_length
    assign seo_title = seo_title | truncate: title_max_length
  endif
-%}

{%- comment -%} Get meta description with priority: custom > metafield > template-specific > default {%- endcomment -%}
{%- liquid
  assign seo_description = custom_description
  
  if seo_description == blank
    if template.name == 'product'
      if product.metafields.seo.description != blank
        assign seo_description = product.metafields.seo.description
      elsif product.description != blank
        assign seo_description = product.description | strip_html | strip
      endif
    elsif template.name == 'collection'
      if collection.metafields.seo.description != blank
        assign seo_description = collection.metafields.seo.description
      elsif collection.description != blank
        assign seo_description = collection.description | strip_html | strip
      endif
    elsif template.name == 'article'
      if article.metafields.seo.description != blank
        assign seo_description = article.metafields.seo.description
      elsif article.excerpt != blank
        assign seo_description = article.excerpt | strip_html | strip
      elsif article.content != blank
        assign seo_description = article.content | strip_html | strip
      endif
    elsif template.name == 'page'
      if page.metafields.seo.description != blank
        assign seo_description = page.metafields.seo.description
      elsif page.content != blank
        assign seo_description = page.content | strip_html | strip
      endif
    elsif template.name == 'index'
      if settings.seo_homepage_description != blank
        assign seo_description = settings.seo_homepage_description
      endif
    else
      assign seo_description = page_description
    endif
  endif
  
  if seo_description == blank and settings.seo_default_description != blank
    assign seo_description = settings.seo_default_description
  endif
  
  if seo_description != blank
    assign seo_description_length = seo_description | size
    if seo_description_length > description_max_length
      assign seo_description = seo_description | truncate: description_max_length
    endif
  endif
-%}

{%- comment -%} Get SEO image {%- endcomment -%}
{%- liquid
  assign seo_image = null
  assign seo_image_width = 1200
  assign seo_image_height = 630
  
  if template.name == 'product' and product.featured_media
    assign seo_image = product.featured_media
  elsif template.name == 'article' and article.image
    assign seo_image = article.image
  elsif template.name == 'collection' and collection.featured_image
    assign seo_image = collection.featured_image
  elsif template.name == 'page' and page.featured_image
    assign seo_image = page.featured_image
  elsif settings.seo_og_image != blank
    assign seo_image = settings.seo_og_image
  endif
  
  if seo_image != null
    assign seo_image_width = 1200
    assign seo_image_height = seo_image_width | divided_by: seo_image.aspect_ratio | round
  endif
-%}

{%- comment -%} Output meta title {%- endcomment -%}
{%- if seo_title != blank -%}
  <meta name="title" content="{{ seo_title | escape }}">
{%- endif -%}

{%- comment -%} Output meta description {%- endcomment -%}
{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | escape }}">
{%- endif -%}

{%- comment -%} Output meta keywords (legacy support) {%- endcomment -%}
{%- if template.name == 'product' and product.metafields.seo.keywords != blank -%}
  <meta name="keywords" content="{{ product.metafields.seo.keywords | escape }}">
{%- elsif template.name == 'collection' and collection.metafields.seo.keywords != blank -%}
  <meta name="keywords" content="{{ collection.metafields.seo.keywords | escape }}">
{%- elsif template.name == 'article' and article.metafields.seo.keywords != blank -%}
  <meta name="keywords" content="{{ article.metafields.seo.keywords | escape }}">
{%- elsif template.name == 'page' and page.metafields.seo.keywords != blank -%}
  <meta name="keywords" content="{{ page.metafields.seo.keywords | escape }}">
{%- elsif settings.seo_default_keywords != blank -%}
  <meta name="keywords" content="{{ settings.seo_default_keywords | escape }}">
{%- endif -%}

{%- comment -%} Output SEO image meta tags {%- endcomment -%}
{%- if seo_image != null -%}
  <meta property="og:image" content="https:{{ seo_image | image_url: width: seo_image_width }}">
  <meta property="og:image:secure_url" content="https:{{ seo_image | image_url: width: seo_image_width }}">
  <meta property="og:image:width" content="{{ seo_image_width }}">
  <meta property="og:image:height" content="{{ seo_image_height }}">
  <meta property="og:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
  <meta name="twitter:image" content="https:{{ seo_image | image_url: width: seo_image_width }}">
  <meta name="twitter:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
{%- endif -%}

{%- comment -%} SEO Validation Data (for development/debugging) {%- endcomment -%}
{%- if settings.seo_enable_validation -%}
  <meta name="seo:title-length" content="{{ seo_title_length }}">
  <meta name="seo:description-length" content="{{ seo_description | size }}">
  <meta name="seo:title-valid" content="{% if seo_title_length >= title_min_length and seo_title_length <= title_max_length %}true{% else %}false{% endif %}">
  <meta name="seo:description-valid" content="{% if seo_description != blank and seo_description.size >= description_min_length and seo_description.size <= description_max_length %}true{% else %}false{% endif %}">
{%- endif -%}

