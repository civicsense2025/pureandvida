{%- liquid
  # @description Slideshow section for image carousel with text overlays
  # Supports auto-play, navigation controls, and multiple transition effects
  # @settings autoplay {checkbox} - Enable automatic slide advancement
  # @settings autoplay_speed {range} - Seconds between slides
  # @blocks slide {object} - Individual slide with image and content
  # @example
  #   Use for hero banners, promotional campaigns, or product showcases
-%}

{% if request.design_mode %}
  <div class="editor-controls editor-controls--slideshow">
    <span class="editor-label">Slideshow</span>
    <span class="editor-info">
      {{ section.blocks.size }} slides |
      {% if section.settings.autoplay %}Auto: {{ section.settings.autoplay_speed }}s{% else %}Manual{% endif %}
    </span>
  </div>
{% endif %}

<section
  class="slideshow slideshow--{{ section.settings.layout }}"
  id="slideshow-{{ section.id }}"
  style="
    {% if section.settings.layout == 'full_screen' %}
      min-height: {{ section.settings.full_screen_height }}vh;
    {% else %}
      min-height: {{ section.settings.slide_height }}px;
    {% endif %}
  "
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-transition="{{ section.settings.transition }}"
  aria-label="Slideshow"
  role="region"
>
  <div class="slideshow__container">
    {%- if section.blocks.size > 0 -%}
      <div class="slideshow__slides" role="list">
        {%- for block in section.blocks -%}
          <div
            class="slideshow__slide{% if forloop.first %} slideshow__slide--active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            role="listitem"
            aria-hidden="{% unless forloop.first %}true{% endunless %}"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} Background Image {%- endcomment -%}
            <div class="slideshow__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1920 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 640 }} 640w,
                    {{ block.settings.image | image_url: width: 960 }} 960w,
                    {{ block.settings.image | image_url: width: 1280 }} 1280w,
                    {{ block.settings.image | image_url: width: 1600 }} 1600w,
                    {{ block.settings.image | image_url: width: 1920 }} 1920w
                  "
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | escape | default: block.settings.heading | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  class="slideshow__image"
                >
              {%- else -%}
                <div class="slideshow__placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" fill="none" preserveAspectRatio="xMidYMid slice">
                    <rect width="1920" height="1080" fill="#E8E8E8"/>
                    <text x="50%" y="50%" text-anchor="middle" fill="#CACACA" font-size="48" font-family="sans-serif">Slide {{ forloop.index }}</text>
                  </svg>
                </div>
              {%- endif -%}

              {%- if block.settings.show_overlay -%}
                <div
                  class="slideshow__overlay"
                  style="
                    background: {{ block.settings.overlay_color | default: '#000000' }};
                    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                  "
                ></div>
              {%- endif -%}
            </div>

            {%- comment -%} Content {%- endcomment -%}
            <div
              class="slideshow__content slideshow__content--{{ block.settings.content_position }}"
              style="
                text-align: {{ block.settings.text_alignment }};
                max-width: {{ block.settings.content_width }}px;
              "
            >
              <div class="slideshow__content-inner">
                {%- if block.settings.subheading != blank -%}
                  <span
                    class="slideshow__subheading"
                    style="color: {{ block.settings.text_color | default: '#ffffff' }};"
                  >
                    {{ block.settings.subheading }}
                  </span>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h2
                    class="slideshow__heading"
                    style="
                      font-size: {{ block.settings.heading_size }}px;
                      color: {{ block.settings.text_color | default: '#ffffff' }};
                    "
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div
                    class="slideshow__text"
                    style="color: {{ block.settings.text_color | default: '#ffffff' }};"
                  >
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_label != blank -%}
                  <div class="slideshow__buttons">
                    <a
                      href="{{ block.settings.button_link }}"
                      class="slideshow__button button button--{{ block.settings.button_style }}"
                      {% if block.settings.button_link == blank %}aria-disabled="true"{% endif %}
                    >
                      {{ block.settings.button_label }}
                    </a>

                    {%- if block.settings.secondary_button_label != blank -%}
                      <a
                        href="{{ block.settings.secondary_button_link }}"
                        class="slideshow__button slideshow__button--secondary button button--{{ block.settings.secondary_button_style }}"
                        {% if block.settings.secondary_button_link == blank %}aria-disabled="true"{% endif %}
                      >
                        {{ block.settings.secondary_button_label }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Navigation {%- endcomment -%}
      {%- if section.blocks.size > 1 -%}
        {%- if section.settings.show_arrows -%}
          <div class="slideshow__navigation">
            <button
              type="button"
              class="slideshow__arrow slideshow__arrow--prev"
              aria-label="{{ 'accessibility.previous_slide' | t | default: 'Previous slide' }}"
              data-slideshow-prev
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="slideshow__arrow slideshow__arrow--next"
              aria-label="{{ 'accessibility.next_slide' | t | default: 'Next slide' }}"
              data-slideshow-next
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_pagination -%}
          <div class="slideshow__pagination" role="tablist" aria-label="Slide pagination">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="slideshow__dot{% if forloop.first %} slideshow__dot--active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Go to slide {{ forloop.index }}"
                data-slide-index="{{ forloop.index0 }}"
                data-slideshow-dot
              >
                <span class="visually-hidden">Slide {{ forloop.index }}</span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      {%- if request.design_mode -%}
        <div class="slideshow__empty">
          <div class="slideshow__empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
          </div>
          <h3>Slideshow</h3>
          <p>Add slide blocks to create your slideshow.</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .slideshow {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .slideshow__container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slideshow__slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slideshow__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ section.settings.transition_speed }}ms ease, visibility {{ section.settings.transition_speed }}ms ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slideshow__slide--active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  /* Slide transition */
  {% if section.settings.transition == 'slide' %}
    .slideshow__slide {
      transform: translateX(100%);
      transition: transform {{ section.settings.transition_speed }}ms ease, opacity {{ section.settings.transition_speed }}ms ease;
    }

    .slideshow__slide--active {
      transform: translateX(0);
    }

    .slideshow__slide--prev {
      transform: translateX(-100%);
    }
  {% endif %}

  .slideshow__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .slideshow__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  .slideshow__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e0e0e0, #f5f5f5);
  }

  .slideshow__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .slideshow__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
  }

  .slideshow__content {
    position: relative;
    z-index: 2;
    padding: 40px;
    width: 100%;
  }

  .slideshow__content--top-left {
    align-self: flex-start;
  }

  .slideshow__content--top-center {
    align-self: flex-start;
    margin: 0 auto;
  }

  .slideshow__content--top-right {
    align-self: flex-start;
    margin-left: auto;
  }

  .slideshow__content--center-left {
    align-self: center;
  }

  .slideshow__content--center-center {
    align-self: center;
    margin: 0 auto;
  }

  .slideshow__content--center-right {
    align-self: center;
    margin-left: auto;
  }

  .slideshow__content--bottom-left {
    align-self: flex-end;
  }

  .slideshow__content--bottom-center {
    align-self: flex-end;
    margin: 0 auto;
  }

  .slideshow__content--bottom-right {
    align-self: flex-end;
    margin-left: auto;
  }

  .slideshow__content-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .slideshow__subheading {
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .slideshow__heading {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight, 700);
    line-height: 1.1;
    margin: 0;
  }

  .slideshow__text {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .slideshow__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .slideshow__button {
    display: inline-block;
    padding: 14px 32px;
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  /* Button styles */
  .button--primary-light {
    background-color: white;
    color: var(--color-text, #333);
    border: 2px solid white;
  }

  .button--primary-light:hover {
    background-color: transparent;
    color: white;
  }

  .button--outline-light {
    background-color: transparent;
    color: white;
    border: 2px solid white;
  }

  .button--outline-light:hover {
    background-color: white;
    color: var(--color-text, #333);
  }

  .button--primary-dark {
    background-color: var(--color-primary, #2c5530);
    color: white;
    border: 2px solid var(--color-primary, #2c5530);
  }

  .button--primary-dark:hover {
    background-color: var(--color-primary-dark, #1e3a21);
    border-color: var(--color-primary-dark, #1e3a21);
  }

  .button--outline-dark {
    background-color: transparent;
    color: var(--color-text, #333);
    border: 2px solid var(--color-text, #333);
  }

  .button--outline-dark:hover {
    background-color: var(--color-text, #333);
    color: white;
  }

  /* Navigation arrows */
  .slideshow__navigation {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    pointer-events: none;
    z-index: 10;
  }

  .slideshow__arrow {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.navigation_background }};
    color: {{ section.settings.navigation_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    transition: all 0.3s ease;
    opacity: 0.8;
  }

  .slideshow__arrow:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  /* Pagination dots */
  .slideshow__pagination {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .slideshow__dot {
    width: 12px;
    height: 12px;
    background: {{ section.settings.pagination_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    opacity: 0.5;
    transition: all 0.3s ease;
    padding: 0;
  }

  .slideshow__dot:hover,
  .slideshow__dot--active {
    opacity: 1;
    transform: scale(1.2);
  }

  /* Empty state */
  .slideshow__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, rgba(44, 85, 48, 0.05), rgba(44, 85, 48, 0.02));
    border: 2px dashed rgba(44, 85, 48, 0.3);
  }

  .slideshow__empty-icon {
    margin-bottom: 16px;
    color: var(--color-primary, #2c5530);
    opacity: 0.6;
  }

  .slideshow__empty h3 {
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    margin: 0 0 8px;
    color: var(--color-text, #333);
  }

  .slideshow__empty p {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    color: var(--color-text, #666);
    margin: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .slideshow__slide {
      min-height: {{ section.settings.mobile_slide_height }}px;
    }

    .slideshow__content {
      padding: 24px;
    }

    .slideshow__heading {
      font-size: calc(var(--heading-size, 48px) * 0.6) !important;
    }

    .slideshow__text {
      font-size: 1rem;
    }

    .slideshow__navigation {
      padding: 0 10px;
    }

    .slideshow__arrow {
      width: 40px;
      height: 40px;
    }

    .slideshow__buttons {
      flex-direction: column;
    }

    .slideshow__button {
      width: 100%;
      text-align: center;
    }
  }

  /* Editor mode styles */
  {% if request.design_mode %}
    .slideshow {
      outline: 2px dashed rgba(44, 85, 48, 0.3);
      outline-offset: -2px;
    }

    .slideshow::before {
      content: 'SLIDESHOW';
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(44, 85, 48, 0.95);
      color: white;
      padding: 4px 12px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.5px;
      border-radius: 3px;
      z-index: 100;
      pointer-events: none;
    }

    .editor-controls--slideshow {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.90);
      color: white;
      padding: 8px 14px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font-body-family);
      display: flex;
      flex-direction: column;
      gap: 4px;
      pointer-events: none;
      border: 2px solid rgba(44, 85, 48, 0.5);
    }

    .editor-controls--slideshow .editor-label {
      font-weight: 600;
      color: var(--color-primary, #2c5530);
      font-size: 12px;
    }

    .editor-controls--slideshow .editor-info {
      font-size: 10px;
      opacity: 0.85;
    }
  {% endif %}
</style>

<script>
  (function() {
    const slideshow = document.getElementById('slideshow-{{ section.id }}');
    if (!slideshow) return;

    const slides = slideshow.querySelectorAll('.slideshow__slide');
    const dots = slideshow.querySelectorAll('[data-slideshow-dot]');
    const prevButton = slideshow.querySelector('[data-slideshow-prev]');
    const nextButton = slideshow.querySelector('[data-slideshow-next]');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let autoplayInterval;
    const autoplay = slideshow.dataset.autoplay === 'true';
    const autoplaySpeed = parseInt(slideshow.dataset.autoplaySpeed) || 5000;

    function goToSlide(index) {
      // Handle wrap around
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      // Update slides
      slides[currentIndex].classList.remove('slideshow__slide--active');
      slides[currentIndex].setAttribute('aria-hidden', 'true');

      slides[index].classList.add('slideshow__slide--active');
      slides[index].setAttribute('aria-hidden', 'false');

      // Update dots
      if (dots.length > 0) {
        dots[currentIndex].classList.remove('slideshow__dot--active');
        dots[currentIndex].setAttribute('aria-selected', 'false');
        dots[index].classList.add('slideshow__dot--active');
        dots[index].setAttribute('aria-selected', 'true');
      }

      currentIndex = index;
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoplay() {
      if (autoplay) {
        autoplayInterval = setInterval(nextSlide, autoplaySpeed);
      }
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
      }
    }

    // Event listeners
    if (prevButton) {
      prevButton.addEventListener('click', function() {
        stopAutoplay();
        prevSlide();
        startAutoplay();
      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', function() {
        stopAutoplay();
        nextSlide();
        startAutoplay();
      });
    }

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        stopAutoplay();
        goToSlide(parseInt(dot.dataset.slideIndex));
        startAutoplay();
      });
    });

    // Pause on hover
    slideshow.addEventListener('mouseenter', stopAutoplay);
    slideshow.addEventListener('mouseleave', startAutoplay);

    // Keyboard navigation
    slideshow.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        stopAutoplay();
        prevSlide();
        startAutoplay();
      } else if (e.key === 'ArrowRight') {
        stopAutoplay();
        nextSlide();
        startAutoplay();
      }
    });

    // Touch/swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    slideshow.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slideshow.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        stopAutoplay();
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
        startAutoplay();
      }
    }

    // Initialize autoplay
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "🎠 Slideshow",
  "tag": "section",
  "class": "section-slideshow",
  "settings": [
    {
      "type": "paragraph",
      "content": "**Page Builder Controls:** Create engaging image slideshows with text overlays and call-to-action buttons. Add slide blocks below."
    },
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full_width", "label": "Full Width" },
        { "value": "full_screen", "label": "Full Screen" }
      ],
      "default": "full_width"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide Height (Full Width)",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "full_screen_height",
      "label": "Screen Height (Full Screen)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_slide_height",
      "label": "Mobile Slide Height",
      "min": 250,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "top center", "label": "Top" },
        { "value": "center center", "label": "Center" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "⏱️ Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "🎬 Transition"
