{% liquid
  # @description Premium customer addresses management section
  # List of saved addresses with add/edit/delete functionality
  # Supports color schemes, visibility controls, and modern styling
  # @blocks help_text, shipping_info
%}

{% render 'visibility-classes',
  show_on_mobile: section.settings.show_on_mobile,
  show_on_desktop: section.settings.show_on_desktop,
  section_id: section.id
%}

<div
  id="{{ section.id }}"
  class="customer-addresses color-scheme-{{ section.settings.color_scheme }}"
>
  <style>
    #{{ section.id }} {
      {% render 'color-scheme', scheme: section.settings.color_scheme %}
      {% render 'section-spacing', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
      {% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}
    }

    #{{ section.id }} .addresses-container {
      {% render 'container-width', width: section.settings.container_width %}
    }

    /* Header */
    #{{ section.id }} .addresses-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-xl);
    }

    #{{ section.id }} .addresses-title {
      font-family: var(--font-heading-family);
      font-size: clamp(1.5rem, 4vw, calc(var(--font-heading-size) * {{ section.settings.title_scale | divided_by: 100.0 }}));
      font-weight: var(--font-heading-weight);
      color: {% if section.settings.heading_color != blank %}{{ section.settings.heading_color }}{% else %}var(--section-heading, var(--color-heading)){% endif %};
      margin: 0;
      line-height: 1.2;
    }

    #{{ section.id }} .addresses-subtitle {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text-secondary));
      margin: var(--spacing-xs) 0 0 0;
      opacity: 0.8;
    }

    /* Add Button */
    #{{ section.id }} .btn-add-address {
      display: inline-flex;
      align-items: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm) var(--spacing-lg);
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      font-weight: 500;
      color: {% if section.settings.button_text_color != blank %}{{ section.settings.button_text_color }}{% else %}var(--button-primary-text){% endif %};
      background: {% if section.settings.button_background_color != blank %}{{ section.settings.button_background_color }}{% else %}var(--button-primary-bg){% endif %};
      border: none;
      border-radius: var(--button-radius);
      cursor: pointer;
      transition: background-color var(--transition-fast), transform var(--transition-fast);
    }

    #{{ section.id }} .btn-add-address:hover {
      background: var(--button-primary-hover);
      transform: translateY(-1px);
    }

    /* Address Grid */
    #{{ section.id }} .addresses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: {{ section.settings.card_spacing }}px;
      margin-bottom: var(--spacing-xl);
    }

    /* Address Card */
    #{{ section.id }} .address-card {
      position: relative;
      background: {% if section.settings.card_background != blank %}{{ section.settings.card_background }}{% else %}var(--scheme-default-bg, white){% endif %};
      border: 1px solid var(--color-text-secondary);
      border-radius: {{ section.settings.card_border_radius }}px;
      padding: {{ section.settings.card_padding }}px;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }

    #{{ section.id }} .address-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    #{{ section.id }} .address-card--default {
      border-color: var(--color-primary);
    }

    /* Default Badge */
    #{{ section.id }} .address-badge {
      position: absolute;
      top: var(--spacing-sm);
      right: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-sm);
      font-size: 0.75rem;
      font-weight: 600;
      color: white;
      background: var(--color-product-badge-new, #059669);
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Address Content */
    #{{ section.id }} .address-content {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      line-height: 1.6;
      color: {% if section.settings.text_color != blank %}{{ section.settings.text_color }}{% else %}var(--section-text, var(--color-text)){% endif %};
      margin-bottom: var(--spacing-md);
    }

    #{{ section.id }} .address-content p {
      margin: 0;
    }

    /* Card Actions */
    #{{ section.id }} .address-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
    }

    #{{ section.id }} .btn-address {
      flex: 1;
      min-width: 80px;
      padding: var(--spacing-xs) var(--spacing-sm);
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.875);
      font-weight: 500;
      color: var(--section-text, var(--color-text));
      background: transparent;
      border: 1px solid var(--color-text-secondary);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    #{{ section.id }} .btn-address:hover {
      background: var(--color-primary);
      border-color: var(--color-primary);
      color: white;
    }

    #{{ section.id }} .btn-address--delete {
      color: var(--color-product-badge-sale, #DC2626);
      border-color: var(--color-product-badge-sale, #DC2626);
    }

    #{{ section.id }} .btn-address--delete:hover {
      background: var(--color-product-badge-sale, #DC2626);
      color: white;
    }

    #{{ section.id }} .btn-address--default {
      flex-basis: 100%;
      margin-top: var(--spacing-xs);
    }

    /* Empty State */
    #{{ section.id }} .addresses-empty {
      text-align: center;
      padding: var(--spacing-3xl) var(--spacing-lg);
    }

    #{{ section.id }} .addresses-empty-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto var(--spacing-md);
      color: var(--color-text-secondary);
      opacity: 0.5;
    }

    #{{ section.id }} .addresses-empty-text {
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      color: var(--section-text, var(--color-text-secondary));
      margin: 0;
    }

    /* Form Wrapper */
    #{{ section.id }} .address-form-wrapper {
      background: {% if section.settings.card_background != blank %}{{ section.settings.card_background }}{% else %}var(--scheme-default-bg, white){% endif %};
      border: 1px solid var(--color-text-secondary);
      border-radius: {{ section.settings.card_border_radius }}px;
      padding: var(--spacing-xl);
      margin-top: var(--spacing-xl);
    }

    #{{ section.id }} .address-form-wrapper.hidden {
      display: none;
    }

    #{{ section.id }} .address-form-title {
      font-family: var(--font-heading-family);
      font-size: clamp(1.25rem, 3vw, 1.5rem);
      font-weight: var(--font-heading-weight);
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-lg);
    }

    /* Form Grid */
    #{{ section.id }} .form-row {
      display: grid;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-md);
    }

    #{{ section.id }} .form-row--2col {
      grid-template-columns: 1fr 1fr;
    }

    #{{ section.id }} .form-row--3col {
      grid-template-columns: 2fr 1fr 1fr;
    }

    #{{ section.id }} .form-group {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    #{{ section.id }} .form-label {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.875);
      font-weight: 500;
      color: var(--section-text, var(--color-text));
    }

    #{{ section.id }} .form-input,
    #{{ section.id }} .form-select {
      width: 100%;
      padding: var(--spacing-sm);
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      color: var(--input-text);
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: var(--radius-sm);
      transition: border-color var(--transition-fast);
    }

    #{{ section.id }} .form-input:focus,
    #{{ section.id }} .form-select:focus {
      outline: none;
      border-color: var(--input-focus-border);
    }

    #{{ section.id }} .form-checkbox {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      cursor: pointer;
    }

    #{{ section.id }} .form-checkbox input {
      width: 18px;
      height: 18px;
      accent-color: var(--color-primary);
    }

    #{{ section.id }} .form-checkbox span {
      font-family: var(--font-body-family);
      font-size: calc(var(--font-body-size) * 0.9375);
      color: var(--section-text, var(--color-text));
    }

    /* Form Actions */
    #{{ section.id }} .form-actions {
      display: flex;
      gap: var(--spacing-md);
      margin-top: var(--spacing-lg);
    }

    #{{ section.id }} .btn-submit {
      padding: var(--spacing-sm) var(--spacing-xl);
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      font-weight: 500;
      color: var(--button-primary-text);
      background: var(--button-primary-bg);
      border: none;
      border-radius: var(--button-radius);
      cursor: pointer;
      transition: background-color var(--transition-fast);
    }

    #{{ section.id }} .btn-submit:hover {
      background: var(--button-primary-hover);
    }

    #{{ section.id }} .btn-cancel {
      padding: var(--spacing-sm) var(--spacing-xl);
      font-family: var(--font-body-family);
      font-size: var(--font-body-size);
      color: var(--section-text, var(--color-text));
      background: transparent;
      border: 1px solid var(--color-text-secondary);
      border-radius: var(--button-radius);
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    #{{ section.id }} .btn-cancel:hover {
      background: var(--color-text-secondary);
      color: white;
    }

    /* Blocks */
    #{{ section.id }} .addresses-blocks {
      margin-top: var(--spacing-xl);
    }

    #{{ section.id }} .block-help-text {
      padding: var(--spacing-lg);
      background: var(--scheme-subtle-bg, #f5f5f5);
      border-radius: var(--radius-md);
      margin-bottom: var(--spacing-md);
    }

    #{{ section.id }} .block-help-text__title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-body-size) * 1.125);
      font-weight: 600;
      color: var(--section-heading, var(--color-heading));
      margin: 0 0 var(--spacing-sm);
    }

    #{{ section.id }} .block-help-text__content {
      font-size: calc(var(--font-body-size) * 0.9375);
      line-height: 1.6;
      color: var(--section-text, var(--color-text-secondary));
      margin: 0;
    }

    #{{ section.id }} .block-shipping-info {
      display: flex;
      gap: var(--spacing-md);
      padding: var(--spacing-lg);
      background: var(--scheme-accent-bg, var(--color-primary));
      color: var(--scheme-accent-text, white);
      border-radius: var(--radius-md);
    }

    #{{ section.id }} .block-shipping-info__icon {
      flex-shrink: 0;
      width: 32px;
      height: 32px;
    }

    #{{ section.id }} .block-shipping-info__content {
      flex: 1;
    }

    #{{ section.id }} .block-shipping-info__title {
      font-family: var(--font-heading-family);
      font-size: calc(var(--font-body-size) * 1.125);
      font-weight: 600;
      margin: 0 0 var(--spacing-xs);
    }

    #{{ section.id }} .block-shipping-info__text {
      font-size: calc(var(--font-body-size) * 0.9375);
      line-height: 1.5;
      margin: 0;
      opacity: 0.9;
    }

    /* Responsive */
    @media screen and (max-width: 767px) {
      #{{ section.id }} .addresses-header {
        flex-direction: column;
        align-items: flex-start;
      }

      #{{ section.id }} .addresses-grid {
        grid-template-columns: 1fr;
      }

      #{{ section.id }} .form-row--2col,
      #{{ section.id }} .form-row--3col {
        grid-template-columns: 1fr;
      }

      #{{ section.id }} .form-actions {
        flex-direction: column;
      }
    }
  </style>

  <div class="addresses-container page-width">
    <header class="addresses-header">
      <div>
        <h1 class="addresses-title">
          {{ section.settings.heading | default: 'customer.addresses.title' | t }}
        </h1>
        {% if section.settings.subtitle != blank %}
          <p class="addresses-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      {% if section.settings.show_add_address_button %}
        <button
          type="button"
          class="btn-add-address"
          onclick="document.getElementById('AddAddress').classList.remove('hidden'); this.scrollIntoView({behavior: 'smooth'});"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          {{ section.settings.add_button_text | default: 'customer.addresses.add_new' | t }}
        </button>
      {% endif %}
    </header>

    {% paginate customer.addresses by 6 %}
      {% if customer.addresses.size > 0 %}
        <div class="addresses-grid">
          {% for address in customer.addresses %}
            <article class="address-card{% if address == customer.default_address %} address-card--default{% endif %}">
              {% if address == customer.default_address %}
                <span class="address-badge">{{ 'customer.addresses.default' | t }}</span>
              {% endif %}

              <div class="address-content">
                {{ address | format_address }}
              </div>

              <div class="address-actions">
                <button
                  type="button"
                  class="btn-address"
                  onclick="EditAddressForm({{ address.id }})"
                >
                  {{ 'customer.addresses.edit' | t }}
                </button>

                <form method="post" action="{{ address.url }}" style="flex: 1; display: flex;">
                  <input type="hidden" name="_method" value="delete">
                  <button
                    type="submit"
                    class="btn-address btn-address--delete"
                    onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')"
                    style="width: 100%;"
                  >
                    {{ 'customer.addresses.delete' | t }}
                  </button>
                </form>

                {% unless address == customer.default_address %}
                  <form method="post" action="{{ address.url }}" class="btn-address--default" style="flex-basis: 100%;">
                    <input type="hidden" name="_method" value="put">
                    <input type="hidden" name="address[default]" value="1">
                    <button type="submit" class="btn-address" style="width: 100%;">
                      {{ 'customer.addresses.set_default' | t }}
                    </button>
                  </form>
                {% endunless %}
              </div>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="addresses-pagination" style="text-align: center; margin-top: var(--spacing-xl);">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% else %}
        <div class="addresses-empty">
          <svg class="addresses-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <p class="addresses-empty-text">
            {{ section.settings.empty_text | default: 'customer.addresses.title' | t }}
          </p>
        </div>
      {% endif %}
    {% endpaginate %}

    {%- comment -%} Add Address Form {%- endcomment -%}
    <div id="AddAddress" class="address-form-wrapper hidden">
      <h2 class="address-form-title">{{ 'customer.addresses.add_new' | t }}</h2>

      {% form 'customer_address', customer.new_address %}
        <div class="form-row form-row--2col">
          <div class="form-group">
            <label for="AddressFirstNameNew" class="form-label">{{ 'customer.addresses.first_name' | t }}</label>
            <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required class="form-input">
          </div>
          <div class="form-group">
            <label for="AddressLastNameNew" class="form-label">{{ 'customer.addresses.last_name' | t }}</label>
            <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required class="form-input">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="AddressCompanyNew" class="form-label">{{ 'customer.addresses.company' | t }}</label>
            <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization" class="form-input">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="AddressAddress1New" class="form-label">{{ 'customer.addresses.address1' | t }}</label>
            <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required class="form-input">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="AddressAddress2New" class="form-label">{{ 'customer.addresses.address2' | t }}</label>
            <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" class="form-input">
          </div>
        </div>

        <div class="form-row form-row--3col">
          <div class="form-group">
            <label for="AddressCityNew" class="form-label">{{ 'customer.addresses.city' | t }}</label>
            <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required class="form-input">
          </div>
          <div class="form-group">
            <label for="AddressCountryNew" class="form-label">{{ 'customer.addresses.country' | t }}</label>
            <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" autocomplete="country" required class="form-select">
              {{ all_country_option_tags }}
            </select>
          </div>
          <div class="form-group" id="AddressProvinceContainerNew" style="display: none;">
            <label for="AddressProvinceNew" class="form-label">{{ 'customer.addresses.province' | t }}</label>
            <select id="AddressProvinceNew" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1" class="form-select"></select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="AddressZipNew" class="form-label">{{ 'customer.addresses.zip' | t }}</label>
            <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" required class="form-input">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="AddressPhoneNew" class="form-label">{{ 'customer.addresses.phone' | t }}</label>
            <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" class="form-input">
          </div>
        </div>

        <div class="form-row">
          <label class="form-checkbox">
            <input type="checkbox" name="address[default]" value="1">
            <span>{{ 'customer.addresses.set_default' | t }}</span>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-submit">{{ 'customer.addresses.add' | t }}</button>
          <button type="button" class="btn-cancel" onclick="document.getElementById('AddAddress').classList.add('hidden')">{{ 'customer.addresses.cancel' | t }}</button>
        </div>
      {% endform %}
    </div>

    {%- comment -%} Edit Address Forms {%- endcomment -%}
    {% for address in customer.addresses %}
      <div id="EditAddress_{{ address.id }}" class="address-form-wrapper hidden">
        <h2 class="address-form-title">{{ 'customer.addresses.edit_address' | t }}</h2>

        {% form 'customer_address', address %}
          <div class="form-row form-row--2col">
            <div class="form-group">
              <label for="AddressFirstName_{{ address.id }}" class="form-label">{{ 'customer.addresses.first_name' | t }}</label>
              <input type="text" id="AddressFirstName_{{ address.id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" required class="form-input">
            </div>
            <div class="form-group">
              <label for="AddressLastName_{{ address.id }}" class="form-label">{{ 'customer.addresses.last_name' | t }}</label>
              <input type="text" id="AddressLastName_{{ address.id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" required class="form-input">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="AddressCompany_{{ address.id }}" class="form-label">{{ 'customer.addresses.company' | t }}</label>
              <input type="text" id="AddressCompany_{{ address.id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" class="form-input">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="AddressAddress1_{{ address.id }}" class="form-label">{{ 'customer.addresses.address1' | t }}</label>
              <input type="text" id="AddressAddress1_{{ address.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required class="form-input">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="AddressAddress2_{{ address.id }}" class="form-label">{{ 'customer.addresses.address2' | t }}</label>
              <input type="text" id="AddressAddress2_{{ address.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" class="form-input">
            </div>
          </div>

          <div class="form-row form-row--3col">
            <div class="form-group">
              <label for="AddressCity_{{ address.id }}" class="form-label">{{ 'customer.addresses.city' | t }}</label>
              <input type="text" id="AddressCity_{{ address.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required class="form-input">
            </div>
            <div class="form-group">
              <label for="AddressCountry_{{ address.id }}" class="form-label">{{ 'customer.addresses.country' | t }}</label>
              <select id="AddressCountry_{{ address.id }}" name="address[country]" data-default="{{ form.country }}" autocomplete="country" required class="form-select">
                {{ all_country_option_tags }}
              </select>
            </div>
            <div class="form-group" id="AddressProvinceContainer_{{ address.id }}" style="display: none;">
              <label for="AddressProvince_{{ address.id }}" class="form-label">{{ 'customer.addresses.province' | t }}</label>
              <select id="AddressProvince_{{ address.id }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1" class="form-select"></select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="AddressZip_{{ address.id }}" class="form-label">{{ 'customer.addresses.zip' | t }}</label>
              <input type="text" id="AddressZip_{{ address.id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" required class="form-input">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="AddressPhone_{{ address.id }}" class="form-label">{{ 'customer.addresses.phone' | t }}</label>
              <input type="tel" id="AddressPhone_{{ address.id }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" class="form-input">
            </div>
          </div>

          <div class="form-row">
            <label class="form-checkbox">
              <input type="checkbox" name="address[default]" value="1"{% if address == customer.default_address %} checked{% endif %}>
              <span>{{ 'customer.addresses.set_default' | t }}</span>
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-submit">{{ 'customer.addresses.update' | t }}</button>
            <button type="button" class="btn-cancel" onclick="document.getElementById('EditAddress_{{ address.id }}').classList.add('hidden')">{{ 'customer.addresses.cancel' | t }}</button>
          </div>
        {% endform %}
      </div>
    {% endfor %}

    {%- comment -%} Blocks {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="addresses-blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'help_text' %}
              <div class="block-help-text" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h3 class="block-help-text__title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.content != blank %}
                  <div class="block-help-text__content">{{ block.settings.content }}</div>
                {% endif %}
              </div>

            {% when 'shipping_info' %}
              <div class="block-shipping-info" {{ block.shopify_attributes }}>
                <svg class="block-shipping-info__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <div class="block-shipping-info__content">
                  {% if block.settings.title != blank %}
                    <h3 class="block-shipping-info__title">{{ block.settings.title }}</h3>
                  {% endif %}
                  {% if block.settings.content != blank %}
                    <p class="block-shipping-info__text">{{ block.settings.content }}</p>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  function EditAddressForm(addressId) {
    document.querySelectorAll('.address-form-wrapper').forEach(function(form) {
      form.classList.add('hidden');
    });
    const editForm = document.getElementById('EditAddress_' + addressId);
    if (editForm) {
      editForm.classList.remove('hidden');
      editForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const countrySelects = document.querySelectorAll('[id^="AddressCountry"]');
    countrySelects.forEach(function(select) {
      select.addEventListener('change', function() {
        const idSuffix = this.id.replace('AddressCountry', '');
        const provinceContainer = document.getElementById('AddressProvinceContainer' + idSuffix);
        const provinceSelect = document.getElementById('AddressProvince' + idSuffix);

        if (provinceContainer && provinceSelect) {
          const selectedOption = this.options[this.selectedIndex];
          const provinces = selectedOption.dataset.provinces;

          if (provinces) {
            try {
              const provinceList = JSON.parse(provinces);
              provinceSelect.innerHTML = '';
              provinceList.forEach(function(province) {
                const option = document.createElement('option');
                option.value = province[0];
                option.textContent = province[1];
                provinceSelect.appendChild(option);
              });
              provinceContainer.style.display = 'block';
            } catch (e) {
              provinceContainer.style.display = 'none';
            }
          } else {
            provinceContainer.style.display = 'none';
          }
        }
      });

      // Trigger change on load for default country
      if (select.value) {
        select.dispatchEvent(new Event('change'));
      }
    });
  });
</script>

