{% comment %}
  Typography Utilities Snippet
  Provides consistent typography classes and utilities based on Figma design tokens.

  Usage:
  {% render 'typography' %}

  This snippet outputs CSS classes for typography that can be used throughout sections.

  Available Classes:
  - .font-accent: Uses the accent font (Versailles by default)
  - .font-heading: Uses the heading font (Nohemi by default)
  - .font-body: Uses the body font (Nohemi by default)
  - .text-hero: Hero title size (80px)
  - .text-h1: H1 size (64px)
  - .text-h2: H2 size (48px)
  - .text-h3: H3 size (32px)
  - .text-h4: H4 size (24px)
  - .text-body: Body size (24px)
  - .text-small: Small size (16px)
  - .tracking-heading: Heading letter spacing (12%)
  - .tracking-body: Body letter spacing (6%)
  - .tracking-button: Button letter spacing (12%)
{% endcomment %}

<style>
  /* Font Family Utilities */
  .font-accent {
    font-family: var(--font-accent-family);
  }

  .font-heading {
    font-family: var(--font-heading-family);
  }

  .font-body {
    font-family: var(--font-body-family);
  }

  /* Font Size Utilities (from Figma scale) */
  .text-hero {
    font-size: var(--font-size-hero);
    line-height: 1.1;
  }

  .text-h1 {
    font-size: var(--font-size-h1);
    line-height: 1.15;
  }

  .text-h2 {
    font-size: var(--font-size-h2);
    line-height: 1.2;
  }

  .text-h3 {
    font-size: var(--font-size-h3);
    line-height: 1.25;
  }

  .text-h4 {
    font-size: var(--font-size-h4);
    line-height: 1.3;
  }

  .text-body {
    font-size: var(--font-size-body);
    line-height: 1.6;
  }

  .text-small {
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  /* Letter Spacing Utilities */
  .tracking-heading {
    letter-spacing: var(--letter-spacing-heading);
  }

  .tracking-body {
    letter-spacing: var(--letter-spacing-body);
  }

  .tracking-button {
    letter-spacing: var(--letter-spacing-button);
  }

  .tracking-none {
    letter-spacing: 0;
  }

  /* Font Weight Utilities */
  .font-light {
    font-weight: 300;
  }

  .font-normal {
    font-weight: 400;
  }

  .font-medium {
    font-weight: 500;
  }

  .font-semibold {
    font-weight: 600;
  }

  .font-bold {
    font-weight: 700;
  }

  /* Color Utilities (from Figma palette) */
  .text-primary {
    color: var(--color-primary);
  }

  .text-secondary {
    color: var(--color-secondary);
  }

  .text-dark {
    color: var(--color-dark);
  }

  .text-white {
    color: #ffffff;
  }

  .text-muted {
    color: var(--color-text-secondary);
  }

  /* Button Styles (from Figma) */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--button-padding-y) var(--button-padding-x);
    border-radius: var(--button-radius);
    font-family: var(--font-body-family);
    font-weight: var(--button-font-weight);
    letter-spacing: var(--button-letter-spacing);
    text-transform: var(--button-text-transform);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--button-primary-bg);
    color: var(--button-primary-text);
    border: none;
  }

  .btn-primary:hover {
    background-color: var(--button-primary-hover);
  }

  .btn-secondary {
    background-color: var(--button-secondary-bg);
    color: var(--button-secondary-text);
    border: 2px solid var(--button-secondary-border);
  }

  .btn-secondary:hover {
    opacity: 0.9;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--button-outline-text);
    border: 2px solid var(--button-outline-border);
  }

  .btn-outline:hover {
    background-color: var(--button-outline-border);
    color: #ffffff;
  }

  /* Responsive Typography */
  @media screen and (max-width: 768px) {
    .text-hero {
      font-size: calc(var(--font-size-hero) * 0.6);
    }

    .text-h1 {
      font-size: calc(var(--font-size-h1) * 0.65);
    }

    .text-h2 {
      font-size: calc(var(--font-size-h2) * 0.7);
    }

    .text-h3 {
      font-size: calc(var(--font-size-h3) * 0.8);
    }

    .text-body {
      font-size: calc(var(--font-size-body) * 0.85);
    }
  }

  @media screen and (max-width: 480px) {
    .text-hero {
      font-size: calc(var(--font-size-hero) * 0.45);
    }

    .text-h1 {
      font-size: calc(var(--font-size-h1) * 0.5);
    }

    .text-h2 {
      font-size: calc(var(--font-size-h2) * 0.6);
    }
  }
</style>
