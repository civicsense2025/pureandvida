{% liquid
  # @description FAQ accordion section with expandable questions and answers
  # Supports dual content management: blocks (dynamic) or settings (fixed fields)
  # @settings content_mode {String} - Content mode: 'blocks' or 'settings'
  # @settings heading {String} - Section heading
  # @settings default_open {Boolean} - Open first item by default
  # @blocks faq_item - Individual FAQ with question and answer
  # @example
  #   Use blocks mode for dynamic FAQs, settings mode for fixed 10-item layout
  assign structural_element = section.settings.structural_element | default: 'section'
%}

<{{ structural_element }} class="faq-section" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %} padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;">
  <div class="faq-content page-width" style="{% if section.settings.content_width != blank %}max-width: {{ section.settings.content_width }}px; margin: 0 auto;{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq-title" style="{% if section.settings.heading_color != blank %}color: {{ section.settings.heading_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; font-size: {{ section.settings.heading_size }}px; font-weight: {{ section.settings.heading_weight }}; margin-bottom: {{ section.settings.heading_spacing }}px;">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    
    {%- if section.settings.description != blank -%}
      <p class="faq-description" style="{% if section.settings.description_color != blank %}color: {{ section.settings.description_color }};{% endif %} text-align: {{ section.settings.heading_alignment }}; font-size: {{ section.settings.description_size }}px; margin-bottom: {{ section.settings.description_spacing }}px;">{{ section.settings.description }}</p>
    {%- endif -%}
    
    <div class="faq-list">
      {%- comment -%} Determine which mode to use: blocks mode if set AND blocks exist, otherwise use settings mode {%- endcomment -%}
      {%- if section.settings.content_mode == 'blocks' and section.blocks.size > 0 -%}
        {%- comment -%} Blocks mode - Dynamic FAQ items {%- endcomment -%}
        {%- for block in section.blocks -%}
          <details class="faq-item" {% if section.settings.default_open and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq-question" style="{% if block.settings.question_color != blank %}color: {{ block.settings.question_color }};{% elsif section.settings.default_question_color != blank %}color: {{ section.settings.default_question_color }};{% endif %} font-size: {{ section.settings.question_size }}px; font-weight: {{ section.settings.question_weight }}; padding: {{ section.settings.item_padding }}px; background: {% if section.settings.item_background_color != blank %}{{ section.settings.item_background_color }}{% else %}transparent{% endif %}; border: {{ section.settings.item_border_width }}px solid {% if section.settings.item_border_color != blank %}{{ section.settings.item_border_color }}{% else %}rgba(0,0,0,0.1){% endif %}; border-radius: {{ section.settings.item_border_radius }}px;">
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq-icon" style="{% if block.settings.icon_color != blank %}color: {{ block.settings.icon_color }};{% elsif section.settings.default_icon_color != blank %}color: {{ section.settings.default_icon_color }};{% endif %} font-size: {{ section.settings.icon_size }}px;">{{ section.settings.icon_text }}</span>
            </summary>
            <div class="faq-answer" style="{% if block.settings.answer_color != blank %}color: {{ block.settings.answer_color }};{% elsif section.settings.default_answer_color != blank %}color: {{ section.settings.default_answer_color }};{% endif %} font-size: {{ section.settings.answer_size }}px; line-height: {{ section.settings.answer_line_height }}; padding: {{ section.settings.answer_padding }}px; background: {% if section.settings.answer_background_color != blank %}{{ section.settings.answer_background_color }}{% else %}transparent{% endif %};">
              <p>{{ block.settings.answer }}</p>
            </div>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Settings mode - Fixed fields (used when content_mode is 'settings' OR when blocks mode has no blocks) {%- endcomment -%}
        {%- for i in (1..10) -%}
          {%- assign question_key = 'faq_' | append: i | append: '_question' -%}
          {%- assign answer_key = 'faq_' | append: i | append: '_answer' -%}
          {%- assign question = section.settings[question_key] -%}
          {%- assign answer = section.settings[answer_key] -%}
          {%- if question != blank or answer != blank -%}
            <details class="faq-item" {% if section.settings.default_open and forloop.first %}open{% endif %}>
              <summary class="faq-question" style="{% if section.settings.default_question_color != blank %}color: {{ section.settings.default_question_color }};{% endif %} font-size: {{ section.settings.question_size }}px; font-weight: {{ section.settings.question_weight }}; padding: {{ section.settings.item_padding }}px; background: {% if section.settings.item_background_color != blank %}{{ section.settings.item_background_color }}{% else %}transparent{% endif %}; border: {{ section.settings.item_border_width }}px solid {% if section.settings.item_border_color != blank %}{{ section.settings.item_border_color }}{% else %}rgba(0,0,0,0.1){% endif %}; border-radius: {{ section.settings.item_border_radius }}px;">
                <span>{{ question | escape }}</span>
                <span class="faq-icon" style="{% if section.settings.default_icon_color != blank %}color: {{ section.settings.default_icon_color }};{% endif %} font-size: {{ section.settings.icon_size }}px;">{{ section.settings.icon_text }}</span>
              </summary>
              <div class="faq-answer" style="{% if section.settings.default_answer_color != blank %}color: {{ section.settings.default_answer_color }};{% endif %} font-size: {{ section.settings.answer_size }}px; line-height: {{ section.settings.answer_line_height }}; padding: {{ section.settings.answer_padding }}px; background: {% if section.settings.answer_background_color != blank %}{{ section.settings.answer_background_color }}{% else %}transparent{% endif %};">
                <p>{{ answer }}</p>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</{{ structural_element }}>

<style>
  /* FAQ Section Base Styles */
  .faq-content {
    padding: 0 clamp(20px, 4vw, 0);
  }
  
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.item_spacing }}px;
  }
  
  .faq-item {
    margin: 0;
  }
  
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    transition: all 0.3s ease;
  }
  
  .faq-question::-webkit-details-marker {
    display: none;
  }
  
  .faq-question:hover {
    {%- if section.settings.item_hover_background_color != blank -%}
      background-color: {{ section.settings.item_hover_background_color }} !important;
    {%- endif -%}
  }
  
  .faq-item[open] .faq-question {
    {%- if section.settings.item_open_background_color != blank -%}
      background-color: {{ section.settings.item_open_background_color }};
    {%- endif -%}
  }
  
  .faq-icon {
    min-width: 24px;
    min-height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 15px;
  }
  
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  
  .faq-answer {
    transition: all 0.3s ease;
  }
  
  /* Mobile adjustments */
  @media screen and (max-width: 767px) {
    .faq-content {
      max-width: 100%;
    }
  }
</style>

