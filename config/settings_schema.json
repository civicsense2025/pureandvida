  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter URL"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "richtext",
        "id": "footer_copyright_text",
        "label": "Copyright Text",
        "default": "<p>Copyright © 2025 Pure Vida. All rights reserved.</p>"
      },
      {
        "type": "checkbox",
        "id": "footer_show_payment_icons",
        "label": "Show Payment Icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "footer_show_newsletter",
        "label": "Show Newsletter Signup",
        "default": false
      }
    ]
  },
  {
    "name": "SEO",
    "settings": [
      {
        "type": "header",
        "content": "General SEO Settings"
      },
      {
        "type": "text",
        "id": "seo_homepage_title",
        "label": "Homepage Meta Title",
        "info": "Leave blank to use shop name. Recommended: 50-60 characters"
      },
      {
        "type": "textarea",
        "id": "seo_homepage_description",
        "label": "Homepage Meta Description",
        "info": "Recommended: 120-160 characters"
      },
      {
        "type": "textarea",
        "id": "seo_default_description",
        "label": "Default Meta Description",
        "info": "Used as fallback when page-specific description is not available"
      },
      {
        "type": "text",
        "id": "seo_default_keywords",
        "label": "Default Meta Keywords",
        "info": "Comma-separated keywords (legacy support)"
      },
      {
        "type": "select",
        "id": "seo_robots_default",
        "label": "Default Robots Meta Tag",
        "options": [
          { "value": "index, follow", "label": "Index, Follow" },
          { "value": "index, nofollow", "label": "Index, No Follow" },
          { "value": "noindex, follow", "label": "No Index, Follow" },
          { "value": "noindex, nofollow", "label": "No Index, No Follow" }
        ],
        "default": "index, follow"
      },
      {
        "type": "header",
        "content": "Social Media & Open Graph"
      },
      {
        "type": "image_picker",
        "id": "seo_og_image",
        "label": "Default Open Graph Image",
        "info": "Recommended: 1200x630px. Used when page-specific image is not available"
      },
      {
        "type": "image_picker",
        "id": "seo_organization_logo",
        "label": "Organization Logo",
        "info": "Used in structured data. Recommended: 600x600px"
      },
      {
        "type": "text",
        "id": "seo_organization_contact_point",
        "label": "Organization Contact Email",
        "info": "Used in Organization schema"
      },
      {
        "type": "header",
        "content": "Site Verification"
      },
      {
        "type": "text",
        "id": "seo_google_verification",
        "label": "Google Search Console Verification Code",
        "info": "Enter the content value from the meta tag"
      },
      {
        "type": "text",
        "id": "seo_bing_verification",
        "label": "Bing Webmaster Tools Verification Code",
        "info": "Enter the content value from the meta tag"
      },
      {
        "type": "text",
        "id": "seo_pinterest_verification",
        "label": "Pinterest Verification Code",
        "info": "Enter the content value from the meta tag"
      },
      {
        "type": "header",
        "content": "Structured Data Settings"
      },
      {
        "type": "checkbox",
        "id": "seo_enable_organization_schema",
        "label": "Enable Organization Schema",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "seo_enable_website_schema",
        "label": "Enable Website Schema",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "seo_enable_breadcrumbs",
        "label": "Enable Breadcrumb Schema",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "seo_enable_local_business",
        "label": "Enable Local Business Schema",
        "default": false
      },
      {
        "type": "header",
        "content": "Local Business Information",
        "info": "Only used if Local Business Schema is enabled"
      },
      {
        "type": "text",
        "id": "seo_local_business_name",
        "label": "Business Name"
      },
      {
        "type": "image_picker",
        "id": "seo_local_business_image",
        "label": "Business Image"
      },
      {
        "type": "textarea",
        "id": "seo_local_business_description",
        "label": "Business Description"
      },
      {
        "type": "text",
        "id": "seo_local_business_address",
        "label": "Street Address"
      },
      {
        "type": "text",
        "id": "seo_local_business_city",
        "label": "City"
      },
      {
        "type": "text",
        "id": "seo_local_business_state",
        "label": "State/Province"
      },
      {
        "type": "text",
        "id": "seo_local_business_postal_code",
        "label": "Postal Code"
      },
      {
        "type": "text",
        "id": "seo_local_business_country",
        "label": "Country",
        "default": "US"
      },
      {
        "type": "text",
        "id": "seo_local_business_phone",
        "label": "Phone Number"
      },
      {
        "type": "header",
        "content": "Image Optimization"
      },
      {
        "type": "checkbox",
        "id": "seo_enable_webp",
        "label": "Enable WebP Format Support",
        "default": false,
        "info": "Automatically serve WebP images when supported"
      },
      {
        "type": "header",
        "content": "Advanced Settings"
      },
      {
        "type": "checkbox",
        "id": "seo_enable_validation",
        "label": "Enable SEO Validation Meta Tags",
        "default": false,
        "info": "Adds meta tags with SEO validation data (for development/debugging)"
      }
    ]
  },
  {
    "name": "Product Page",
    "settings": [
      {
        "type": "header",
        "content": "Product Page Presets"
      },
      {
        "type": "select",
        "id": "product_page_layout",
        "label": "Default Product Page Layout",
        "options": [
          { "value": "standard", "label": "Standard (Image Left, Info Right)" },
          { "value": "centered", "label": "Centered (Image Above, Info Below)" },
          { "value": "fullwidth", "label": "Full Width Gallery" },
          { "value": "minimal", "label": "Minimal" },
          { "value": "bundle", "label": "Bundle Focused" }
        ],
        "default": "standard"
      },
      {
        "type": "header",
        "content": "Variant Picker"
      },
      {
        "type": "select",
        "id": "default_variant_picker_style",
        "label": "Default Variant Picker Style",
        "options": [
          { "value": "dropdown", "label": "Dropdown" },
          { "value": "buttons", "label": "Buttons" },
          { "value": "swatches", "label": "Color Swatches" },
          { "value": "images", "label": "Image Swatches" }
        ],
        "default": "dropdown"
      },
      {
        "type": "checkbox",
        "id": "show_unavailable_variants",
        "label": "Show Unavailable Variants",
        "default": false
      },
      {
        "type": "header",
        "content": "Product Badges"
      },
      {
        "type": "checkbox",
        "id": "show_product_badges",
        "label": "Show Product Badges",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "badge_new",
        "label": "Show New Badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "badge_sale",
        "label": "Show Sale Badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "badge_featured",
        "label": "Show Featured Badge",
        "default": false
      },
      {
        "type": "header",
        "content": "Mobile Settings"
      },
      {
        "type": "checkbox",
        "id": "mobile_sticky_add_to_cart",
        "label": "Sticky Add to Cart on Mobile",
        "default": true
      },
      {
        "type": "select",
        "id": "mobile_gallery_style",
        "label": "Mobile Gallery Style",
        "options": [
          { "value": "carousel", "label": "Carousel" },
          { "value": "stacked", "label": "Stacked" }
        ],
        "default": "carousel"
      },
      {
        "type": "checkbox",
        "id": "mobile_collapse_description",
        "label": "Collapse Description on Mobile",
        "default": true
      }
    ]
  }
]
