<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=5,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- liquid
      assign load_shopify_fonts = false
      if settings.custom_font_heading == 'shopify_font' and settings.font_heading.system? == false
        assign load_shopify_fonts = true
      endif
      if settings.custom_font_body == 'shopify_font' and settings.font_body.system? == false
        assign load_shopify_fonts = true
      endif
    -%}
    {%- if load_shopify_fonts -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.join(', ') }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- comment -%} Enhanced Meta Tags {%- endcomment -%}
    {% render 'meta-tags' %}
    {% render 'seo-meta-advanced' %}

    {%- comment -%} Site Verification Codes {%- endcomment -%}
    {%- if settings.seo_google_verification != blank -%}
      <meta name="google-site-verification" content="{{ settings.seo_google_verification }}">
    {%- endif -%}
    {%- if settings.seo_bing_verification != blank -%}
      <meta name="msvalidate.01" content="{{ settings.seo_bing_verification }}">
    {%- endif -%}
    {%- if settings.seo_pinterest_verification != blank -%}
      <meta name="p:domain_verify" content="{{ settings.seo_pinterest_verification }}">
    {%- endif -%}

    {%- comment -%} Structured Data {%- endcomment -%}
    {%- if settings.seo_enable_organization_schema != false -%}
      {% render 'structured-data', include_organization: true, include_website: settings.seo_enable_website_schema != false, include_breadcrumbs: settings.seo_enable_breadcrumbs != false %}
    {%- else -%}
      {% render 'structured-data', include_organization: false, include_website: settings.seo_enable_website_schema != false, include_breadcrumbs: settings.seo_enable_breadcrumbs != false %}
    {%- endif -%}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-tabs.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}

    {%- liquid
      if settings.custom_font_body == 'shopify_font'
        assign body_font_bold = settings.font_body | font_modify: 'weight', 'bold'
        assign body_font_italic = settings.font_body | font_modify: 'style', 'italic'
        assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      endif
      if settings.custom_font_heading == 'shopify_font'
        assign heading_font_to_load = settings.font_heading
      endif
    %}

    {% style %}
      {%- if settings.custom_font_body == 'shopify_font' -%}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {{ body_font_bold | font_face: font_display: 'swap' }}
        {{ body_font_italic | font_face: font_display: 'swap' }}
        {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if settings.custom_font_heading == 'shopify_font' -%}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
      {%- endif -%}

      /* Custom Fonts from Assets */
      {%- assign nohemi_light = 'Nohemi-Light.otf' | asset_url -%}
      {%- assign nohemi_regular = 'Nohemi-Regular.otf' | asset_url -%}
      {%- assign nohemi_medium = 'Nohemi-Medium.otf' | asset_url -%}
      {%- assign nohemi_semibold = 'Nohemi-SemiBold.otf' | asset_url -%}
      {%- assign nohemi_bold = 'Nohemi-Bold.otf' | asset_url -%}
      {%- assign versailles = 'Jen Wagner Co. - Versailles Regular.ttf' | asset_url -%}
      {%- assign myriad = 'MyriadPro-Regular.otf' | asset_url -%}

      @font-face {
        font-family: 'Nohemi';
        font-weight: 300;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_light }}) format('opentype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_regular }}) format('opentype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 500;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_medium }}) format('opentype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 600;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_semibold }}) format('opentype');
      }

      @font-face {
        font-family: 'Nohemi';
        font-weight: 700;
        font-style: normal;
        font-display: swap;
        src: url({{ nohemi_bold }}) format('opentype');
      }

      @font-face {
        font-family: 'Versailles';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url({{ versailles }}) format('truetype');
      }

      @font-face {
        font-family: 'MyriadPro';
        font-weight: 400;
        font-style: normal;
        font-display: swap;
        src: url({{ myriad }}) format('opentype');
      }

      :root {
        /* Typography */
        {%- liquid
          if settings.custom_font_body == 'nohemi'
            assign body_font_family = 'Nohemi'
            assign body_font_style = 'normal'
            assign body_font_weight = 400
          elsif settings.custom_font_body == 'versailles'
            assign body_font_family = 'Versailles'
            assign body_font_style = 'normal'
            assign body_font_weight = 400
          elsif settings.custom_font_body == 'myriad'
            assign body_font_family = 'MyriadPro'
            assign body_font_style = 'normal'
            assign body_font_weight = 400
          else
            assign body_font_family = settings.font_body.family
            assign body_font_style = settings.font_body.style
            assign body_font_weight = settings.font_body.weight
          endif

          if settings.custom_font_heading == 'nohemi'
            assign heading_font_family = 'Nohemi'
            assign heading_font_style = 'normal'
            assign heading_font_weight = 600
          elsif settings.custom_font_heading == 'versailles'
            assign heading_font_family = 'Versailles'
            assign heading_font_style = 'normal'
            assign heading_font_weight = 400
          elsif settings.custom_font_heading == 'myriad'
            assign heading_font_family = 'MyriadPro'
            assign heading_font_style = 'normal'
            assign heading_font_weight = 600
          else
            assign heading_font_family = settings.font_heading.family
            assign heading_font_style = settings.font_heading.style
            assign heading_font_weight = settings.font_heading.weight
          endif
        -%}
        --font-body-family: {{ body_font_family }}{% if settings.custom_font_body == 'shopify_font' %}, {{ settings.font_body.fallback_families }}{% else %}, sans-serif{% endif %};
        --font-body-style: {{ body_font_style }};
        --font-body-weight: {{ body_font_weight }};
        --font-body-weight-bold: {% if settings.custom_font_body == 'shopify_font' %}{{ settings.font_body.weight | plus: 300 | at_most: 1000 }}{% else %}700{% endif %};
        --font-body-size: {{ settings.font_size_body | default: 16 }}px;
        --font-body-line-height: 1.6;

        --font-heading-family: {{ heading_font_family }}{% if settings.custom_font_heading == 'shopify_font' %}, {{ settings.font_heading.fallback_families }}{% else %}, sans-serif{% endif %};
        --font-heading-style: {{ heading_font_style }};
        --font-heading-weight: {{ heading_font_weight }};
        --font-heading-size: {{ settings.font_size_heading | default: 36 }}px;
        --font-heading-line-height: 1.2;

        /* Colors */
        --color-primary: {{ settings.color_primary }};
        --color-secondary: {{ settings.color_secondary }};
        --color-accent: {{ settings.color_accent }};
        --color-background: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-text-secondary: {{ settings.color_text_secondary }};
        --color-base-text: {{ settings.color_text }};
        --color-base-background-1: {{ settings.color_background }};
        --color-base-solid-button-labels: {{ settings.color_background }};
        --color-base-outline-button-labels: {{ settings.color_primary }};
        --color-base-accent-1: {{ settings.color_primary }};
        --color-base-accent-2: {{ settings.color_secondary }};

        /* Product-specific colors */
        --color-product-badge-sale: {{ settings.color_product_badge_sale | default: '#DC2626' }};
        --color-product-badge-new: {{ settings.color_product_badge_new | default: '#059669' }};
        --color-product-badge-featured: {{ settings.color_product_badge_featured | default: '#3B82F6' }};
        --color-product-price: {{ settings.color_product_price | default: settings.color_text }};
        --color-product-price-sale: {{ settings.color_product_price_sale | default: '#DC2626' }};
        --color-product-button: {{ settings.color_product_button | default: settings.color_primary }};
        --color-product-button-text: {{ settings.color_product_button_text | default: settings.color_background }};

        /* Spacing */
        --spacing-xs: {{ settings.spacing_xs | default: 4 }}px;
        --spacing-sm: {{ settings.spacing_sm | default: 8 }}px;
        --spacing-md: {{ settings.spacing_md | default: 16 }}px;
        --spacing-lg: {{ settings.spacing_lg | default: 24 }}px;
        --spacing-xl: {{ settings.spacing_xl | default: 32 }}px;
        --spacing-2xl: {{ settings.spacing_2xl | default: 48 }}px;
        --spacing-3xl: {{ settings.spacing_3xl | default: 64 }}px;
        --section-spacing: {{ settings.section_spacing | default: 40 }}px;

        /* Border Radius */
        --radius-xs: {{ settings.radius_xs | default: 2 }}px;
        --radius-sm: {{ settings.radius_sm | default: 4 }}px;
        --radius-md: {{ settings.radius_md | default: 8 }}px;
        --radius-lg: {{ settings.radius_lg | default: 12 }}px;
        --radius-xl: {{ settings.radius_xl | default: 16 }}px;
        --radius-full: 9999px;

        /* Shadows */
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

        /* Transitions & Animations */
        --transition-fast: {{ settings.transition_fast | default: 150 }}ms ease;
        --transition-base: {{ settings.transition_base | default: 250 }}ms ease;
        --transition-slow: {{ settings.transition_slow | default: 350 }}ms ease;
        --animation-duration: {{ settings.animation_duration | default: 300 }}ms;

        /* Layout */
        --page-width: {{ settings.container_width }}px;
        --page-width-padding: {{ settings.page_width_padding | default: 20 }}px;

        /* Responsive Breakpoints */
        --breakpoint-mobile-portrait: 480px;
        --breakpoint-mobile-landscape: 768px;
        --breakpoint-tablet-portrait: 768px;
        --breakpoint-tablet-landscape: 1024px;
        --breakpoint-desktop-small: 1200px;
        --breakpoint-desktop-medium: 1440px;
        --breakpoint-desktop-large: 1920px;
        
        /* Legacy breakpoints for backward compatibility */
        --breakpoint-mobile: 768px;
        --breakpoint-tablet: 1024px;
        --breakpoint-desktop: 1440px;

        /* Product-specific spacing */
        --product-gallery-gap: {{ settings.product_gallery_gap | default: 16 }}px;
        --product-info-gap: {{ settings.product_info_gap | default: 24 }}px;
        --product-badge-size: {{ settings.product_badge_size | default: 12 }}px;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: calc(var(--font-body-scale) * 62.5%);
        height: 100%;
      }

      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
        line-height: calc(1 + 0.8 / var(--font-body-scale));
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
        color: var(--color-text);
        background-color: var(--color-background);
      }

      @media screen and (min-width: 750px) {
        body {
          font-size: 1.6rem;
        }
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'pure-vida.css' | asset_url | stylesheet_tag }}

    {%- if settings.custom_font_body == 'shopify_font' and settings.font_body.system? == false -%}
      <link rel="preload" as="font" href="{{ settings.font_body | font_url }}" type="font/woff2" crossorigin>
    {%- endif -%}
    {%- if settings.custom_font_heading == 'shopify_font' and settings.font_heading.system? == false -%}
      <link rel="preload" as="font" href="{{ settings.font_heading | font_url }}" type="font/woff2" crossorigin>
    {%- endif -%}

    {%- comment -%} Preload custom fonts from assets {%- endcomment -%}
    <link rel="preload" as="font" href="{{ 'Nohemi-Light.otf' | asset_url }}" type="font/otf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Nohemi-Regular.otf' | asset_url }}" type="font/otf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Nohemi-Medium.otf' | asset_url }}" type="font/otf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Nohemi-SemiBold.otf' | asset_url }}" type="font/otf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Nohemi-Bold.otf' | asset_url }}" type="font/otf" crossorigin>
    <link rel="preload" as="font" href="{{ 'Jen Wagner Co. - Versailles Regular.ttf' | asset_url }}" type="font/ttf" crossorigin>
    <link rel="preload" as="font" href="{{ 'MyriadPro-Regular.otf' | asset_url }}" type="font/otf" crossorigin>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="gradient">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- render 'cart-notification' -%}

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
      }
    </script>
  </body>
</html>
