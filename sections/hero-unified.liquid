          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "header", "label": "Header" },
            { "value": "content", "label": "Content" }
          ],
          "default": "header"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle Text",
          "default": "Supporting text goes here"
        }
      ]
    },
    {
      "type": "media",
      "name": "Media",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            { "value": "media", "label": "Media Column" },
            { "value": "content", "label": "Content Column" }
          ],
          "default": "media"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Primary Image",
          "info": "Recommended: 800x800px"
        },
        {
          "type": "image_picker",
          "id": "image_2",
