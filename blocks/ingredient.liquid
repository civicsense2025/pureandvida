{% comment %}
  Theme Block: Ingredient
  -----------------------
  Ingredient item with image, name, description, and optional benefit tags.
  Supports grouped overrides for colors, typography, and spacing.
{% endcomment %}

{% liquid
  # Content
  assign ingredient_image = block.settings.image
  assign ingredient_image_asset = block.settings.image_asset
  assign ingredient_name = block.settings.name
  assign ingredient_description = block.settings.description
  assign ingredient_benefit_tags = block.settings.benefit_tags

  # Image settings
  assign img_size = block.settings.image_size | default: 400
  assign image_max_width = block.settings.image_max_width | default: 200
  assign image_border_radius = block.settings.image_border_radius | default: 8

  # Color overrides
  assign bg_color = block.settings.background_color
  assign name_color = block.settings.name_color
  assign text_color = block.settings.description_color
  assign tag_bg_color = block.settings.tag_background_color
  assign tag_text_color = block.settings.tag_text_color
  assign border_color = block.settings.border_color

  # Typography overrides
  assign name_size = block.settings.name_size
  assign name_weight = block.settings.name_weight
  assign text_size = block.settings.text_size
  assign line_height = block.settings.line_height

  # Spacing overrides
  assign padding_y = block.settings.padding_vertical
  assign padding_x = block.settings.padding_horizontal
  assign gap = block.settings.internal_gap
  assign border_width = block.settings.border_width
  assign border_radius = block.settings.border_radius
  assign alignment = block.settings.alignment | default: 'center'
%}

<div
  class="block-ingredient block-ingredient--align-{{ alignment }}"
  {{ block.shopify_attributes }}
  style="
    --block-image-max-width: {{ image_max_width }}px;
    --block-image-radius: {{ image_border_radius }}px;
    {% if bg_color != blank %}--block-bg: {{ bg_color }};{% endif %}
    {% if name_color != blank %}--block-name-color: {{ name_color }};{% endif %}
    {% if text_color != blank %}--block-text-color: {{ text_color }};{% endif %}
    {% if tag_bg_color != blank %}--block-tag-bg: {{ tag_bg_color }};{% endif %}
    {% if tag_text_color != blank %}--block-tag-color: {{ tag_text_color }};{% endif %}
    {% if border_color != blank %}--block-border-color: {{ border_color }};{% endif %}
    {% if name_size != blank %}--block-name-size: {{ name_size }}px;{% endif %}
    {% if name_weight != blank %}--block-name-weight: {{ name_weight }};{% endif %}
    {% if text_size != blank %}--block-text-size: {{ text_size }}px;{% endif %}
    {% if line_height != blank %}--block-line-height: {{ line_height }};{% endif %}
    {% if padding_y != blank %}--block-padding-y: {{ padding_y }}px;{% endif %}
    {% if padding_x != blank %}--block-padding-x: {{ padding_x }}px;{% endif %}
    {% if gap != blank %}--block-gap: {{ gap }}px;{% endif %}
    {% if border_width != blank %}--block-border-width: {{ border_width }}px;{% endif %}
    {% if border_radius != blank %}--block-border-radius: {{ border_radius }}px;{% endif %}
  "
>
  {% if ingredient_image != blank %}
    <div class="block-ingredient__image">
      <img
        src="{{ ingredient_image | image_url: width: img_size }}"
        srcset="
          {{ ingredient_image | image_url: width: 200 }} 200w,
          {{ ingredient_image | image_url: width: 300 }} 300w,
          {{ ingredient_image | image_url: width: img_size }} {{ img_size }}w
        "
        sizes="(max-width: 480px) 50vw, (max-width: 768px) 33vw, 20vw"
        alt="{{ ingredient_name | escape }}"
        loading="lazy"
        width="{{ ingredient_image.width }}"
        height="{{ ingredient_image.height }}"
      >
    </div>
  {% elsif ingredient_image_asset != blank %}
    <div class="block-ingredient__image">
      <img
        src="{{ ingredient_image_asset | asset_url }}"
        alt="{{ ingredient_name | escape }}"
        loading="lazy"
        width="200"
        height="200"
      >
    </div>
  {% else %}
    <div class="block-ingredient__placeholder">
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}

  {% if ingredient_name != blank %}
    <h3 class="block-ingredient__name">
      {{ ingredient_name | escape }}
    </h3>
  {% endif %}

  {% if ingredient_description != blank %}
    <p class="block-ingredient__description">
      {{ ingredient_description }}
    </p>
  {% endif %}

  {% if ingredient_benefit_tags != blank %}
    <div class="block-ingredient__tags">
      {{ ingredient_benefit_tags }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .block-ingredient {
    display: flex;
    flex-direction: column;
    background: var(--block-bg, transparent);
    padding: var(--block-padding-y, 0) var(--block-padding-x, 0);
    gap: var(--block-gap, var(--spacing-sm, 8px));
    border: var(--block-border-width, 0) solid var(--block-border-color, transparent);
    border-radius: var(--block-border-radius, 0);
  }

  .block-ingredient--align-left {
    align-items: flex-start;
    text-align: left;
  }

  .block-ingredient--align-center {
    align-items: center;
    text-align: center;
  }

  .block-ingredient--align-right {
    align-items: flex-end;
    text-align: right;
  }

  .block-ingredient__image,
  .block-ingredient__placeholder {
    width: 100%;
    max-width: var(--block-image-max-width, 200px);
    overflow: hidden;
    border-radius: var(--block-image-radius, 8px);
  }

  .block-ingredient__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .block-ingredient__placeholder {
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .block-ingredient__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  .block-ingredient__name {
    font-size: var(--block-name-size, clamp(1rem, 3vw, 1.25rem));
    font-weight: var(--block-name-weight, 600);
    color: var(--block-name-color, inherit);
    margin: 0;
    line-height: 1.3;
  }

  .block-ingredient__description {
    font-size: var(--block-text-size, clamp(0.813rem, 2vw, 0.938rem));
    line-height: var(--block-line-height, 1.6);
    color: var(--block-text-color, var(--color-text-secondary, inherit));
    margin: 0;
    opacity: 0.85;
  }

  .block-ingredient__tags {
    font-size: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
  }

  .block-ingredient__tags span,
  .block-ingredient__tags p {
    display: inline-block;
    background: var(--block-tag-bg, var(--color-primary-light, rgba(44, 85, 48, 0.1)));
    color: var(--block-tag-color, var(--color-primary, #2c5530));
    padding: 2px 8px;
    border-radius: 4px;
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Ingredient Name",
      "default": "Ingredient"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Describe the ingredient and its benefits."
    },
    {
      "type": "richtext",
      "id": "benefit_tags",
      "label": "Benefit Tags",
      "info": "Add tags like <span>Organic</span> <span>Vegan</span>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image Asset Filename",
      "info": "Alternative: enter asset filename (e.g., 'ingredient.png')"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image Quality",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 400,
      "unit": "px",
      "info": "Higher = better quality, larger file"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image Max Width",
      "min": 100,
      "max": 400,
      "step": 20,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Color Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name Color"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color"
    },
    {
      "type": "color",
      "id": "tag_background_color",
      "label": "Tag Background Color"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag Text Color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color"
    },
    {
      "type": "header",
      "content": "Typography Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name Size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "info": "Default: responsive 16-20px"
    },
    {
      "type": "select",
      "id": "name_weight",
      "label": "Name Weight",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description Size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "info": "Default: responsive 13-15px"
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line Height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Spacing Overrides"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to inherit from theme defaults"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal Padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "internal_gap",
      "label": "Internal Gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "info": "Space between elements. Default: 8px"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Ingredient"
    }
  ]
}
{% endschema %}
